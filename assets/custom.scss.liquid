  }

  span {
    max-width: 70%;
    padding-right: 16px;
    font-size: 16px;
    line-height: 130%;
  }

  .wrapping-result-message {
    max-width: 100%;
  }
}

.cart-gift-wrapping-icon {
  width: 26px;
  height: 26px;
  margin-right: 30px;

  @media screen and (max-width: $tablet) {
    margin-right: 10px;
  }

  svg {
    width: 100%;
  }
}

.cart-gift-wrapping-btn {
  padding: 0;
  margin: 0;
  background-color: transparent;
  border: none;
  font-size: 14px;
  line-height: 16px;
  text-decoration: underline;
}

.cart-gift-wrapping-modal {
  position: absolute;
  top: 60px;
  left: 0;
  transform: translateX(100%);
  width: 100%;
  height: calc(100% - 64px);
  background-color: #fff;
  z-index: 3;
  display: flex;
  flex-direction: column;
  transition: all var(--medium) var(--ease);
}

.cart-gift-wrapping-modal[aria-expanded='true'] {
  transform: translateX(0);
}

.cart-gift-wrapping-modal__content {
  flex-grow: 1;
  overflow-y: scroll;
  overflow-x: hidden;
  -ms-overflow-style: none;
  scrollbar-width: none;

  &::-webkit-scrollbar {
    display: none;
  }
  ::-webkit-scrollbar {
    display: none;
  }

  .cart-drawer__item {
    padding: 25px 32px 25px 22px;
    border: none;
  }
}

.cart-gift-wrapping-modal__content-header {
  padding: 19px 24px;
  font-family: $font-header;
  font-weight: 500;
  font-size: 26px;
  line-height: 100%;
  text-align: center;
  background-color: #FFF9E5;

  button {
    position: absolute;
    right: 24px;
    top: 50%;
    height: 20px;
    transform: translateY(-50%);
    background-color: transparent;
  }
}

.cart-gift-wrapping-modal__note {
  padding: 16px 32px 16px 22px;

  label {
    margin-bottom: 16px;
    display: block;
    font-weight: 700;
    font-size: 16px;
    line-height: 100%;
  }

  #cart-note {
    width: 100%;
    height: 175px;
    padding: 14px 18px;
    margin-bottom: 8px;
    border: 1px solid #C2C2C2;
    border-radius: 5px;
    position: relative;
    font-family: $font-base;
    font-style: normal;
    font-weight: normal;
    font-size: 16px;
    line-height: 120%;
    outline: none !important;

    &::placeholder {
      color: #ABABAB;
      font-size: 16px;
    }

    &::-webkit-resizer {
      display: none;
    }
  }

  .cart-note-wrapper {
    &:before,
    &:after {
      content: '';
      position: absolute;
      bottom: 6px;
      display: block;
      height: 1px;
      background-color: #C2C2C2;
    }

    &:after {
      width: 16px;
      right: 16px;
      transform: rotate(-45deg) translateX(10px);
    }

    &:before {
      width: 34px;
      right: 18px;
      transform: rotate(-45deg) translateX(18px);
    }
  }

  .note-length {
    font-size: 14px;
    line-height: 120%;
    color: #ABABAB;
  }
}

.cart-gift-wrapping-modal__footer {
  padding: 32px 22px;
  background-color: $color-black;

  button {
    width: calc(50% - 4px);
    padding: 16px;
    border-radius: 12px;
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    text-align: center;
    text-transform: capitalize;
  }

  .btn--dark {
    border: 2px solid $color-white;
  }

  .btn--light {
    &:hover {
      border: 2px solid $color-white;
    }
  }
}

.gwp-point-text {
  position: absolute;
  top: 125%;
  left: 65%;
  font-size: 13px;
  font-weight: 700;
}

.gwp-nostack-text {
  font-weight: 500;
  color: #000;
  text-transform:none;
  text-align: center;
  margin: 0;
}

.gwp-point {
  position: absolute;
  bottom: 0;
  left: 0;
  transform: translateX(-50%);
  display: block;
  width: 2px;
  height: 150%;
  background-color: #fff;
}

.pdpMain__bundle-gallery-wrapper {
  padding: 0 8px 0 0;
