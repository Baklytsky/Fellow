  .heroSection__image {
    position: relative;
    padding-top: 100%;

    img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-position: center;
      object-fit: cover;
    }
  }
}

.pdpFeature__wrapper {
  max-width: 1440px;
  padding: 0 32px;
  margin: 32px auto;
  text-align: center;

  @media screen and (max-width: $tablet) {
    padding: 0 16px;
  }
}

.pdpFeature__heading {
  margin: 0 0 42px;
  font-weight: 500;
  font-size: 48px;
  line-height: 100%;

  @media screen and (max-width: $tablet) {
    margin: 0 0 32px;
    font-size: 40px;
  }
}

.pdpFeature__mobileImage {
  display: none;
  margin-bottom: 34px;

  img {
    width: 100%;
    object-position: center;
    object-fit: contain;
  }

  @media screen and (max-width: $large_desk) {
    display: block;
  }
}

.pdpFeature__icon {
  width: 56px;
  min-width: 56px;
  height: 56px;
  margin-bottom: 15px;

  @media screen and (max-width: $large_desk) {
    width: 48px;
    min-width: 48px;
    height: 48px;
    margin: 0 10px 0 0;
  }

  img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-position: center;
    object-fit: cover;
  }
}

.pdpFeature__copy {
  display: flex;
  flex-direction: column;
  text-align: left;

  @media screen and (max-width: $large_desk) {
    flex-direction: row;
  }
}

.pdpFeature__copy-textEnd {
  align-items: flex-end;

  @media screen and (max-width: $large_desk) {
    align-items: unset;
  }
}

.pdpFeature__copy-textRight {
  text-align: right;

  @media screen and (max-width: $large_desk) {
    text-align: left;
  }
}

.pdpFeature__copy-heading {
  margin: 0 0 10px;
  font-weight: 500;
  font-size: 26px;
  line-height: 100%;

  @media screen and (max-width: $large_desk) {
    font-size: 30px;
    margin: 9px 0 16px;
  }
}

.pdpFeature__copy-text {
  margin: 0;
  font-weight: normal;
  font-size: 16px;
  line-height: 130%;
}

.pdpFeature__content {
  display: flex;
  justify-content: space-between;
  align-items: stretch;

  @media screen and (max-width: $large_desk) {
    display: block;
  }
}

.pdpFeature__content-desktop {
  @media screen and (max-width: $large_desk) {
    display: none;
  }
}

.pdpFeature__content-mobile {
  @media screen and (min-width: 1201px) {
    display: none;
  }
}

.pdpFeature__details {
  @media screen and (max-width: $large_desk) {
    width: 100%;
    margin-bottom: 20px;
  }
}

.pdpFeature__content-left,
.pdpFeature__content-right {
  width: 25%;
  display: flex;
  flex-direction: column;

  @media screen and (max-width: $large_desk) {
    width: 100%;
  }
}

.pdpFeature__content-left {
  padding-right: 24px;
  justify-content: center;
}

.pdpFeature__content-right {
  padding-left: 24px;
  justify-content: space-between;
}

.pdpFeature__content-image {
  width: 49%;

  @media screen and (max-width: $large_desk) {
    display: none;
  }
}

.pdpFeature__content-imageWrapper {
  img {
    width: 100%;
    object-fit: contain;
  }
}

.pdpImgCollection {
  margin: 32px 0;
}

.pdpImgCollection__wrapper {
  max-width: 1440px;
  padding: 55px 122px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;

  @media screen and (max-width: $large_desk) {
    padding: 0;
    flex-direction: column;
    justify-content: center;
  }
}

.pdpImgCollection__content {
  width: 41%;
  padding-right: 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;

  @media screen and (max-width: $large_desk) {
    width: 100%;
    max-width: 440px;
    padding: 40px 20px 32px;
  }
}

.pdpImgCollection__content-subheading {
  margin: 0 0 16px;
  font-weight: bold;
  font-size: 16px;
  line-height: 120%;
  color: inherit;

  @media screen and (max-width: $large_desk) {
    margin: 0 0 8px;
  }
}

.pdpImgCollection__content-heading {
  margin: 0 0 24px;
  font-weight: 500;
  font-size: 72px;
  line-height: 100%;
  color: inherit;

  @media screen and (max-width: $large_desk) {
    font-size: 56px;
  }
}

.pdpImgCollection__content-description {
  margin: 0 0 32px;
  font-size: 20px;
  line-height: 120%;

  @media screen and (max-width: $large_desk) {
    margin: 0 0 48px;
    font-size: 16px;
    line-height: 130%;
  }
}

.pdpImgCollection__content-logo {
  max-width: 210px;
  margin: 0 auto;

  img {
    width: 100%;
  }
}

.pdpImgCollection__slider {
  .pdpImgCollection__slide-image {
    padding-top: 100%;

    img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-position: center;
      object-fit: cover;
    }
  }
}

.pdpImgCollection__slider-wrapper {
  width: 48%;

  @media screen and (max-width: $large_desk) {
    width: 70%;
  }

  @media screen and (max-width: $tablet) {
    width: 100%;
  }

  .jsPrevSlide,
  .jsNextSlide {
    position: absolute;
    top: 50%;
    width: 29px;
    height: 29px;
    transform: translateY(-50%);
    color: inherit;
    background-color: transparent;
    z-index: 1;

    @media screen and (max-width: $tablet) {
      display: none;
    }
  }

  .jsPrevSlide {
    left: -53px;
  }

  .jsNextSlide {
    right: -53px;
  }
}

.pdpCompare {
  margin: 32px 0;
}

.pdpCompare__wrapper {
  max-width: 1440px;
  padding: 0 32px;
  margin: 0 auto;

  @media screen and (max-width: $tablet) {
    padding: 0 16px;
  }
}

.pdpCompare__heading {
  margin: 0;
  padding: 0 0 16px;
  font-weight: 500;
  font-size: 48px;
  line-height: 100%;
  border-bottom: 2px solid #DBDBDB;

  @media screen and (max-width: $large_desk) {
    padding: 0 0 24px;
    font-size: 40px;
    border: none;
  }
}

.pdpCompare__table {
  margin-top: 50px;
  border-collapse: collapse;

  @media screen and (max-width: $large_desk) {
    display: none;
  }

  th {
    padding: 16px 24px 0 0;
    font-weight: bold;
    font-size: 16px;
    line-height: 100%;
    text-align: left;
    vertical-align: top;
  }

  td {
    padding: 16px 24px 0 0;
    font-weight: normal;
    font-size: 16px;
    line-height: 130%;
    vertical-align: top;

    p {
      margin: 0 0 16px;
    }
  }

  tr, td {
    border-bottom: 2px solid #DBDBDB;
  }

  tr:first-child {
    border: none;
    td {
      border: none;
    }
  }
}

.pdpCompare__table-th {
  max-width: 320px;
  height: inherit;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.pdpCompare__table-td {
  max-width: 320px;
}

.pdpCompare__table-productTitle {
  margin: 0 0 16px;
  font-weight: 500;
  font-size: 26px;
  line-height: 100%;
  text-align: center;
}

.pdpCompare__table-productImage {
  width: 100%;
  max-width: 320px;
  padding-top: 100%;
  background-color: $color-dim-white;
}

.pdpCompare__table-half {
  th, td {
    width: 50%;
  }
}

.pdpCompare__table-third {
  th, td {
    width: 36%;
  }

  thead tr th:first-child {
    width: 29%;
  }

  tbody tr th {
    width: 29%;
  }
}

.pdpCompare__table-four {
  th, td {
    width: 25%;
  }

  thead tr th:first-child {
    width: 17%;
  }

  thead tr th:last-child {
    width: 33%;
    padding-right: calc(8% + 24px);
  }

  tbody tr th {
    width: 17%;
  }

  tbody tr td:last-child {
    width: 33%;
    padding-right: calc(8% + 24px);
  }
}

.pdpCompare__tabs,
.pdpCompare__tabsProducts-wrapper {
  display: none;

  @media screen and (max-width: $large_desk) {
    display: block;
  }
}

.pdpCompare__tabsProducts-wrapper {
  padding: 0 14px 60px;
  background-color: $color-grey;
}

.pdpCompare__tabsProductsImage {
  width: 100%;
  padding-top: 100%;
}

.pdpCompare__tabsProductsTitle {
  margin: 24px 0 16px;
  font-weight: 500;
  font-size: 24px;
  line-height: 100%;
}

.pdpCompare__tabsProductsSettings {
  margin: 8px 0;
  font-weight: 500;
  font-size: 16px;
  line-height: 100%;
}

.pdpCompare__tabsProductsDescription {
  p {
    margin: 0 0 16px;
    font-weight: normal;
    font-size: 16px;
    line-height: 130%;
  }
}

.pdpCompare__tabsList {
  overflow-x: scroll;
  margin-bottom: 36px;
  display: flex;
  -ms-overflow-style: none;
  scrollbar-width: none;

  &::-webkit-scrollbar {
    display: none;
  }
  ::-webkit-scrollbar {
    display: none;
  }

  li {
    padding: 0 8px 0 0;
  }
}

.pdpCompare__tabButton {
  padding: 8px 16px;
  font-weight: 500;
  font-size: 16px;
  line-height: 20px;
  color: inherit;
  background-color: $color-dim-white;
  border-radius: 12px;
  white-space: nowrap;
}

.pdpCompare__tabButton[aria-selected='true'] {
  background-color: $color-black;
  color: $color-white;
}

.bundleDescription {
  padding: 24px;
  margin-bottom: 16px;
  background-color: $color-dim-white;

  @media screen and (max-width: $tablet) {
    margin-bottom: 24px;
  }
}

.bundleDescription__Heading {
  margin: 0 0 16px 0;
  font-weight: 500;
  font-size: 20px;
  line-height: 120%;

  @media screen and (max-width: $tablet) {
    font-weight: normal;
    line-height: 140%;
  }
}

.bundleDescription__ContentImage {
  margin-right: 16px;
  width: 56px;
  height: 56px;
}

.bundleDescription__ContentTitle,
.bundleDescription__ContentSubTitle {
  font-weight: normal;
  font-size: 14px;
  line-height: 16px;
}

.bundleDescription__ContentTitle {
  margin: 0 0 8px 0;
  text-decoration: underline;
}

.bundleDescription__ContentTitle {
  margin: 0;
}

.pdpBundleInclude {
  padding: 0 34px;
  margin: 32px 0;

  @media screen and (max-width: $tablet) {
    padding: 0 16px;
  }

  .pdpBundleInclude__descriptionText,
  .dropdownContent--animate-block {
    p {
      margin: 0 0 16px;
      font-size: 16px;
      line-height: 130%;
      font-weight: normal;
    }
  }
}

.pdpBundleInclude__heading {
  margin: 0 0 16px 0;
  font-weight: normal;
  font-size: 48px;
  line-height: 100%;
  text-align: center;

  @media screen and (max-width: $large_desk) {
    margin: 0 0 32px 0;
    font-weight: 500;
    font-size: 40px;
  }
}

.pdpBundleInclude__dropdown-wrapper {
  margin: 24px auto 0;
  max-width: 1376px;
  background-color: $color-sand;

  @media screen and (max-width: $tablet) {
    margin: 16px auto 0;
  }
}

.pdpBundleInclude__dropdown-header {
  padding: 24px;
  cursor: pointer;

  @media screen and (max-width: $tablet) {
    padding: 24px 16px;
  }
}

.pdpBundleInclude__dropdown-title {
  font-weight: 500;
  font-size: 42px;
  line-height: 100%;

  @media screen and (max-width: $large_desk) {
    font-size: 20px;
  }
}

.pdpBundleInclude__dropdown-content {
  padding: 16px 24px 24px;
  display: flex;
  justify-content: space-between;

  @media screen and (max-width: $large_desk) {
    flex-direction: column;
    justify-content: unset;
  }

  @media screen and (max-width: $tablet) {
    padding: 0 16px 32px;
  }
}

.pdpBundleInclude__imageWrapper {
  width: 27.5%;

  @media screen and (max-width: $large_desk) {
    width: 100%;
    margin-bottom: 16px;
  }
}

.pdpBundleInclude__image {
  padding-top: 100%;
  border-radius: 12px;
  overflow: hidden;

  @media screen and (max-width: $large_desk) {
    border-radius: 24px;
  }
}

.pdpBundleInclude__description {
  width: 30%;
  padding: 0 10px;

  @media screen and (max-width: $large_desk) {
    width: 100%;
    margin-bottom: 8px;
    padding: 0;
  }
}

.pdpBundleInclude__descriptionTitle {
  margin: 0 0 16px;
  font-family: $font-base;
  font-weight: 500;
  font-size: 20px;
  line-height: 120%;
  padding-right: 10px;

  @media screen and (max-width: $large_desk) {
    font-weight: 600;
    font-size: 14px;
  }
}

.pdpBundleInclude__descriptionLink {
  margin: 0;
  font-weight: normal;
  font-size: 14px;
  line-height: 16px;
  text-decoration: underline;

  @media screen and (max-width: $tablet) {
    margin: 8px 0 0;
  }
}

.pdpBundleInclude__feature {
  width: 30%;
  @media screen and (max-width: $large_desk) {
    width: 100%;
  }
}

.pdpBundleInclude__featureItem {
  margin-bottom: 40px;

  @media screen and (max-width: $large_desk) {
    margin-bottom: 16px;

    &:last-child {
      margin-bottom: 24px;
    }
  }
}
.pdpBundleInclude__featureItemIconWrapper {
  margin-right: 16px;
  width: 100%;
  max-width: 82px;

  @media screen and (max-width: $large_desk) {
    margin-right: 8px;
    max-width: 48px;
  }
}

.pdpBundleInclude__featureItemIcon {
  padding-top: 100%;
}

.pdpBundleInclude__featureItemText {
  font-weight: 500;
  font-size: 20px;
  line-height: 120%;
}
