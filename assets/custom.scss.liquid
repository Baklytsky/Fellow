/* TAB */

[data-action="toggle-tab"] {
  color: $color-dim-dark;

  &[aria-selected="true"] {
    color: $color-black;
  }
}

[data-tab] {
  height: 0;
  opacity: 0;
  transition: all 150ms;

  &[aria-selected='true'] {
    height: auto;
    opacity: 1;
    transition: all 350ms;
  }
}

