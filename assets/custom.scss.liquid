      line-height: 1.3em;
    }
  }
}
.ProductInfoSlider__Link {
  display: inline-block;
  font-family: $font-base;
  font-weight: 600;
  font-size: 20px;
  line-height: 24px;
  border-bottom: 1px solid $color-black;

  @media screen and (max-width: $tablet) {
    font-size: 16px;
    line-height: 20px;
  }
}
.ProductInfoSlider__Arrow {
  position: absolute;
  top: 50%;
  transform: translateX(-50%);
  background: transparent;
  border: transparent;
  padding: 20px;
  line-height: 0;


  @media screen and (max-width: $tablet){
    display: none;
  }

  i {
    display: inline-block;
    color: transparent;
    width: 0;
    height: 0;
    font-size: 1px;
  }

  .icon {
    width: 20px;
    height: 20px;
    display: block;
  }
}
.ProductInfoSlider__ArrowPrev {
  left: 0;
  transform: translateY(-50%);
}
.ProductInfoSlider__ArrowNext {
  right: 0;
  transform: translateY(-50%);
}

