}

.bundle-product__heading {
  margin: 0 0 16px 0;
  font-family: $font-base;
  font-weight: 600;
  font-size: 18px;
  line-height: 20px;
}

.bundle-product__icon-wrapper {
  width: 82px;
  height: 82px;
  min-width: 82px;

