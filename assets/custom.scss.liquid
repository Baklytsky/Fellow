.filter-group__list-item-color {
  display: inline-block;

  .filter-group-title {
    display: none;

    @media screen and (max-width: $tablet) {
      display: inline-block;
    }
  }
}

.filter-group-circle,
.filter-group-circle[data-color] {
  width: 24px;
  height: 24px;
  margin: 0 8px 0 0;
  border: 2px solid #000000;
  flex-shrink: 0;
  border-radius: 50%;
  cursor: pointer;

  &:before,
  &:after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    width: 20px;
    height: 20px;
    border: 2px solid transparent;
    border-radius: 50%;
    background-color: transparent;

    @media screen and (max-width: $tablet) {
      border: 2px solid #ABABAB;
    }
  }

  @media screen and (max-width: $tablet) {
    margin: 0 10px 0 0;
    display: none;
    border: 2px solid transparent;
  }
}

.filter-group-circle[data-color] {
  border: 2px solid transparent;
  margin: 0 16px 0 0;
  &:before,
  &:after {
    border: 2px solid #c2c2c2;
    background-color: currentColor;
  }

  &:before {
    z-index: 2;
    transform: rotate(-45deg);
    clip: rect(0,11px,24px,0);
  }

  @media screen and (max-width: $tablet) {
    display: block;
  }
}

.filter-group-sort-by {
  display: flex;
  flex-direction: column;

  @media screen and (max-width: $tablet) {
    padding-bottom: 8px;
    border-bottom: 1px solid #ABABAB;
