// Search

input[type="search"]::-webkit-search-decoration,
input[type="search"]::-webkit-search-cancel-button,
input[type="search"]::-webkit-search-results-button,
input[type="search"]::-webkit-search-results-decoration {
  display: none;
}

#MainHeader {
  position: relative;
}

.headerSearch {
  background-color: $color-white;
  padding: 40px 10vw;
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  visibility: hidden;
  opacity: 0;
  transform: translateY(-100px);
  transition: transform .15s ease-in-out,opacity .15s ease-in-out,visibility .15s ease-in-out;
  z-index: -1;
  max-height: calc(100vh - var(--header-height));
  overflow-y: auto;
  -ms-overflow-style: none;
  scrollbar-width: none;

  &::-webkit-scrollbar {
    display: none;
  }

  @media screen and (max-width: $tablet) {
    height: calc(100vh - var(--header-height));
    padding: 24px 0 90px;
    z-index: 2;
  }
}

.headerSearch[aria-hidden=false] {
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.searchForm {
  position: relative;

  @media screen and (max-width: $tablet) {
    margin: 0 16px;
  }
}

.searchForm__input {
  width: 100%;
  padding: 16px 50px 14px 20px;
  font-size: 16px;
  line-height: 130%;
  border-radius: 5px;
  border: 1px solid #C2C2C2;

  &:focus {
    border: 1px solid #000;
    border-radius: 5px;
  }
}

.searchForm__resetInput {
  font-size: 0;
  height: 0;
  padding: 0;

  &:focus + label {
    outline: 2px solid blue;
  }
}

.searchForm__resetLabel {
  position: absolute;
  top: 2px;
  right: 30px;
  padding: 10px;
  cursor: pointer;

  @media screen and (max-width: $tablet) {
    top: 3px;
  }

  svg {
    width: 13px;
    height: 13px;
    stroke-width: 1;
  }
}

.searchForm__Submit {
  position: absolute;
  top: 50%;
  right: 0;
  transform: translateY(-50%);
  background: transparent;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;

  @media screen and (max-width: $tablet) {
    transform: translateY(-66%);
  }

  &:focus {
    outline: 2px solid blue;
  }

  svg {
    width: 16px;
    height: 16px;
    vertical-align: middle;
  }
}

.headerSearch__resetLabel {
  display: none;
}

@keyframes rotator {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(270deg);
  }
}

@keyframes dash {
  0% {
    stroke-dashoffset: 280;
  }
  50% {
    stroke-dashoffset: 75;
    transform: rotate(135deg);
  }
  100% {
    stroke-dashoffset: 280;
    transform: rotate(450deg);
  }
}

.headerSearch:not(.loading) .headerSearch__results__loadingState {
  display: none;
}

.headerSearch__results__loadingState {
  width: 16px;
  height: 16px;
  position: absolute;
  top: 40px;
  right: 20px;

  .spinner {
   animation: rotator 1.4s linear infinite;
  }

  .path {
    stroke-dasharray: 280;
    stroke-dashoffset: 0;
    transform-origin: center;
    stroke: currentColor;
    animation: dash 1.4s ease-in-out infinite;
  }
}

.headerSearch__resultsText,
.headerSearch__emptyResults {
  font-weight: bold;
  font-size: 16px;
  line-height: 120%;
  margin: 0 0 24px;
  color: #232323;

  @media screen and (max-width: $tablet) {
    margin: 0 0 16px;
  }
}

.headerSearch__emptyResults {
  margin: 0;
}

.search__popularHeading,
.searchBestSellers__heading {
  margin: 16px 0 8px;
  font-weight: 500;
  font-size: 38px;
  line-height: 100%;
  color: #232323;

  @media screen and (max-width: $tablet) {
    font-size: 16px;
    line-height: 120%;
    font-weight: bold;
    margin: 16px 0;
    font-family: $font-base;
  }
}

.searchBestSellers__heading {
  @media screen and (max-width: $tablet) {
    margin-bottom: 24px;
  }
}

.headerSearch__results {
  padding: 30px 20px;
  transition: all .4s linear;
  border: 1px solid #ABABAB;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
  border-top: none;
  margin: -5px auto 0;
  max-width: 1440px;
  position: relative;

  @media screen and (max-width: $tablet) {
    margin: 24px 0 0;
    padding: 24px 16px 0;
    border: none;
    border-top: 1px solid #DBDBDB;
    border-radius: 0;
  }
}

.headerSearch__results[aria-hidden="false"] {
  display: block;
}

.headerSearch__item {
  margin-bottom: 24px;
  font-size: 16px;
  line-height: 130%;
  display: block;

  &:last-child {
    margin-bottom: 0;
  }
}

.search__popular {
  padding: 24px 0 0;

  @media screen and (max-width: $tablet) {
    padding: 14px 0 0;
  }
}

.search__popular--header.search__popular--hide-desktop {
  @media screen and (min-width: $tablet) {
    display: none!important;
  }
}

.search__popularImageWrapper {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  position: relative;
  border-radius: 10px;
  overflow: hidden;

  @media screen and (max-width: $mobile) {
    padding-bottom: 108%;
  }
}

.headerSearch__emptyResults {
  display: none;

  @media screen and (max-width: $mobile) {
    text-align: center;
  }
}

.search__popularImage {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

.search__popularGrid,
.searchBestSellers__content {
  display: flex;
  flex-wrap: wrap;
  width: calc(100% + 16px);
  margin-left: -8px;
}

.search__popularItem ,
.searchBestSellers__item {
  width: 25%;
  padding: 8px;
  flex-shrink: 0;

  @media screen and (max-width: $mobile) {
    width: 50%;
  }
}

.searchBestSellers__item {
  @media screen and (max-width: $mobile) {
    width: calc(50vw - 8px);
    flex: auto 0 0;
  }
}

.search__popularItemHeading {
  margin: 15px 0;
  text-align: center;
  font-family: $font-base;
  font-weight: normal;
  font-size: 16px;
}

.searchMain {
  padding: 65px 30px 25px;

  @media screen and (max-width: $tablet) {
    padding: 30px 16px 10px;
  }
}

.searchFormMain {
  max-width: 1150px;
  margin: 0 auto;
}

.searchMain__searchSize {
  font-size: 14px;
  line-height: 120%;
  margin-bottom: 24px;

  @media screen and (max-width: $tablet) {
    margin: 25px 0 10px;
  }
}

.search__popular--mainWrapper,
.searchForm,
.searchBestSellers {
  max-width: 1440px;
  margin: 0 auto;
}

.searchMain__resultHeading {
  font-weight: 500;
  font-size: 48px;
  line-height: 100%;
  margin: 0;

  @media screen and (max-width: $tablet) {
    font-size: 33px;
  }
}

.searchMain__empty {
  padding: 40px 0 60px;
  border-bottom: 1px solid #ABABAB;
  text-align: center;

  @media screen and (max-width: $tablet) {
    padding: 25px 0;
  }
}

.searchBestSellers {
  margin-top: 40px;

  .relatedProducts__row {
    @media screen and (max-width: $mobile) {
      margin-left: -16px;
    }

    @media screen and (min-width: $mobile) {
      padding: 8px 0 0 0;
    }
  }

  .relatedProducts__item {
    @media screen and (max-width: $mobile) {
      padding-left: 16px;
      width: calc(50vw - 8px);
    }
  }

  .relatedProducts__row-wrapper {
    -ms-overflow-style: none;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }
}

@keyframes animation-loading-line {
  0% {
    background-position: -200px 0;
  }
  100% {
    background-position: calc(200px + 100%) 0;
  }
}

.searchMain__gridItem {
  width: calc(100% / 3 - 12px);
  flex-shrink: 0;
  padding: 12px 0;

  &.searchMain__gridItem--Loading {
    .bg-animation {
      background-color: #f2f2f2;
      background-image: linear-gradient(90deg, #f2f2f2, #f6f6f6, #f2f2f2 );
      background-size: 200px 100%;
      background-repeat: no-repeat;
      border-radius: 4px;
      animation: animation-loading-line 1.2s ease-in-out infinite;
    }

     .productCard__details {
       margin-top: 10px;
       height: 50px;
     }
  }
}

.filter-group:only-child {
  @media screen and (max-width: $tablet) {
    .dropdownHeader {
      border-top: 0;
      margin-top: 0;
    }
  }
}

.searchMain__content {
  display: flex;
  padding: 0;

  .collection__products {
    @media screen and (min-width: $tablet) {
      padding: 60px 0 0 ;
    }
  }

  .collection__products-filter-results {
    @media screen and (min-width: $tablet) {
      top: 10px;
    }
  }

  .filter-group-mobile [data-mobile-filter] {
    padding: 0;
  }

  .searchMain__searchSize {
    margin-bottom: 12px;
  }
}

.searchForm__Input {
  @media screen and (min-width: $tablet) {
    border-color: #ABABAB;
  }
}

.search__popular--main {
  @media screen and (min-width: $tablet) {
    padding-top: 44px;
  }
}

ul.pdp_details__feature_list {
list-style: unset;
  padding: 0 16px;
}
ul.pdp_details__feature_list > li {
  margin: 0 0 16px;
}


//Yotpo

#pdp-reviews {
  margin: 0 auto;
  max-width: 1440px;
  padding: 0 33px;
  position: relative;

  @media screen and (max-width: $tablet) {
    padding: 0 16px;
  }

  .pdp-reviews__header {
    padding: 0 0 40px;
    border-bottom: 1px solid #ABABAB;

    @media screen and (max-width: $tablet) {
      padding: 0 0 80px;
      text-align: center;
    }

    .pdp-reviews__average {
      display: flex;
      align-items: center;

      @media screen and (max-width: $tablet) {
        padding-bottom: 16px;
        border-bottom: 1px solid #ABABAB;
        justify-content: center;
        flex-direction: row-reverse;
      }
    }

    .pdp-reviews__heading {
      margin: 32px 0 24px;
      font-weight: 500;
      font-size: 48px;
      line-height: 100%;

      @media screen and (max-width: $tablet) {
        margin: 32px 0 8px;
        font-weight: 400;
        font-size: 33px;
        line-height: 100%;
      }
    }

    .pdp-reviews__average-rating {
      margin: 0 20px 0 0;
      font-weight: normal;
      font-size: 26px;
      line-height: 100%;

      @media screen and (max-width: $tablet) {
        margin: 0 0 0 8px;
        font-size: 18px;
        line-height: 120%;
      }
    }

    .pdp-reviews__average-counter {
      display: none;
      @media screen and (max-width: $tablet) {
        margin: 0 0 8px 0;
        display: block;
        font-weight: 600;
        font-size: 20px;
        line-height: 120%;
      }
    }

    .yotpo-display-wrapper {
      .standalone-bottomline {
        padding: 0;
      }

      .yotpo-stars .yotpo-icon.yotpo-icon-star {
        margin-right: 8px;
        font-size: 20px;
      }

      .text-m {
        margin: 0 0 0 20px;
        font-weight: 600;
        font-size: 18px;
        line-height: 20px;

        @media screen and (max-width: $tablet) {
          display: none;
        }
      }
    }
  }

  #pdp-reviews__widget {

    .yotpo-label,
    .yotpo-bottomline-empty-state,
    .yotpo-small-box.yotpo-nav,
    .yotpo-label-container,
    .new-yotpo-small-box,
    .yotpo-regular-box.yotpo-bottomline {
      display: none;
    }

    button, a {
      outline: none !important;
    }

    .yotpo-nav-content {
      .yotpo-review.yotpo-regular-box {
        position: relative;
        min-height: 288px;
        margin: 0;
        padding: 40px 0;
        border-top: 0;
        border-bottom: 1px solid #ABABAB;

        @media screen and (max-width: 1199px) {
          min-height: unset;
        }
      }

      .yotpo-icon-profile,
      .label-with-tooltip,
      .yotpo-footer {
        display: none;
      }

      .yotpo-header-element.yotpo-header-actions {
        display: block;
      }

      .yotpo-user-name,
      .yotpo-review-date {
        font-family: $font-base;
        font-size: 16px;
        line-height: 120%;
        color: $color-black;
      }

      .yotpo-user-name {
        font-weight: 700;
      }

      .yotpo-header.yotpo-verified-buyer {
        display: flex;
      }

      .yotpo-main {
        margin: 24px 0 0;
        max-width: 875px;

        @media screen and (max-width: 1199px) {
          max-width: 100%;
        }

        .content-title {
          margin: 0 0 8px;
          font-family: $font-header;
          font-weight: 500;
          font-size: 26px;
          line-height: 100%;
          color: $color-black;
        }

        .content-review {
          font-family: $font-base;
          font-weight: 400;
          font-size: 16px;
          line-height: 130%;
          color: $color-black;
        }

        .yotpo-review-media-wrapper-desktop,
        .yotpo-review-media-wrapper-mobile,
        .media-review {
          width: 208px !important;
          height: 208px !important;
          margin: 0 !important;
          position: absolute;
          top: 20px;
          right: 0;

          @media screen and (max-width: 1199px) {
            width: 177px !important;
            height: 177px !important;
            position: static;
            top: unset;
            right: unset;
          }
        }
      }

      .yotpo-reviews-filters {
        margin: 0;
        padding: 0;
        border: none;
        height: 0;

        .filters-container {
          position: static;

          .desktop-clear-all-btn {
            right: 33px;
            border: 1px solid #ABABAB;
            display: none;

            .desktop-clear-btn-text {
              font-family: $font-base;
              font-weight: 400;
              color: $color-black;
            }
          }

          .yotpo-visible-mobile {
            display: none !important;
          }

          .yotpo-hidden-mobile {
            display: block !important;
          }
        }

        .dropdown-filters-container {
          position: absolute;
          top: 58px;
          right: 33px;

          @media screen and (max-width: $tablet) {
            top: 130px;
            right: 0;
            left: calc(50% - 159px);
          }

          .yotpo-dropdown-button {
            width: 155px;
            height: 40px;
            padding: 10px 12px;
            border: 1px solid #ABABAB;
            border-radius: 5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: $font-base;
            font-weight: 400;
            font-size: 16px;
            line-height: 130%;
            color: $color-black;

            .selected {
              width: auto;
              font-family: $font-base;
              font-weight: 400;
              font-size: 16px;
              line-height: 130%;
              color: $color-black;
              position: relative;
            }

            .selected[data-selected-key="All"] {
              width: 100%;
              height: 100%;
              font-size: 0;

              &:before {
                content: 'Filter';
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                display: block;
                color: $color-black;
                font-size: 16px;
              }
            }
          }

          .filters-dropdown {
            margin: 0 !important;
          }

          .filters-dropdown[data-default-button-display-value="Rating"] {
            display: none;
          }
        }

        .filters-container-title {
          display: none;
        }
      }

      .yotpo-drop-down-layout .yotpo-dropdown.list-categories {
        top: 40px;
        border: 1px solid #ABABAB;
        width: 155px;
        min-width: 155px;

        .list-category {
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .selected-item,
        .non-selected-item {
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          outline: none;
        }
        [sort-name="highest_rating"], [sort-name="lowest_rating"] {
          display: none !important;
        }
      }

      .yotpo-reviews-header {
        height: 0;
        padding: 0;
        margin: 0;

        .sort-drop-down.yotpo-nav-dropdown  {
          width: 155px;
          height: 40px;
          position: absolute;
          top: 58px;
          right: 215px;
          padding: 10px 12px;
          border: 1px solid #ABABAB;
          border-radius: 5px;
          display: flex;
          justify-content: space-between;
          align-items: center;
          font-family: $font-base;
          font-weight: 400;
          font-size: 16px;
          line-height: 130%;
          color: $color-black;

          @media screen and (max-width: $tablet) {
            top: 130px;
            right: 0;
            left: calc(50% + 4px);
          }

          .yotpo-dropdown-button {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: stretch;
          }

          span {
            padding: 0;
            font-family: $font-base;
            font-weight: 400;
            font-size: 16px;
            line-height: 130%;
            color: $color-black;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;

            &:first-child {
              display: none;
            }
          }

          .selected-bold.selected {
            width: 100%;
            font-family: $font-base;
            font-weight: 400 !important;
            font-size: 16px;
            line-height: 130% !important;
            color: $color-black !important;
            position: relative;
          }

          .selected-bold.selected[data-selected-key="Select"] {
            font-size: 0;

            &:before {
              content: 'Sort By';
              position: absolute;
              left: 0;
              top: 50%;
              transform: translateY(-50%);
              display: block;
              color: $color-black;
              font-size: 16px;
            }
          }
        }

        .reviews-header .reviews-amount {
          display: none;
        }
      }

      .yotpo-empty-search-results,
      .search-in-progress {
        margin-top: 40px;
      }

      .yotpo-icon.yotpo-icon-down-triangle {
        &:before {
          content: url("{{ 'right-arrow.svg' | asset_url }}");
          width: 30px;
          height: 30px;
          display: block;
          transform: rotate(90deg);
          object-position: center;

        }
      }
    }

    .yotpo-pager {
      margin: 40px 0;
      display: flex;
      justify-content: center;
      align-items: center;

      .yotpo-page-element {
        position: relative;
        margin: 0 20px;
        display: inline-block;
        font-family: $font-base;
        font-weight: 500;
        font-size: 16px;
        line-height: 20px;
        color: $color-black;

        @media screen and (max-width: $tablet) {
          margin: 0 5px;
        }
      }

      .yotpo-page-element.yotpo-icon-right-arrow {
        margin: 0 0 0 20px;
        width: 30px !important;
        height: 30px;

        @media screen and (max-width: $tablet) {
          margin: 0 0 0 5px;
        }

        &:before {
          content: url("{{ 'right-arrow.svg' | asset_url }}");
          position: absolute;
          top: 0;
          left: 0;
          width: 30px;
          height: 30px;
          object-position: center;
        }
      }

      .yotpo-page-element.yotpo-icon-left-arrow {
        margin: 0 20px 0 0;
        width: 30px !important;
        height: 30px;

        @media screen and (max-width: $tablet) {
          margin: 0 5px 0 0;
        }

        &:before {
          content: url("{{ 'left-arrow.svg' | asset_url }}");
          position: absolute;
          top: 0;
          left: 0;
          width: 30px;
          height: 30px;
          object-position: center;
        }
      }

      .yotpo-active {
        font-weight: 500;

        &:after {
          content: '';
          position: absolute;
          left: 0;
          bottom: -2px;
          width: 100%;
          height: 2px;
          display: block;
          background-color: $color-black;
        }
      }
    }
  }
}