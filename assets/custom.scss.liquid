  font-size: 48px;
  line-height: 1em;
  text-align: center;

  @media screen and (max-width: $tablet) {
    font-size: 40px;
    padding: 0 16px;
  }
}

/* PDP */

.pdpBar {
  padding: 0 20px;
}

.pdpBar__wrapper {
  width: 100%;
  max-width: 990px;
  margin: 0 auto;
}

.pdpBar__item {
  padding: 13px 0;
}

.pdpBar__item-title {
  padding: 0 10px;
  font-size: 14px;
  font-weight: 400;
  line-height: 120%;
}

.pdpMain__container {
  padding: 24px 33px 46px;

  @media screen and (max-width: $tablet) {
    padding: 0;
  }
}

.pdpMain__gallery-wrapper {
  margin-bottom: -16px;
  padding: 0 24px;

  @media screen and (max-width: $tablet) {
    margin-bottom: 0;
    padding: 0;
  }

  .slick-list, .slick-slide {
    height: inherit;
  }
}

.pdpMain__gallery-thumbnails {
  width: 100%;
  max-width: 92px;
  height: 590px;
  position: sticky;
  top: calc(var(--header-height) + 24px);
  display: block;
  overflow: hidden;

  @media screen and (max-width: $tablet) {
    display: none;
  }

  .slick-slide {
    margin-bottom: 10px;
    border: 2px solid $color-dim-white;
  }

  .slick-list {
    margin-bottom: -30px;
  }

  .pdpMain__gallery-thumbnails-item {
    width: 100%;
    height: 88px;
    cursor: pointer;
    transition: all .2s linear;

    &:hover {
      border: 2px solid #F5F5F5;
      filter: drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.25));
    }
  }

  .pdpMain__gallery-thumbnails-item.current-thumbnail {
    border: 2px solid $color-dim-dark;
  }
}

.pdpMain__variant-image {
  //background-color: #F5F5F5;
  margin-bottom: 16px;
  @media screen and (max-width: $tablet) {
    margin-bottom: 0;
    padding-top: 100%;

    img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-position: center;
      object-fit: contain;
    }
  }

  .productCard__badge {
    top: 16px;
    right: 16px;
    background-color: #EBE9E9;
    font-size: 14px;
    line-height: 120%;

    @media screen and (max-width: $tablet) {
      top: 8px;
      right: 8px;
    }
  }
}

.gtm-pdp {
  .breadcrumbs {
    padding: 24px 33px 0;
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;

    @media screen and (max-width: $tablet) {
      display: none;
    }

    li {
      display: inline;
    }

    li:not(:last-child):after {
      content: ' / ';
    }
  }
}

.pdpCopy__header {
  margin-bottom: 0;

  .pdpCopy__header-title {
    font-size: 48px;
    line-height: 100%;
    margin-bottom: 16px;

    @media screen and (max-width: $tablet) {
      font-weight: 500;
      font-size: 40px;
      margin-bottom: 8px;
    }
  }
}

.pdpCopy__price.hide-desktop {
  margin-top: 8px;
}

h2.pdpCopy__header-price ,
.pdpCopy__header-price {
  margin: 0 0 0 10px;
  font-family: $font-header;
  font-size: 26px;
  line-height: 100%;

  @media screen and (max-width: $tablet) {
    font-size: 24px;
    margin: 0 0 8px 0;
  }
}

.pdpCopy__header-price-small {
  font-size: 16px;
  @media screen and (max-width: $tablet) {
    margin: 0 8px 8px 0;
  }
}

.price-round-arrow {
  position: absolute;
  top: -15px;
  left: 75%;
}

.pdp__tagline {
  margin-bottom: 16px;
  font-weight: bold;
  font-size: 16px;
  line-height: 120%;
  text-transform: capitalize;

  @media screen and (max-width: $tablet) {
    display: none;
  }
}

.pdpMain__details {
  .option-title {
    font-weight: 600;
    font-size: 14px;
    line-height: 120%;
    margin-bottom: 16px;

    span {
      font-weight: normal;
      font-size: 14px;
    }
  }

  .cart__button {
    max-width: 320px;
    padding: 13px 20px;
    margin: 16px 0;
    border-radius: 15px;
    outline: none;
    font-family: 'Inter', sans-serif;
    font-style: normal;
    font-weight: 500;
    font-size: 18px;
    line-height: 24px;
    text-transform: capitalize;

    @media screen and (max-width: $mobile) {
      max-width: 100%;
    }
  }
}

.dropdown {
  .dropdownHeader {
    padding: 26px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .dropdownHeader-title {
    margin: 0;
    font-family: $font-base;
    font-weight: 600;
    font-size: 20px;
    line-height: 24px;
    text-transform: capitalize;
  }

  .dropdownContent {
    padding: 0 24px 24px;
    font-size: 14px;
    line-height: 120%;

    a {
      text-decoration: underline;
    }

    h1,h2,h3,h4,h5,h6,a,p {
      font-size: 14px;
      line-height: 120%;
    }
  }

  .dropdownContent--animate-block {
    opacity: 0;
    transition: opacity .5s cubic-bezier(.215,.61,.355,1),visibility .5s cubic-bezier(.215,.61,.355,1);
    visibility: hidden;
  }

  .dropdownContent--animate-block-visible {
    opacity: 1;
    transition: opacity .8s cubic-bezier(.215,.61,.355,1) .4s,visibility .8s cubic-bezier(.215,.61,.355,1) .4s;
    visibility: visible;

    p {
      font-size: 14px;
      font-weight: 400;
      line-height: 1.2;
    }
  }

  .dropdownHeader-icon {
    width: 29px;
    height: 29px;
    transition: all .2s linear;
  }

  .dropdownHeader-icon--rotate {
    transform: rotate(180deg);
  }
}

.pdpInfo {
  margin-top: 16px;
}
.pdpInfo-item {
  margin-bottom: 16px;
  background-color: #F5F5F5;
}

.pdpBadges-item {
  padding: 16px 12px;
  margin: 16px 0;
  background-color: $color-sand;
}

.pdpBadges-item-content-title,
.pdpBadges-item-link {
  font-family: $font-base;
  font-size: 14px;
  line-height: 120%;
}

.pdpBadges-item-content-title {
  padding: 0 8px;
  margin: 0;
}

.pdpBadges-item-link {
  white-space: nowrap;
  text-decoration: underline;
  font-weight: 400;
}

.pdpVideo__Wrapper {
  padding: 80px 33px;
  flex-direction: column;
  color: #ffffff;
  background-color: #000;

  @media screen and (max-width: $tablet) {
    padding: 40px 15px;
  }
}

.pdpVideo__Copy {
  max-width: 850px;
  margin: 0 auto 48px;
  text-align: center;

  @media screen and (max-width: $tablet) {
    margin: 0 auto 24px;
  }

  h1, h2, h3, h4, h5, h6 {
    margin: 0 0 24px 0;
    font-weight: 500;
    font-size: 72px;
    line-height: 100%;

    @media screen and (max-width: $tablet) {
      font-size: 56px;
      margin: 0 0 16px 0;
    }
  }

  p {
    font-size: 20px;
    line-height: 120%;
    margin: 0 0 16px 0;

    @media screen and (max-width: $tablet) {
      font-size: 16px;
      line-height: 130%;
    }
  }

  a {
    text-decoration: underline;
  }
}

.pdpVideo__Content {
  z-index: 1;
  .cw svg path {
    fill: #FFFFFF;
  }

  .cb svg path {
    fill: #000000;
  }
}

.pdpVideo__Wrapper-row {
  padding: 64px 72px;
  flex-direction: row;
  align-items: center;

  @media screen and (max-width: $tablet) {
    padding: 40px 15px;
    flex-direction: column;
  }

  .pdpVideo__Copy {
    padding-right: 40px;
    margin: 0;
    flex: 1;
    text-align: left;

    @media screen and (max-width: $tablet) {
      flex: auto;
      padding: 0;
      margin: 0 auto 24px;
      text-align: center;
    }
  }

  .pdpVideo__Content {
    width: 100%;
    max-width: 58.7%;

    @media screen and (max-width: $tablet) {
      max-width: 100%;
    }
  }
}

.pdpStickyBar {
  display: none;
  position: fixed;
  top: var(--header-height);
  left: 0;
  width: 100%;
  height: auto;
  background-color: #fff;
  box-shadow: 0 4px 5px rgba(0, 0, 0, 0.1);
  z-index: 10;

  .pdpStickyBar__wrapper {
    padding: 16px 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pdpCopy__header-title {
    margin: 0;
    font-size: 26px;
  }

  .pdpCopy__header-price {
    font-size: 16px;
    line-height: 100%;
  }

  .pdp__options {
    padding-right: 64px;
  }

  #pdp-sticky-atc {
    margin: 0;
  }

  .counter-wrapper {
    padding-right: 64px;
  }

  .option-groups .option-groups__group {
    &:not(:first-child) {
      margin-left: 20px;
    }
  }

  [data-option-color] .radio {
    &:not(:last-child) {
      margin-right: 20px;
    }
  }
}

.pdpStickyBar__badge {
  .separator {
    padding: 0 14px 0 24px;

  }
}

.pdp__sticky-options {
  display: flex;
  flex-direction: row-reverse;
  align-items: center;

  .pdp__sticky-options-label {
    white-space: nowrap;
  }

  .pdp__sticky-options-item {
    display: flex;
    align-items: center;
    margin: 0;

    &:after {
      content: "|";
      padding: 0 16px;
    }

    .option-title {
      padding-right: 16px;
      margin: 0;
    }

    .pdp__sticky-dropdown-icon {
      width: 29px;
      height: 29px;
      position: absolute;
      top: 50%;
      right: 0;
      transform: translate(50%, -50%);
      cursor: pointer;
      transition: all .2s linear;

      svg {
        width: 25px;
        transition: all .2s linear;
      }
    }

    .group-open {
      svg {
        transform: rotate(180deg);
      }
    }
  }

  .radio.checked {
    .radio__title {
      border-color: #000;
      &:before, &:after {
        border-color: #FFF;
      }
    }
  }

  .option-groups {
    margin: 0;
  }

  .option-groups-size {
    padding: 5px;
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    right: 16px;

    .radio {
      margin-bottom: 5px;
    }

    .radio.checked {
      .radio__title {
        color: #ffffff;
        background-color: #000000;
      }
    }
  }

  .option-groups__group {
    padding: 0;
  }

  .radio-group-size {
    margin: 0 !important;
  }
}

.pdpStickyBar {
  @media screen and (max-width: $tablet) {
    top: unset;
    bottom: 0;

    .pdpStickyBar__wrapper {
      padding: 6px 16px;
      justify-content: center;
    }

    .counter-wrapper {
      padding-right: 20px;
    }

    #pdp-sticky-atc {
      min-width: 167px;
    }

    .pdpCopy__header,
    .pdp__options {
      display: none;
    }
  }
}

