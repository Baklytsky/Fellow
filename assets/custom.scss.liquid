.dropdown {
  .dropdownHeader {
    padding: 26px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .dropdownHeader-title {
    margin: 0;
    font-family: $font-base;
    font-weight: 600;
    font-size: 18px;
    line-height: 20px;
    text-transform: capitalize;
  }

  .dropdownContent {
    padding: 0 24px 8px;
    margin-top: -15px;
    font-size: 14px;
    line-height: 120%;

    a {
      text-decoration: underline;
    }

    h1,h2,h3,h4,h5,h6,a,p {
      font-size: 14px;
      line-height: 120%;
      margin: 0 0 16px 0;
    }

    em {
      font-style: normal;
      margin: 0 0 8px 0;
    }

    p:empty {
      margin: 0;
    }
  }

  .dropdownContent--animate-block {
    opacity: 0;
    -webkit-transition: opacity .3s cubic-bezier(.215,.61,.355,1),visibility .3s cubic-bezier(.215,.61,.355,1);
    -o-transition: opacity .3s cubic-bezier(.215,.61,.355,1),visibility .3s cubic-bezier(.215,.61,.355,1);
    transition: opacity .3s cubic-bezier(.215,.61,.355,1),visibility .3s cubic-bezier(.215,.61,.355,1);
    visibility: hidden;
  }

  .dropdownContent--animate-block-visible {
    opacity: 1;
    /*
    -webkit-transition: opacity .8s cubic-bezier(.215,.61,.355,1) .4s,visibility .8s cubic-bezier(.215,.61,.355,1) .4s;
    -o-transition: opacity .8s cubic-bezier(.215,.61,.355,1) .4s,visibility .8s cubic-bezier(.215,.61,.355,1) .4s;
    transition: opacity .8s cubic-bezier(.215,.61,.355,1) .4s,visibility .8s cubic-bezier(.215,.61,.355,1) .4s;
     */
    visibility: visible;

    p {
      font-size: 14px;
      font-weight: 400;
      line-height: 1.2;
    }
  }

  .dropdownHeader-icon {
    width: 29px;
    height: 29px;
    transition: all .2s linear;
  }

  .dropdownHeader-icon--rotate {
    transform: rotate(180deg);
  }
}

