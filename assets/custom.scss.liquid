    display: flex;
    align-items: center;
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    background-color: transparent;

    svg {
      transition: all .2s linear;
    }

    &.open-filter {
      svg {
        transform: rotate(180deg);
      }
