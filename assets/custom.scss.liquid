      display: none;
    }

    .cart__button--select-size {
      display: block;
    }
  }
}

.pdpStickyBar__badge {
  .separator {
    padding: 0 14px 0 24px;

  }
}

.pdp__sticky-options {
  display: flex;
  flex-direction: row-reverse;
  align-items: center;

  .pdp__sticky-options-label {
    white-space: nowrap;
  }

  .pdp__sticky-options-item {
    display: flex;
    align-items: center;
    margin: 0;

    &:after {
      content: "|";
      padding: 0 16px;
    }

    .option-title {
      padding-right: 16px;
      margin: 0;
    }

    .pdp__sticky-dropdown-icon {
      width: 29px;
      height: 29px;
      position: absolute;
      top: 50%;
      right: 0;
      transform: translate(50%, -50%);
      cursor: pointer;
      transition: all .2s linear;

      svg {
        width: 25px;
        transition: all .2s linear;
      }
    }

    .group-open {
      svg {
        transform: rotate(180deg);
      }
    }
  }

  .radio.checked {
    .radio__title {
      border-color: #000;
      &:before, &:after {
        border-color: #FFF;
      }
    }
  }

  .option-groups {
    margin: 0;
  }

  .option-groups-size {
    padding: 5px;
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    right: 16px;

    .radio {
      margin-bottom: 5px;
    }

    .radio.checked {
      .radio__title {
        color: #ffffff;
        background-color: #000000;
      }
    }
  }

  .option-groups-size[data-disabled-size="true"] {
    .radio.checked {
      .radio__title {
        color: #000000;
        background-color: #e7e8e6;
      }
    }
  }

  .option-groups__group {
    padding: 0;
  }

  .radio-group-size {
    margin: 0 !important;
  }
}

.pdpStickyBar {
  @media screen and (max-width: $large_desk) {
    top: unset;
    bottom: 0;

    .pdpStickyBar__wrapper {
      padding: 16px;
      justify-content: center;
    }

    .counter-wrapper {
      padding-right: 20px;
    }

    #pdp-sticky-atc,
    .cart__button--select-size {
      min-width: 167px;
    }

    .pdpCopy__header,
    .pdp__options {
      display: none;
    }
  }
}

