/* STORE REDESIGN */

/* Font-face */
@font-face {
  font-family: 'Inter';
  font-style: normal;
  font-weight: 400;
  src: url(https://fonts.gstatic.com/s/inter/v3/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hjp-Ek-_EeA.woff) format('woff');
}
@font-face {
  font-family: 'PP Right Grotesk';
  src: url('{{ 'PPRightGrotesk-Medium.otf' | asset_url }}') format('opentype');
  font-weight: 500;
  font-style: normal;
}

/* Variable */
$color-white: #fff;
$color-dim-white: #F5F5F5;
$color-black: #000;
$color-dim-dark: #ABABAB;
$color-dim-black: #585858;
$color-sand: #FFF9E5;
$color-grey: #F2F2F2;

$font-header: 'PP Right Grotesk', sans-serif;
$font-base: 'Inter', sans-serif;
/*Breakpoints*/
$mobile: 768px;
$tablet: 992px;
$desk: 1140px;
$large_desk: 1200px;
$widescreen: 1440px;

body {
  font-family: $font-base;
  font-size: 14px;
  -webkit-tap-highlight-color: transparent;
}

h1, h2, h3, h4, h5, h6 {
  font-family: $font-header;
}


//-----------------------Header navigation----------------------------------
#header .newHeader__openedBlock .newHeader__button {
  margin: 0 0 16px 0;
  font-weight: bold;
  background: none;
  padding: 0;
}
#header .mobileMenu .newHeader__button {
  font-weight: bold;
}
#header .topMenu .newHeader__button {
  font-weight: 400;
  background: none;
  padding: 0;
  color: inherit;
}


.newHeader {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 5;

  * {
    font-family: "Inter";
    font-size: 16px;

    .icon--search {
      width: 17px;
      height: 17px;
    }
  }

  .topMenu {
    position: relative;
    width: 100%;
    background: $color-black;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 32px;
    font-family: $font-base;
    color: $color-white;
    font-weight: normal;
    line-height: 1.3em;

    p {
      line-height: 1.3em;
    }

    @media screen and (max-width: $tablet) {
      justify-content: center;
      padding: 6px 32px;
    }
  }

  .topMenu__menu {
    display: flex;
    margin: 0 -12px;

    li {
      margin: 0 12px;
    }

    @media screen and (max-width: $tablet) {
      display: none;
    }
  }

  .rightMenu__search a {
    display: flex;
    align-items: center;

    p {
      margin: 0 15px 0 0;
    }
  }

  .mainMenu {
    background: $color-white;
    display: flex;
    justify-content: space-between;
    flex-wrap: nowrap;
    position: relative;
    padding: 17px 33px;
    align-items: center;
    font-weight: 500;
    box-shadow: 0 0 4px 5px rgba(0, 0, 0, 0.1);

    @media screen and (max-width: $tablet) {
      padding: 5px 16px;
    }
  }

  .mainMenu.mainMenu__center {
    flex-wrap: wrap;

    .mainMenu__logoWrapper {
      flex: 1 1 50%;
    }

    .mainMenu__listWrapper {
      order: 4;
      width: 100%;
      margin: 10px 0 0;
    }

  }

  .mainMenu__logoWrapper {
    order: 1;
    width: 100%;
    margin: 0 20px -5px 0;


    @media screen and (max-width: $tablet) {
      position: absolute;
      top: 55%;
      left: 50%;
      transform: translate3d(-50%, -50%, 0);
    }
  }

  .mainMenu__listWrapper {
    order: 2;
    width: fit-content;
    @media screen and (max-width: $tablet) {
      display: none;
    }
  }

  .mainMenu__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .mainMenu__item {
    position: relative;
    margin: 5px 17px;

    button {
      background: none;
      font-size: inherit;
      padding: 0;
      font-weight: 500;
    }

    @media screen and (max-width: $desk) {
      margin: 5px 7px;
    }
  }

  .mainMenu__cardWrapper {
    order: 3;
    display: flex;
    align-items: center;
    outline: none;
    margin-left: 20px;
  }

  .mainMenu__cardTitle {
    margin: 0 15px 0 0;
    font-weight: 400;

    @media screen and (max-width: $tablet) {
      display: none;
    }
  }

  .mainMenu__cardIcon {
    position: relative;
    transition: 0.3s;

    svg {
      width: 32px;
      height: 42px;
    }

    @media screen and (max-width: $tablet) {
      svg {
        width: 24px;
        height: 32px;
      }
    }
  }

  .mainMenu__cardIcon:hover {
    transform: translateY(-10px);

    @media screen and (max-width: $tablet) {
      transform: none;
    }
  }

  .mainMenu__cardCount {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    bottom: 0;
    margin: auto;
    transform: translateY(-50%);
    color: white;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    line-height: 17px;
  }

  .megaMenu, .megaMenu[data-visible="true"] {
    position: relative;
    display: none;
  }

  .megaMenu[data-selected="true"] {
    display: flex;
    justify-content: space-between;
    overflow-x: auto;
    overflow-y: hidden;

    @media screen and (max-width: $tablet) {
      overflow-x: auto;
    }

  }

  .newHeader__openedBlock .megaMenu[data-visible="false"] {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 300px;
    display: flex;
    justify-content: space-between;
    padding: 24px 25px 22px 32px;
    background: $color-white;
    z-index: 6;
  }

  .megaMenu__list {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    max-height: 245px;
    max-width: 700px;
    margin: 35px 0 0 105px;

    @media screen and (min-width: $tablet) {
      flex-direction: row;
      flex-wrap: nowrap;
      max-width: none;
      flex-flow: row wrap;
      align-content: flex-start;
      writing-mode: vertical-lr;
    }

    @media screen and (max-width: $desk) {
      margin-left: 0;
    }

    @media screen and (max-width: $tablet) {
      margin: 0;
    }
  }

  .megaMenu__item {
    margin: 0 12.5px;
    width: 210px;

    @media screen and (min-width: $tablet) {
      writing-mode: horizontal-tb;
    }

    @media screen and (max-width: $desk) {
      width: fit-content;
    }
  }

  .megaMenu__item > a {
    display: block;
    font-weight: normal;
    margin: 0 0 16px 0;
    width: -moz-fit-content;
    width: fit-content;
    transition: 0.3s;

    &:hover {
      font-weight: bold;
    }
  }

  .megaMenu__itemBold {
    margin: 0 12.5px 16px;
  }

  .megaMenu__itemBold > a {
    font-weight: bold;
  }

  .megaMenu__bar {
    margin: 0 auto;
  }

  .megaMenu__bar * {
    text-align: center;
    margin: 0;

    @media screen and (max-width: $tablet) {
      font-size: 12px;
      line-height: 24px;
    }
  }

  .megaMenu_blockImages {
    flex: 0 0 33.5%;
  }

  .megaMenu__onlyImagesBlock {
    .megaMenu_blockImages {
      flex: 1 1 auto;
    }

    .blockImages__list {
      max-width: none;
      justify-content: center;
    }

    .blockImages__card {
      flex: 0 1 33.5%;
      max-width: 400px;
    }
  }

  .subMenuList__item {
    margin: 0 0 16px 0;
    font-weight: 400;
    transition: 0.3s;

    &:hover {
      font-weight: bold;
    }
  }

  .blockImages {
    position: relative;
    justify-content: flex-end;
  }

  .blockImages__list {
    display: flex;
    width: 100%;
    max-width: 430px;
  }

  .blockImages__card {
    max-width: 410px;
    width: 100%;
    margin: 0 7px;
    text-align: center;
  }

  .blockImages__bottom {
    margin: 15px auto 5px;
    width: fit-content;
    width: -moz-fit-content;
    line-height: 1.3em;
    font-size: 16px;
    font-weight: normal;
    transition: 0.3s;
    &:hover {
      font-weight: bold;
    }
  }

  .blockImages {
    display: flex;

    .blockImages__img {
      position: relative;
      max-height: 220px;
      height: 16vw;
      width: 100%;

      img {
        position: absolute;
        top: 0;
        left: 0;
        object-fit: cover;
        width: 100%;
        height: 100%;
        object-position: center;
        border-radius: 10px;
        transition: 0.3s;

        &:hover {
          opacity: 80%;
          box-shadow: 0 4px 4px 0px rgba(0, 0, 0, 0.25);
        }
      }
    }
  }

  .newHeader__blockImages {
    justify-content: center;
    width: 100%;

    .blockImages__card {
      flex: 0 1 32%;
    }
  }

  .newHeader__openedBlock {
    display: none;
    position: relative;
    width: 100%;
    background: $color-white;
    padding: 24px 25px 22px 32px;
    box-shadow: inset 0px 35px 5px -30px rgba(0, 0, 0, 0.1);
  }
}

.burgerMenu {
  display: none;

  @media screen and (max-width: $tablet) {
    display: block;
    position: relative;
    width: 17px;
    height: 12px;
    z-index: 5;
    background: none;
    border: none;

    span {
      transition: all 0.3s ease 0s;
      top: calc(50% - 1px);
      left: 0;
      position: absolute;
      width: 17px;
      height: 2px;
      background-color: $color-black;

      &:first-child {
        top: 0;
      }

      &:last-child {
        top: auto;
        bottom: 0;
      }
    }

    &.active {
      span {
        transform: scale(0);

        &:first-child {
          transform: rotate(-45deg);
          top: 50%;
        }

        &:last-child {
          transform: rotate(45deg);
          bottom: calc(50% - 2px);
        }
      }
    }
  }
}

.mobileMenu {
  display: none;
  position: fixed;
  top: var(--header-height);
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 105%;
  transform: translateX(-100%);
  transition: 0.3s;
  padding: 0 0 30px;

  .mobileMenu__wrapper {
    background: $color-white;
    height: 100%;
    padding-bottom: 30%;
    overflow-x: hidden;
    overflow-y: auto;
    box-shadow: inset 0 35px 5px -30px rgba(0, 0, 0, 0.1);

    @media (orientation: landscape) {
      padding-bottom: 10%;
    }
  }

  .mobileMenu__list {
    position: relative;

    * {
      font-size: 16px;
      font-weight: 400;

      button {
        background: none;
        padding: 0;
      }

      p {
        margin: 0;
      }
    }
  }

  .mobileMenu__item {
    padding: 16px 25px 16px 16px;
    border-bottom: 1px solid #c4c4c4;
    -webkit-tap-highlight-color: transparent;

  }

  .mobileMenu__link {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;

    > p {
      font-weight: bold;
    }
  }

  .mobileMenu__item .megaMenu.active {
    transform: translateX(0);
    position: fixed;
  }

  .mobileMenu__item .megaMenu.megaMenu__onlyImagesBlock {
    .blockImages {
      flex-direction: column;
      margin: 0;
    }

    .blockImages__list {
      flex-direction: column;
      padding: 0 16px;
    }

    .blockImages__card {
      margin: 10px 0 0;

      &:first-child {
        margin: 40px 0 0;
      }
    }
  }

  .mobileMenu__item .megaMenu {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    transform: translateX(100%);
    transition: 0.3s;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    z-index: 1;
    padding-bottom: 30%;
    background: $color-white;

    @media (orientation: landscape) {
    padding-bottom: 15%;

  }

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100vh;
      background: $color-white;
    }

    .megaMenu__list {
      max-height: none;
      max-width: none;
      margin-left: 0;
    }

    .megaMenu__item {
      width: 100%;
      margin: 0;
      z-index: 1;
      -webkit-tap-highlight-color: transparent;
    }

    .megaMenu__itemHeading {
      width: 100%;
      display: flex;
      justify-content: space-between;
      padding: 16px 25px 16px 16px;
      background: $color-black;
      font-weight: bold;
      text-transform: capitalize;
      color: $color-white;

      svg {
        transform: rotate(180deg);

        * {
          fill: $color-white;
        }
      }
    }

    .newHeader__link {
      margin: 0;
      display: flex;
      justify-content: space-between;
      width: 100%;
      padding: 21px 21px 21px 16px;
      border-bottom: 1px solid #c4c4c4;

      svg {
        transform: rotate(90deg);
        transition: 0.4s;
      }

      &::after {
        content: none;
      }
    }

    .newHeader__link.active {
      svg {
        transform: rotate(-90deg);
      }
    }

    .megaMenu_blockImages {
      margin: 40px 0 0 0;
    }

    .blockImages__list {
      padding: 0 6px;
      max-width: none;
    }

    .blockImages__card {
      max-width: none;
      margin: 0 10px;
      -webkit-tap-highlight-color: transparent;
    }

    .blockImages__img {
      height: 188px;
    }

    .subMenuList {
      display: none;
    }

    .subMenuList__item {
      margin: 0;
    }
  }

  @media screen and (max-width: $tablet) {
    display: block;
  }
}

.mobileMenu.active {
  transform: translateX(0);
}

/*Tehnical classes*/

.fixed {
  overflow: hidden;
}

.linkWhite[data-selected="true"], .linkWhite[data-selected="false"] {
  position: relative;

  &::after {
    position: absolute;
    bottom: -5px;
    left: 50%;
    width: 100%;
    height: 1px;
    content: "";
    transform: translateX(-50%);
    background: $color-white;
    transition: 0.2s;

  }
}

.linkWhite[data-selected="false"] {
  position: relative;

  &::after {
    width: 0;
  }

  &:hover {
    &::after {
      width: 100%;
    }
  }
}

.linkBlack[data-selected="true"], .linkBlack[data-selected="false"] {
  position: relative;

  &::after {
    position: absolute;
    bottom: -5px;
    left: 50%;
    width: 100%;
    height: 2px;
    content: "";
    transform: translateX(-50%);
    -webkit-transform: translateX(-50%);
    -o-transform: translateX(-50%);
    background: $color-black;
    transition: 0.5s;
    -webkit-transition: 0.5s;
    -o-transition: 0.5s;
    will-change: transition;
  }
}

.linkBlack[data-selected="false"] {
  &::after {
    width: 0;
  }

  &:hover {
    &::after {
      width: 100%;
    }
  }
}


//-----------------------End Header navigation----------------------------------

/* Slick default styles */
.slick-slider {
  position: relative;
  display: block;
  box-sizing: border-box;
  -moz-box-sizing: border-box;
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  -khtml-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  -ms-touch-action: pan-y;
  touch-action: pan-y;
  -webkit-tap-highlight-color: transparent;
  z-index: 1;
  overflow-x: hidden;
}
.slick-list {
  position: relative;
  overflow: hidden;
  display: block;
  margin: 0;
  padding: 0;

  &:focus {
    outline: none;
  }

  &.dragging {
    cursor: pointer;
    cursor: hand;
  }
}
.slick-slider .slick-track,
.slick-slider .slick-list {
  -webkit-transform: translate3d(0, 0, 0);
  -moz-transform: translate3d(0, 0, 0);
  -ms-transform: translate3d(0, 0, 0);
  -o-transform: translate3d(0, 0, 0);
  transform: translate3d(0, 0, 0);
}

.slick-track {
  position: relative;
  left: 0;
  top: 0;
  display: flex;

  &:before,
  &:after {
    content: "";
    display: table;
  }

  &:after {
    clear: both;
  }

  .slick-loading & {
    visibility: hidden;
  }
}
.slick-slide {
  float: left;
  height: 100%;
  min-height: 1px;
  display: none;
  [dir="rtl"] & {
    float: right;
  }
  img {
    display: block;
  }
  &.slick-loading img {
    display: none;
  }
  &.dragging img {
    pointer-events: none;
  }
  &:focus {
    outline: none;
  }

  .slick-initialized & {
    display: block;
  }

  .slick-loading & {
    visibility: hidden;
  }
  .slick-vertical & {
    display: block;
    height: auto;
    border: 1px solid transparent;
  }
}

.slick-dots {
  width: 100%;
  padding: 12px 16px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;

  li {
    margin: 4px;
    width: 8px;
    height: 8px;
    font-size: 0;
    line-height: 0;
  }

  li button {
    width: 8px;
    height: 8px;
    padding: 0;
    display: block;
    border-radius: 50%;
    background-color: #DBDBDB;
    font-size: 0;
    line-height: 0;
  }

  li.slick-active button {
    background-color: #000000;
  }
}

.slick-vertical .slick-track {
  flex-direction: column;
}

.image-abs-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-position: center;
  object-fit: cover;
}

.image-abs-contain {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-position: center;
  object-fit: contain;
}

/* Announcement bar timer */
.announcement-bar {
  display: flex;
  flex-wrap: wrap;
  padding: 1rem 2rem;

  @media (max-width: 991.98px) {
    padding: 1rem;
  }
}
.announcement-bar__message {
  padding-right: 16px;
}

.announcement-bar__message,
.announcement-bar__timer {
  font-size: 16px;

  @media (max-width: 991.98px) {
    font-size: 14px;
  }
}

.announcement-bar__timer {
  display: inline-flex;
  align-items: center;
  flex-wrap: nowrap;
  font-weight: 400;
  line-height: 1.6;

  * {
    margin-right: 4px;
    white-space: nowrap;
  }
}

.announcement-bar__timer-days:empty {
  display: none;
}

.site-header__logo-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  img, svg {width: 100%}
}

.hide-mobile {
  @media screen and (max-width: 991.98px) {
    display: none;
  }
}

.hide-desktop {
  @media screen and (min-width: 992px) {
    display: none;
  }
}

#shopify-section-footer {
  -webkit-tap-highlight-color: transparent;
  .inner {
    -webkit-tap-highlight-color: transparent;
  }
}

.footer__icons {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.footer__icons-item {
  list-style-type: none;
  margin-right: 24px;

  &:last-child {
    margin-right: unset;
  }
}

.footer__icon {
  border-radius: 52%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 24px;
  width: 24px;

  svg {
    width: auto;
    height: 100%;
    margin: 0;
  }
}

.footer__icon-link {
  display: block;
}

/* Nav Drawer Header */

@media (min-width: 992px) {
  .header__inner--constrain .nav__item.is-open .nav__drawer {
    top: var(--header-height) !important;
  }
}

/* Product Recommended Collection */

.pdpRecCollection {
  .col-lg-10 {
    padding-left: 0;
    padding-right: 0;
  }
}

.pdpRecCollection__slideshow {
  padding: 0 20px;

  .slick-arrow {
    background: 0 0;
    color: #737373;
    font-size: 1.5rem;
    transition: all var(--fast) var(--ease);

    position: absolute;
    top: 0;
    height: 100%;
    width: 40px;
    z-index: 1;

    &:hover {
      color: #000000;
    }
  }

  .slick-disabled {
    opacity: 0;
  }

  .slick-prev {
    left: -10px;
  }

  .slick-next {
    right: -10px;
  }
}

.pdpRecCollection__slide {
  &.slick-slide {
    display: flex;
    height: auto;
    padding: 0 1vw;
  }

  .productCard {
    width: 100%;
  }
}

/* Page referral */

#conjured_referral {
  input,
  select,
  textarea {
    border: 1px solid #000;
  }
}

[data-color="stone-blue"],
[data-material="stone-blue"] {
  color: rgb(237, 200, 144);
  &:after {
    color: #2B3C4D;
  }
}


/* STORE REDESIGN */


/* Animation */
@keyframes pulse {
  0% {opacity: 1;}
  20% {opacity: .7;}
  40% {opacity: .5;}
  60% {opacity: .3;}
  80% {opacity: .5;}
  1000% {opacity: 7;}
}

/* MODAL */
#modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  padding: 16px;
  width: 100%;
  height: 100%;
  background-color: rgba($color-dim-black, .8);
}

.Modal {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  max-width: 910px;
  max-height: 90%;
  padding: 40px;
  background: $color-white;
  border-radius: 12px;
}

#emptyModal {
  padding: 80px;
  margin: 0 auto;
  width: 100%;
  max-width: 50%;

