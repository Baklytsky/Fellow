  @media screen and (max-width: $tablet) {
    font-size: 18px;
    flex-direction: column;
    justify-content: unset;
  }
}

.upsell-product__content-price {
  font-family: $font-base;
  font-weight: normal;
  font-size: 24px;
  line-height: 120%;
margin-left: 10px;

  @media screen and (max-width: $tablet) {
    margin-top: 8px;
    font-size: 16px;
    margin-left: 0;
  }
}

.upsell-product__content-description {
  margin-bottom: 16px;
  font-weight: normal;
  font-size: 16px;
  line-height: 130%;

  @media screen and (max-width: $tablet) {
    font-size: 14px;
    line-height: 120%;
  }
}

#pdp-product-upsell-atc {
  padding: 0;
  display: inline-block;
  font-weight: 500;
  font-size: 14px;
  line-height: 16px;
