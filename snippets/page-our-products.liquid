{%- assign items = page.metafields.custom_fields["our_products_items"] -%}
{% if items != blank %}
  <div class="our-products container--l">
    {% if page.metafields.custom_fields["our_products_heading"] != blank %}
      <h2 class="ac">{{ page.metafields.custom_fields["our_products_heading"] }}</h2>
    {% endif %}

    <div class="our-products__inner">
      {% for item in items %}
        <div class="our-products__item">
          <div class="our-products__image rel">
            <img class="x block {% if item['secondary_image'] != blank %} primary {% endif %}" src="{{ item['primary_image'] }}" alt='Image of custom product for {{ item["title"] }}' role="img">
            {% if item['secondary_image'] != blank %}
              <img class="x y abs secondary fill z1" src="{{ item['secondary_image'] }}" alt='Secondary image of custom product for {{ item["title"] }}' role="img">
            {% endif %}
          </div>
          <div class="mt1 ac">
            <h4 class="our-products__item-title my0 open-sans p semi">
              {{ item["title"] }}
            </h4>
            <div class="our-products__item-body my0">
              {{ item["body"] }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}