{%- assign section_order = page.metafields["custom_fields_family"]["section_order"] | default: 100 -%}
{%- assign section_title = page.metafields["custom_fields_family"]["heading"] -%}
{%- assign section_subtitle = page.metafields["custom_fields_family"]["subtitle"] -%}
{%- assign section_description = page.metafields["custom_fields_family"]["description"] -%}

{% if page.metafields["custom_fields"]["family_slides"] != blank %}
  {%- capture 'slick-config' -%}
    {
    "slidesToShow": 1,
    "arrows": false,
    "dots": false,
    "speed": 300,
    "fade": true,
    "draggable": false,
    "swipe": false,
    "touchMove": false
    }
  {%- endcapture -%}

  <slide-tab-section class="slide-tab-section block"
                     data-section-type="slick-slideshow"
                     data-slick-config='{{- slick-config -}}'
                     style="order: {{ section_order }}">

    <div class="jsSlickSlider">
      {%- assign tabs_size = page.metafields["custom_fields"]["family_slides"].size -%}

      {% for item in page.metafields["custom_fields"]["family_slides"] %}
        {%- assign breadcrumb_name = item["breadcrumb_name"] -%}
        {%- assign breadcrumb_url = item["breadcrumb_url"] -%}
        {%- assign bg_color = item["background_color"] | default: '#FFF' -%}
        {%- assign bg_image = item["background_image"] -%}
        {%- assign bg_image_mobile = item["background_image_mobile"] -%}
        {%- assign text_color = item["text_color"] | default: '#000' -%}
        {%- assign tab_style = item["tab__button_style"] | default: 'light' -%}
        {%- assign tab_name = item["tab_name"] | default: 'Tab name' -%}
        {%- assign slide_title = item["title"] -%}
        {%- assign slide_description = item["description"] -%}
        {%- assign slide_btn_text = item["button_text"] | default: 'Shop now' -%}
        {%- assign slide_btn_url = item["button_url"] -%}
        {%- assign slide_image = item["image"] -%}
        {%- assign slide_image_on_the_left = item["image_on_the_left"] -%}
        {%- assign slideCounter = forloop.index0 -%}

        {%- capture image -%}
          <div class="slide-tab__inner-image-wrapper rel">
            {%- if slide_image != blank -%}
              {%- assign alt = slide_image.alt | default: slide_title -%}
              {% render 'image-lazy-metafields',
                image: slide_image,
                class_name: 'image-abs-cover',
                alt: alt,
                size: 'medium' %}
            {%- endif -%}
          </div>
        {%- endcapture -%}

        <div class="slide-tab slide-tab-{{ forloop.index }} rel"
             style="background-color: {{ bg_color }}; color: {{ text_color }}">
          <div class="slide-tab__wrapper page-wrapper">

            {%- if breadcrumb_name != blank and breadcrumb_url != blank -%}
              <div class="slide-tab__breadcrumbs f aic hide-mobile">
                <a href="/">Home</a>
                <span>/</span>
                <a href="{{ breadcrumb_url }}">{{ breadcrumb_name }}</a>
              </div>
            {%- endif -%}

            <div class="slide-tab__inner {% if slide_image_on_the_left == '1' %}slide-tab__inner--reverse{% endif %}">
              <div class="slide-tab__inner-content">
                {%- if section_title != blank -%}
                  <h2 class="slide-tab__inner-title">{{ section_title }}</h2>
                {%- endif -%}
                {%- if section_subtitle != blank -%}
                  <h3 class="slide-tab__inner-subtitle">{{ section_subtitle }}</h3>
                {%- endif -%}
                {%- if section_description != blank -%}
                  <div class="slide-tab__inner-description">{{ section_description }}</div>
                {%- endif -%}

                <div class="slide-tab__inner-tabs slide-tab__inner-tabs--{{ tab_style | handleize }} slide-tab__inner-tabs--{{ tabs_size }}">
                  {% for item in page.metafields["custom_fields"]["family_slides"] %}
                    {%- assign tab_name = item["tab_name"] | default: 'Tab name' -%}
                    <button class="slide-tab__inner-tab {% if slideCounter == forloop.index0 %}active{% endif %}"
                            data-slide-index="{{ forloop.index0 }}">
                      {{ tab_name }}
                    </button>
                  {% endfor %}
                </div>

                <div class="slide-tab__inner-image hide-desktop">
                  {{ image }}
                </div>

                {%- if slide_title != blank or slide_description != blank or slide_btn_url != blank -%}
                  <div class="slide-tab__inner-block">
                    {%- if slide_title != blank -%}
                      <h4 class="slide-tab__inner-block-title">{{ slide_title }}</h4>
                    {%- endif -%}
                    {%- if slide_description != blank -%}
                      <div class="slide-tab__inner-block-description">{{ slide_description }}</div>
                    {%- endif -%}
                    {%- if slide_btn_url != blank -%}
                      <a href="{{ slide_btn_url }}"
                         class="slide-tab__inner-block-btn btn btn--{{ tab_style | handleize }}">
                        {{ slide_btn_text }}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

              <div class="slide-tab__inner-image hide-mobile">
                {{ image }}
              </div>
            </div>
          </div>

          {%- assign desktop_image_class_name = 'image-abs-cover z-1' -%}

          {%- if bg_image_mobile != blank -%}
            {%- assign alt = slide_image.alt | default: slide_title -%}
            {%- assign desktop_image_class_name = 'image-abs-cover hide-mobile z-1' -%}
            {% render 'image-lazy-metafields',
              image: bg_image_mobile,
              class_name: 'image-abs-cover hide-desktop z-1',
              alt: alt,
              size: 'medium' %}
          {%- endif -%}

          {%- if bg_image != blank -%}
            {%- assign alt = slide_image.alt | default: slide_title -%}
            {% render 'image-lazy-metafields',
              image: bg_image,
              class_name: desktop_image_class_name,
              alt: alt,
              size: 'medium' %}
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
  </slide-tab-section>
{% endif %}