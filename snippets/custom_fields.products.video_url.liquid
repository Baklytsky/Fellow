{% if product.metafields.custom_fields["video_url"] != blank %}
  <div class="custom-field custom-field__video-url custom-field__type--url">
    <h3 class="custom-field--title">Video URL</h3>
    <div class="custom-field--value">
      {{ product.metafields.custom_fields["video_url"] }}
    </div>
  </div>
{% endif %}