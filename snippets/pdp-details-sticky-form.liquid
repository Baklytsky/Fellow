{% comment %}form start & end moved to pdp-details-main to adjust for shop pay {% endcomment %}
{% comment %} Always include product-options, product.js:20 reads from it for ATC {% endcomment %}
{% include 'product-sticky-options' %}

  <div class='f {% if template contains 'gift_card' %}fdc{% else %}fdr{% endif %} jcb' id='atc-sticky-wrapper'>
    {%- assign hasPreorderTag = false -%}
    {%- if product.tags contains 'preorder' -%}
      {%- assign hasPreorderTag = true -%}
    {%- endif -%}
  {%- capture cta -%}
    {% if product.selected_variant.available %}
      <span data-atc-copy class="js-atc-copy">
        {% if product.selected_variant.metafields.my_fields.preorder or hasPreorderTag %}
          Pre-Order
        {% else %}
          Add to Cart
        {% endif %}
      </span>
      {%- assign disableVal = false -%}
    {% else %}
    <span data-atc-copy class="js-atc-copy">
      {% if product.tags contains 'discontinued' %}
        Discontinued
      {% else %}
        Out Of Stock | Notify Me
      {% endif %}
      {%- assign disableVal = false -%}
    </span>
    {% endif %}
  {%- endcapture -%}
  {% comment %} Add catch for low stock variants {% endcomment %}
    <div class="pdpStickyDetails__btns" data-disabled-size="{{ product_has_size_option }}">

      {%- if product_has_size_option -%}
        <button type="button" class="cart__button cart__button--select-size">Select size</button>
      {%- endif -%}

      {%
        include 'component-button' with
        tag: 'button',
        id: 'pdp-sticky-atc',
        name: 'add',
        type: 'button',
        href: '#',
        className: 'cart__button',
        dataAttr: '',
        disabled: disableVal,
        cta: cta,
      %}
    </div>
</div>