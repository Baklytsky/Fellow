{% assign article = articles[section.settings.featuredPost] %}

<div class='featuredPost__wrapper x rel f fdc'>
  {% if section.settings.title != blank and section.settings.title_location == "left_inner" %}
    <div class='d-none d-lg-block d-xl-block'>
      {% include 'blog-title-block' %}
    </div>
  {% endif %}
  <div class='featuredPost x y rel f fdc'>
    <a href='{{ article.url }}' class='abs x y top left z1'>
      <span class='u-sr-only'>Featured Post: {{ article.title }}</span>
    </a>
    <div class='featuredPost__content y z0'>
      <div class="image z0">
        {% render 'image-lazy',
          image: article.image,
          size: 'medium',
          alt: section.settings.title,
          loader: true %}
      </div>
      <div class='featuredPost__copy al'>
        <p class='eyebrow'>Featured</p>
        <h3 class='b mt0 mb1'>{{ article.title }}</h3>
        <div class='rte mb1'>
          {{ article.excerpt_or_content | strip_html | truncatewords: 25, '...' }}
        </div>
        <a href="{{ article.url }}" class='underline underlineArrow' aria-label='Read more about {{ article.title | escape }}'>{{ 'blogs.article.read_more' | t }}</a>
      </div>
    </div>
  </div>
</div>