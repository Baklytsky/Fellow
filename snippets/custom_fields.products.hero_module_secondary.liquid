{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-products.myshopify.com/products/configure/96988/edit
{% endcomment %}
{% if product.metafields.custom_fields["hero_module_secondary"] != blank %}
  <div class="custom-field custom-field__hero-module-secondary custom-field__type--field-collection">
    <h3 class="custom-field--title">Hero Module Bottom</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign hero_copy_bottom_array = product.metafields.custom_fields["hero_copy_bottom"] | split: separator %}
      {% assign hero_image_bottom_array = product.metafields.custom_fields["hero_image_bottom"] | split: separator %}
      {% assign fc_keys = product.metafields.custom_fields["hero_module_secondary"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--hero module fc-index--{{ index }}">
          <div class="fc-field field__hero-copy-bottom">
            {{ hero_copy_bottom_array[index] }}
          </div>
          <div class="fc-field field__hero-image-bottom">
            {{ hero_image_bottom_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}