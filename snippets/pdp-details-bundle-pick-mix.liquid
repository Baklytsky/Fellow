{% if product.metafields.custom_fields["product_tagline"] != blank %}
  {% assign tagline = product.metafields.custom_fields["product_tagline"] %}
{% endif %}
{% capture dataProductForm %}
  { "money_format": {{ shop.money_format | json }}, "button": {{ 'products.product.add_to_cart' | t | json }} }
{% endcapture %}

<section class='pdpMain__details pdpMain-bundle__details z2 rel'>

  {% form 'product', product, data-product-form: dataProductForm, class: 'shopify-product-form pdpForm' %}
    <div class='pdpCopy__header'>
      <div class=' f jcb aic'>
        <h1 class='pdpCopy__header-title'>{{ product.title }}</h1>
        <h2 data-selected-var-price class="ml1 visually-hidden">{{ current_variant.price | money | remove: '.00' }}</h2>
        <div class="pdpCopy__price hide-mobile f aic">
          {% if product.available %}
            {% if product.compare_at_price > product.price %}
              <span class="inline-block strike card__price--regular ml1 pdpCopy__header-price pdpCopy__header-price-small rel"
                    data-compare-at-price>
              <span>{{ current_variant.compare_at_price | money_without_trailing_zeros }}</span>
              <div class="price-round-arrow">{% render 'icon' with 'round-arrow' %}</div>
            </span>
              <span class="visually-hidden">{{ 'products.current_variant.regular_price' | t }}</span>
              <h2 class="inline-block card__price--sale ml1 pdpCopy__header-price" data-product-price>
                {{ current_variant.price | money_without_trailing_zeros }}
              </h2>
            {% else %}
              {% comment %}
                Product is available and not on sale
              {% endcomment %}
              <h2 data-selected-var-price class="ml1 pdpCopy__header-price"
                  data-product-price>{{ current_variant.price | money | remove: '.00' }}</h2>
            {% endif %}
          {% else %}
            {% comment %}
              Sold Out
            {% endcomment %}
            <h2 class='strike' data-product-price>{{ current_variant.price | money_without_trailing_zeros }}</h2>
          {% endif %}
          {% if product.compare_at_price > product.price %}
            <span class="productCard__badge abs z3 xsmall cb"
                  style="top:50px;">{% if product.price_max > product.price %}Save up to ${{ product.compare_at_price_max | minus:product.price_max | times:0.01 | floor }} {% elsif product.compare_at_price > product.price %} Save ${{ product.compare_at_price | minus:product.price | times:0.01 | floor }} {% else %} {% endif %}</span>
          {% endif %}
        </div>
      </div>
      {% if tagline != blank %}
        <div class='pdp__tagline'>{{ tagline }}</div>{% endif %}

      <afterpay-placement
              data-intro-text="Pay in"
              data-logo-type="badge"
              data-show-with="true"
              data-badge-theme="black-on-mint"
              data-size="sm"
              data-type="price-paragraph"
              data-is-eligible="true"
              data-locale="en_US"
              data-modal-link-style="circled-info-icon"
              data-amount="{{ current_variant.price | money | remove: '.00' }}"
              data-modal-theme="white" class="mb1 mt1 hidden-md-down">
      </afterpay-placement>

      <div class="pdp__reviews mb1 mt1">
        {%- assign reviews_count = product.metafields.yotpo.reviews_count | plus: 0 -%}
        {%- if reviews_count > 0 -%}
          {% include 'yotpo-star-rating-widget' %}
        {%- endif -%}
      </div>
      <div class="pdpCopy__price hide-desktop">
        {% if product.available %}
          {% if product.compare_at_price > product.price %}
            <span class="inline-block strike card__price--regular ml1 pdpCopy__header-price pdpCopy__header-price-small rel"
                  data-compare-at-price>
              <span>{{ current_variant.compare_at_price | money_without_trailing_zeros }}</span>
              <div class="price-round-arrow">{% render 'icon' with 'round-arrow' %}</div>
            </span>
            <span class="visually-hidden">{{ 'products.current_variant.regular_price' | t }}</span>
            <h2 class="inline-block card__price--sale ml1 pdpCopy__header-price" data-product-price>
              {{ current_variant.price | money_without_trailing_zeros }}
            </h2>
          {% else %}
            {% comment %}
              Product is available and not on sale
            {% endcomment %}
            <h2 data-selected-var-price class="ml1 pdpCopy__header-price"
                data-product-price>{{ current_variant.price | money | remove: '.00' }}</h2>
          {% endif %}
        {% else %}
          {% comment %}
            Sold Out
          {% endcomment %}
          <h2 class='strike' data-product-price>{{ current_variant.price | money_without_trailing_zeros }}</h2>
        {% endif %}
        {% if product.compare_at_price > product.price %}
          <span class="productCard__badge abs z3 xsmall cb" style="font-size:12px;margin-left:8px;top:auto;right:auto;"><span>{% if product.price_max > product.price %}Save up to ${{ product.compare_at_price_max | minus:product.price_max | times:0.01 | floor }} {% elsif product.compare_at_price > product.price %} Save ${{ product.compare_at_price | minus:product.price | times:0.01 | floor }} {% else %} {% endif %}</span></span>
        {% endif %}
      </div>
    </div>
    <afterpay-placement
            data-intro-text="Or"
            data-logo-type="lockup"
            data-show-with="false"
            data-lockup-theme="black"
            data-size="sm"
            data-type="price-paragraph"
            data-is-eligible="true"
            data-locale="en_US"
            data-modal-link-style="none"
            data-show-upper-limit="false"
            data-amount="{{ current_variant.price | money | remove: '.00' }}"
            data-modal-theme="white" class="mb1 mt1 hidden-lg-up">
    </afterpay-placement>

    {%- if product.metafields.custom_fields["bundle_product"] != blank -%}
      {% include 'pdp-details-form-bundle-pick-mix' %}
    {%- else -%}
      {% include 'pdp-details-form-bundle' %}
    {%- endif -%}
  {% endform %}

  {% include 'pdp-badges' %}
  {% include 'pdp-info' %}
</section>
