{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-products.myshopify.com/products/configure/129937/edit
{% endcomment %}
{% if product.metafields.custom_fields["placeholder_badge"] != blank %}
  <div class="custom-field custom-field__placeholder-badge custom-field__type--image">
    <h3 class="custom-field--title">Placeholder Badge</h3>
    <div class="custom-field--value">  
      {% include 'cf-image' with image: product.metafields.custom_fields["placeholder_badge"] %}
    </div>
  </div>
{% endif %}