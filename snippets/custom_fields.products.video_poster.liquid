{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-products.myshopify.com/products/configure/111570/edit
{% endcomment %}
{% if product.metafields.custom_fields["video_poster"] != blank %}
  <div class="custom-field custom-field__video-poster custom-field__type--image">
    <h3 class="custom-field--title">Video Poster Image</h3>
    <div class="custom-field--value">  
      {% include 'cf-image' with image: product.metafields.custom_fields["video_poster"], print: 'url' %}
    </div>
  </div>
{% endif %}