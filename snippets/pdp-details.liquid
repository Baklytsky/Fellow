{% if product.metafields.custom_fields["product_tagline"] != blank %}
  {% assign tagline = product.metafields.custom_fields["product_tagline"] %}
{% endif %}
{% capture dataProductForm %}
  { "money_format": {{ shop.money_format | json }}, "button": {{ 'products.product.add_to_cart' | t | json}} }
{% endcapture %}

<section class='pdpMain__details z2 rel'>


  <div class='pdpStickyBar'>
    <div class="pdpStickyBar__wrapper">
      <div class='pdpCopy__header'>
        <div class='f jcb aic'>
          <h1 class='pdpCopy__header-title'>{{ product.title }}</h1>
          <h2 data-selected-var-price class="ml1 visually-hidden">{{ current_variant.price | money | remove: '.00' }}</h2>
        </div>
      </div>
      {% include 'pdp-details-sticky-form' %}
    </div>
  </div>


  {% comment %} <form action='/cart/add' method='post' enctype='multipart/form-data' data-component='productForm'> {% endcomment %}
  {% form 'product', product, data-product-form: dataProductForm, class: 'shopify-product-form pdpForm' %}
    <div class='pdpCopy__header'>
      <div class=' f jcb aic'>
        <h1 class='pdpCopy__header-title'>{{ product.title }}</h1>
        <h2 data-selected-var-price class="ml1 visually-hidden">{{ current_variant.price | money | remove: '.00' }}</h2>
        <div class="pdpCopy__price hide-mobile">
          {% if product.available %}
          {% if current_variant.compare_at_price > current_variant.price %}
          {% comment %}
            Product is available and on sale
          {% endcomment %}
            <div class="pdpCopy__price f aic">
              <span class="inline-block strike card__price--regular ml1 pdpCopy__header-price pdpCopy__header-price-small rel">
                {{ current_variant.compare_at_price | money_without_trailing_zeros }}
                <div class="price-round-arrow">{% render 'icon' with 'round-arrow' %}</div>
              </span>
              <span class="visually-hidden">{{ 'products.current_variant.regular_price' | t }}</span>
              <h2 class="inline-block card__price--sale ml1 pdpCopy__header-price">
                {{ current_variant.price | money_without_trailing_zeros }}
              </h2>
            </div>
            {% else %}
              {% comment %}
                Product is available and not on sale
              {% endcomment %}
              <h2 data-selected-var-price class="ml1 pdpCopy__header-price">{{ current_variant.price | money | remove: '.00' }}</h2>
            {% endif %}
            {% else %}
              {% comment %}
                Sold Out
              {% endcomment %}
              <h2 class='strike'>{{ current_variant.price | money_without_trailing_zeros }}</h2>
            {% endif %}
        </div>
      </div>
      {% if tagline != blank %}<div class='pdp__tagline hide-mobile'>{{ tagline }}</div>{% endif %}
      <afterpay-placement 
         data-intro-text="Pay in"
         data-logo-type="badge"
         data-show-with="true"
         data-badge-theme="black-on-mint"
         data-size="sm"
         data-type="price-paragraph"
         data-is-eligible="true"
         data-locale="en_US"
         data-modal-link-style="circled-info-icon"
         data-show-upper-limit="false"
         data-amount="{{ current_variant.price | money | remove: '.00' }}"
         data-modal-theme="white" class="mb1 mt1 hidden-md-down">
     </afterpay-placement>
      <div class="pdp__reviews mb05 mt05">
        {%- assign reviews_count = product.metafields.yotpo.reviews_count | plus: 0 -%}
        {%- if reviews_count > 0 -%}
          {% include 'yotpo-star-rating-widget' %}
        {%- endif -%}
      </div>
      <div class="pdpCopy__price hide-desktop">
        {% if product.available %}
        {% if current_variant.compare_at_price > current_variant.price %}
        {% comment %}
          Product is available and on sale
        {% endcomment %}
          <div class="pdpCopy__price f aic">
            <span class="inline-block strike card__price--regular ml1 pdpCopy__header-price pdpCopy__header-price-small rel">
                {{ current_variant.compare_at_price | money_without_trailing_zeros }}
                <div class="price-round-arrow">{% render 'icon' with 'round-arrow' %}</div>
              </span>
            <span class="visually-hidden">{{ 'products.current_variant.regular_price' | t }}</span>
            <h2 class="inline-block card__price--sale ml1 pdpCopy__header-price">
              {{ current_variant.price | money_without_trailing_zeros }}
            </h2>
          </div>
          {% else %}
            {% comment %}
              Product is available and not on sale
            {% endcomment %}
            <h2 data-selected-var-price class="ml1 pdpCopy__header-price">{{ current_variant.price | money | remove: '.00' }}</h2>
          {% endif %}
          {% else %}
            {% comment %}
              Sold Out
            {% endcomment %}
            <h2 class='strike'>{{ current_variant.price | money_without_trailing_zeros }}</h2>
          {% endif %}
      </div>
      <afterpay-placement 
         data-intro-text="Or"
         data-logo-type="lockup"
         data-show-with="false"
         data-lockup-theme="black"
         data-size="sm"
         data-type="price-paragraph"
         data-is-eligible="true"
         data-locale="en_US"
         data-modal-link-style="none"
         data-show-upper-limit="false"
         data-amount="{{ current_variant.price | money | remove: '.00' }}"
         data-modal-theme="white" class="mb1 mt1 hidden-lg-up">
     </afterpay-placement>
    </div>
    {% include 'pdp-bundle-description' %}
    {% include 'pdp-details-form' %}
  {% endform %}

    {% include 'pdp-badges' %}
    {% include 'pdp-info' %}
    {% include 'pdp-product-upsell' %}
</section>
