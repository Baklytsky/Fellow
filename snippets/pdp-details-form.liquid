{% comment %}form start & end moved to pdp-details-main to adjust for shop pay {% endcomment %}
{% comment %} Always include product-options, product.js:20 reads from it for ATC {% endcomment %}
{% include 'product-options' %}

{% if section.settings.quantity_selector_inline != true %}
  <div class='pb15' {% if section.settings.show_quantity_selector !=true or product.tags contains 'gift' %}style='display:none'{% endif %}>
    {% include 'component-counter' %}
  </div>
{% endif %}

{% comment %}
Uncomment to include
<div class='f aic py1'>
  <span data-selected-var-price>{{ current_variant.price | money }}</span>
  <s data-compare-price style='display: none'>{{ current_variant.compare_at_price | money }}</s>
</div>
{% endcomment %}

{% if template contains 'gift_card' %}
  <div class='f fdc jcb' id='atc-wrapper'>
{% else %}
  <div class='f fdr jcb' id='atc-wrapper'>
{% endif %}
  {% unless template contains 'gift_card' %}
    {% if section.settings.show_quantity_selector and section.settings.quantity_selector_inline %}
      <div class="f is-inline">
        {% include 'component-counter' %}
      </div>
    {% endif %}
  {% endunless %}
  {%- capture cta -%}
    {% if product.available %}
      <span data-atc-copy class="js-atc-copy">
        {% if product.tags contains 'preorder' %}
          Preorder
        {% else %}
          Add to Cart
        {% endif %}
      </span>
      <span> | </span>
      <span data-selected-var-price>{{ current_variant.price | money }}</span>
      {%- assign disableVal = false -%}
    {% else %}
      {% if product.tags contains 'discontinued' %}
        Discontinued
      {% else %}
        Out of Stock
      {% endif %}
      {%- assign disableVal = true -%}
    {% endif %}
  {%- endcapture -%}
  {% comment %} Add catch for low stock variants {% endcomment %}
  {%
    include 'component-button' with
    tag: 'button',
    id: 'pdp-atc',
    name: 'add',
    type: 'submit',
    href: '#',
    className: 'js-add-to-cart cart__button',
    dataAttr: 'data-atc="true"',
    disabled: disableVal,
    cta: cta,
  %}
</div>
<div class='d-md-none' data-pay-btn>
  <div class='py1'>
    {{ form | payment_button }}
  </div>
</div>
<div class='is-hidden' data-bis>
  <button class='button cart__button klaviyo-bis-trigger'>Out of Stock | Notify Me</button>
</div>
