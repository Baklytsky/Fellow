{% comment %}form start & end moved to pdp-details-main to adjust for shop pay {% endcomment %}
{% comment %} Always include product-options, product.js:20 reads from it for ATC {% endcomment %}
{% include 'product-options' %}

<div class='pb15' {% if section.settings.show_quantity_selector != true or product.tags contains 'gift' %}style='display:none'{% endif %}>
  <div class="counter-wrapper rel">
    <label for="productQuantity" class='py025'>
      <span class='caps small mb05 block'><strong>Quantity</strong></span>
    </label>
    {%- include 'component-counter' id: 'productQuantity', class: 'counter', single: false, val: 1, min: 1, max: 50 -%}
  </div>
</div>

{% if template contains 'gift_card' %}
  <div class='f fdc jcb' id='atc-wrapper'>
{% else %}
  <div class='f fdr fw' id='atc-wrapper'>
{% endif %}
    {%- assign hasPreorderTag = false -%}
    {%- if product.tags contains 'preorder' -%}
      {%- assign hasPreorderTag = true -%}
    {%- endif -%}
  {%- capture cta -%}
    {% if product.available %}
      <span data-atc-copy class="js-atc-copy">
        {% if product.selected_variant.metafields.my_fields.preorder or hasPreorderTag %}
          Pre-Order
        {% else %}
          Add to Cart
        {% endif %}
      </span>
      {%- comment -%}
        <span> | </span>
        <span data-selected-var-price>{{ current_variant.price | money }}</span>
      {%- endcomment -%}

      {%- assign disableVal = false -%}
    {% else %}
      {% if product.tags contains 'discontinued' %}
        Discontinued
    {% else %}
    Out of Stock
      {% endif %}
      {%- assign disableVal = true -%}
    {% endif %}
  {%- endcapture -%}    

  {% comment %} Add catch for low stock variants {% endcomment %}
  <div class="pdpDetails__btns" data-disabled-size="{{ product_has_size_option }}">

    {%- if product_has_size_option -%}
      <button type="button" class="cart__button--select-size" disabled>Select size</button>
    {%- endif -%}

  {% unless product.tags contains 'closed' %}  
    {%
      include 'component-button' with
      tag: 'button',
      id: 'pdp-atc',
      name: 'add',
      type: 'submit',
      href: '#',
      className: 'js-add-to-cart cart__button',
      dataAttr: 'data-atc="true"',
      disabled: disableVal,
      cta: cta,
    %}
    {% endunless %}
    

    <div class='is-hidden' data-bis>
      <button class='button cart__button klaviyo-bis-trigger'>Out of Stock | Notify Me</button>
    </div>
   
    {% if product.metafields.custom_fields["enable_customize_button"] == 1 and product.metafields.custom_fields["customize_button_url"] != blank %}
      {%
        include 'component-button' with
        tag: 'a',
        href: product.metafields.custom_fields["customize_button_url"],
        className: 'customize-btn',
        cta: 'Customize your mug',
      %}
    {% endif %}
    
      {% if product.tags contains 'customizer' %}
      <div class="f is-inline pdpDetails__personalize">
        {% include 'component-customize' %}
      </div>
    {% endif %}
  </div>
    </div>
 {% if product.tags contains 'closed' %}
      <div class="klaviyo-form-VBeupD"></div>
      <div class="klaviyo-form-TQxAiu"></div>
{% endif %}