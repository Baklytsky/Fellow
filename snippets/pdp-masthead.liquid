{% if product.metafields.custom_fields["desktop_masthead_image"] != blank %}
  {%- assign desktop_masthead = product.metafields.custom_fields["desktop_masthead_image"] -%}
{% endif %}

{% if product.metafields.custom_fields["pdp_masthead_alt_text"] != blank %}
  {% assign masthead_alt = product.metafields.custom_fields["pdp_masthead_alt_text"] %}
{% else %}
  {% assign masthead_alt = product.title %}
{% endif %}


{% if desktop_masthead != blank %}
  {%
    include 'component-masthead' with
    img: desktop_masthead,
    altText: masthead_alt,
    mobileHidden: true,
    dataAttr: 'componentMasthead',
    className: 'pdpMasthead',
    overlap: true
  %}
{% comment %}
  We have to generate a blank masthead with componentMasthead dataAttr to make sure the js that handles isEmpty in componentMasthead.js runs. (In Slater, component JS only runs if the containing component is loaded)
  -ae 05.13.20
{% endcomment %}
{% else %}
  {%
    include 'component-masthead' with
    dataAttr: 'componentMasthead'
  %}
{% endif %}