{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-devshop.myshopify.com/pages/configure/253458/edit
{% endcomment %}
{% if page.metafields.custom_fields["social_photos"] != blank %}
  <div class="custom-field custom-field__social-photos custom-field__type--field-collection">
    <h3 class="custom-field--title">Customs - Social Photos</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign social_photos_image_array = page.metafields.custom_fields["social_photos_image"] | split: separator %}
      {% assign social_photos_caption_array = page.metafields.custom_fields["social_photos_caption"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["social_photos"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item-- fc-index--{{ index }}">
          <div class="fc-field field__social-photos-image">
            {{ social_photos_image_array[index] }}
          </div>
          <div class="fc-field field__social-photos-caption">
            {{ social_photos_caption_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}