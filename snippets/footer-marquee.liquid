{%- assign staggSrc = "kettleBud-min2.gif" | asset_img_url: '250x' -%}
{%- assign atmosSrc = "walkinAtmos-min2.gif" | asset_img_url: '250x' -%}
{%- assign clydeSrc = "walkinClyde-min2.gif" | asset_img_url: '250x' -%}

<section class='full rel x y my0'>
  <div class="marquee--left x y">
    <div class="inner f jcb aie" data-component='footerMarquee'>
      <div class="image x y f rel aie stagg walkinDude is-visible is-loaded">
        <img src="{{ staggSrc }}"
             class='block z1 rel  x scale-down'
             role='img'
             loading='lazy'
             alt="Kettle Bud"/>
      </div>
      <div class="image x y f rel aie stagg walkinDude is-visible is-loaded">
        <img src="{{ atmosSrc }}"
             class='block z1 rel  x scale-down'
             role='img'
             loading='lazy'
             alt="Walkin Atmos"/>
      </div>
      <div class="image x y f rel aie stagg walkinDude is-visible is-loaded">
        <img src="{{ clydeSrc }}"
             class='block z1 rel  x scale-down'
             role='img'
             loading='lazy'
             alt="Walkin Clyde"/>
      </div>
    </div>
  </div>
</section>