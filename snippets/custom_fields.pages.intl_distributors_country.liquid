{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-devshop.myshopify.com/pages/configure/247136/edit
{% endcomment %}
{% if page.metafields.custom_fields["intl_distributors_country"] != blank %}
  <div class="custom-field custom-field__intl-distributors-country custom-field__type--field-collection">
    <h3 class="custom-field--title">Sellers / Distributors - Country Groupings</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign country_name_array = page.metafields.custom_fields["country_name"] | split: separator %}
      {% assign region_array = page.metafields.custom_fields["region"] | split: separator %}
      {% assign content_array = page.metafields.custom_fields["content"] | split: separator %}
      {% assign two_column_array = page.metafields.custom_fields["two-column"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["intl_distributors_country"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--country grouping fc-index--{{ index }}">
          <div class="fc-field field__country-name">
            {{ country_name_array[index] }}
          </div>
          <div class="fc-field field__region">
            {{ region_array[index] }}
          </div>
          <div class="fc-field field__content">
            {{ content_array[index] }}
          </div>
          <div class="fc-field field__two-column">
            {{ two_column_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}