{%- comment -%}
{% render 'account-address',
  address: address,
  default: default_addy,
  className: '' %}
{%- endcomment -%}

{%- capture address_content -%}
  {% if default %}
    <p class="account-title">{{ 'customer.addresses.default' | t }}</p>
  {% endif %}
{%- render 'default-address', address: address -%}
{%- endcapture -%}

<div class="account-address-item">
  {{ address_content }}
  <div class="account-action-wrapper f aic">
    <button type="button" class="account-action-btn"
            data-toggle-address="{{ address.id }}" data-breadcrumbs-title="{{ 'customer.addresses.update' | t }}">
      {{ 'customer.addresses.edit' | t }}
    </button>
    <modal-opener data-modal="#PopupModal--{{ address.id }}">
      <button class="account-action-btn"
              type="button"
              aria-haspopup="dialog">
        {{ 'customer.addresses.delete' | t }}
      </button>
    </modal-opener>
  </div>

  <modal-dialog id="PopupModal--{{ address.id }}" class="account-delete-popup">
    <div class="account-delete-popup__content"
         role="dialog"
         aria-label="Delete address {{ address.city }} {{ address.province_code }} {{ address.zip }}"
         aria-modal="true"
         aria-hidden='true'
         tabindex="-1">
      <button id="ModalClose--{{ address.id }}"
              type="button"
              class="modal-close-btn"
              aria-label="{{ 'customer.addresses.close' | t }}">
        {% render 'icon-close' %}
      </button>
      <div class="account-delete-popup__content-wrapper">
        <h2 class="account-heading">Confirm Removal</h2>
        <div class="account-text">Are you sure you would like to remove this address?</div>
        {{ address_content }}

        <div class="account-delete-popup__btn-wrapper">
          <button type="button" id="ModalClose--{{ address.id }}-btn"
                  class="account-btn btn btn--lg btn--light">{{ 'customer.addresses.delete_reject_btn' | t }}</button>
          <button type="button" class="account-btn btn btn--lg btn--dark"
                  data-delete-address="{{ address.id }}">{{ 'customer.addresses.delete_confirm_btn' | t }}</button>
        </div>

      </div>
    </div>
  </modal-dialog>
</div>
