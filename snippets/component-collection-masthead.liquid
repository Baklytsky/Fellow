{% if altText != blank %}
  {% assign img_alt = altText | replace: "'", ' ' %}
{% else %}
  {% assign img_alt = section.settings.title | replace: "'", ' ' %}
{% endif %}

{%- assign desctop_image_class = 'image-abs-cover' -%}

{%- if imgMobile != blank -%}
  {%- assign desctop_image_class = 'image-abs-cover hide-mobile' -%}
{%- endif -%}

<div class="collectionHero">
  <div class="collectionHero__media rel">
    {% if img != blank %}
      {% render 'image-lazy-metafields',
        image: img,
        class_name: desctop_image_class,
        size: 'medium',
        alt: img_alt,
        loader: true %}
    {% endif %}
    {%- if imgMobile != blank -%}
      {% render 'image-lazy-metafields',
        image: imgMobile,
        class_name: 'image-abs-cover hide-desktop',
        size: 'medium',
        alt: img_alt,
        loader: true %}
    {%- endif -%}
  </div>
  <div class='collectionHero__content'>
      <h2 class='collectionHero__contentHeading'>{{ heading }}</h2>
      {% if copy != blank %}
        <div class="collectionHero__contentDescription">
          {{ copy }}
        </div>
      {% endif %}
  </div>
</div>

{% assign copy = blank %}
{% assign img = blank %}
{% assign imgMobile = blank %}
{% assign alt = blank %}
{% assign className = blank %}
{% assign mobileHidden = blank %}
{% assign dataAttr = blank %}
{% assign overlay = blank %}
{% assign overlap = blank %}
{% assign cx = '' %}
