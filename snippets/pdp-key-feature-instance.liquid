<div class="keyFeatures__instance fc-index--{{ index }}">
  <div class='keyFeatures__instance-wrapper aic {% if position == 'Text left' %} keyFeatures__instance-wrapper--reverse{% endif %}'>
    <div class='keyFeatures__media'>
      <div class="{% if key_feature_quadrature == 1 %}keyFeature__image-quadrature{% endif %} f jcc">
        <div class="keyFeature__image-wrapper rel">
        {% if mediaType == 'Video' %}
          <video class="x y fill" autoplay muted loop playsinline controls>
            {% if webmSrc != blank %}
              <source src="{{ webmSrc }}" type="video/webm">
            {% endif %}
            {% if mp4Src != blank %}
              <source src="{{ mp4Src }}" type="video/mp4">
            {% endif %}
          </video>
        {% else %}
          {% if imageSrc != blank %}
            <section class='keyFeature__image{% if secondaryImageSrc != blank %} keyFeature__image--primary{% endif %} rel x y fill'>
              {%
                include 'component-image' with
                src: imageSrc,
                alt: alt,
                className: classList,
                fill: true
              %}
            </section>
          {% endif %}
          {% if secondaryImageSrc != blank %}
            <section class='keyFeature__image keyFeature__image--secondary abs x y fill'>
              {%
                include 'component-image' with
                src: secondaryImageSrc,
                alt: alt,
                className: classList,
                fill: true
              %}
            </section>
          {% endif %}
        {% endif %}
        </div>
      </div>
    </div>
    <div class='keyFeatures__text'>
      <section class='keyFeature__details'>
        {% if iconSrc != blank %}
        <div class='keyFeatureDetails__icon'>
          {%
            include 'component-image' with
            src: iconSrc,
            alt: key_feature_title_array[index],
            className: 'image',
            fill: true,
            centered: false,
          %}
        </div>
        {% endif %}
        <div class='keyFeatureDetails__copy'>
          <h3 class='keyFeatureDetails__copy-heading'>{{ key_feature_title_array[index] }}</h3>
          <p class="keyFeatureDetails__copy-text">{{ key_feature_copy_array[index] }}</p>
          {%- if key_features_table_left_column_array[index] != blank or key_features_table_right_col_array[index] != blank -%}
            <div class='keyFeatureDetails__Table x'>
              {%- if key_features_table_left_column_array[index] != blank  -%}
                <div class='keyFeatureDetails__Table-left'>{{ key_features_table_left_column_array[index] }}</div>
              {%- endif -%}
              {%- if key_features_table_right_col_array[index] != blank  -%}
                <div class='keyFeatureDetails__Table-right'>{{ key_features_table_right_col_array[index] }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </section>
    </div>
  </div>
</div>