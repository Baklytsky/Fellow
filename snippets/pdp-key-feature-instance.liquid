<link rel="stylesheet" href="{{ 'section-pdp-key-feature-instance.min.css' | asset_url }}">

<div class="keyFeatures__instance fc-index--{{ index }}">
  <div class='keyFeatures__instance-wrapper aic {% if position == 'Text left' %} keyFeatures__instance-wrapper--reverse{% endif %}'>
    <div class='keyFeatures__media'>
      <div class="{% if key_feature_quadrature == 1 %}keyFeature__image-quadrature{% endif %} f jcc">
        <div class="keyFeature__image-wrapper rel x">
        {% if mediaType == 'Video' %}
          <video class="x y fill" autoplay muted loop playsinline controls>
            {% if webmSrc != blank %}
              <source src="{{ webmSrc }}" type="video/webm">
            {% endif %}
            {% if mp4Src != blank %}
              <source src="{{ mp4Src }}" type="video/mp4">
            {% endif %}
          </video>
        {% else %}
          {% if imageSrc != blank %}
            <section class='keyFeature__image{% if secondaryImageSrc != blank %} keyFeature__image--primary{% endif %} rel x y fill'>
              {% render 'image-lazy-metafields',
                image: imageSrc,
                class_name: 'image-abs-cover',
                alt: alt,
                size: 'medium',
                loader: true %}
            </section>
          {% endif %}
          {% if secondaryImageSrc != blank %}
            <section class='keyFeature__image keyFeature__image--secondary abs x y fill'>
              {% render 'image-lazy-metafields',
                image: secondaryImageSrc,
                class_name: 'image-abs-cover',
                alt: alt,
                size: 'medium',
                loader: false %}
            </section>
          {% endif %}
        {% endif %}
        </div>
      </div>
    </div>
    <div class='keyFeatures__text'>
      <section class='keyFeature__details'>
        {% if iconSrc != blank %}
        <div class='keyFeatureDetails__icon'>
          <div class="image">
            {% render 'image-lazy-metafields',
              image: iconSrc,
              alt: key_feature_title,
              size: 'small',
              loader: false %}
          </div>
        </div>
        {% endif %}
        <div class='keyFeatureDetails__copy'>
          <h3 class='keyFeatureDetails__copy-heading'>{{ key_feature_title }}</h3>
          <p class="keyFeatureDetails__copy-text">{{ key_feature_copy }}</p>
          {%- if key_features_table_left_column != blank or key_features_table_right_column != blank -%}
            <div class='keyFeatureDetails__Table x'>
              {%- if key_features_table_left_column != blank  -%}
                <div class='keyFeatureDetails__Table-left'>{{ key_features_table_left_column }}</div>
              {%- endif -%}
              {%- if key_features_table_right_column != blank  -%}
                <div class='keyFeatureDetails__Table-right'>{{ key_features_table_right_column }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </section>
    </div>
  </div>
</div>