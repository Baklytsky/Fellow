{% assign social_photos = page.metafields.custom_fields["social_photos_items" %}
{% if social_photos != blank %}
  <div class="social-photos container--l">
    {% if page.metafields.custom_fields["social_photos_heading"] != blank %}
      <h2 class="ac">{{ page.metafields.custom_fields["social_photos_heading"] }}</h2>
    {% endif %}

    <div class="social-photos__inner">
      {% for photo in social_photos %}
        <div class="social-photos__item rel">
            {{ photo['link'] }}
            <img class="social-photos__item-image x block" src="{{ photo['image'] }}" alt="{{ photo['caption'] | escape }}" role="img">
            <p class="xsmall social-photos__item-body mb0 mt025">
              {{ photo["caption"] }}
            </p>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}