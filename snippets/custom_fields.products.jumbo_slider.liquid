{% if product.metafields.custom_fields["jumbo_slider"] != blank %}
  <div class="custom-field custom-field__jumbo-slider custom-field__type--field-collection">
    <h3 class="custom-field--title">Jumbo Slider</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign jumbo_slide_array = product.metafields.custom_fields["jumbo_slide"] | split: separator %}
      {% assign jumbo_slide_alt_array = product.metafields.custom_fields["jumbo_slide_alt"] | split: separator %}
      {% assign fc_keys = product.metafields.custom_fields["jumbo_slider"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--slide fc-index--{{ index }}">
          <div class="fc-field field__jumbo-slide">
            {{ jumbo_slide_array[index] }}
          </div>
          <div class="fc-field field__jumbo-slide-alt">
            {{ jumbo_slide_alt_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}