{% assign separator = "|###|" %}
{% assign compare_product_array = product.metafields.custom_fields["compare_product"] | split: separator %}

{% if compare_product_array.size > 1 %}

  {%- assign compare_products_heading = product.metafields.custom_fields["compare_products_heading"] %}
  {%- assign display_order = product.metafields.custom_fields["compare_products_order"] %}


  {% assign compare_product_image_array = product.metafields.custom_fields["compare_product_image"] | split: separator %}
  {% assign compare_product_text_array = product.metafields.custom_fields["compare_product_text"] | split: separator %}
  {% assign compare_product_cta_text_array = product.metafields.custom_fields["compare_product_cta_text"] | split: separator %}
  {% assign fc_keys = product.metafields.custom_fields["compare_products_item"] | split: "," %}

  <div data-component="compareProducts" class='{% if display_order != blank %} o-{{ display_order }}{% endif %}'>

    <section class="module compareProducts">
      <div class="compareProducts__inner row">
        <div class='compareProducts__title col-lg-2'>
          <h2 class='t-vertical caps'>{{ compare_products_heading | default: 'Compare Products' | escape }}</h2>
        </div>

        <div class="compareProducts__row-wrapper col-lg-10">
          <div class='f jcs fdr compareProducts__row'>

            {% for i in fc_keys %}
              {% assign index = i | plus: 0 %}
              {% assign compare_product_handle = compare_product_array[index] %}
              {% assign compare_product = all_products[compare_product_handle] %}

              {% assign compare_image_url = compare_product_image_array[index] %}

              {% assign compare_cta_text = compare_product_cta_text_array[index] %}

              {% assign compare_product_text_html = compare_product_text_array[index] %}

              {% assign this_product = false %}
              {% if product.handle == compare_product.handle %}
                {% assign this_product = true %}
              {% endif %}

              {% assign default_cta_text = "Learn More" %}

              {% if this_product == true %}
                {% assign default_cta_text = "Add To Cart" %}
              {% endif %}

              {% capture compare_text %}
                <div class="compareProducts__item-text f1">
                  {{ compare_product_text_html }}
                </div>
                <a data-compare-this-product-cta class="x compareProducts__item-button button rel btn btn--lg btn--dark" href="{{ compare_product.url }}" title="{{ compare_product.title }} {{ index }} | {{ compare_cta_text | default: default_cta_text }}">

                  {{ compare_cta_text | default: default_cta_text }}
                </a>
              {% endcapture %}
              <div class="compareProducts__item {% if compare_product_array.size == 3 %}one-third{% endif %}">
                {%
                  include 'product-card' with
                  product: compare_product,
                  hide_variants: true,
                  cx: 'y',
                  content_cx: 'f fdc',
                  bottom_content: compare_text,
                  product_image_url: compare_image_url,
                  large_title: true,
                  transparent_image: true
                %}
              </div>

            {% endfor %}

          </div>
        </div>
      </div>
    </section>
  </div>
{% endif %}
