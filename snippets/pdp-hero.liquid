{% if product.metafields.custom_fields["show_hero_module_section"] == 1 %}
  {% if product.metafields.custom_fields["hero_module"] != blank %}
    {% assign hero_title = product.metafields.custom_fields["hero_copy_title"] %}
    {% assign hero_copy = product.metafields.custom_fields["hero_copy"] %}

    {% assign hero_media_type = product.metafields.custom_fields["hero_media_type"] %}
    {% assign hero_media_webm = product.metafields.custom_fields["hero_media_webm"] %}
    {% assign hero_media_mp4 = product.metafields.custom_fields["hero_media_mp4"] %}

    {% assign image = product.metafields.custom_fields["hero_image"] %}
    {% assign alt_text = product.metafields.custom_fields["hero_image_alt"] %}
    {% if alt_text != blank %}
      {% assign alt = alt_text %}
      {% elsif hero_title != blank %}
      {% assign alt = hero_title %}
    {% endif %}

    {% assign flex_order = product.metafields.custom_fields["hero_order"] | downcase %}
    {% if flex_order %}
      {% unless flex_order == 'default' %}
      {% assign display_order = flex_order %}
      {% endunless %}
    {% endif %}

    {% if product.metafields.custom_fields["hero_module_bg_color"] != blank %}
      {%- assign section_bg_color = product.metafields.custom_fields["hero_module_bg_color"] -%}
    {% endif %}

    {% if product.metafields.custom_fields["hero_module_text_color"] != blank %}
      {%- assign section_text_color = product.metafields.custom_fields["hero_module_text_color"] -%}
    {% endif %}

    {% if product.metafields.custom_fields["enable_round_image"] == 1 %}
      {%- assign enable_round_image = true -%}
    {% endif %}

    <section class='heroSection{% if display_order %} o-{{ display_order }}{% endif %}'
             data-component='pdp-hero'
             style="background-color: {{ section_bg_color }}; color: {{ section_text_color }}">
      <div class='heroSection__wrapper'>
        <div class='heroSection__text-block x'>
          <div class='heroSection__copy rte'>
            {{ hero_copy }}
          </div>
        </div>
        <div class='heroSection__image-block x {% if enable_round_image and hero_media_type != 'Video' %} heroSection__image-block-round{% endif %}'>
          {% if hero_media_type == 'Video' %}
            <video class='heroSection__image x y fill' autoplay muted loop playsinline controls>
              {% if hero_media_webm != blank %}
                <source src="{{ hero_media_webm }}" type="video/webm">
              {% endif %}
              {% if hero_media_mp4 != blank %}
                <source src="{{ hero_media_mp4 }}" type="video/mp4">
              {% endif %}
            </video>
          {% else %}
            {% unless image == blank %}
              {%
                include 'component-image' with
                src: image,
                alt: alt,
                className: 'heroSection__image image',
                fill: true
              %}
            {% endunless %}
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}
{% endif %}

{% comment %} Reset {% endcomment %}
{% assign hero_media_type = blank %}
{% assign hero_media_webm = blank %}
{% assign hero_media_mp4 = blank %}
{% assign display_order = blank %}