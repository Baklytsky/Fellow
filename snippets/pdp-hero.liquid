{% if product.metafields.custom_fields["show_hero_module_section_new"] == 1 %}
  {% if product.metafields.custom_fields["hero_module_new"] != blank %}

    {% assign flex_order = product.metafields.custom_fields["hero_module_order_new"] | downcase %}
    {% if flex_order %}
      {% unless flex_order == 'default' %}
      {% assign display_order = flex_order %}
      {% endunless %}
    {% endif %}

    {% if product.metafields.custom_fields["hero_module_bg_color_new"] != blank %}
      {%- assign section_bg_color = product.metafields.custom_fields["hero_module_bg_color_new"] -%}
    {% endif %}

    {% if product.metafields.custom_fields["hero_module_text_color_new"] != blank %}
      {%- assign section_text_color = product.metafields.custom_fields["hero_module_text_color_new"] -%}
    {% endif %}

    {% if product.metafields.custom_fields["enable_round_image_new"] == 1 %}
      {%- assign enable_round_image = true -%}
    {% endif %}

    {%- for item in product.metafields.custom_fields["hero_module_new"] -%}
      {% assign hero_copy = item["hero_copy_new"] %}
      {% assign image = item["hero_img_new"] %}
      {% assign hero_media_type = item["hero_media_type_new"] %}
      {% assign hero_media_webm = item["hero_media_webm"] %}
      {% assign hero_media_mp4 = item["hero_media_mp4"] %}

      <section class='heroSection{% if display_order %} o-{{ display_order }}{% endif %}'
               data-component='pdp-hero'
               style="background-color: {{ section_bg_color }}; color: {{ section_text_color }}">
        <div class='heroSection__wrapper'>
          <div class='heroSection__text-block x'>
            <div class='heroSection__copy rte'>
              {{ hero_copy }}
            </div>
          </div>
          <div class='heroSection__image-block x {% if enable_round_image and hero_media_type != 'Video' %} heroSection__image-block-round{% endif %}'>
            {% if hero_media_type == 'Video' %}
              <video class='heroSection__image x y fill' autoplay muted loop playsinline controls>
                {% if hero_media_webm != blank %}
                  <source src="{{ hero_media_webm }}" type="video/webm">
                {% endif %}
                {% if hero_media_mp4 != blank %}
                  <source src="{{ hero_media_mp4 }}" type="video/mp4">
                {% endif %}
              </video>
            {% else %}
              {% if image != blank %}
                {%
                  include 'component-image' with
                  src: image,
                  alt: alt,
                  className: 'heroSection__image image',
                  fill: true
                %}
              {% endif %}
            {% endif %}
          </div>
        </div>
      </section>
    {%- endfor -%}
  {% endif %}
{% endif %}

{% comment %} Reset {% endcomment %}
{% assign hero_media_type = blank %}
{% assign hero_media_webm = blank %}
{% assign hero_media_mp4 = blank %}
{% assign display_order = blank %}