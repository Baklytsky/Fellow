{% if page.metafields.custom_fields["partnerships"] != blank %}
  {% assign separator = "|###|" %}
  {% assign partnership_page_array = page.metafields.custom_fields["partnership_page"] | split: separator %}
  {% assign partnership_title_array = page.metafields.custom_fields["partnership_title"] | split: separator %}
  {% assign partnership_short_description_array = page.metafields.custom_fields["partnership_short_description"] | split: separator %}
  {% assign partnership_image_array = page.metafields.custom_fields["partnership_image"] | split: separator %}
  {% assign fc_keys = page.metafields.custom_fields["partnerships"] | split: "," %}
  <section class="module">
    <div class='row'>
      <div class='col-lg-11 offset-lg-1'>
        {% for i in fc_keys %}
          {% assign index = i | plus: 0 %}
          {% assign pageRef = pages[partnership_page_array[index]] %}
          {% assign partnershipTitle = partnership_title_array[index] %}
          {% assign partnershipShortDesc = partnership_short_description_array[index] %}
          {% assign partnershipImage = partnership_image_array[index] %}
          <div class='partners__listing my3rem'>
            <div class='row'>
              {% if partnershipImage != blank %}
                <div class='col-lg-6 pr25'>
                  {%
                    include 'component-image' with
                    src: partnershipImage,
                    alt: alt,
                    className: 'image',
                    scaleDown: true,
                  %}
                </div>
              {% endif %}

              {% if partnershipShortDesc != blank %}
                <div class='col-lg-6 pl2.5'>
                  {% if partnershipTitle != blank %}
                    <h2>{{ partnershipTitle }}</h2>
                  {% else if pageRef != blank %}
                    <h2 class='caps'>{{ pageRef.title }}</h2>
                  {% endif %}
                  {{ partnershipShortDesc }}
                  <a class='btn my1 btn--sm btn--dark' href='{{ pageRef.url }}' aria-label="Learn more about {{ pageRef.title }}">Learn More
                  </a>
                </div>
              {% endif %}
            </div>
          </div>
          {% comment %} Reset {% endcomment %}
          {% assign partnershipTitle = blank %}
          {% assign partnershipShortDesc = blank %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}