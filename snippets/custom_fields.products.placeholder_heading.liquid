{% if product.metafields.custom_fields["placeholder_heading"] != blank %}
  <div class="custom-field custom-field__placeholder-heading custom-field__type--text">
    <h3 class="custom-field--title">Placeholder Heading</h3>
    <div class="custom-field--value">
      {{ product.metafields.custom_fields["placeholder_heading"] }}
    </div>
  </div>
{% endif %}