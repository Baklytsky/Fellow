{% assign badge_text = product.metafields.custom_fields.card_badge %}
{%- capture 'slick-pdp-mobile-config' -%}
{
  "rows": 2,
  "slidesPerRow": 2,
  "arrows": false,
  "dots": true,
  "autoplay": false,
  "infinite": false,
  "adaptiveHeight": true
}
{%- endcapture -%}

<div class='pdpMain__gallery pdpMain__bundle-gallery x rel f'
     data-section-type="slick-slideshow"
     data-slick-config='{{- slick-pdp-mobile-config -}}'>
  <div class='pdpMain__bundle-gallery-wrapper x y block rel jsSlickSlider'>
    {%- if product.metafields.custom_fields["bundle_product"] != blank -%}

      {% for item in product.metafields.custom_fields["bundle_product"] %}
        {% if item["product"] != blank %}
          {%- assign bundle_product = all_products[item["product"]] -%}
        {% endif %}
        {% if item["product_variants_id"] != blank %}
          {%- assign bundle_product_variants_id = item["product_variants_id"] | split: ',' -%}
        {% endif %}

        {%- assign uniq_id = bundle_product.id | append: '-' | append: forloop.index -%}

        {%- if bundle_product != blank -%}
          {%- if bundle_product_variants_id == blank -%}
            {%- if bundle_product.variants.size > 1 -%}
              <div class="pdpMain__bundle-image-wrapper rel x f aic">
                {% for variant in bundle_product.variants %}
                  {%- assign imageSrc = variant.image.src | img_url: '900x' -%}
                    <div class='pdpMain__bundle-image abs x y f aic'
                         data-variant-media='{{ variant.id | append: '-' | append: uniq_id }}' {%- if forloop.first %} style="visibility: visible" {% endif %}>
                      {%- if variant.image.alt contains 'tag:' and forloop.first == false -%}
                        {%- assign image_custom_tag = variant.image.alt | split: 'tag:' | last -%}
                        <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ image_custom_tag }}</span>
                      {%- endif -%}
                      <img src="{{ imageSrc }}"
                           class='x'
                           alt='{{ variant.image.alt }}'
                           role='img'
                           loading='lazy'/>
                    </div>
                {% endfor %}
              </div>
            {%- else -%}
              <div class="pdpMain__bundle-image-wrapper rel x f aic">
                <div class='pdpMain__bundle-image abs x y f aic'
                     data-variant-media='{{ bundle_product.selected_or_first_available_variant.id | append: '-' | append: uniq_id }}' style="visibility: visible">
                    {%- if bundle_product.featured_image.alt contains 'tag:' -%}
                      {%- assign image_custom_tag = bundle_product.featured_image.alt | split: 'tag:' | last -%}
                      <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ image_custom_tag }}</span>
                    {%- endif -%}
                  <img src="{{ bundle_product.featured_image | img_url: '900x' }}" class='x' alt='{{ bundle_product.featured_image.alt }}' role='img' loading='lazy'/>
                </div>
              </div>
            {%- endif -%}

          {%- else -%}
          <div class="pdpMain__bundle-image-wrapper rel x f aic">
            {%- assign variant_counter = 0 -%}
            {% for variant in bundle_product.variants %}
              {%- assign show_variant = false -%}

              {%- for bundle_variant_id in bundle_product_variants_id -%}
                {%- assign bundle_variant_id_num = bundle_variant_id | plus: 0 -%}

                {%- if bundle_variant_id_num == variant.id -%}
                  {%- assign variantId = variant.id -%}
                  {%- assign show_variant = true -%}
                  {%- assign variant_counter = variant_counter | plus: 1 -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- if show_variant -%}
              {%- assign imageSrc = variant.image.src | img_url: '900x' -%}
                  <div class='pdpMain__bundle-image abs x y f aic'
                       data-variant-media='{{ variantId | append: '-' | append: uniq_id }}' {% if variant_counter == 1 %} style="visibility: visible" {% endif %}>
                    {%- if image.alt contains 'tag:' and forloop.first == false -%}
                      {%- assign image_custom_tag = image.alt | split: 'tag:' | last -%}
                      <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ image_custom_tag }}</span>
                    {%- endif -%}
                    <img src="{{ imageSrc }}"
                         class='x' alt='{{ image.alt }}'
                         role='img'
                         loading='lazy'/>
                  </div>
              {%- endif -%}
            {% endfor %}
          </div>
          {%- endif -%}
        {%- endif -%}
        {%- assign bundle_product = blank -%}
        {%- assign bundle_product_variants_id = blank -%}
      {% endfor %}

      {%- if product.featured_image != blank -%}
        <div class="pdpMain__bundle-image-wrapper rel x f aic">
          <div class='pdpMain__bundle-image abs x y f aic'
               data-variant-media='{{ product.selected_or_first_available_variant }}' style="visibility: visible">
            {%- if badge_text != blank -%}
              <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ badge_text }}</span>
            {%- endif -%}
            <img src="{{ product.featured_image | img_url: '900x' }}" class='x' alt='{{ product.title }}' role='img' loading='lazy'/>
          </div>
        </div>
      {%- endif -%}

    {%- else -%}
      {% for image in product.images %}
      {% if image.variants.size > 0 %}
        {% for variant in image.variants %}
          {%- assign variantId = variant.id -%}
        {% endfor %}
      {% else %}
        {%- assign variantId = product.id | append: forloop.index -%}
      {% endif %}
      {%- assign imageSrc = image.src | img_url: '900x' -%}
      <div class="pdpMain__bundle-image-wrapper rel x f aic">
        <div class='pdpMain__bundle-image abs x y f aic'
             data-variant-media='{{ variantId }}' style="visibility: visible">
          {%- if forloop.first and badge_text != blank -%}
            <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ badge_text }}</span>
          {%- endif -%}
          {%- if image.alt contains 'tag:' and forloop.first == false -%}
            {%- assign image_custom_tag = image.alt | split: 'tag:' | last -%}
            <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ image_custom_tag }}</span>
          {%- endif -%}
          <img src="{{ imageSrc }}" class='x' alt='{{ image.alt }}' role='img' loading='lazy'/>
        </div>
      </div>
      {% endfor %}
    {%- endif -%}
  </div>
</div>