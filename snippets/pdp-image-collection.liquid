{% if product.metafields.custom_fields["show_image_collection_new"] == 1 %}
  {% comment %}Assign Media Proof Flex Order{% endcomment %}
  {% assign flex_order = product.metafields.custom_fields["image_collection_order_new"] | downcase %}
  {% if flex_order %}
    {% unless flex_order == 'default' %}
    {% assign display_order = flex_order %}
    {% endunless %}
  {% endif %}

  {%- assign section_bg = product.metafields.custom_fields["image_collection_bg_color_new"] -%}
  {%- assign section_text_color = product.metafields.custom_fields["imagecollection_text_color_new"] -%}
  {%- assign subheading = product.metafields.custom_fields["imagecollection_subheading_new"] -%}
  {%- assign heading = product.metafields.custom_fields["imagecollection_heading_new"] -%}
  {%- assign description = product.metafields.custom_fields["imagecollection_description_n"] -%}
  {%- assign logo = product.metafields.custom_fields["image_collection_logo_new"] -%}
  {% if product.metafields.custom_fields["image_col_show_button_new"] == 1 %}
    {%- assign show_button = true -%}
  {% else %}
    {%- assign show_button = false -%}
  {% endif %}
  {%- assign button_color = product.metafields.custom_fields["image_col_button_color_new_"] -%}
  {%- assign button_text = product.metafields.custom_fields["image_col_button_text_new"] -%}
  {%- assign button_link = product.metafields.custom_fields["image_col_button_link_new"] -%}

  {%- case button_color -%}
  {%- when 'white' -%}
  {%- assign button_color_class = 'btn--light' -%}
  {%- when 'black' -%}
  {%- assign button_color_class = 'btn--dark' -%}
    {%- else -%}
  {%- assign button_color_class = 'btn--light' -%}
  {%- endcase -%}


  {%- capture 'slick-config' -%}
  {
    "slidesToShow": 1,
    "autoplay": false,
    "arrows": true,
    "dots": false,
    "responsive": [
      {
        "breakpoint": 992,
        "settings": {
          "autoplay": true
        }
      }
    ]
  }
  {%- endcapture -%}

  <section class='pdpImgCollection {% if display_order %} o-{{ display_order }}{% endif %}'
           data-section-type='slick-slideshow'
           data-slick-config='{{- slick-config -}}'
           style="color: {{ section_text_color }}; background-color: {{ section_bg }};">
    <div class="pdpImgCollection__wrapper x">
      {%- if subheading != blank or heading != blank or description != blank or logo != blank -%}
        <div class="pdpImgCollection__content">
          {%- if subheading != blank -%}
            <h4 class="pdpImgCollection__content-subheading">{{ subheading }}</h4>
          {%- endif -%}
          {%- if heading != blank -%}
            <h3 class="pdpImgCollection__content-heading">{{ heading }}</h3>
          {%- endif -%}
          {%- if description != blank -%}
            <p class="pdpImgCollection__content-description">{{ description }}</p>
          {%- endif -%}
          {%- if logo != blank -%}
            <div class="pdpImgCollection__content-logo x">{{ logo }}</div>
          {%- endif -%}
          {%- if show_button and button_text != blank and button_link != blank -%}
            <div class="pdpImgCollection__content-btn-wrapper">
              <a href="{{ button_link }}" class="button rel btn pdpImgCollection__content-btn {{ button_color_class }}">
                {{ button_text }}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if product.metafields.custom_fields["image_collection_slides_new"] != blank -%}
        <div class="pdpImgCollection__slider-wrapper rel">
          <div class="pdpImgCollection__slider jsSlickSlider">
            {% for item in product.metafields.custom_fields["image_collection_slides_new"] %}
              {%- assign slide = item["image_slide_new"] -%}
              {%- if slide != blank -%}
                <div class="pdpImgCollection__slide">
                  <div class="pdpImgCollection__slide-image rel">
                    {%
                      include 'component-image' with
                      src: slide,
                      alt: heading,
                      className: 'image',
                      absolute: true,
                      fill: true
                    %}
                    {%- comment -%}
                      {{ slide }}
                    {%- endcomment -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <button type="button"
                  class="jsPrevSlide"
                  aria-label="Previous slide" {% if product.metafields.custom_fields["image_collection_slides_new"].size == 1 %} style="display: none" {% endif %}>
            {% render 'icon' with 'arrow-prev' %}
          </button>
          <button type="button"
                  class="jsNextSlide"
                  aria-label="Next slide" {% if product.metafields.custom_fields["image_collection_slides_new"].size == 1 %} style="display: none" {% endif %}>
            {% render 'icon' with 'arrow-next' %}
          </button>

        </div>
      {%- endif -%}
    </div>
  </section>
{% endif %}