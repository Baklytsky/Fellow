{%- assign option_lable = label | handleize -%}
{%- assign option_name = name | handleize -%}

{% if product.metafields.custom_fields["product_size_images_new"] != blank and option_name == 'size' %}
  {% for item in product.metafields.custom_fields["product_size_images_new"] %}
    {% if item["size_name_new"] != blank and item["size_svg_icon_new"] != blank %}
      {%- assign item_size_handleize = item["size_name_new"] | handleize -%}
      {%- if item_size_handleize == option_lable -%}
        {%- assign has_size_image = true -%}
        {%- assign size_image = item["size_svg_icon_new"] -%}
        {% break %}
      {%- endif -%}
    {% endif %}
  {% endfor %}
{% endif %}

{%- if option_name == 'color'-%}
  {%- assign color_name = label | handleize -%}
  {%- assign color_swatch_name = product.handle | append: '_' | append: color_name | append: '.png' -%}
  {%- assign color_swatch_image = images[color_swatch_name] -%}
{%- endif -%}

<label class='radio {% if has_size_image %}radio__label-size-image{% endif %}' for='{{ label | handleize }}'>
  <span class='u-sr-only'>{{ value | escape }}</span>
  <input
    id='{{ label | handleize }}'
    type=radio
    name='{{ name | escape}}'
    value='{{ value | escape }}'
    title='{{ label | escape }}'
    data-value-handle='{{ value | handleize }}'
    data-total-available
    {{ attributes }}
    {% if checked == true %}checked{% endif %}
  />
  <div class="radio__title f aic jcc {% if has_size_image %}radio__title-size-image{% endif %} {% if color_swatch_image != blank %}radio__title-bg-image{% endif %}"
       data-{{ name }}='{{ label | handleize }}'
       {% if color_swatch_image != blank %}style="background: url({{ color_swatch_image | img_url: '64x64' }}) no-repeat center center / cover; color: transparent;"{% endif %}>
    {%- if has_size_image -%}
      <div class="size__wrapper">
        <div class="size__image-wrapper rel">
          <div class="size__image-wrapper-icon x">
            {{ size_image }}
          </div>
        </div>
        <span class="size__image-wrapper-span" data-{{ name }}='{{ label }}' style="white-space: break-spaces">{{ label }}</span>
      </div>
    {%- endif -%}

    {%- unless has_size_image -%}
      <span class="size__image-wrapper-span" data-{{ name }}='{{ label }}' style="white-space: break-spaces">{{ label }}</span>
    {%- endunless -%}
  </div>
</label>

{% assign label = blank %}
{% assign name = blank %}
{% assign value = blank %}
{% assign attributes = blank %}
{% assign checked = blank %}
{% assign has_size_image = false %}
{%- assign size_image = blank -%}
{%- assign size_image_active = blank -%}

