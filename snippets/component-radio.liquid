<label class='radio' for='{{ label | handleize }}'>
  <span class='u-sr-only'>{{ value | escape }}</span>
  <input
    id='{{ label | handleize }}'
    type=radio
    name='{{ name | escape}}'
    value='{{ value | escape }}'
    title='{{ label | escape }}'
    data-value-handle='{{ value | handleize }}'
    data-total-available
    {{ attributes }}
    {% if checked == true %}checked{% endif %}
  />
  <div class="radio__title f aic jcc" data-{{ name }}='{{ label | handleize }}'><span>{{label}}</span></div>
</label>

{% assign label = blank %}
{% assign name = blank %}
{% assign value = blank %}
{% assign attributes = blank %}
{% assign checked = blank %}
