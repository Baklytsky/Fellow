{% if product.metafields.custom_fields["show_learn_more_section"] == 1 %}
  <link rel="stylesheet" href="{{ 'section-pdp-learn-more.min.css' | asset_url }}">
  <script src="{{ 'component-pdp-learn-more.min.js' | asset_url }}" defer="defer"></script>

  {% comment %}Assign Media Proof Flex Order{% endcomment %}
  {% assign flex_order = product.metafields.custom_fields["learn_more_order"] | downcase %}
  {% if flex_order %}
    {% unless flex_order == 'default' %}
    {% assign display_order = flex_order %}
    {% endunless %}
  {% endif %}

  {% if product.metafields.custom_fields["learn_more"] != blank %}
    <pdp-learn-more class='pdpLearnMore {% if display_order %} o-{{ display_order }}{% endif %}'>
      <h3 class="pdpLearnMore__heading">Learn More</h3>
      <div class="pdpLearnMore__wrapper">
        {% for item in product.metafields.custom_fields["learn_more"] %}
          <div class="pdpLearnMore__dropdown-wrapper">
            <div class="pdpLearnMore__dropdown">
              {% if item["learn_more_block_title"] != blank %}
                <slide-toggle class="pdpLearnMore__dropdown-header f jcb aic"
                              data-slide-target="{{ item["learn_more_block_title"] | handleize }}-{{ forloop.index0 }}">
                  <div class="pdpLearnMore__dropdown-title">
                    {{ item["learn_more_block_title"] }}
                  </div>
                  <div class="dropdownHeader-icon">
                    {% render 'icon' with 'dropdown' %}
                  </div>
                </slide-toggle>
              {% endif %}
              {% if item["learn_more_links"] != blank %}
                <div class="pdpLearnMore__dropdown-content"
                     data-slide-content="{{ item["learn_more_block_title"] | handleize }}-{{ forloop.index0 }}">
                  <div class="pdpLearnMore__dropdown-content-wrapper">
                    {% for learn_more_links_item in item["learn_more_links"] %}
                      {%- if forloop.index <= 4 -%}
                        <div class="pdpLearnMore__dropdown-link-item">
                          {% if learn_more_links_item["link_title"] != blank and learn_more_links_item["link_url"] != blank %}
                            <a href="{{ learn_more_links_item["link_url"] }}">{{ learn_more_links_item["link_title"] }}</a>
                          {% endif %}
                        </div>
                      {%- else -%}
                        <div class="pdpLearnMore__dropdown-link-item" style="display: none">
                          {% if learn_more_links_item["link_title"] != blank and learn_more_links_item["link_url"] != blank %}
                            <a href="{{ learn_more_links_item["link_url"] }}">{{ learn_more_links_item["link_title"] }}</a>
                          {% endif %}
                        </div>
                      {%- endif -%}
                    {% endfor %}
                    {% for learn_more_links_item in item["learn_more_links"] %}
                      {%- if forloop.index > 4 -%}
                        <button type="button" class="pdpLearnMore__dropdown-view-all">View all {{ forloop.length }} articles</button>
                        {%- break -%}
                      {%- endif -%}
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </pdp-learn-more>
  {% endif %}

{% endif %}

