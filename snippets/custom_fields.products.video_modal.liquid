{% if product.metafields.custom_fields["video_modal"] != blank %}
  <div class="custom-field custom-field__video-modal custom-field__type--checkbox">
    <h3 class="custom-field--title">Video Modal</h3>
    <div class="custom-field--value">
      {% if product.metafields.custom_fields["video_modal"] == 1 %}
        TRUE
      {% else %}
        FALSE
      {% endif %}
    </div>
  </div>
{% endif %}