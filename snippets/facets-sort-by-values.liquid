{%- comment -%}
{%- render 'facets-sort-by-values' collection: collection -%}
{%- endcomment -%}

<li class="facet-group__list-item">
  <input id="facet-sort-by-best-sellers"
         type="radio"
         name="sort-by"
         class="facet-group-input"
         value="best_selling"
         title="best_selling"
         data-default-sort-by/>
  <label class="facet-group-radio f aic"
         for="facet-sort-by-best-sellers">
    Best sellers
  </label>
</li>
<li class="facet-group__list-item">
  <input id='facet-sort-by-product-random'
         type="radio"
         name="sort-by"
         class="facet-group-input"
         value="random"
         title="random"/>
  <label class="facet-group-radio f aic"
         for="facet-sort-by-product-random">
    Random
  </label>
</li>
<li class="facet-group__list-item">
  <input id='facet-sort-by-product-inventory-low_to_high'
         type="radio"
         name="sort-by"
         class="facet-group-input"
         value="inventory_low_to_high"
         title="inventory"
         data-sort-order="ascending"/>
  <label class='facet-group-radio f aic'
         for='facet-sort-by-product-inventory-low_to_high'>
    Inventory (low to high)
  </label>
</li>
<li class="facet-group__list-item">
  <input id='facet-sort-by-product-inventory-high_to_low'
         type="radio"
         name="sort-by"
         class="facet-group-input"
         value="inventory_high_to_low"
         title="inventory"
         data-sort-order="descending"/>
  <label class='facet-group-radio f aic'
         for='facet-sort-by-product-inventory-high_to_low'>
    Inventory (high to low)
  </label>
</li>
<li class="facet-group__list-item">
  <input id='facet-sort-by-product-date-new-to-old'
         type="radio"
         name="sort-by"
         class="facet-group-input"
         value="date-new-to-old"
         title="date"
         data-sort-order="ascending"/>
  <label class='facet-group-radio f aic'
         for='facet-sort-by-product-date-new-to-old'>
    Created date (new to old)
  </label>
</li>
<li class="facet-group__list-item">
  <input id='facet-sort-by-product-date-old-to-new'
         type="radio"
         name="sort-by"
         class="facet-group-input"
         value="date-old-to-new"
         title="date"
         data-sort-order="descending"/>
  <label class='facet-group-radio f aic'
         for='facet-sort-by-product-date-old-to-new'>
