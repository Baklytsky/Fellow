{% if product.metafields.custom_fields["related_product_new"] != blank %}
  {%- assign related_products_heading = product.metafields.custom_fields["related_products_heading_new"] %}
  {%- assign related_products_handles = product.metafields.custom_fields["related_product_new"] | split: "|" -%}

    <section class="x relatedProducts pdpRelatedProducts">
      <div class="relatedProducts__inner x f fdc">
        {% if related_products_heading != blank %}
          <h2 class='relatedProducts__title'>{{ related_products_heading | default: 'Related Products' | escape }}</h2>
        {% endif %}

        <div class="relatedProducts__row-wrapper rel">
          <div class='f jcs fdr one-fourth relatedProducts__row'>
            {% for related_product_handle in related_products_handles limit: 10 %}
              {% assign related_product = all_products[related_product_handle] %}
              {%- if related_product != blank -%}
                <div class="relatedProducts__item">
                  {%
                    include 'product-card' with
                    cx: 'y',
                    product: related_product
                  %}
                </div>
              {%- endif -%}
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

{% endif %}