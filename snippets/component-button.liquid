{%- capture cx -%}
  button rel {{ className }}
  {% if outline == true %}button--outline{% endif %}
  {% if small == true %}button--small{% endif %}
{%- endcapture -%}

<{{ tag | default: 'a' }}
  {% if href != blank %}href='{{ href }}'{% endif %}
  {% if id != blank %}id='{{ id }}'{% endif %}
  {% if name != blank %}name='{{ name }}'{% endif %}
  {% if disabled %}disabled{% endif %}
  {% if dataAttr != blank %}{{ dataAttr }}{% endif %}
  {% if bundle_name != blank %}data-bundle-name='{{ bundle_name }}'{% endif %}
  {% if tag != 'a' %}type='{{ type | default: 'button' }}'{% endif %}
  class='{{ cx | strip }}'
  role='button'>
  {{ cta | strip }}
</{{ tag | default: 'a' }}>

{% assign cta = blank %}
{% assign className = blank %}
{% assign href = blank %}
{% assign name = blank %}
{% assign id = blank %}
{% assign disabled = false %}
{% assign dataAttr = blank %}
{% assign type = blank %}
{% assign cx = '' %}
