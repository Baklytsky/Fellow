{% if page.metafields.custom_fields["wholesale_quick_links"] != blank %}
  <div class="wholesale-quick-links container--l ac">
    {% if page.metafields.custom_fields["wholesale_quick_links"] != blank %}
      <h3 class="wholesale-quick-links__heading caps">{{ page.metafields.custom_fields["wholesale_quick_links_heading"] }}</h3>
    {% endif %}

    <div class="f fw jcb ">
      {% assign separator = "|###|" %}
      {% assign wholesale_quick_links_link_array = page.metafields.custom_fields["wholesale_quick_links_link"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["wholesale_quick_links"] | split: "," %}

      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="wholesale-quick-links__item py1 x">
          {{ wholesale_quick_links_link_array[index] }}
        </div>
      {% endfor %}
    </div>

    </div>
{% endif %}
