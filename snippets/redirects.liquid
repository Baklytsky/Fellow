{%- if request.path == '/cart'
  or request.path == '/collections'
  or request.path == '/collections/all'
  or request.path == '/products' -%}
  <script>window.location = '/'</script>
{%- endif -%}

<script>
  window.onpageshow = function(event) {
    if (event.persisted) {
      window.location.reload()
    }
  };
</script>