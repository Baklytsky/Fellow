{% assign slimNav = true %}
{% for link in link.links %}
  {% if link.links != blank %}
    {% assign slimNav = false %}
  {% else %}
    {% assign linkObject = link.object %}
    {% comment %} TODO: Recode this catch to allow for blog post nav endcaps a'la Snowe {% endcomment %}
    {% if linkObject.image and link.type == 'collection_link' %}
      {% assign slimNav = false %}
    {% endif %}
  {% endif %}
{% endfor %}


<li
  class='nav__item'
  data-component='navDrawer'
  data-prop='navDrawer-{{ link.title | handleize }}'
>
  <button
    id='navDrawerBtn-{{ link.title | handleize }}'
    class='nav__link js-nav-drawer-toggle'
    data-prop='navDrawer-{{ link.title | handleize }}'
    aria-label='Press enter to expand nav for {{ link.title }}'
    aria-expanded='false'
    aria-controls='navDrawerBtn-{{ link.title | handleize }}'
  >
    <span class='navLink__focus' tabindex='-1'>{{ link.title }}</span>
  </button>
  <section
    id='navDrawer-{{ link.title | handleize }}'
    class='nav__drawer{% if slimNav == true %} nav__drawer--slim{% endif %}'
    aria-labelledby='navDrawerBtn-{{ link.title }}'
  >
    <ul class='nav__drawerInner'>
      {% for link in link.links %}
        {% if link.links == blank %}
          <li class='nav__drawerItem'>
            {% comment %}
              render collection and product links with their collection image
            {% endcomment %}
            {% if link.type == 'collection_link' %}
              {% assign linkObject = link.object %}
              {% if linkObject.image %}
                <a
                  href="{{ link.url }}"
                  class='drawerItem__link'
                  {% if link.current %} aria-current="page" {% endif %}
                  title="{{ link.title }}"
                  aria-label="{{ link.title }}"
                  target="_self"
                >
                  <span class="drawerItem__title">{{ link.title }}</span>
                  <picture>
                    <source srcset="{{ linkObject.image.src | collection_img_url: '1x1' }}" media="(max-width: 991px)">
                    <img src="{{ linkObject.image.src | collection_img_url: 'large' }}" alt="{{ linkObject.title | escape  }}" />
                  </picture>
                </a>
              {% endif %}
            {% elsif link.type == 'product_link' %}
              {% assign linkObject = link.object %}
              {% if linkObject.image %}
                <a href="{{ link.url }}" target="_self" class='drawerItem__link' aria-label="{{ linkObject.title }}" aria-labelledby="{{ linkObject.title }}">
                  <img src="{{ linkObject.image.src | product_img_url: 'large' }}" alt="{{ linkObject.title | escape  }}" />
                  <span>{{ link.title }}</span>
                </a>
              {% endif %}
            {% elsif link.type == 'blog_link' %}
              {% assign linkObject = link.object %}
              <h4><a href="{{ link.url }}" target="_self">{{ link.title }}</a></h4>
            {% else %}
              <h4><a href="{{ link.url }}" target="_self">{{ link.title }}</a></h4>
            {% endif %}
          </li>
        {% else %}
          {% comment %}
            This is for reference for when you're ready to hook link--active up to some JS -ae 08.07.19
            <h4><a href="{{ link.url }}" target="_self" {% if link.current %}aria-current="page" class="link--active"{% endif %}>{{ link.title }}</a></h4>
          {% endcomment %}
          {% comment %} This probably only happens for link-lists.  {% endcomment %}
          <li class='nav__drawerItem'>
            <div class='drawerItem__linkList'>
              <h4 class='linkList__title'>{{ link.title }}</h4>
              <ul class='f fdc aic'>
                {% for link in link.links %}
                  <li class='linkList__link'>
                    <a href="{{ link.url }}" target="_self">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>
</li>