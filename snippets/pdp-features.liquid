{% if product.metafields.custom_fields["key_features_new"] != blank or product.metafields.custom_fields["additional_features_new"] != blank %}
  {% comment %} Metafields for reordering {% endcomment %}
  {% assign flex_order = product.metafields.custom_fields["features_order_new"] | downcase %}
  {% if flex_order %}
    {% unless flex_order == 'default' %}
      {% assign display_order = flex_order %}
    {% endunless %}
  {% endif %}
  <div class='features_wrap {% if display_order %} o-{{ display_order }}{% endif %}'>
    {% if product.metafields.custom_fields["show_key_features_new"] == 1 %}
      {% include 'pdp-key-features' %}
    {% endif %}
    <div class="klaviyo-form-WMNHYc"></div>
    {% if product.metafields.custom_fields["show_additional_features_new"] == 1 %}
      {% include 'pdp-addl-features' %}
    {% endif %}
  </div>
{% endif %}