{%- capture uid -%}
  select{{name | default: label}}
{%- endcapture -%}

{%- capture cx -%}
  select-wrapper x rel {{ className }}
{%- endcapture -%}

{%- capture selTitle -%}
  {%- if index -%}
    {{ selectTitle | append: index }}
  {%- else -%}
    {{ selectTitle }}
  {%- endif -%}
{%- endcapture -%}

<div class='{{ cx }}' style='{{ style }}'>
  <label id='{{ selTitle }}' for='{{ id | default: uid | strip }}' class='hide'>{{ selTitle }}</label>
  <div class='rel' tabindex='-1'>
    <select
      id='{{ id | default: uid | strip }}'
      name='{{ name | default: label | strip }}'
      value='{{ value }}'
      title='{{ selTitle }}'
      class="js-select"
      {{ attributes }}
      {% if ariaHidden %}aria-hidden='true'{% endif %}
      {% if required %}required{% endif %}
      tabindex='-1'
      aria-label="Product variants select"
    >
      {% if placeholder %}<option disabled selected>{{ placeholder }}</option>{% endif %}
      {{ options }}
    </select>

  </div>
</div>

{% assign id = blank %}
{% assign style = blank %}
{% assign label = blank %}
{% assign name = blank %}
{% assign required = blank %}
{% assign ariaHidden = blank %}
{% assign value = blank %}
{% assign placeholder = blank %}
{% assign options = blank %}
{% assign attributes = blank %}
