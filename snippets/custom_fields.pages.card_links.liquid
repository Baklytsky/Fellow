{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-devshop.myshopify.com/pages/configure/253421/edit
{% endcomment %}
{% if page.metafields.custom_fields["card_links"] != blank %}
  <div class="custom-field custom-field__card-links custom-field__type--field-collection">
    <h3 class="custom-field--title">Wholesale & Customs - Card Links</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign card_links_image_array = page.metafields.custom_fields["card_links_image"] | split: separator %}
      {% assign card_links_heading_array = page.metafields.custom_fields["card_links_heading"] | split: separator %}
      {% assign card_links_body_array = page.metafields.custom_fields["card_links_body"] | split: separator %}
      {% assign card_links_link_array = page.metafields.custom_fields["card_links_link"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["card_links"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--card fc-index--{{ index }}">
          <div class="fc-field field__card-links-image">
            {{ card_links_image_array[index] }}
          </div>
          <div class="fc-field field__card-links-heading">
            {{ card_links_heading_array[index] }}
          </div>
          <div class="fc-field field__card-links-body">
            {{ card_links_body_array[index] }}
          </div>
          <div class="fc-field field__card-links-link">
            {{ card_links_link_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}