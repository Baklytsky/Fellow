{% capture date %}{{ article.published_at | time_tag: format: 'month_day_year' }}{% endcapture %}
{% if article.image %}
  {%- assign imgSrc = article | img_url: '320x' -%}
{% endif %}
{% if article.metafields.custom_fields["author_name"] != blank %}
  {%- assign author_name = article.metafields.custom_fields["author_name"] -%}
{% else %}
  {%- assign author_name = article.author -%}
{% endif %}

<article class='additionalPost__single f jcs ais rel'>
  <a href="{{ article.url }}" class='abs z1 x y fill'>
    <span class='u-sr-only'>{{ article.title }}</span>
  </a>
  {% if article.image %}
    <div class='additionalPost__thumb rel z0'>
      {%
        include 'component-image' with
        src: imgSrc,
        alt: article.title,
        className: 'image ais',
        centered: false,
        fill: true
      %}
    </div>
  {% endif %}
  <div class='additionalPost__copy'>
    <div class='articleCard__header'>
      {% if section.settings.show_author and section.settings.show_date %}
        <p class='eyebrow'>{{ 'blogs.article.author_on_date_html' | t: author: author_name, date: date }}</p>
      {% else %}
        {% if section.settings.show_author %}
          <p class='eyebrow'>By {{ author_name }}</p>
        {% endif %}
        {% if section.settings.show_date %}
          <p class='eyebrow'>{{ date }}</p>
        {% endif %}
      {% endif %}
      <h3 class='b'>{{ article.title }}</h3>
    </div>
    <div class='rte articleCard__excerpt'>
      {% if section.settings.show_author or section.settings.show_date %}
        {{ article.excerpt_or_content | strip_html | truncatewords: 15, '...' }}
      {% else %}
        {{ article.excerpt_or_content | strip_html | truncatewords: 20, '...' }}
      {% endif %}
    </div>
    <a href="{{ article.url }}" class='d-lg-none d-xl-none underline underlineArrow' aria-label='Read more about {{ article.title | escape }}'>{{ 'blogs.article.read_more' | t }}</a>
  </div>
</article>