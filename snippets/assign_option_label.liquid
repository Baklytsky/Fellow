{% assign option_value_label = value %}
{% assign option_value_group = blank %}

{% if option.name == 'Color' or option.name == 'color' %}
  {% assign option_value_group = 'Classic' %}
{% else %}
  {% assign option_value_group = 'Color' %}
{% endif %}

{% if value contains ':' %}
  {% assign option_value_label = value | split: ':' | last | strip %}
  {% assign option_value_group = value | split: ':' | first | capitalize | strip %}
{% endif %}

