
{% if article.image %}
  {%- assign imgSrc = article.image | img_url: '500x' -%}
  <div class='col'>
    <div class="image">
      {% render 'image-lazy',
        image: article.image,
        size: 'medium',
        alt: alt,
        loader: true %}
    </div>
  </div>
{% endif %}
<div class='col-lg-7'>
  <div class='featuredRoaster__info'>
    <h3 class='caps mt0'>{{ article.title }}</h3>
    <p>{{ article.excerpt }}</p>
    <a class='btn caps' href='{{ article.url }}' aria-label="Read More about {{ article.title }}" aria-labelledby="Read More about {{ article.title }}">
      Read More
    </a>
  </div>
</div>