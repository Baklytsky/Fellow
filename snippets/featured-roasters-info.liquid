
{% if article.image %}
  {%- assign imgSrc = article.image | img_url: '500x' -%}
  <div class='col'>
    {%
      include 'component-image' with
      src: imgSrc,
      alt: alt,
      className: 'image',
      fill: false
    %}
  </div>
{% endif %}
<div class='col-lg-7'>
  <div class='featuredRoaster__info'>
    <h3 class='caps mt0'>{{ article.title }}</h3>
    <p>{{ article.excerpt }}</p>
    <a class='btn caps' href='{{ article.url }}'>
      Read More
    </a>
  </div>
</div>