{% if product.metafields.custom_fields["show_jumbo_slider"] == 1 %}
{% if product.metafields.custom_fields["jumbo_slider"] != blank %}
  {% assign separator = "|###|" %}
  {% assign jumbo_slide_array = product.metafields.custom_fields["jumbo_slide"] | split: separator %}
  {% assign jumbo_slide_alt_array = product.metafields.custom_fields["jumbo_slide_alt"] | split: separator %}
  {% assign fc_keys = product.metafields.custom_fields["jumbo_slider"] | split: "," %}

  {% assign flex_order = product.metafields.custom_fields["jumbo_slider_order"] | downcase %}
  {% if flex_order %}
    {% unless flex_order == 'default' %}
      {% assign display_order = flex_order %}
    {% endunless %}
  {% endif %}
  <div class='jumboSlider__mobileWrap{% if display_order %} o-{{ display_order }}{% endif %}'>
    <section class='jumboSlider module pdpJumboSlider' data-component='jumboSlider'>
      <div class='x y block rel' data-jumboSlider>
        {% for i in fc_keys %}
          {% assign index = i | plus: 0 %}
          {% assign imageSrc = jumbo_slide_array[index] %}
          {% assign alt = jumbo_slide_alt_array[index] | escape %}
          <div class='jumboSlider__slide x y fill abs'>
            {%
              include 'component-image' with
              src: imageSrc,
              alt: alt,
              className: 'image',
              fill: true
            %}
          </div>
        {% endfor %}
      </div>
      {% if jumbo_slide_array.size > 1 %}
      <div class='slider__controls abs block fill z2'>
        <div class='rel f fdr aic jcc y'>
          <div class='slider__nav rel f jcb x'>
            <button data-slidePrev>
              {% render 'icon' with 'arrow-prev' %}
            </button>
            <button data-slideNext>
              {% render 'icon' with 'arrow-next' %}
            </button>
          </div>
        </div>
      </div>
      {% endif %}
    </section>
  </div>
{% endif %}
{% endif %}

{% comment %} Reset {% endcomment %}
{% assign display_order = blank %}