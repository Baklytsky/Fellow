{% comment %}form start & end moved to pdp-details-main to adjust for shop pay {% endcomment %}
{% comment %} Always include product-options, product.js:20 reads from it for ATC {% endcomment %}

{%- assign component_button_id = 'pdp-atc' -%}
{%- assign component_button_id = 'pdp-bundle-atc' -%}

    {%- if product.metafields.custom_fields["bundle_product"] != blank -%}
      {% for item in product.metafields.custom_fields["bundle_product"] %}
        {%- assign bundle_product_icon = bundle_product.featured_image | img_url: '200x' -%}
        {% if item["product"] != blank %}
          {%- assign bundle_product = all_products[item["product"]] -%}
        {% endif %}
        {% if item["product_icon"] != blank %}
          {%- assign bundle_product_icon = item["product_icon"] -%}
        {% endif %}
        {% if item["product_variants_id"] != blank %}
          {%- assign bundle_product_variants_id = item["product_variants_id"] | split: ',' -%}
        {% endif %}

        {%- if bundle_product != blank -%}
          <div class="bundle-product">
            <div class="bundle-product__icon-wrapper rel">
              <img src="{{ bundle_product_icon }}" class="image-abs-cover" alt="{{ bundle_product.title }}">
            </div>
            <div class="bundle-product__description">
              <h3 class="bundle-product__description-title">
                <a href="{{ bundle_product.url }}">{{ bundle_product.title }}</a>
              </h3>
              {%- assign bandle_variant_option1 = '' -%}
              {%- assign bandle_variant_option2 = '' -%}
              {%- assign bandle_variant_option3 = '' -%}
              {%- assign bandle_option_name_1 = '' -%}
              {%- assign bandle_option_name_2 = '' -%}
              {%- assign bandle_option_name_3 = '' -%}

              {%- for option in bundle_product.options_with_values -%}
                {%- case forloop.index -%}
                {%- when 1 -%}
                {%- assign bandle_option_name_1 = option.name -%}
                {%- when 2 -%}
                {%- assign bandle_option_name_2 = option.name -%}
                {%- when 3 -%}
                {%- assign bandle_option_name_3 = option.name -%}
                {%- endcase -%}
              {%- endfor -%}

              {%- for variant in bundle_product.variants -%}
                {%- for i in (1..3) -%}
                  {%- assign option_key = "option" | append: i -%}
                  {%- case i -%}
                  {%- when 1 -%}
                  {%- assign bandle_variant_option1 = bandle_variant_option1 | append: variant[option_key] | append: '|#|' -%}
                  {%- when 2 -%}
                  {%- assign bandle_variant_option2 = bandle_variant_option2 | append: variant[option_key] | append: '|#|' -%}
                  {%- when 3 -%}
                  {%- assign bandle_variant_option3 = bandle_variant_option3 | append: variant[option_key] | append: '|#|' -%}
                  {%- endcase -%}
                {%- endfor -%}

                {%- assign bandle_variant_options1_arr = bandle_variant_option1 | split: '|#|' | uniq -%}
                {%- assign bandle_variant_options2_arr = bandle_variant_option2 | split: '|#|' | uniq -%}
                {%- assign bandle_variant_options3_arr = bandle_variant_option3 | split: '|#|' | uniq -%}
              {%- endfor -%}

              <div class="bundle-product__option-wrapper f fdc">
                {%- if bandle_option_name_1 != blank -%}
                  {% include 'product-options-bundle' with
                    bundle_product: bundle_product,
                    options_array: bandle_variant_options1_arr,
                    option_name: bandle_option_name_1 %}
                {%- endif -%}

                {%- if bandle_option_name_2 != blank -%}
                  {% include 'product-options-bundle' with
                    bundle_product: bundle_product,
                    options_array: bandle_variant_options2_arr,
                    option_name: bandle_option_name_2 %}
                {%- endif -%}

                {%- if bandle_option_name_3 != blank -%}
                  {% include 'product-options-bundle' with
                    bundle_product: bundle_product,
                    options_array: bandle_variant_options3_arr,
                    option_name: bandle_option_name_3 %}
                {%- endif -%}
              </div>

              {%- capture options -%}
                {%- for variant in bundle_product.variants -%}
                <option
                        value='{{ variant.id }}'
                        {% unless variant.available %}disabled{% endunless %}
                        data-variant-price='{{ variant.price | money | remove: ".00" }}'
                        data-variant-inventory-quantity='{{ variant.inventory_quantity }}'
                        data-variant-inventory-policy='{{ variant.inventory_policy }}'
                        data-variant-inventory-management='{{ variant.inventory_management }}'>{{ variant.title }}</option>
                {%- endfor -%}
              {%- endcapture -%}

              {%- capture selectTitle -%}Options for {{ bundle_product.title }}{%- endcapture -%}
              {% include 'component-select' with
                name: 'id'
                options: options,
                selectTitle: selectTitle,
                className: 'js-variant is-hidden',
                required: true,
                ariaHidden: true,
                attributes: 'data-option-main' %}

            </div>
          </div>
        {%- endif -%}

        {%- assign bundle_product_icon = blank -%}
        {%- assign bundle_product = blank -%}
        {%- assign bundle_product_variants_id = blank -%}
      {%- endfor -%}
    {% endif %}

<div class='f fdc jcb' id='atc-wrapper'>
  {%- capture cta -%}
    {% if product.available and available_bundle_variant and available_bundle_product %}
      <span data-atc-copy class="js-atc-copy">
        {% if product.tags contains 'preorder' %}
          Preorder
        {% else %}
          Add to Cart
        {% endif %}
      </span>

      {%- assign disableVal = false -%}
    {% else %}
      {% if product.tags contains 'discontinued' %}
        Discontinued
      {% else %}
        Out of Stock
      {% endif %}
      {%- assign disableVal = true -%}
    {% endif %}
  {%- endcapture -%}
  {% comment %} Add catch for low stock variants {% endcomment %}
  {%
    include 'component-button' with
    tag: 'button',
    id: component_button_id,
    name: 'add',
    type: 'submit',
    href: '#',
    className: 'js-add-to-cart cart__button',
    dataAttr: 'data-atc="true"',
    disabled: disableVal,
    cta: cta,
  %}
</div>
  <div class='none' data-pay-btn>
    <div class='py1'>
      {{ form | payment_button }}
    </div>
  </div>
<div class='is-hidden' data-bis>
  <button class='button cart__button klaviyo-bis-trigger'>Out of Stock | Notify Me</button>
</div>
