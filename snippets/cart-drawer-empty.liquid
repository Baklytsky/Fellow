{%- assign emptyCTA = settings.cart_empty_cta.url -%}
{%- assign emptyCTACopy = settings.cart_empty_cta_text -%}
<section class='cart-drawer__empty rel x y js-no-items'>
  <div class='x y f jcc aic abs ac'>
    <div>
      <h4 class='caps'>Your Cart Is Empty</h4>
      {%
        include 'component-button' with
        tag: 'a',
        cta: emptyCTACopy,
        href: emptyCTA,
        className: 'y cart__button cart-drawer__button gradient-hover'
      %}
    </div>
  </div>
</section>