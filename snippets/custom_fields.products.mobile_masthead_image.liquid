{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-products.myshopify.com/products/configure/94685/edit
{% endcomment %}
{% if product.metafields.custom_fields["mobile_masthead_image"] != blank %}
  <div class="custom-field custom-field__mobile-masthead-image custom-field__type--image">
    <h3 class="custom-field--title">Mobile Masthead image</h3>
    <div class="custom-field--value">  
      {% include 'cf-image' with image: product.metafields.custom_fields["mobile_masthead_image"], print: 'url' %}
    </div>
  </div>
{% endif %}