
{% if product.title contains "Ode Brew Grinder" or product.title contains "Stagg EKG Electric Kettle" %}

{%- if product.metafields.custom_fields["product_badges"] != blank -%}
  <div class="pdpBadges">
    {%- for item in product.metafields.custom_fields["product_badges"] -%}
      <div class="pdpBadges-item f {% if item["product_badge_learn_more_link"] != blank %}jcb{% else %}jcc{% endif %} aic">
        <div class="pdpBadges-item-content f aic">
          {%- if item["product_badge_icon"] != blank  -%}
            {{ item["product_badge_icon"] }}
          {%- endif -%}
          {%- if item["product_badge_title"] != blank %}
            <h4 class="pdpBadges-item-content-title">{{ item["product_badge_title"] }}</h4>
          {%- endif -%}
        </div>
        {%- if item["product_badge_learn_more_link"] != blank -%}
        <a href="{{ item["product_badge_learn_more_link"] }}" class="pdpBadges-item-link">Learn more</a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% endif %}

{% unless product.title contains "Ode Brew Grinder" or product.title contains "Stagg EKG Electric Kettle" or product.title contains "The Greatest Hits Kit" %}
<div class="pdpBadges">
      <div class="pdpBadges-item f jcc aic">
        <div class="pdpBadges-item-content f aic">
         <img src="https://cdn.shopify.com/s/files/1/0057/6235/1219/t/9/assets/9b49888a9b92--FP-icon-Bundle-dollar-black-c19213.svg?v=1635265072" alt="sale" typeof="foaf:Image">
            <h4 class="pdpBadges-item-content-title">Black Friday came early - Spend $200+ get 20% off!</h4>
        </div>
      </div>
  </div>
{% endunless %}

