{% if product.metafields.custom_fields["media_proof_items_new"] != blank %}
  {% comment %}Assign Media Proof Flex Order{% endcomment %}
  {% assign flex_order = product.metafields.custom_fields["media_proof_order_new"] | downcase %}
  {% if flex_order %}
    {% unless flex_order == 'default' %}
      {% assign display_order = flex_order %}
    {% endunless %}
  {% endif %}

  {%- capture 'slick-config' -%}
  {
    "slidesToShow": 1,
    "slidesToScroll": 1,
    "arrows": false,
    "dots": true
  }
  {%- endcapture -%}

  {%- capture 'slick-response' -%}
    {
    "response": 992,
    "maxMedia": true,
    "selector": ".mediaProof__items",
    "config": {{- slick-config -}}
    }
  {%- endcapture -%}

  <section class='pdpMediaProof mediaProof rel f jcc aic{% if display_order %} o-{{ display_order }}{% endif %}'
           data-section-type="slick-slideshow"
           data-slick-config='{{- slick-config -}}'>
    <div class='x pdpMediaProof__wrapper'>
      <div class='mediaProof__items f fw jca jsSlickSlider' data-check-slick-response='{{- slick-response -}}'>
        {% for item in product.metafields.custom_fields["media_proof_items_new"] %}
          {% assign index = i | plus: 0 %}
          {% assign imageSrc = item["media_proof_item_image_new"] %}
          {% assign quote = item["media_proof_item_quote_new"] %}
            {% include 'media-proof-single' %}
        {% endfor %}
      </div>
    </div>
  </section>

{% endif %}