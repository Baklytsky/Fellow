{% if product.metafields.custom_fields["media_proof"] != blank %}
  {% comment %}Assign Media Proof Flex Order{% endcomment %}
  {% assign flex_order = product.metafields.custom_fields["media_proof_order"] | downcase %}
  {% if flex_order %}
    {% unless flex_order == 'default' %}
      {% assign display_order = flex_order %}
    {% endunless %}
  {% endif %}

  {%- capture 'slick-config' -%}
  {
    "slidesToShow": 1,
    "slidesToScroll": 1,
    "arrows": false,
    "dots": true
  }
  {%- endcapture -%}

  <section class='pdpMediaProof mediaProof rel f jcc aic{% if display_order %} o-{{ display_order }}{% endif %}'
           data-section-type="slick-slideshow"
           data-slick-config='{{- slick-config -}}'>
    <div class='x pdpMediaProof__wrapper'>
      <div class='mediaProof__items f fw jca jsSlickSlider'>

        {% assign separator = "|###|" %}
        {% assign image_array = product.metafields.custom_fields["media_proof_item_image"] | split: separator %}
        {% assign quote_array = product.metafields.custom_fields["media_proof_item_quote"] | split: separator %}
        {% assign fc_keys = product.metafields.custom_fields["media_proof"] | split: "," %}

        {% for i in fc_keys %}
          {% assign index = i | plus: 0 %}
          {% assign imageSrc = image_array[index] %}
          {% assign quote = quote_array[index] %}
            {% include 'media-proof-single' %}
        {% endfor %}
      </div>
    </div>
  </section>

{% endif %}