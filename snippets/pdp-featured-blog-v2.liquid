{%- if product.metafields.custom_fields["show_featured_blog_section"] == 1 -%}
  {%- assign articles_array = product.metafields.custom_fields["featured_articles"] | default: false -%}
  {%- assign heading = product.metafields.custom_fields["featured_blog_heading"] | default: blog.title -%}
  {%- assign description = product.metafields.custom_fields["featured_blog_description"] | default: false -%}
  {%- assign cta_title = product.metafields.custom_fields["feature_blog_cta_copy"] | default: false -%}
  {%- assign cta_url = product.metafields.custom_fields["featured_blog_cta_url"] | default: false -%}

  {%- assign limit = product.metafields.custom_fields["featured_blog_posts_limit"] -%}
  {%- assign bg_color = '#000' -%}
  {%- assign text_color = '#FFF' -%}

  {%- if product.metafields.custom_fields["featured_blog_cta_color"] == 'White' -%}
    {%- assign cta_color = 'btn--light' -%}
  {%- else -%}
    {%- assign cta_color = 'btn--dark' -%}
  {%- endif -%}


  {% comment %}Assign Media Proof Flex Order{% endcomment %}
  {% assign flex_order = product.metafields.custom_fields["featured_blog_section_order"] | downcase %}
  {% if flex_order %}
    {% unless flex_order == 'default' %}
    {% assign display_order = flex_order %}
    {% endunless %}
  {% endif %}

  {%- if articles_array or description or cta_title -%}

    {%- capture 'slick-config' -%}
      {
        "slidesToShow": 3,
        "arrows": false,
        "dots": false,
        "responsive": [
          {
            "breakpoint": 992,
            "settings": {
              "dots": true,
              "infinite": false,
              "centerMode": true,
              "slidesToShow": 1.05
            }
          }
        ]
      }
    {%- endcapture -%}

    <section id="blog-{{ product.id }}" class="BlogSection {% if display_order %} o-{{ display_order }}{% endif %}">
      <div class="BlogSection__Wrapper" style="background: {{ bg_color }}; color: {{ text_color }}"
           data-section-type="slick-slideshow"
           data-slick-config='{{- slick-config -}}'>
        <div class="BlogSection__Content">
          {%- if description -%}
            <div class="BlogSection__Info">
              <h3 class="BlogSection__InfoHeading">{{ heading }}</h3>

              {%- if description -%}
                <div class="BlogSection__InfoDescription">
                  <p>{{ description }}</p>
                </div>
              {%- endif -%}

              {%- if cta_title and cta_url -%}
                <div class="BlogSection__InfoButton">
                  <a class="btn btn--lg {{ cta_color }}"
                     href="{{ cta_url }}"
                     title="{{ cta_title }}"
                     role="button">
                    {{ cta_title }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if articles_array -%}
            {% assign article_refs = articles_array | split: "|" %}

            <div class="BlogSection__ArticleWrapper jsSlickSlider">
              {%- for article_handle in article_refs -%}
                {% assign article_blog_handle = article_handle | replace: ".", "/" %}
                {%- assign article = articles[article_blog_handle] -%}
                    <div>
                      <div class="BlogSection__Article">
                        {%- if article.image != blank -%}
                          <a class="BlogSectionArticle__ImageWrapper AspectRatio AspectRatio--square"
                             href="{{ article.url }}"
                             aria-label="Image link"
                             role="button"
                             title="{{ article.title }}">
                            {% render 'image-lazy',
                              image: article,
                              class_name: 'BlogSectionArticle__Image',
                              size: 'medium',
                              alt: article.title,
                              loader: true %}
                          </a>
                        {%- endif -%}
                        <div class="BlogSectionArticle__Content">
                          <a href="{{ article.url }}" aria-label="{{ article.title }}">
                            <h3 class="BlogSectionArticle__Heading">{{ article.title }}</h3>
                          </a>

                          <a class="BlogSectionArticle__Button btn btn--lg {{ cta_color }}"
                             href="{{ article.url }}"
                             aria-label="{{ 'blogs.article.read_more' | t }}"
                             role="button"
                             title="{{ article.title }}">
                            {{ 'blogs.article.read_more' | t }}
                          </a>
                        </div>
                      </div>
                    </div>

              {%- endfor -%}
            </div>

          {%- endif -%}
        </div>
      </div>
    </section>

  {%- endif -%}
{%- endif -%}
