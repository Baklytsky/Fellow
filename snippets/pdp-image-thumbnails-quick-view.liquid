{% assign badge_text = product.metafields.custom_fields.card_badge %}
  {%- capture 'slick-thumbnail-config' -%}
    {
    "slidesToShow": 6,
    "slidesToScroll": 1,
    "vertical": true,
    "verticalSwiping": true,
    "arrows": false,
    "dots": false,
    "autoplay": false,
    "infinite": false,
    "adaptiveHeight": true,
    "focusOnSelect": true,
    "asNavFor": "#PopupModal--quick-add .pdpMain__gallery-wrapper"
    }
  {%- endcapture -%}
  {%- capture 'slick-gallery-config' -%}
    {
    "slidesToShow": 1,
    "slidesToScroll": 1,
    "arrows": false,
    "dots": false,
    "autoplay": false,
    "infinite": false,
    "fade": true,
    "adaptiveHeight": true,
    "asNavFor": "#PopupModal--quick-add .pdpMain__gallery-thumbnails"
    }
  {%- endcapture -%}
<div class='pdpMain__gallery x rel f'>
  <div class='pdpMain__gallery-thumbnails'
       data-slick-config='{{- slick-thumbnail-config -}}'>
    {%- for media in product.media -%}
      {%- assign variant_has_media = false -%}

      {%- if media.media_type == 'image' -%}
        {%- for variant in product.variants -%}
          {%- if variant.featured_media.id == media.id -%}
            {%- assign variantId = variant.id -%}
            {%- assign variant_has_media = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- unless variant_has_media -%}
          {%- assign variantId = product.id | append: forloop.index -%}
        {%- endunless -%}
      {%- endif -%}

      {%- if media.media_type == 'video' -%}
        {%- assign variantId = product.id | append: forloop.index -%}
      {%- endif -%}

      {%- assign media_alt = media.preview_image.alt | default: product.title | append: ' - media' -%}
      {%- assign imageSrc = media.preview_image | img_url: '200x' -%}
      <div class='pdpMain__gallery-thumbnails-item rel x' data-variant-img='{{ variantId }}'>
        {%- if media.media_type == 'video' -%}
          <div class="pdpMain__gallery-thumbnails-video-icon">
            {% render 'icon' with 'play-btn-mp4' %}
          </div>
        {%- endif -%}
        <img src='{{ imageSrc }}' class='image-abs-cover x' alt='{{ media_alt }}' role='img' loading='lazy'/>
      </div>
      {%- for variant in product.variants -%}
        {%- if variant.id == variantId -%}
          {%- for i in (1..10) -%}
            {%- assign metafield_key =  'variant_image_' | append: i -%}
            {%- assign metafield_variant_image = variant.metafields.my_fields[metafield_key] -%}
            {%- if metafield_variant_image != blank -%}
              {%- assign media_metafield = metafield_variant_image.value -%}
              {%- assign media_alt = metafield_variant_image.alt | default: variant.title | append: ' - media' -%}
              <div class='pdpMain__gallery-thumbnails-item rel x' data-variant-img='{{ variantId | append: forloop.index }}'>
                {%- if media_metafield.media_type == 'video' -%}
                  <div class="pdpMain__gallery-thumbnails-video-icon">
                    {% render 'icon' with 'play-btn-mp4' %}
                  </div>
                {%- endif -%}
                <img src='{{ metafield_variant_image | img_url: '200x' }}' class='image-abs-cover x' alt='{{ media_alt }}' role='img' loading='lazy'/>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {% endfor %}
  </div>
  <div class='pdpMain__gallery-wrapper x f rel'
       data-slick-config='{{- slick-gallery-config -}}'>
    {%- for media in product.media -%}
      {%- assign variant_has_media = false -%}

      {%- if media.media_type == 'image' -%}
        {%- for variant in product.variants -%}
          {%- if variant.featured_media.id == media.id -%}
            {%- assign variantId = variant.id -%}
            {%- assign variant_has_media = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- unless variant_has_media -%}
        {%- assign variantId = product.id | append: forloop.index -%}
        {%- endunless -%}
      {%- endif -%}

      {%- if media.media_type == 'video' -%}
        {%- assign variantId = product.id | append: forloop.index -%}
      {%- endif -%}

      {%- assign media_alt = media.preview_image.alt | default: product.title | append: ' - media' -%}
      <div class="x">
        <div class='pdpMain__variant-image rel x rel'
             data-variant-media='{{ variantId }}'>
          {%- if forloop.first and badge_text != blank -%}
            <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ badge_text }}</span>
          {%- endif -%}
          {%- if image.alt contains 'tag:' and forloop.first == false -%}
            {%- assign image_custom_tag = image.alt | split: 'tag:' | last -%}
            <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ image_custom_tag }}</span>
          {%- endif -%}

          {%- assign media_alt = media.alt | default: product.title | append: ' - media' -%}

          {%- if media.media_type == 'image' -%}
            <img src="{{ media.preview_image | img_url: '600x' }}"
                 class='x image-abs-cover' alt='{{ media_alt }}'
                 role='img'
                 loading='lazy'/>
            {%- elsif media.media_type == 'video' -%}
            <video class='x image-abs-cover' loop muted autoplay playsinline controls poster="{{ media.preview_image | img_url: "600x" }}">
              {%- for source in media.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- endif -%}
        </div>
      </div>
      {%- for variant in product.variants -%}
        {%- if variant.id == variantId -%}
          {%- for i in (1..10) -%}
            {%- assign metafield_key =  'variant_image_' | append: i -%}
            {%- assign metafield_variant_image = variant.metafields.my_fields[metafield_key] -%}
            {%- if metafield_variant_image != blank -%}
              {%- assign media_metafield = metafield_variant_image.value -%}
              <div class="x">
                <div class='pdpMain__variant-image rel x f aic'
                     data-variant-media='{{ variantId | append: forloop.index }}'>

                  {%- assign media_alt = metafield_variant_image.alt | default: variant.title | append: ' - media' -%}

                  {%- if media_metafield.media_type == 'video' -%}
                    <video class='x image-abs-cover' loop muted autoplay playsinline controls poster="{{ metafield_variant_image | img_url: "600x" }}">
                      {%- for source in media_metafield.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endfor -%}
                    </video>
                  {%- else -%}
                    <img src="{{ metafield_variant_image | img_url: '600x' }}"
                         class='x image-abs-cover' alt='{{ media_alt }}'
                         role='img'
                         loading='lazy'/>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {% endfor %}
  </div>
</div>