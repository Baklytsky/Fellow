{%- comment -%}
{%
  render 'account-address-form',
  id: address.id,
  action: address,
  formClassName: 'account-address-form',
  title: edit_address_title,
  cta: 'Save',
  default_addy: default_addy
%}
{%- endcomment -%}

<div id='form_{{id}}' class='{{formClassName}}' style='display: none'>
  {%- if title != blank -%}
    <h2 class="account-heading">{{ title }}</h2>
  {%- endif -%}

  {%- capture return_btn_attr -%}
    data-toggle-address="{{id}}" data-breadcrumbs-title="{{ title }}"
  {%- endcapture -%}

  {%- assign return_cta = 'customer.addresses.return' | t -%}

  {% render 'component-button',
    tag: 'button',
    cta: return_cta,
    type: 'button',
    dataAttr: return_btn_attr,
    className: 'account-cancel-btn' %}

  <div class="account-text required">{{ 'customer.register.required' | t }}</div>

  {% form 'customer_address', action %}

    {% comment %}
      id = address.id || 'new
    {% endcomment %}

  {% assign form_suffix = '_' | append: id %}
  {% assign form_country_id = 'country' | append: form_suffix %}
  {% assign form_province_container_id = 'provinceContainer' | append: form_suffix %}
  {% assign form_province_id = 'province' | append: form_suffix %}

  {%- assign first_name_lable = 'customer.addresses.first_name' | t -%}

  {% render 'component-input',
    label: first_name_lable,
    name: 'address[first_name]',
    required: 'true',
    value: form.first_name,
    unique_id: id %}

  {%- assign last_name_lable = 'customer.addresses.last_name' | t -%}

  {% render 'component-input',
    label: last_name_lable,
    name: 'address[last_name]',
    required: 'true',
    value: form.last_name,
    unique_id: id %}

  {%- assign address1_lable = 'customer.addresses.address1' | t -%}

  {% render 'component-input',
    label: address1_lable,
    name: 'address[address1]',
    required: 'true',
    value: form.address1,
    unique_id: id %}

  {%- assign address2_lable = 'customer.addresses.address2' | t -%}

  {% render 'component-input',
    label: address2_lable,
    name: 'address[address2]',
    value: form.address2,
    unique_id: id %}

  {%- assign city_lable = 'customer.addresses.city' | t -%}

  {% render 'component-input',
    label: city_lable,
    name: 'address[city]',
    value: form.city,
    required: 'true',
    unique_id: id %}

    {%- capture attr -%}
      data-default="{{ form.country }}"
    {%- endcapture -%}

  {%- assign country_lable = 'customer.addresses.country' | t -%}

  {% render 'component-select',
    label: country_lable,
    id: form_country_id,
    name: 'address[country]',
    required: 'true',
    options: country_option_tags,
    attributes: attr %}

    <div class="account-zip-province-wrapper f aic">
      {%- capture attr -%}
        data-default="{{ form.province }}"
      {%- endcapture -%}

      {%- assign province_lable = 'customer.addresses.province' | t -%}

      <div id="{{ form_province_container_id }}" class="account-province-wrapper">
        {% render 'component-select',
          label: province_lable,
          id: form_province_id,
          name: 'address[province]',
          required: 'true',
          options: '',
          attributes: attr %}
      </div>

      <div class="account-zip-wrapper">
        {%- assign zip_lable = 'customer.addresses.zip' | t -%}

        {% render 'component-input',
          label: zip_lable,
          name: 'address[zip]',
          value: form.zip,
          required: 'true',
          unique_id: id %}
      </div>
    </div>

  {%- assign phone_lable = 'customer.addresses.phone' | t -%}

  {% render 'component-input',
    label: phone_lable,
    name: 'address[phone]',
    value: form.phone,
    type: 'tel',
    unique_id: id %}

  {%- assign set_as_default_lable = 'customer.addresses.set_default' | t -%}
  {%- assign set_as_default_addres = 'false' -%}

  {%- if default_addy -%}
    {%- assign set_as_default_addres = 'true' -%}
  {%- endif -%}

  {% render 'component-input',
    label: set_as_default_lable,
    type: 'checkbox'
    name: 'address[default]',
    value: set_as_default_addres,
    unique_id: id  %}

  {% render 'component-button',
    tag: 'button',
    cta: cta,
    type: 'submit',
    className: 'account-btn btn btn--lg btn--dark' %}

    {%- capture cancel_btn_attr -%}
      data-toggle-address="{{id}}"
    {%- endcapture -%}

  {%- assign cancel_lable = 'customer.addresses.cancel' | t -%}

  {% render 'component-button',
    tag: 'button',
    cta: cancel_lable,
    type: 'button',
    dataAttr: cancel_btn_attr,
    className: 'account-cancel-btn cancel-form' %}
  {% endform %}

  <script>
    (function(){
      var countrySelector = document.getElementById({{form_country_id | json}})
      var provinceContainer = document.getElementById({{form_province_container_id | json}})
      var provinceSelector = document.getElementById({{form_province_id | json}})
      var countryDefault = countrySelector.getAttribute('data-default') ? countrySelector.getAttribute('data-default') : countrySelector.options[0].value
      var provinceDefault = provinceSelector.getAttribute('data-default') || ''

      /**
       * Select an option within a <select>
       * based on a given value
       *
       * @param {string} value Value to search for
       * @param {element} select <select> element
       * @return {element} The first matching select option
       */
      function selectOption(value, select) {
        return Array.prototype.slice.call(select.options).filter(function (option, i) {
          if (option.value === value) {
            select.selectedIndex = i
            return true
          }
          return false
        })[0]
      }

      /**
       * Generate province options and show select element
       *
       * @param {array} options Array of arrays from selected country
       */
      function showProvinces(options) {
        var previousValue = provinceSelector.options[0] ? provinceSelector.options[0].value : false
        var isNewValue = !previousValue || options[0][0] !== previousValue ? true : false

        if (isNewValue) {
          // Emptry provinces select
          provinceSelector.innerHTML = ''

          // Generate new options from values
          for (var i = 0; i < options.length; i++) {
            var option = document.createElement('option')
            option.value = options[i][0]
            option.innerHTML = options[i][1]
            provinceSelector.appendChild(option)
          }
        }

        // Select the default province
        if (provinceDefault.length > 0) selectOption(provinceDefault, provinceSelector)

        // Show provinces
        provinceSelector.setAttribute('required', '')
        provinceContainer.style.display = 'block'
      }

      /**
       * Hide provinces container
       */
      function hideProvinces() {
        provinceSelector.innerHTML = ''
        provinceSelector.removeAttribute('required')
        provinceContainer.style.display = 'none'
      }

      /**
       * If we have an active default country,
       * select it and select it's default province
       *
       * (this is for the edit form)
       */
      function selectDefaults() {
        if (countryDefault.length < 1) return

        var selectedCountry = selectOption(countryDefault, countrySelector)
        var options = JSON.parse(selectedCountry.getAttribute('data-provinces')) || []

        options.length > 0 ? showProvinces(options) : hideProvinces()
      }

      /**
       * Get selected country, read it's
       * provinces, and toss them into the
       * provinces selector
       */
      countrySelector.onchange = function () {
        var selectedCountry = countrySelector.options[countrySelector.selectedIndex]
        var options = JSON.parse(selectedCountry.getAttribute('data-provinces')) || []
        options.length > 0 ? showProvinces(options) : hideProvinces()
      }

      selectDefaults()
    })()
  </script>
</div>
