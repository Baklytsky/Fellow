{% if product.metafields.custom_fields["card_badge"] != blank %}
  <div class="custom-field custom-field__card-badge custom-field__type--text">
    <h3 class="custom-field--title">Card Badge</h3>
    <div class="custom-field--value">
      {{ product.metafields.custom_fields["card_badge"] }}
    </div>
  </div>
{% endif %}