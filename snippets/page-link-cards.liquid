{% if page.metafields.custom_fields["card_links"] != blank %}
  <div class="card-links container--l">
    <div class="card-links__inner f fw jcb">
      {% assign separator = "|###|" %}
      {% assign card_links_image_array = page.metafields.custom_fields["card_links_image"] | split: separator %}
      {% assign card_links_heading_array = page.metafields.custom_fields["card_links_heading"] | split: separator %}
      {% assign card_links_body_array = page.metafields.custom_fields["card_links_body"] | split: separator %}
      {% assign card_links_link_array = page.metafields.custom_fields["card_links_link"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["card_links"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="ac card-link x">
          <div class="bg-xlightgrey p15 card-link__inner y">
            <img class="card-link__image x block" src="{{ card_links_image_array[index] }}" alt="{{ card_links_heading_array[index] | escape }}">
            <h2 class="card-link__heading">
              {{ card_links_heading_array[index] }}
            </h2>
            <p class="card-link__body">
              {{ card_links_body_array[index] | newline_to_br }}
            </p>
            <div class="btn btn--lg btn--dark card-link__button">
              {{ card_links_link_array[index] }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}