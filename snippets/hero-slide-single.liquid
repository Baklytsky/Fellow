{% assign ctaColor = block.settings.heroSlide__ctaColor %}
{% if ctaColor == 'white' %}
  {%  assign ctaClasses = 'btn btn--lg btn--light' %}
{% else %}
  {% assign ctaClasses = 'btn btn--lg btn--dark' %}
{% endif %}

<div id='hero__slide--{{ block.id }}' class='hero__slide f aic jcc' data-flickity-bg-lazyload='{{ block.settings.heroSlide | img_url: "1440x" }}' data-color='{{ block.settings.heroSlide__color }}'>
  {% if block.settings.mobileAlignment != 'center' or block.settings.desktopAlignment %}
    <style>
      {% if block.settings.mobileAlignment %}
      @media (max-width: 991.98px) {
        #hero__slide--{{ block.id }} {
          background-position: {{ block.settings.mobileAlignment }};
        }
      }
      {% endif %}
      {% if block.settings.desktopAlignment %}
        @media (min-width: 992px) {
          #hero__slide--{{ block.id }} {
            background-position: {{ block.settings.desktopAlignment }};
          }
        }
      {% endif %}
    </style>
  {% endif %}
  {% if block.settings.heroSlide__textAlignment %}
    <style>
      @media (min-width: 992px) {
        #hero__slide--{{ block.id }} .hero__textWrapper {
          {% if block.settings.heroSlide__textAlignment == 'left' %}
            text-align: left;
          {% endif %}
          {% if block.settings.heroSlide__textAlignment == 'right' %}
            text-align: right;
          {% endif %}
        }
      }
    </style>
  {% endif %}
  <img
    src='{{ block.settings.heroSlide | img_url: "400x" }}'
    srcset='{{ block.settings.heroSlide | img_url: "400x" }} 400w, {{ block.settings.heroSlide | img_url: "500x" }} 500w, {{ block.settings.heroSlide | img_url: "600x" }} 600w, {{ block.settings.heroSlide | img_url: "1000x" }} 991w, {{ block.settings.heroSlide | img_url: "1280x" }} 1280w, {{ block.settings.heroSlide | img_url: "1440x" }} 1400w'
    alt='{{ block.settings.heroSlide__header }}' role="img"
  >
  {% if block.settings.heroSlide__header != blank %}
    <div class='hero__text fill z5'>
      <div class='hero__textWrapper x'>
        <div class='container--l x'>
          <h1 class='m0 p0'>{{ block.settings.heroSlide__header }}</h1>
          <div class='hero__subheader'>
            {% comment %} render this even if no text for spacing reasons {% endcomment %}
            <p class='h3 mt2 mb0'>{{ block.settings.heroSlide__subheader }}</p>
            {% if ctaCopy != blank %}
              {%
                include 'component-button' with
                tag: 'a',
                cta: ctaCopy,
                href: ctaURL,
                className: ctaClasses
              %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</div>