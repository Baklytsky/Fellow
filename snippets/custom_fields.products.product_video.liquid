{% if product.metafields.custom_fields["product_video"] != blank %}
  <div class="custom-field custom-field__product-video custom-field__type--field-collection">
    <h3 class="custom-field--title">Product Video</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign video_title_array = product.metafields.custom_fields["video_title"] | split: separator %}
      {% assign video_host_array = product.metafields.custom_fields["video_host"] | split: separator %}
      {% assign btn_color_array = product.metafields.custom_fields["btn_color"] | split: separator %}
      {% assign fc_keys = product.metafields.custom_fields["product_video"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--product video fc-index--{{ index }}">
          <div class="fc-field field__video-title">
            {{ video_title_array[index] }}
          </div>
          <div class="fc-field field__video-host">
            {{ video_host_array[index] }}
          </div>
          <div class="fc-field field__btn-color">
            {{ btn_color_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}