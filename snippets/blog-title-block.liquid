<div class='featuredArticleBlog__title pb0{% if section.settings.title_location == "left_top" %} mb3rem{% elsif section.settings.title_location == "left_inner" %} mb15{% else %} mb1{% endif %}'>
  {% if section.settings.eyebrow != blank %}
    <p class='eyebrow'>{{ section.settings.eyebrow }}</p>
  {% endif %}
  <h2 class='h1 mt0 mb05'>{{ section.settings.title }}</h2>
  {% if section.settings.show_view_all %}
    <a href="{{ blog.url }}" class='underline underlineArrow' aria-label="{{ 'blogs.general.view_all' | t }}">
      Read the latest
    </a>
  {% endif %}
</div>