{% if imageAlt != blank %}
  {% assign altText = imageAlt %}
{% else %}
  {% assign altText = quote %}
{% endif %}

<div class='mediaProof__item rel ac'>
  <div class="mediaProof__item-image rel">
    {% render 'image-lazy-metafields', image: imageSrc, size: 'small', alt: altText, loader: true %}
  </div>
  <p class='mxa'>“{{ quote }}”</p>
</div>

{% assign quote = blank %}
{% assign imageSrc = blank %}
{% assign altText = blank %}