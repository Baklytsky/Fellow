{% if imageAlt != blank %}
  {% assign altText = imageAlt %}
{% else %}
  {% assign altText = quote %}
{% endif %}

<div class='mediaProof__item rel ac'>
  {%
    include 'component-image' with
    src: imageSrc,
    alt: altText,
    className: 'image'
  %}
  <p class='mxa'>“{{ quote }}”</p>
</div>

{% assign quote = blank %}
{% assign imageSrc = blank %}
{% assign altText = blank %}