{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-devshop.myshopify.com/pages/configure/253044/edit
{% endcomment %}
{% if page.metafields.custom_fields["wholesale_logos"] != blank %}
  <div class="custom-field custom-field__wholesale-logos custom-field__type--field-collection">
    <h3 class="custom-field--title">Wholesale - Logos</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign wholesale_logo_array = page.metafields.custom_fields["wholesale_logo"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["wholesale_logos"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--logo fc-index--{{ index }}">
          <div class="fc-field field__wholesale-logo">
            {{ wholesale_logo_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}