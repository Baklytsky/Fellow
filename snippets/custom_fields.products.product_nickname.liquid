{% if product.metafields.custom_fields["product_nickname"] != blank %}
  <div class="custom-field custom-field__product-nickname custom-field__type--text">
    <h3 class="custom-field--title">Product Nickname</h3>
    <div class="custom-field--value">
      {{ product.metafields.custom_fields["product_nickname"] }}
    </div>
  </div>
{% endif %}