{% if page.metafields.custom_fields["quick_links"] != blank %}
  <link rel="stylesheet" href="{{ 'section-page-quick-links.min.css' | asset_url }}">
  <div class="quick-links container--l ac">
    {% if page.metafields.custom_fields["quicklinks_heading"] != blank %}
      <h3 class="quick-links__heading caps">{{ page.metafields.custom_fields["quicklinks_heading"] }}</h3>
    {% endif %}

    <div class="f fw jcb ">
      {% assign separator = "|###|" %}
      {% assign quicklinks_link_array = page.metafields.custom_fields["quicklinks_link"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["quick_links"] | split: "," %}

      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="quick-links__item py1 x">
          {{ quicklinks_link_array[index] }}
        </div>
      {% endfor %}
    </div>

  </div>
{% endif %}
