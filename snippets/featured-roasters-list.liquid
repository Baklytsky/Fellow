{% if article.metafields.custom_fields["featured_roasters"] != blank %}
  {% assign separator = "|###|" %}
  {% assign featured_roaster_image_array = article.metafields.custom_fields["featured_roaster_image"] | split: separator %}
  {% assign featured_roaster_name_array = article.metafields.custom_fields["featured_roaster_name"] | split: separator %}
  {% assign featured_roaster_location_array = article.metafields.custom_fields["featured_roaster_location"] | split: separator %}
  {% assign featured_roaster_coffee_array = article.metafields.custom_fields["featured_roaster_coffee"] | split: separator %}
  {% assign featured_roaster_details_array = article.metafields.custom_fields["featured_roaster_details"] | split: separator %}
  {% assign fc_keys = article.metafields.custom_fields["featured_roasters"] | split: "," %}

  {% for i in fc_keys %}
    {% assign index = i | plus: 0 %}
    {% assign imgSrc = featured_roaster_image_array[index] %}
    {% assign roasterName = featured_roaster_name_array[index] %}
    {% assign roasterLocation = featured_roaster_location_array[index] %}
    {% assign coffeeName = featured_roaster_coffee_array[index] %}
    <div class="col">
      <div class='featuredRoaster__image'>
        <div class="image">
          {% render 'image-lazy-metafields',
            image: imgSrc,
            alt: alt,
            size: 'medium',
            loader: true %}
        </div>
      </div>
      <section class='featuredRoaster__details'>
        <h5 class='caps mt05 mb0'>{{ roasterName }}</h5>
        <p class='my025'>{{ roasterLocation }}</p>
        <p class='my025'>{{ coffeeName }}</p>
      </section>
    </div>
  {% endfor %}
{% endif %}