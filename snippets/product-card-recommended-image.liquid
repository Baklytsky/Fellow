{%- comment -%}
  {% assign badge_text = product.metafields.custom_fields.card_badge %}
{%- endcomment -%}

<div aria-label='Image of {{ product.title }}' class='productCard__img rel z0{% unless transparent_image == true %} productCard__img--solid{% endunless %}'>

  {% if badge_text and badge_text != blank %}
    <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ badge_text }}</span>
  {% endif %}

  <div class='productCard__img-container default'>
    <img src="{{ image_url }}" alt="{{ alt }}" class="productCard__image image image-abs-cover">
  </div>
  {% comment %}Only make multiple image divs if there's more than one option{% endcomment %}
  {% if hide_variants != true and product.variants.size > 1 %}
    {% for product_option in product.options_with_values %}
      {% assign option_name = product_option.name | handleize %}
      {% if option_name == 'color' or option_name == 'material' %}
        {% comment %}Found Color/Swatch, now loop through those{% endcomment %}
        {% for value in product_option.values %}
          {% for variant in product.variants %}
            {% if variant.option1 == value or variant.option2 == value %}
              {% assign variantImg = variant | img_url: '500x' %}
              <div class='productCard__img-container variant js-variant-image'
                {% if option_name == 'color' or option_name == 'material' %}data-color='{{ value | handleize }}'{% endif %}
                data-variant-url='{{ variant.url }}'
                data-variant-id='{{ variant.id }}'
                aria-label='{{ variant.title }}'>
                <img src="{{ variantImg }}" alt="{{ alt }}" class="productCard__image image image-abs-cover">
              </div>
              {% break %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {%- comment -%}
    <div class="productCardImg__QuickView">
      <button class="productCardImg__QuickViewButton js-product-view" data-quick-view="{{ url }}?view=quick-view" type="button">{{ 'products.product.quick_view' | t }}</button>
    </div>
  {%- endcomment -%}

  <a class='productCardImg__ProductLink abs fill z2 js-product-link' href='{{ url }}' title="{{ product.title }}" aria-label='{{ product.title }}'>
    {%- if product.metafields.custom_fields["product_alternative_image"] != blank -%}
      {%- assign alternative_url = product.metafields.custom_fields["product_alternative_image"] -%}
      <img src="{{ alternative_url }}"
           alt="{{ alt }}"
           class="productCardImg__AlternativeImage image-abs-cover"
           role='img'
           loading='lazy'>
    {%- endif -%}
  </a>
</div>

{% assign image_url = blank %}
{% assign transparent_image = blank %}
{% assign url = blank %}
{% assign alternative_url = blank %}

