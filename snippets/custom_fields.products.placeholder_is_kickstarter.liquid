{% if product.metafields.custom_fields["placeholder_is_kickstarter"] != blank %}
  <div class="custom-field custom-field__placeholder-is-kickstarter custom-field__type--checkbox">
    <h3 class="custom-field--title">Enable Green Kickstarter CTA Button</h3>
    <div class="custom-field--value">
      {% if product.metafields.custom_fields["placeholder_is_kickstarter"] == 1 %}
        TRUE
      {% else %}
        FALSE
      {% endif %}
    </div>
  </div>
{% endif %}