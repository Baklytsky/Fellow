<div class='pdp__options pdp__options-main rel'>
  {%- assign product_has_size_option = false -%}
  <div {% if product.has_only_default_variant or product.variants.size <= 1 %}style='display:none'{% else %} class="f fdcr" {% endif %}>
    {% for option in product.options_with_values %}
      <div class='{% if option.values.size <= 1 %} hide{% endif %}' data-option-radio data-index='{{ forloop.index0 }}' data-options-count='{{ option.values.size }}'>
        {% for value in option.values %}
          {% include 'assign_option_label', option: option, value: value %}
          {% if option_value_group != blank %}
            {% assign option_group_arr = option_value_group | split: '|anything-to-make-an-array|' %}
            {% assign option_group_names = option_group_names | concat: option_group_arr | uniq %}
          {% endif %}
        {% endfor %}

        {%- assign option_name_handleize = option.name | handleize -%}

        {%- if option_name_handleize == 'size' -%}
          {%- assign product_has_size_option = true -%}
        {%- endif -%}

        <label class='py025 block' data-option-label='{{ option.name }}' {% if option_group_names.size > 2 and option_name_handleize == 'color' %} style="display: none"{% endif %}>
          {% include 'assign_option_label', value: option.selected_value %}
          <span class='option-title block'><strong>{% if option_group_names.size <= 2 and option_name_handleize == 'color' %}Classic{% else %}{{ option.name }}{% endif %} : </strong><span data-option-current='{{ option.name }}' {% if option_name_handleize == 'size' %}data-disabled-size="true"{% endif %}>{{ option_value_label }}</span></span>
        </label>

        {% assign option_group_names = '' | split: '' %}
        {% for value in option.values %}
          {% include 'assign_option_label', option: option, value: value %}
          {% if option_value_group != blank %}
            {% assign option_group_arr = option_value_group | split: '|anything-to-make-an-array|' %}
            {% assign option_group_names = option_group_names | concat: option_group_arr | uniq %}
          {% endif %}
        {% endfor %}
        <div class="option-groups f ais jcs fw rel" {% if product_has_size_option %} data-disabled-size="true"{% endif %}>
          {% for group in option_group_names %}
            <div class="option-groups__group pb1 x">
              {% if option_group_names.size > 1 %}
                <label>
                  {%- comment -%}
                    <span class='caps small my05 block' data-option-label='{{ option.name }}'>{{ group }}</span>
                  {%- endcomment -%}
                  <span class='option-title option-group-title block'><strong>{{ group }} : </strong><span class="option-group-title-value"></span></span>
                </label>
              {% endif %}
              <div class='radio-group f aic' data-option-{{ option.name | handleize }}>
                {% for value in option.values %}
                  {% include 'assign_option_label', option: option, value: value %}
                  {% if option_value_group == group %}
                    {% if option.selected_value == value %}
                      {%- assign checkedVal = true -%}
                    {% else %}
                      {%- assign checkedVal = false -%}
                    {% endif %}

                    {%
                      include 'component-radio' with
                      label: option_value_label,
                      value: value,
                      name: option.name,
                      checked: checkedVal
                    %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>

  {%- capture options -%}
    {% comment %}
      PR: multi-line <option> tag introduces whitespace that breaks updateSelection() in options.js for variant titles >1 word
      the option tag is one-lined to avoid adding whitespace which breaks updateSelection() in options.js
    {% endcomment %}
    {% for variant in product.variants %}
      <option
        value='{{ variant.id }}'
        {% unless variant.available %}disabled{% endunless %}
        data-variant-price='{{ variant.price | money | remove: ".00" }}'
        data-variant-inventory-quantity='{{ variant.inventory_quantity }}'
        data-variant-inventory-policy='{{ variant.inventory_policy }}'
        data-variant-inventory-management='{{ variant.inventory_management }}'>{{ variant.title }}</option>
    {% endfor %}
  {%- endcapture -%}
  {%- capture selectTitle -%}Options for {{ product.title }}{%- endcapture -%}
  {%
    include 'component-select' with
    name: 'id'
    options: options,
    selectTitle: selectTitle,
    className: 'js-variant is-hidden',
    required: true,
    ariaHidden: true,
    attributes: 'data-option-main'
  %}
</div>
