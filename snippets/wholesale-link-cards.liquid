{% if page.metafields.custom_fields["wholesale_card_links"] != blank %}
  <div class="wholesale-card-links container--l">
    <div class="wholesale-card-links__inner f fw jcb">
      {% assign separator = "|###|" %}
      {% assign wholesale_card_links_image_array = page.metafields.custom_fields["wholesale_card_links_image"] | split: separator %}
      {% assign wholesale_card_links_heading_array = page.metafields.custom_fields["wholesale_card_links_heading"] | split: separator %}
      {% assign wholesale_card_links_body_array = page.metafields.custom_fields["wholesale_card_links_body"] | split: separator %}
      {% assign wholesale_card_links_link_array = page.metafields.custom_fields["wholesale_card_links_link"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["wholesale_card_links"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="ac wholesale-card-link x">
          <div class="bg-xlightgrey p15 wholesale-card-link__inner y">
            <div class="wholesale-card-link__image x">
              {{ wholesale_card_links_image_array[index] }}
            </div>
            <h2 class="wholesale-card-link__heading">
              {{ wholesale_card_links_heading_array[index] }}
            </h2>
            <p class="wholesale-card-link__body">
              {{ wholesale_card_links_body_array[index] | newline_to_br }}
            </p>
            <div class="btn btn--lg btn--dark wholesale-card-link__button">
              {{ wholesale_card_links_link_array[index] }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}