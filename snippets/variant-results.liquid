{%- comment -%}
{%- render 'variant-results' -%}
{%- endcomment -%}
<script id="collection__variant-template" type="text/x-handlebars-template">
  {% raw %}
  {{#if variants.length}}
    {{#each variants}}
    <div class='productCard'>
      <div class='productCard__content y'>
        <div aria-label='Image of {{ title }}' class='productCard__img rel z0'>
        {{#if budge}}
          <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ budge_text }}</span>
        {{/if}}
          <div class='productCard__img-container default'>
            <img src="{{ image.large }}"
                 alt="{{ title }}"
                 class="productCard__image image image-abs-cover"
                 loading="lazy">
          </div>
          {{#unless bundle}}
          <div class="productCardImg__QuickView">
            <button class="productCardImg__QuickViewButton js-product-view"
                    data-quick-view="{{ variant_url }}&view=quick-view" type="button">
              + Quick Add
            </button>
          </div>
          {{/unless }}
          <a class='productCardImg__ProductLink abs fill z2 js-product-link'
             href='{{ variant_url }}'
             title="{{ title }}"></a>
        </div>
        <div class='productCard__details rel'>
          <h3 class='productCard__title js-product-card-title'>{{ title }}</h3>
          <div class="productCard__price js-product-card-price">
            {{#unless available}}
              <p class='productCard__from eyebrow'>Sold Out</p>
            {{/unless }}
            <div class="ar productCard__price-wrapper">
            {{#if available}}
              {{#if compare_at_price_is_more_than_price}}
              <div class="pdpCopy__price f aic">
                <span class="inline-block strike card__price--regular ml1 pdpCopy__header-price pdpCopy__header-price-small rel">
                  {{ price_money }}
                  <div class="price-round-arrow">
                      <svg xmlns="http://www.w3.org/2000/svg" width="25" height="14" viewBox="0 0 25 14" fill="none">
                        <path d="M21.8717 2.55273L22.064 7.23249L17.2605 7.54226" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M21 6.49951C21 6.49951 16.3627 1.55385 10.0543 3.38802C3.74592 5.22219 1.9372 10.8949 1.9372 10.8949" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                  </div>
                </span>
                <span class="visually-hidden">Regular price</span>
                <h2 class="inline-block card__price--sale ml1 pdpCopy__header-price">
                  {{ compare_at_price_money }}
                </h2>
              </div>
              {{ else }}
                <h2 class="ml1 pdpCopy__header-price">{{ price_money }}</h2>
              {{/if}}
            {{ else }}
              <h2 class='strike'>{{ price_money }}</h2>
            {{/if}}
            </div>
          </div>
          <a href='{{ product_url }}' class='abs fill z2 js-product-link' aria-label='{{ title }}'></a>
        </div>

        <div class="productCard_ratings f fdr aie mb05 mt05 rel"
             {{#unless reviews_count }}style="display:none;"{{/unless}}>
          <div class="yotpo bottomLine" style="display:inline-block;" data-product-id="{{ product_id }}"></div>
          <span class="productCard__reviewNum">({{ reviews_count }})</span>
          <a href="{{ product_url }}#pdp-reviews" class="abs x y z5" aria-label="{{ title }} rating stars"></a>
        </div>

      {{#if options_in_card}}
        <div class="productCard_options">{{ options_in_card }}</div>
      {{/if}}
      </div>
    </div>
    {{/each }}
  {{else}}
    <div class="collection__variant-empty">
      <h2>No results</h2>
    </div>
  {{/if}}
  {% endraw %}
</script>