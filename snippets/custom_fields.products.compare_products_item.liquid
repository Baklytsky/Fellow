{% if product.metafields.custom_fields["compare_products_item"] != blank %}
  <div class="custom-field custom-field__compare-products-item custom-field__type--field-collection">
    <h3 class="custom-field--title">Compare Products Items</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign compare_product_array = product.metafields.custom_fields["compare_product"] | split: separator %}
      {% assign compare_product_image_array = product.metafields.custom_fields["compare_product_image"] | split: separator %}
      {% assign compare_product_text_array = product.metafields.custom_fields["compare_product_text"] | split: separator %}
      {% assign compare_product_cta_text_array = product.metafields.custom_fields["compare_product_cta_text"] | split: separator %}
      {% assign fc_keys = product.metafields.custom_fields["compare_products_item"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--compare product fc-index--{{ index }}">
          <div class="fc-field field__compare-product">
            {{ compare_product_array[index] }}
          </div>
          <div class="fc-field field__compare-product-image">
            {{ compare_product_image_array[index] }}
          </div>
          <div class="fc-field field__compare-product-text">
            {{ compare_product_text_array[index] }}
          </div>
          <div class="fc-field field__compare-product-cta-text">
            {{ compare_product_cta_text_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}