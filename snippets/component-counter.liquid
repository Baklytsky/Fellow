{% comment %}
/components/counter.css
{% endcomment %}

<div class="counter-wrapper rel" data-component="productCounter">
  <label for="productQuantity" class='py025'>
    <span class='caps small mb05 block'><strong>Quantity</strong></span>
  </label>
  <div class="counter rel f aic">
    <button type="button" class="js-counter-remove">-</button>
    <input id="productQuantity" type="number" name="quantity" value="1" min="1" max="" class="js-counter-quantity">
    <button type="button" class="js-counter-add">+</button>
  </div>  
  <div>
    <a href='https://fellow-threekit-demo.herokuapp.com/CarterEveryWhereMug'
       
       class='abs fill z2 js-product-link'
       aria-label='Customize Product'></a>
  </div>
</div>
