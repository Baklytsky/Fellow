{%- comment -%}
  {%- include 'component-counter', id: , class: , single: , val: , min: , max:  -%}
{%- endcomment -%}

<quantity-stepper class="{{ class }} f aic" data-single-stepper="{{ single }}">
  <button type="button" class="cart-stepper js-minus">-</button>
  <input id="{{ id }}"
         type="number"
         name="quantity"
         value="{{ val | default: 1 }}"
         min="{{ min | default: 0 }}"
         {% if max != blank %}max="{{ max }}{% endif %}"
         title="Quantity selector for - {{ product.title }}"
         class="cart-quantity js-quantity">
  <button type="button" class="cart-stepper js-plus">+</button>
</quantity-stepper>