{% if product.metafields.custom_fields["desktop_masthead_image"] != blank %}
  <div class="custom-field custom-field__desktop-masthead-image custom-field__type--image">
    <h3 class="custom-field--title">Desktop Masthead Image</h3>
    <div class="custom-field--value">  
      {% render 'cf-image' with image: product.metafields.custom_fields["desktop_masthead_image"], print: 'url' %}
    </div>
  </div>
{% endif %}