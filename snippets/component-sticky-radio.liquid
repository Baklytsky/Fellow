<label class='radio {% if checked %}checked{% endif %}' for='{{ label | handleize }}'>
  <span class='u-sr-only'>{{ value | escape }}</span>
  <input type="hidden" value="{{ label | handleize }}">
  <span class="radio__title f aic jcc" data-{{ name }}='{{ label | handleize }}'><span>{{label}}</span></span>
</label>

{% assign label = blank %}
{% assign name = blank %}
{% assign value = blank %}
{% assign attributes = blank %}
{% assign checked = blank %}
