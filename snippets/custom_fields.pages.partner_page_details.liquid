{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-products.myshopify.com/pages/configure/102926/edit
{% endcomment %}
{% if page.metafields.custom_fields["partner_page_details"] != blank %}
  <div class="custom-field custom-field__partner-page-details custom-field__type--field-collection">
    <h3 class="custom-field--title">Partner Page Details</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign details_image_array = page.metafields.custom_fields["details_image"] | split: separator %}
      {% assign details_title_array = page.metafields.custom_fields["details_title"] | split: separator %}
      {% assign details_copy_array = page.metafields.custom_fields["details_copy"] | split: separator %}
      {% assign details_product_array = page.metafields.custom_fields["details_product"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["partner_page_details"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--detail row fc-index--{{ index }}">
          <div class="fc-field field__details-image">
            {{ details_image_array[index] }}
          </div>
          <div class="fc-field field__details-title">
            {{ details_title_array[index] }}
          </div>
          <div class="fc-field field__details-copy">
            {{ details_copy_array[index] }}
          </div>
          <div class="fc-field field__details-product">
            {{ details_product_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}