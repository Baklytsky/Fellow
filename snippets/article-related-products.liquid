{% if article.metafields.custom_fields["related_products"] != blank %}
  <div class="blogProducts">
    <h3 class="caps">Shop The Post</h3>
    {% assign product_refs = article.metafields.custom_fields["related_products"] | split: "|" %}
    <div class="blogProducts__col">
      {% for product_handle in product_refs %}
        {% assign product_ref = all_products[product_handle] %}
        {% assign product = product_ref %}
        {%- if product != blank -%}
          {% include 'product-card', cx: 'mb2' %}
        {%- endif -%}
      {% endfor %}
    </div>
  </div>
{% endif %}