{% comment %} <div class="pagination row ac">
  {{ paginate | default_pagination }}
</div> {% endcomment %}
<ul class="f jcb aic pagination">
  {% unless paginate.previous.is_link %}
    <li aria-hidden="true">
      <div class="btn btn--secondary btn--narrow btn--disabled is-hidden">
        <span>&larr;</span>
        <span class="icon__fallback-text">Previous</span>
      </div>
    </li>
    {% else %}
    <li>
      <a href="{{ paginate.previous.url }}" class="btn btn--secondary btn--narrow">
        <span>&larr;</span>
        <span class="icon__fallback-text">Previous</span>
      </a>
    </li>
  {% endunless %}
  <li class="pagination__text">
    {{ 'general.pagination.current_page' | t: current: paginate.current_page, total: paginate.pages }}
  </li>
  {% unless paginate.next.is_link %}
    <li aria-hidden="true">
      <div class="btn btn--secondary btn--narrow btn--disabled">
        <span class="icon__fallback-text">Next</span>
        <span>&rarr;</span>
      </div>
    </li>
  {% else %}
    <li>
      <a href="{{ paginate.next.url }}" class="btn btn--secondary btn--narrow">
        <span class="icon__fallback-text">Next</span>
        <span>&rarr;</span>
      </a>
    </li>
  {% endunless %}
</ul>