{% if product.metafields.custom_fields["player_handler"] != blank %}
  <div class="custom-field custom-field__player-handler custom-field__type--checkbox">
    <h3 class="custom-field--title">Player Handler</h3>
    <div class="custom-field--value">
      {% if product.metafields.custom_fields["player_handler"] == 1 %}
        TRUE
      {% else %}
        FALSE
      {% endif %}
    </div>
  </div>
{% endif %}