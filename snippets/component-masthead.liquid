{% comment %} Default Overlay to True {% endcomment %}
{% assign overlay = true %}
{%- capture cx -%}
  {% if mobileHidden == true and img != blank %}
    masthead rel f aic jcc {{ className }}{% if overlay == true %} masthead--overlay{% endif %}{% if overlap == true %} masthead--overlap{% endif %} masthead--mobile-empty js-masthead--mobile-empty
  {% elsif img != blank %}
    masthead rel f aic jcc {{ className }}{% if overlay == true %} masthead--overlay{% endif %}{% if overlap == true %} masthead--overlap{% endif %}
  {% else %}
    masthead--empty js-masthead--empty
  {% endif %}
{%- endcapture -%}

{% if altText != blank %}
  {% assign img_alt = altText | replace: "'", ' ' %}
{% else %}
  {% assign img_alt = section.settings.title | replace: "'", ' ' %}
{% endif %}

<{{ tag | default: 'section' }}
  {% if dataAttr %}data-component='{{ dataAttr }}'{% endif %}
  class='{{ cx | strip }}'
>
  {%- assign desktop_image_class = 'image-abs-cover' -%}

  {%- if imgMobile != blank -%}
    {%- assign desktop_image_class = 'image-abs-cover hide-tablet' -%}
  {%- endif -%}

  {% if img %}
    <div class="{{ desktop_image_class }}">
      {% render 'image-lazy-metafields',
        image: img,
        class_name: desktop_image_class,
        alt: img_alt,
        loader: true %}
    </div>
  {% endif %}
  {%- if imgMobile -%}
    <div class="image-abs-cover hide-tablet-desk">
      {% render 'image-lazy-metafields',
        image: imgMobile,
        class_name: 'image-abs-cover hide-tablet-desk',
        alt: img_alt,
        loader: true %}
    </div>
  {%- endif -%}
  {% if copy %}
    <div class='abs x bottom left z2'>
      <div class='rel container--l'>
        <h1 class='h0 bold cw'>{{ copy }}</h1>
      </div>
    </div>
  {% endif %}
</{{ tag | default: 'section' }}>

{% assign copy = blank %}
{% assign img = blank %}
{% assign imgMobile = blank %}
{% assign alt = blank %}
{% assign className = blank %}
{% assign mobileHidden = blank %}
{% assign dataAttr = blank %}
{% assign overlay = blank %}
{% assign overlap = blank %}
{% assign cx = '' %}
