{% if product.metafields.custom_fields["video_url_new"] != blank %}
  <link rel="stylesheet" href="{{ 'section-pdp-video.min.css' | asset_url }}">
  <script src="{{ 'section-youtube-vimeo-video.min.js' | asset_url }}" defer="defer"></script>

  {% assign video_title_array = product.metafields.custom_fields["video_title"] %}
  {% assign video_url = product.metafields.custom_fields["video_url_new"] %}
  {% assign video_poster = product.metafields.custom_fields["video_poster_image_new"] %}
  {% assign video_btn_color = product.metafields.custom_fields["video_button_color_new"] | downcase %}
  {% assign video_copy = product.metafields.custom_fields["video_copy_new"] %}
  {% if video_poster %}
    {% include 'cf-image' with image: video_poster, print: "none", size: "1920x1080", format: "pjpg" %}
  {% endif %}
  {%- assign video_type = false -%}

  {% assign flex_order = product.metafields.custom_fields["video_order_new"] | downcase %}
  {% if flex_order %}
    {% unless flex_order == 'default' %}
      {% assign display_order = flex_order %}
    {% endunless %}
  {% endif %}

  {% if product.metafields.custom_fields["video_and_copy_position_new"] == 1 %}
    {%- assign video_in_line = true -%}
  {% else %}
    {%- assign video_in_line = false -%}
  {% endif %}

  {%- if video_url contains 'youtu' -%}
    {%- assign video_type = 'youtube' -%}
    {% if video_url contains 'v=' %}
      {% assign video_id = video_url | split: 'v=' | last %}
    {% else %}
      {% assign video_id = video_url | split: 'youtu.be/' | last %}
    {% endif %}
  {%- else -%}
    {% assign video_id = video_url | split: 'vimeo.com/' | last %}
    {%- assign video_type = 'vimeo' -%}
  {%- endif -%}

  {%- capture video_options -%}
    {
    "videoType": {{ video_type | json }},
    "videoId": {{ video_id | json }},
    "requestHost": {{ request.host | json }}
    }
  {%- endcapture -%}

  <video-section class='video-section {% if display_order %} o-{{ display_order }}{% endif %}{% if video_copy %} has-copy{% endif %}'
                 data-video-options='{{ video_options }}'>

    {% if video_copy != blank or video_url != blank %}
      <div class="pdpVideo__Container">
      <div class='pdpVideo__Wrapper x f {% if video_in_line %} pdpVideo__Wrapper-row{% endif %}'>
        {%- if video_copy != blank -%}
          <div class='pdpVideo__Copy'>
            <div class='heroSection__copy rte'>
              {{ video_copy }}
            </div>
          </div>
        {%- endif -%}
        {%- if video_url != blank -%}
          <div class='pdpVideo__Content'>
            <div class="video_section__player-with-copy rel js-video-wrapper">
              {% if video_poster %}
                {% render 'image-lazy-metafields',
                  image: cf_image,
                  class_name: 'video_section__poster image-abs-cover',
                  alt: alt,
                  size: 'medium',
                  loader: true %}
              {% endif %}
              <button aria-label='Play Video'
                      class="btn btn--clear video-section__load-player-button js-video-play-button{% if video_btn_color == 'white' %} cw{% else %} cb{% endif %}">
                <span class="is-hidden">play video</span>
                {% render 'icon' with 'play-btn' %}
              </button>
              <div class="js-video-mount"></div>
            </div>
          </div>
        {%- endif -%}
      </div>
      </div>
    {% endif %}
  </video-section>
{% endif %}

{% comment %} Reset {% endcomment %}
{% assign display_order = blank %}

{% comment %} host maps to settings.video_url.type {% endcomment %}