{% comment %}
  DO NOT MODIFY THIS FILE DIRECTLY. THIS FILE WILL BE OVERWRITTEN.
  YOU CAN MODIFY THE LIQUID CODE FOR THIS CUSTOM FIELD HERE:
  https://customfields.bonify.io/dashboard/fellow-products.myshopify.com/pages/configure/97109/edit
{% endcomment %}
{% if page.metafields.custom_fields["current_jobs"] != blank %}
  <div class="custom-field custom-field__current-jobs custom-field__type--field-collection">
    <h3 class="custom-field--title">Current Jobs</h3>
    <div class="custom-field--value">
      {% assign separator = "|###|" %}
      {% assign job_page_array = page.metafields.custom_fields["job_page"] | split: separator %}
      {% assign job_title_array = page.metafields.custom_fields["job_title"] | split: separator %}
      {% assign job_short_description_array = page.metafields.custom_fields["job_short_description"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["current_jobs"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        <div class="fc-item fc-item--job fc-index--{{ index }}">
          <div class="fc-field field__job-page">
            {{ job_page_array[index] }}
          </div>
          <div class="fc-field field__job-title">
            {{ job_title_array[index] }}
          </div>
          <div class="fc-field field__job-short-description">
            {{ job_short_description_array[index] }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}