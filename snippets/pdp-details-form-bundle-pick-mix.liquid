{% if product.metafields.custom_fields["bundle_mix_heading"] != blank %}
  <h3 class="bundle-product__heading">{{ product.metafields.custom_fields["bundle_mix_heading"] }}</h3>
{% endif %}

<bundle-mix class="bundle-mix">

  {%- if product.metafields.custom_fields["bundle_product"] != blank -%}
    {% for item in product.metafields.custom_fields["bundle_product"] %}
      {% if item["product"] != blank %}
        {%- assign bundle_product = all_products[item["product"]] -%}
      {% endif %}
      {% if item["product_subtitle"] != blank %}
        {%- assign bundle_product_subtitle = item["product_subtitle"] -%}
      {% endif %}
      {%- assign bundle_product_icon = false -%}
      {% if item["product_icon"] != blank %}
        {%- assign bundle_product_icon = item["product_icon"] -%}
      {% endif %}
      {% if item["product_variants_id"] != blank %}
        {%- assign bundle_product_variants_id = item["product_variants_id"] | split: ',' -%}
      {% endif %}
      {% if item["selected_variant_id"] != blank %}
        {%- assign bundle_product_selected_variant_id = item["selected_variant_id"] -%}
      {% endif %}

      {%- assign hasPreorderTag = false -%}

      {%- if bundle_product != blank -%}
        {%- include 'budle-mix-card' -%}
      {%- endif -%}

      {%- assign bundle_product_icon = blank -%}
      {%- assign bundle_product = blank -%}
      {%- assign bundle_product_subtitle = blank -%}
      {%- assign bundle_product_variants_id = blank -%}
      {%- assign bundle_product_selected_variant_id = blank -%}
      {%- assign uniq_id = blank -%}
      {%- assign custom_class = blank -%}
    {%- endfor -%}
  {% endif %}

  {%- comment -%}
  {%- if product.metafields.custom_fields["multiple_bundle_product_"] != blank -%}
    {%- for item in product.metafields.custom_fields["multiple_bundle_product_"] -%}
      {%- if item["card_title"] != blank -%}
        {%- assign card_title = item["card_title"] -%}
      {%- endif -%}
      {%- if item["card_subtitle"] != blank -%}
        {%- assign card_subtitle = item["card_subtitle"] -%}
      {%- endif -%}
      {%- if item["card_icon"] != blank -%}
        {%- assign card_icon = item["card_icon"] -%}
      {%- endif -%}
      {%- if item["bundle_product_item"] != blank -%}

        {%- capture 'slick-bundle-mix-config' -%}
          {
            "rows": 1,
            "slidesToShow": 1.3,
            "arrows": false,
            "dots": true,
            "autoplay": false,
            "infinite": false,
            "adaptiveHeight": true
          }
        {%- endcapture -%}

        <div class="bundle-product bundle-mix__multiple"
             data-section-type="slick-slideshow"
             data-slick-config='{{- slick-bundle-mix-config -}}'>
          <div class="bundle-mix__multiple-header">
            {%- if card_icon != blank -%}
              <div class="bundle-mix____icon-wrapper rel">
                <img src="{{ card_icon }}"
                     class="image-abs-cover"
                     alt="{{ card_title }}">
              </div>
            {%- endif -%}
            {%- if card_title != blank or card_subtitle != blank -%}
              {%- if card_title != blank -%}
                <h3 class="bundle-mix__title">
                  {{ card_title }}
                </h3>
              {%- endif -%}
              {%- if card_subtitle != blank -%}
                <p class="bundle-mix__subtitle">
                  {{ card_subtitle }}
                </p>
              {%- endif -%}
            {%- endif -%}
          </div>

          <bundle-mix-multiple class="bundle-mix__multiple-wrapper jsSlickSlider">
            {%- for bundle_product_item in item["bundle_product_item"] -%}
              {%- if bundle_product_item["product"] != blank -%}
                {%- assign bundle_product = all_products[bundle_product_item["product"]] -%}
              {%- endif -%}
              {%- assign bundle_product_icon = false -%}
              {%- if bundle_product_item["product_icon"] != blank -%}
                {%- assign bundle_product_icon = bundle_product_item["product_icon"] -%}
              {%- endif -%}
              {%- if bundle_product_item["product_variants_id"] != blank -%}
                {%- assign bundle_product_variants_id = bundle_product_item["product_variants_id"] | split: ',' -%}
              {%- endif -%}
              {%- if bundle_product_item["selected_variant_id"] != blank -%}
                {%- assign bundle_product_selected_variant_id = bundle_product_item["selected_variant_id"] -%}
              {%- endif -%}

              {%- assign hasPreorderTag = false -%}

              {%- if bundle_product != blank -%}
                {%- include 'budle-mix-card' -%}
              {%- endif -%}

              {%- assign bundle_product_icon = blank -%}
              {%- assign bundle_product = blank -%}
              {%- assign bundle_product_subtitle = blank -%}
              {%- assign bundle_product_variants_id = blank -%}
              {%- assign bundle_product_selected_variant_id = blank -%}
              {%- assign uniq_id = blank -%}
              {%- assign custom_class = blank -%}
            {%- endfor -%}
          </bundle-mix-multiple>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- endcomment -%}
  {% include 'pdp-bundle-description' %}


<div class='f fdc jcb' id='atc-wrapper'>
  {%- capture cta -%}
    {% if bundle_available %}
      <span data-atc-copy class="js-atc-copy">
        {% if product.tags contains 'preorder' %}
          Preorder
        {% else %}
          Add to Cart
        {% endif %}
      </span>

      {%- assign disableVal = false -%}
    {% else %}
      {% if product.tags contains 'discontinued' %}
        Discontinued
      {% else %}
        Out of Stock
      {% endif %}
      {%- assign disableVal = true -%}
    {% endif %}
  {%- endcapture -%}
  {% comment %} Add catch for low stock variants {% endcomment %}
  {%
    include 'component-button' with
    tag: 'button',
    id: 'pdp-bundle-atc',
    name: 'add',
    type: 'submit',
    href: '#',
    className: 'js-pick-mix-add-to-cart cart__button pick_mix__cart_bttn',
    dataAttr: 'data-atc="true"',
    bundle_name: product.title,
    disabled: disableVal,
    cta: cta,
  %}
</div>
<p id="PdpErrorMessage"></p>
<div class='is-hidden' data-bis>
  <button class='button cart__button klaviyo-bis-trigger'>Out of Stock | Notify Me</button>
</div>
</bundle-mix>