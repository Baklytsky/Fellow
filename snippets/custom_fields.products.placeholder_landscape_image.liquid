{% if product.metafields.custom_fields["placeholder_landscape_image"] != blank %}
  <div class="custom-field custom-field__placeholder-landscape-image custom-field__type--image">
    <h3 class="custom-field--title">Placeholder Landscape Image</h3>
    <div class="custom-field--value">  
      {% render 'cf-image' with image: product.metafields.custom_fields["placeholder_landscape_image"], print: 'url' %}
    </div>
  </div>
{% endif %}