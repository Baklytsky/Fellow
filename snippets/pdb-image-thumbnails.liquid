{% assign badge_text = product.metafields.custom_fields.card_badge %}
{%- capture 'slick-thumbnail-config' -%}
{
  "slidesToShow": 6,
  "slidesToScroll": 6,
  "vertical": true,
  "verticalSwiping": true,
  "arrows": false,
  "dots": false,
  "autoplay": false,
  "infinite": false,
  "adaptiveHeight": false
}
{%- endcapture -%}
{%- capture 'slick-pdp-mobile-config' -%}
{
  "slidesToShow": 1,
  "slidesToScroll": 1,
  "arrows": false,
  "dots": true,
  "autoplay": false,
  "infinite": false,
  "adaptiveHeight": true
}
{%- endcapture -%}
<div class='pdpMain__gallery x rel f'
     data-section-type="slick-slideshow"
     data-slick-config='{{- slick-thumbnail-config -}}'>
  <div class='pdpMain__gallery-thumbnails jsSlickSlider'>
    {% for image in product.images %}
      {% if image.variants.size > 0 %}
        {% for variant in image.variants %}
          {%- assign variantId = variant.id -%}
        {% endfor %}
      {% else %}
        {%- assign variantId = product.id | append: forloop.index -%}
      {% endif %}
      {%- assign imageSrc = image.src | img_url: '200x' -%}
      <div class='pdpMain__gallery-thumbnails-item rel x' data-variant-img='{{ variantId }}'>
        <img src='{{ imageSrc }}' class='image-abs-cover x' alt='{{ image.alt }}' role='img' loading='lazy'/>
      </div>
      {%- for variant in product.variants -%}
        {%- if variant.id == variantId -%}
          {%- for i in (1..10) -%}
            {%- assign metafield_key =  'variant_image_' | append: i -%}
            {%- assign metafield_variant_image = variant.metafields.my_fields[metafield_key] -%}
            {%- if metafield_variant_image != blank -%}
              <div class='pdpMain__gallery-thumbnails-item rel x' data-variant-img='{{ variantId | append: forloop.index }}'>
                <img src='{{ metafield_variant_image | img_url: '200x' }}' class='image-abs-cover x' alt='{{ image.alt }}' role='img' loading='lazy'/>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {% endfor %}
  </div>
  <div class='pdpMain__gallery-wrapper x y block rel'
       data-slick-config='{{- slick-pdp-mobile-config -}}'>
    {% for image in product.images %}
      {% if image.variants.size > 0 %}
        {% for variant in image.variants %}
          {%- assign variantId = variant.id -%}
        {% endfor %}
      {% else %}
        {%- assign variantId = product.id | append: forloop.index -%}
      {% endif %}
      {%- assign imageSrc = image.src | img_url: '900x' -%}
      <div class="x">
        <div class='pdpMain__variant-image rel x f aic'
             data-variant-media='{{ variantId }}'>
          {%- if forloop.first and badge_text != blank -%}
              <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ badge_text }}</span>
          {%- endif -%}
          {%- if image.alt contains 'tag:' and forloop.first == false -%}
            {%- assign image_custom_tag = image.alt | split: 'tag:' | last -%}
            <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ image_custom_tag }}</span>
          {%- endif -%}
          <img src="{{ imageSrc }}" class='x' alt='{{ image.alt }}' role='img' loading='lazy'/>
        </div>
      </div>
      {%- for variant in product.variants -%}
        {%- if variant.id == variantId -%}
          {%- for i in (1..10) -%}
            {%- assign metafield_key =  'variant_image_' | append: i -%}
            {%- assign metafield_variant_image = variant.metafields.my_fields[metafield_key] -%}
            {%- if metafield_variant_image != blank -%}
              <div class="x">
                <div class='pdpMain__variant-image rel x f aic'
                     data-variant-media='{{ variantId | append: forloop.index }}'>
                  <img src="{{ metafield_variant_image | img_url: '900x' }}" class='x' alt='{{ image.alt }}' role='img' loading='lazy'/>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {% endfor %}
  </div>
</div>