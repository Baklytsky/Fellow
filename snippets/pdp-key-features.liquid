{% if product.metafields.custom_fields["key_features_new"] != blank %}
  {% assign key_feature_quadrature = product.metafields.custom_fields["key_feature_quadrature_image"] %}

  {% comment %} Adjust classes passed to component-image if feature image is square or circular {% endcomment %}
  {% assign classList = 'image' %}
  <section class='keyFeatures x' data-component='pdp-key-features'>
    <h2 class='keyFeatures__Heading'>Key Features</h2>
    <div class='keyFeatures__Wrapper'>
      {% for item in product.metafields.custom_fields["key_features_new"] %}
        {% assign position = item["key_feature_position_new"] %}
        {% assign iconSrc = item["key_feature_icon_new"] %}
        {% assign key_feature_title = item["key_features_title_new"] %}
        {% assign key_feature_copy = item["key_feature_copy_new"] %}
        {% assign key_features_table_left_column = item["key_features_table_left_col_n"] %}
        {% assign key_features_table_right_column = item["key_features_table_rightcol_n"] %}
        {% assign mediaType = item["key_feature_media_type_new"] %}
        {% assign imageSrc = item["key_feature_image_new"] %}
        {% assign secondaryImageSrc = item["key_feature_secondary_img_new"] %}
        {% assign webmSrc = item["key_feature_media_webm_new"] %}
        {% assign mp4Src = item["key_feature_media_mp4_new"] %}
        {% include 'pdp-key-feature-instance' %}
      {% endfor %}
    </div>
  </section>
{% endif %}