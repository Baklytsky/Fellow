{% if product.metafields.custom_fields["key_features"] != blank %}
  {% assign key_feature_quadrature = product.metafields.custom_fields["key_features_circular_images"] | default: blank %}
  {% assign separator = "|###|" %}
  {% assign key_feature_icon_array = product.metafields.custom_fields["key_feature_icon"] | split: separator %}
  {% assign key_feature_title_array = product.metafields.custom_fields["key_feature_title"] | split: separator %}
  {% assign key_feature_copy_array = product.metafields.custom_fields["key_feature_copy"] | split: separator %}
  {% assign key_feature_image_array = product.metafields.custom_fields["key_feature_image"] | split: separator %}
  {% assign key_feature_secondary_image_array = product.metafields.custom_fields["key_feature_secondary_image"] | split: separator %}
  {% assign fc_keys = product.metafields.custom_fields["key_features"] | split: "," %}

  {% comment %} Adjust classes passed to component-image if feature image is square or circular {% endcomment %}
  {% assign classList = 'image' %}
  <section class='module' data-component='pdp-key-features'>
    <div class='row'>
      <div class='col-lg-2'>
        <h2 class='t-vertical caps'>Key Features</h2>
      </div>
      <div class='col-lg-10'>
        {% for i in fc_keys %}
          {% assign index = i | plus: 0 %}
          {% assign iconSrc = key_feature_icon_array[index] %}
          {% assign imageSrc = key_feature_image_array[index] %}
          {% assign secondaryImageSrc = key_feature_secondary_image_array[index] %}
          {% include 'pdp-key-feature-instance' %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}