{% if product.metafields.custom_fields["product_tagline"] != blank %}
  <div class="custom-field custom-field__product-tagline custom-field__type--text">
    <h3 class="custom-field--title">Product Tagline</h3>
    <div class="custom-field--value">
      {{ product.metafields.custom_fields["product_tagline"] }}
    </div>
  </div>
{% endif %}