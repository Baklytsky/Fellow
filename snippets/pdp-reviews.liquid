<link rel="stylesheet" href="{{ 'section-yotpo-reviews.min.css' | asset_url }}">
{%- assign reviews_count = product.metafields.yotpo.reviews_count | plus: 0 -%}
{%- if reviews_count > 0 -%}
  <section id="pdp-reviews" class="pdp-reviews">
    <div class="pdp-reviews__header">
      <h2 class="pdp-reviews__heading caps">Reviews</h2>
      <div class="pdp-reviews__average-counter">{{ reviews_count }} reviews</div>
      <div class="pdp-reviews__average">
        <h3 class="pdp-reviews__average-rating">{{ product.metafields.yotpo.reviews_average }}/5</h3>
        {% include 'yotpo-star-rating-widget' with class: 'f jcc aic' %}
      </div>
    </div>
    <div id="pdp-reviews__widget" class="pdp-reviews__widget">{%- include 'yotpo-review-widget' -%}</div>
  </section>
{%- endif -%}

