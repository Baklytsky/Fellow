{% if page.metafields.custom_fields["page_jumbo_slider"] != blank %}
  {% assign separator = "|###|" %}
  {% assign jumbo_slide_array = page.metafields.custom_fields["page_jumbo_slide"] | split: separator %}
  {% assign fc_keys = page.metafields.custom_fields["page_jumbo_slider"] | split: "," %}
  <div class='jumboSlider__mobileWrap'>
    <section class='jumboSlider module' data-component='jumboSlider'>
      <div class='x y block rel' data-jumboSlider>
        {% for i in fc_keys %}
          {% assign index = i | plus: 0 %}
          {% assign imageSrc = jumbo_slide_array[index] %}
          <div class='jumboSlider__slide x y fill abs'>
            {%
              include 'component-image' with
              src: imageSrc,
              alt: alt,
              className: 'image',
              fill: true
            %}
          </div>
        {% endfor %}
      </div>
      {% if jumbo_slide_array.size > 1 %}
      <div class='slider__controls abs block fill'>
        <div class='rel f fdr aic jcc y'>
          <div class='slider__nav rel f jcb x'>
            <button data-slidePrev>
              &larr;
            </button>
            <button data-slideNext>
              &rarr;
            </button>
          </div>
        </div>
      </div>
      {% endif %}
    </section>
  </div>
{% endif %}