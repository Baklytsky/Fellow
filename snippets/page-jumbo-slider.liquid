{% if page.metafields.custom_fields["page_jumbo_slider"] != blank %}
  {% assign separator = "|###|" %}
  {% assign jumbo_slide_array = page.metafields.custom_fields["page_jumbo_slide"] | split: separator %}
  {% assign fc_keys = page.metafields.custom_fields["page_jumbo_slider"] | split: "," %}

  {%- capture 'slick-config' -%}
    {
    "slidesToShow": 1,
    "slidesToScroll": 1,
    "dots": false,
    "arrows": true,
    "autoplay": true,
    "speed": 500,
    "autoplaySpeed": 7000,
    "adaptiveHeight": true
    }
  {%- endcapture -%}

  <div class='jumboSlider__mobileWrap'>
    <section class='jumboSlider rel' data-section-type='slick-slideshow' data-slick-config='{{- slick-config -}}'>
      <div class='jsSlickSlider'>
        {% for i in fc_keys %}
          {% assign index = i | plus: 0 %}
          {% assign imageSrc = jumbo_slide_array[index] %}
          <div class='jumboSlider__slide'>
            <div class="jumboSlider__slide-item rel x">
              {% render 'image-lazy-metafields',
                image: imageSrc,
                class_name: 'image-abs-cover',
                alt: alt,
                size: 'medium',
                loader: true %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% if jumbo_slide_array.size > 1 %}
        <button class="jsPrevSlide" aria-label="Slide Previous">
          {% render 'icon' with 'arrow-prev' %}
        </button>
        <button class="jsNextSlide" aria-label="Slide Next">
          {% render 'icon' with 'arrow-next' %}
        </button>
      {% endif %}
    </section>
  </div>
{% endif %}