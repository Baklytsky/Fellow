{% if product.metafields.custom_fields["placeholder_cta"] != blank %}
  <div class="custom-field custom-field__placeholder-cta custom-field__type--link">
    <h3 class="custom-field--title">Placeholder CTA URL</h3>
    <div class="custom-field--value">
      {{ product.metafields.custom_fields["placeholder_cta"] }}
    </div>
  </div>
{% endif %}