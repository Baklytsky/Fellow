{%- if section.settings.enable_section -%}
  {%- assign blocks = section.blocks -%}


  {%- assign show_dots = section.settings.show_dots -%}
  {%- assign show_arrows = section.settings.show_arrows -%}

  {%- if blocks.size > 0 -%}
    {%- capture 'slick-config' -%}
      {
      "slidesToShow": 1,
      "arrows": {{ show_arrows }},
      "dots": false,
      "responsive": [
      {
      "breakpoint": 992,
      "settings": {
      "arrows": false,
      "infinite": false,
      "dots": {{ show_dots }}
      }
      }
      ]
      }
    {%- endcapture -%}

    <div id="section-{{ section.id }}"
         class="ProductInfoSlider"
         data-section-type="slick-slideshow"
         data-slick-config='{{- slick-config -}}'>

      <div class="ProductInfoSlider__Wrapper jsSlickSlider" >
        {%- for block in blocks -%}
          {%- assign product = all_products[block.settings.product] -%}
          {%- assign image = block.settings.image | default: product.featured_image -%}
          {%- assign header = block.settings.header | default: false -%}
          {%- assign description = block.settings.description | default: false -%}
          {%- assign link_text = block.settings.link_text | default: 'See product' -%}
          {%- assign link_url = block.settings.link_url | default: product.url -%}

          {%- if product or image or header or description -%}
            <div class="ProductInfoSlider__ItemWrapper px025">
              <div class="ProductInfoSlider__Item">
                {%- if image -%}
                  <div class="ProductInfoSlider__ImageWrapper AspectRatio AspectRatio--square">
                    {% render 'image-lazy',
                      image: image,
                      class_name: 'ProductInfoSlider__Image',
                      size: 'medium',
                      alt: header,
                      loader: true %}
                  </div>
                {%- endif -%}

                {%- if product or header or description -%}
                  <div class="ProductInfoSlider__Content">
                    {%- if product != blank -%}
                      <div class="ProductInfoSlider__ProductInfo">
                        <div class="yotpo bottomLine" tabindex="0" data-product-id="{{ product.id }}"></div>
                        <h4 class="ProductInfoSlider__ProductTitle mt05">{{ product.title }}</h4>
                      </div>
                    {%- endif -%}

                    {%- if header -%}
                      <h2 class="ProductInfoSlider__Header">{{ header }}</h2>
                    {%- endif -%}

                    {%- if description -%}
                      <div class="ProductInfoSlider__Description">{{ description }}</div>
                    {%- endif -%}

                    {%- if link_url != blank -%}
                      <a class="ProductInfoSlider__Link"
                         href="{{ link_url }}"
                         title="{{ link_text | strip_html | escape }}"
                         aria-label="Link: {{ link_text | escape }}"
                         title="{{ link_text | strip_html }}"
                         role="button">

                        {{- link_text -}}

                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <button class="ProductInfoSlider__Arrow ProductInfoSlider__ArrowPrev jsPrevSlide"
              type="button"
              aria-label="Previous slide">
        {% render 'icon' with 'arrow-prev' %}
        <i>Previous slide</i>
      </button>

      <button class="ProductInfoSlider__Arrow ProductInfoSlider__ArrowNext jsNextSlide"
              type="button"
              aria-label="Next slide">
        {% render 'icon' with 'arrow-next' %}
        <i>Next slide</i>
      </button>

      <style>
        {%- unless show_arrows -%}
          #section-{{ section.id }} .ProductInfoSlider__Arrow {
            display: none;
          }
        {%- endunless -%}
      </style>
    </div>
  {%- endif -%}

{%- endif -%}

{% schema %}
{
  "name": "Product Info Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "info": "Mobile only",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "info": "Desktop only",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "header",
          "label": "Description Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description text"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "info": "By Default: 'See product'"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link url",
          "info": "By Default: PRODUCT_URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Info Slider",
      "category": "Homepage Sections"
    }
  ]
}
{% endschema %}