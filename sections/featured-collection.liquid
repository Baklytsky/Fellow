{%- assign collection = collections[section.settings.collection] -%}
{% comment %} {%- assign product_limit = section.settings.grid | times: section.settings.rows -%} {% endcomment %}

{% assign product_image_index = collection.metafields.custom_fields.product_image_index | minus: 1 | at_least: 0 | default: 0 %}


{% if section.settings.show_intro_card %}
  {%- assign product_limit = section.settings.count | minus: 1 -%}
{% else %}
  {%- assign product_limit = section.settings.count -%}
{% endif %}
{%- assign count = section.settings.count -%}
{% if count == 3 %}
  {%- assign count_class = 'one-third' %}
{% endif %}
{% if count == 4 %}
  {%- assign count_class = 'one-fourth' %}
{% endif %}
{% if section.settings.mobile_layout == 'slider_on_mobile' %}
  {% assign slider_on_mobile = true %}
{% else %}
  {% assign slider_on_mobile = false %}
{% endif %}
{% if section.settings.mobile_layout == 'scroll_on_mobile' %}
  {% assign scroll_on_mobile = true %}
{% else %}
  {% assign scroll_on_mobile = false %}
{% endif %}
<section class="featuredCollection {% if slider_on_mobile == true %} is-mobile-slider{% endif %}{% if scroll_on_mobile == true %} is-mobile-scroller{% endif %}" data-component='featuredCollection'>
  {% if section.settings.show_intro_card and scroll_on_mobile == true %}
    <div class="featuredCollection__introRow">{% include 'intro-card' %}</div>
  {% endif %}
  <div class='f fw jcs featuredCollection__row pb2 {{ count_class }} {% if slider_on_mobile == true %} js-slideshow{% endif %}'>
    {% if section.settings.show_intro_card %}
      <div class="featuredCollection__row-item featuredCollection__introCard">
        {% include 'intro-card', cx: 'y' %}
      </div>
    {% endif %}

    {% for product in collection.products limit: product_limit %}
      <div class="featuredCollection__row-item">
        {% include 'product-card', cx: 'y', product_image: product.images[product_image_index] %}
      </div>
    {% endfor %}
  </div>
  {% if section.settings.show_view_all %}
    <div class='row'>
      <div class="ac">
        <a href="{{ collection.url }}" class="btn" aria-label="{{ 'collections.general.view_all_label' | t: collection_name: collection.title }}">
          {{ 'collections.general.view_all' | t }}
        </a>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
  {
    "name": {
      "en": "Featured Collection",
      "de": "Featured Kategorie",
      "fr": "Collection vedette"
    },
    "settings": [
      {
        "type": "header",
        "content": "Headline & Copy"
      },
      {
        "type": "text",
        "id": "eyebrow",
        "label": {
          "en": "Eyebrow Text"
        },
        "info": "Text that Appears Above Title"
      },
      {
        "type": "text",
        "id": "title",
        "label": {
          "en": "Heading",
          "de": "Titel",
          "fr": "En-tête"
        },
        "default": {
          "en": "Our Latest & Greatest"
        }
      },
      {
        "type": "richtext",
        "id": "copy",
        "label": {
          "en": "Body Text"
        },
        "default": {
          "en": "<p>We're real excited about these. We think you will be too.</p>"
        }
      },
      {
        "type": "header",
        "content": "Intro Card"
      },
      {
        "type": "checkbox",
        "id": "show_intro_card",
        "label": "Show Intro Card",
        "default": true
      },
      {
        "type": "color",
        "id": "introCard__bgColor",
        "label": "Intro Card Background Color"
      },
      {
        "type": "select",
        "id": "introCard__textColor",
        "label": "Intro Card Text Color",
        "options": [
          {
            "value": "#FFFFFF",
            "label": "White"
          },
          {
            "value": "#231f20",
            "label": "Black"
          }
        ],
        "default": "#231f20"
      },
      {
        "type": "checkbox",
        "id": "show_cta",
        "label": "Show CTA button",
        "default": false
      },
      {
        "type": "text",
        "id": "cta_copy",
        "label": "CTA Copy"
      },
      {
        "type": "color",
        "id": "introCard__ctaBgColor",
        "label": "CTA Hover BG Color"
      },
      {
        "type": "header",
        "content": "Products"
      },
      {
        "id": "collection",
        "type": "collection",
        "label": {
          "en": "Collection",
          "de": "Kategorie",
          "fr": "Collection"
        }
      },
      {
        "type": "range",
        "id": "count",
        "label": {
          "en": "Items Per Row"
        },
        "info": "Includes Intro Card if enabled",
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 3
      },
      {
        "type": "radio",
        "id": "mobile_layout",
        "label": "Mobile Layout Options",
        "options": [
          {
            "value": "slider_on_mobile",
            "label": "Convert to JS Slider on Mobile"
          },
          {
            "value": "scroll_on_mobile",
            "label": "Convert to horizontal scroll on Mobile"
          }
        ],
        "default": "scroll_on_mobile"
      }
    ],
    "presets": [
      {
        "name": {
          "en": "Featured Collection",
          "de": "Featured Kategorie",
          "fr": "Collection vedette"
        },
        "category": {
          "en": "Collection",
          "de": "Kategorie",
          "fr": "Collection"
        }
      }
    ]
  }
{% endschema %}
