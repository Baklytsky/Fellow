<section class='instagram-feed' data-component='instaFeed'>
  <div class='module'>
    <div class='row'>
      <div class='col-lg-2'>
        <h3 class='caps'>{{ section.settings.heading }}</h3>
      </div>
      <div class='col-lg-10'>
        <div class='row' data-valenciaMount>

        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Instagram Feed",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": {
          "en": "Heading"
        },
        "default": {
          "en": "Instagram"
        }
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": {
          "en": "Subheading"
        },
        "default": {
          "en": "<p>Promotions, new products and sales. Directly to your inbox.</p>"
        }
      }
    ],
    "presets": [
      {
        "name": "Instagram Feed",
        "category": "Social"
      }
    ]
  }
{% endschema %}
