<link rel="stylesheet" href="{{ 'section-featured-collections.min.css' | asset_url }}">
<script src="{{ 'section-featured-collections.min.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.enable_section -%}
  {%- assign heading = section.settings.heading | default: false -%}
  {%- assign blocks = section.blocks -%}
  {%- assign show_view_all = section.settings.show_view_all -%}

  {%- if blocks.size > 0 or heading -%}
    <featured-collections class="FeaturedCollections">
      {%- if heading -%}
        <h2 class="FeaturedCollections__Heading m0">{{ heading }}</h2>
      {%- endif -%}

      {%- if blocks.size > 0 -%}
        <toggle-tabs class="FeaturedCollections__TabsWrapper">
          <div class="FeaturedCollections__TabsHeader">
            <ul class="FeaturedCollections__TabsList">
              {%- for block in blocks -%}
                {%- assign collection = collections[block.settings.collection] -%}

                {%- if collection != blank and collection.products_count > 0 -%}
                  {%- assign tab_text = block.settings.tab_text | default: collection.title -%}
                  {%- assign button_text_default = "Shop All " | append: tab_text -%}
                  {%- assign button_text = block.settings.button_text | default: button_text_default -%}
                  {%- assign button_url = block.setting.button_url | default: collection.url -%}

                  {%- if forloop.first -%}
                    {%- assign first_button_text = button_text -%}
                    {%- assign first_button_link = button_url -%}
                  {%- endif -%}
              
                 <li>
                    <button id="tab-{{ forloop.index }}"
                            class="FeaturedCollections__TabButton"
                            type="button"
                            data-action="toggle-tab"
                            data-link-title="{{ button_text }}"
                            data-link-url="{{ button_url }}"
                            aria-controls="tab-{{ collection.id }}"
                            data-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                            >
                      {{ tab_text }}
                    </button>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- if show_view_all -%}
              <a class="FeaturedCollections__CollectionLink"
                 href="{{ first_button_link }}">
                {{ first_button_text }}
              </a>
            {%- endif -%}

          </div>

          <div class="FeaturedCollections__ProductsWrapper rel">
            {%- for block in blocks -%}
              {%- assign limit = section.settings.limit -%}
              {%- assign collection = collections[block.settings.collection] -%}
              {%- if collection.products_count > 0 -%}
                <div id="tab-{{ collection.id }}"
                     class="FeaturedCollections__ProductsTabs"
                     data-tab="tab-{{ collection.id }}"
                     data-selected="{% if forloop.first %}true{% else %}false{% endif %}">
                  {%- if limit > collection.products_count -%}
                    {%- assign limit = collection.products_count -%}
                  {%- endif -%}

                  {% for product in collection.products limit: limit %}
                    <div class="FeaturedCollections__Product">
                      {% include 'product-card', cx: 'y', product_image: product.images[product_image_index], block_id: block.id %}
                    </div>
                  {% endfor %}

                  {%- if collection.products_count  > 3 -%}
                    <button type="button"
                            class="FeaturedCollections__ScrollPrev"
                            aria-label="Scroll Prev" data-scroll="prev">
                      {% render 'icon' with 'arrow-prev' %}
                    </button>
                    <button type="button"
                            class="FeaturedCollections__ScrollNext"
                            aria-label="Scroll Next" data-scroll="next">
                      {% render 'icon' with 'arrow-next' %}
                    </button>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </toggle-tabs>
      {%- endif -%}
    </featured-collections>
  {%- endif -%}

{%- endif -%}

{% schema %}
{
  "name": "Products | Collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "range",
      "id": "limit",
      "label": {
        "en": "Product Limit"
      },
      "info": "Select first products from collections",
      "min": 2,
      "max": 10,
      "step": 2,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show Shop All CTA",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "text",
          "id": "tab_text",
          "label": "Tab Button Text",
          "info": "By Default: 'COLLECTION_TITLE'"
        },
        {
          "id": "collection",
          "type": "collection",
          "label": {
            "en": "Collection",
            "de": "Kategorie",
            "fr": "Collection"
          }
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "CTA Text",
          "info": "By Default: 'Shop All + 'Tab Button text'"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "CTA Link",
          "info": "By Default: COLLECTION_URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products | Collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}
