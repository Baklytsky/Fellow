{%- if section.settings.enable_section -%}
  {%- assign text = section.settings.text -%}
  {%- assign url = section.settings.url -%}
  {%- assign icon = section.settings.icon -%}

  {%- if icon != blank or text != blank -%}
    <div class='LogoText'>
      <p class="LogoText__Message">
        {{ text }}
        {%- if icon != blank -%}
          <img class="LogoText__Icon" src="{{ icon | img_url: '50x50' }}" alt="{{ icon.alt | default: text }}"
               role="img" aria-label="Icon image" aria-hidden="true">
        {%- endif -%}
      </p>
    </div>
  {%- endif -%}
{%- endif -%}


{% schema %}
  {
    "name": "Logo text",
    "class": "m0",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_section",
        "label": "Enable section",
        "default": true
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "image_picker",
        "id": "icon",
        "label": "Logo icon"
      }
    ],
    "presets": [
      {
        "name": "Logo text",
        "category": "v1 | Homepage Modules"
      }
    ]
  }
{% endschema %}