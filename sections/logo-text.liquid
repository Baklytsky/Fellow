<link rel="stylesheet" href="{{ 'section-logo-text.min.css' | asset_url }}">

{%- if section.settings.enable_section -%}
  {%- assign text = section.settings.text -%}
  {%- assign url = section.settings.url -%}
  {%- assign icon = section.settings.icon -%}

  {%- if icon != blank or text != blank -%}
    <div class='LogoText'>
      <p class="LogoText__Message"><a href="{{ url }}">
        {{ text }}
        {%- if icon != blank -%}
          <img class="LogoText__Icon" src="{{ icon | img_url: '50x50' }}" alt="{{ icon.alt | default: text }}"
               aria-label="Icon image" aria-hidden="true">
        {%- endif -%}
        </a></p>
    </div>
  {%- endif -%}
{%- endif -%}


{% schema %}
  {
    "name": "Text | Highlight",
    "class": "m0",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_section",
        "label": "Enable Section",
        "default": true
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text"
      },
{
        "type": "url",
        "id": "url",
        "label": "Link"
      },
      {
        "type": "image_picker",
        "id": "icon",
        "label": "Logo Icon"
      }
    ],
    "presets": [
      {
        "name": "Text | Highlight",
        "category": "v1 | Homepage Modules"
      }
    ]
  }
{% endschema %}