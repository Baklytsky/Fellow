{% comment %} Metafield represents index as 1, 2, 3, 4, etc. {% endcomment %}
{% assign product_image_index = 0 %}

{% paginate collection.products by 1000 %}

{% if collection.metafields.custom_fields["desktop_masthead_image"] != blank %}
  {%- assign desktop_masthead = collection.metafields.custom_fields["desktop_masthead_image"] -%}
{% endif %}
{% if collection.metafields.custom_fields["mobile_masthead_image"] != blank %}
  {%- assign mobile_masthead = collection.metafields.custom_fields["mobile_masthead_image"] -%}
{% endif %}
{%- assign collection_title = collection.title -%}

{%- comment -%} /// Hidden "sizes" in filters  /// {%- endcomment -%}
{%- assign hidden_sizes_arr = false -%}
{%- if collection.metafields["custom_fields"]["hidden_sizes"] != blank -%}
{%- assign hidden_sizes_arr = collection.metafields["custom_fields"]["hidden_sizes"] | split: ',' | strip -%}
{%- endif -%}
{%- comment -%} /// Hidden "shop by use" in filters  /// {%- endcomment -%}
{%- assign hidden_shop_by_use_arr = false -%}
{%- if collection.metafields["custom_fields"]["hidden_shop_by_use_tags"] != blank -%}
{%- assign hidden_shop_by_use_arr = collection.metafields["custom_fields"]["hidden_shop_by_use_tags"] | split: ',' | strip -%}
{%- endif -%}

<section class='collection'>
  {%- if section.settings.show_breadcrumbs -%}
    {% include 'breadcrumbs' %}
  {%- endif -%}
  {% if desktop_masthead != blank %}
    {%
      include 'component-collection-masthead' with
      img: desktop_masthead,
      imgMobile: mobile_masthead,
      dataAttr: 'componentMasthead',
      heading: collection.title,
      copy: collection.description,
      className: ''
    %}
  {% endif %}

  <collection-facets class='collection-wrapper' data-template="{{ template.suffix }}">
    {%- if template.suffix == 'by-product-with-subcollection'
      and collection.metafields["custom_fields"]["subcollection_list"] != blank -%}
      {%- assign subcollection_counter = 0 -%}
      {%- assign subcollection_template = true -%}

      <script type="application/ld+json" data-subcollections>
          {
            "subcollections": [
              {%- for item in collection.metafields["custom_fields"]["subcollection_list"] -%}
                {%- assign subcollection = collections[item["collection"]] -%}
                {%- assign title = item["title"] | default: collection.title -%}
                {%- assign description = item["description"] | default: false -%}
                {%- assign order = item["order"] | default: 1 -%}
                {%- if subcollection != blank -%}
                {%- assign subcollection_counter = subcollection_counter | plus: 1 -%}
                {%- if subcollection_counter != 1 -%},{%- endif -%}{
                  "title": "{{ title }}",
                  "description": {{ description | newline_to_br | json }},
                  "order": "{{ order | minus: 2 }}",
                  "url": "{{ subcollection.url }}",
                  "link_text": "{{'collections.general.link_text' | t }}",
                  "hidden_sizes_arr": {{ hidden_sizes_arr | json }},
                  "hidden_shop_by_use_arr": {{ hidden_shop_by_use_arr | json }}
                }
                {%- endif -%}
              {%- endfor -%}
            ]
          }
        </script>

    {%- endif -%}

    {%- render 'facets' collection: collection -%}
    <div class='collection__products-wrapper rel'>
      <div class="collection__products-results">
        <div id="collection__result-wrapper"
             class="collection__product-results {% if subcollection_template %}subcollection__product-results{% endif %}">
          {%- for i in (1..4) -%}
            <div class="collection__product-item">
              <div class="collection__product-content">
                <h3 class="collection__product-title skeleton"></h3>
              </div>
              <div class="collection__product-variants">
                {%- for i in (1..5) -%}
                  <div class="productCard">
                    <div class="productCard__content y">
                      <div class="productCard__img skeleton"></div>
                      <div class="productCard__details">
                        <div class="productCard__title skeleton"></div>
                        <div class="productCard__price skeleton"></div>
                      </div>
                      <div class="productCard_ratings f fdr aie mb05 mt05 rel skeleton"></div>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
          {%- render 'product-results' -%}
        </div>
      </div>
    </div>
  </collection-facets>
  <div class='f fw'>
    <div class='col-lg-12'>
      {% if paginate.pages > 1 %}
        {% include 'pagination' %}
      {% endif %}
    </div>
  </div>
</section>

{% endpaginate %}

{% schema %}
  {
    "name": {
      "de": "Kategorie",
      "en": "Collection",
      "es": "Colección",
      "fr": "Collection",
      "it": "Collezione",
      "ja": "コレクション",
      "pt-BR": "Coleção"
    },
    "settings": [
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Show breadcrumbs",
        "default": true
      }
    ]
  }
{% endschema %}