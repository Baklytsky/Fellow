{%- assign full_width_container = section.settings.full_width_container -%}
{%- assign image = section.settings.image -%}
{%- assign image_mobile = section.settings.image_mobile -%}
{%- assign content_position = section.settings.content_position -%}
{%- assign content_position_mobile = section.settings.content_position_mobile -%}
{%- assign text_color = section.settings.text_color -%}
{%- assign heading = section.settings.heading -%}
{%- assign heading_size = section.settings.heading_size -%}
{%- assign text = section.settings.text -%}
{%- assign cta_url = section.settings.cta_url -%}
{%- assign cta_copy = section.settings.cta_copy -%}
{%- assign cta_color = section.settings.cta_color -%}

{%- assign desktop_image_class = 'BannerWithCta__Image image image-abs-cover' -%}

{%- if image_mobile != blank -%}
  {%- assign desktop_image_class = 'BannerWithCta__Image image image-abs-cover hide-mobile' -%}
{%- endif -%}

<section class="BannerWithCta">
  <div class="BannerWithCta__Wrapper rel Content--{{ content_position }} ContentMobile--{{ content_position_mobile }} {% unless full_width_container %}BannerWithCta__Wrapper--Narrow{% endunless %}">
    {%- if image != blank -%}
      <div class="{{ desktop_image_class }}">
        {% render 'image-lazy',
          image: image,
          class_name: 'image-abs-cover',
          size: 'medium',
          loader: true %}
      </div>
      {%- if image_mobile != blank -%}
        <div class="BannerWithCta__Image image image-abs-cover hide-desktop">
          {% render 'image-lazy',
            image: image_mobile,
            class_name: 'image-abs-cover ',
            size: 'medium',
            loader: true %}
        </div>
     
      {%- endif -%}
    {%- endif -%}
  
    {%- if heading != blank or text != blank or btn_url != blank -%}
      <div class="BannerWithCta__Content" style="color: {{ text_color }};">
        {%- if heading != blank -%}
          {%- case heading_size -%}
          {%- when 'h1' -%}
            <h1 class="BannerWithCta__Heading h1">{{ heading }}</h1>
          {%- when 'h2' -%}
            <h2 class="BannerWithCta__Heading h2">{{ heading }}</h2>
          {%- when 'h3' -%}
            <h3 class="BannerWithCta__Heading h3">{{ heading }}</h3>
          {%- when 'h4' -%}
            <h4 class="BannerWithCta__Heading h4">{{ heading }}</h4>
          {%- endcase -%}
        {%- endif -%}
      
        {%- if text != blank -%}
          <p class="BannerWithCta__Text">{{ text }}</p>
        {%- endif -%}
      
        {%- if cta_url != blank and cta_copy != blank -%}
          <a class="btn btn--lg {{ cta_color }}"
             href="{{ cta_url }}"
             title="{{ cta_copy }}"
             role="button">
            {{ cta_copy }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>



{% schema %}
{
  "name": "Banner with CTA",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width_container",
      "label": "Full width container"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "TopLeft",
          "label": "Top left"
        },
        {
          "value": "TopRight",
          "label": "Top right"
        },
        {
          "value": "TopCenter",
          "label": "Top center"
        },
        {
          "value": "MiddleLeft",
          "label": "Middle left"
        },
        {
          "value": "MiddleCenter",
          "label": "Middle center"
        },
        {
          "value": "MiddleRight",
          "label": "Middle right"
        },
        {
          "value": "BottomLeft",
          "label": "Bottom left"
        },
        {
          "value": "BottomCenter",
          "label": "Bottom center"
        },
        {
          "value": "BottomRight",
          "label": "Bottom right"
        }
      ],
      "default": "TopCenter"
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Content position mobile",
      "options": [
        {
          "value": "TopCenter",
          "label": "Top center"
        },
        {
          "value": "MiddleCenter",
          "label": "Middle center"
        },
        {
          "value": "BottomCenter",
          "label": "Bottom center"
        }
      ],
      "default": "TopCenter"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "cta_copy",
      "label": "CTA Copy"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "radio",
      "id": "cta_color",
      "label": "CTA color",
      "options": [
        {
          "value": "btn--light",
          "label": "White"
        },
        {
          "value": "btn--dark",
          "label": "Black"
        }
      ],
      "default": "btn--dark"
    }
  ],
  "presets": [
    {
      "name": "Banner with CTA",
      "category": "Image"
    }
  ]
}
{% endschema %}