{%- assign heading = section.settings.heading -%}
{%- assign description = section.settings.description -%}
{%- assign logo = section.settings.logo_image -%}
{%- assign logo_image_mobile = section.settings.logo_image_mobile -%}
{%- assign bg_color = section.settings.bg_color -%}
{%- assign text_color = section.settings.text_color -%}
{%- assign form_heading = section.settings.form_heading -%}
{%- assign form_description = section.settings.form_description -%}

<section class="JoinFellow rel JoinFellow-{{ section.id }}">
  <div class="JoinFellow__Wrapper">
    {%- if heading != blank or description != blank -%}
      <div class="JoinFellow__TextBlock">
        {%- if heading != blank -%}
          <h3 class="JoinFellow__TextBlock-Heading">
            {{ heading }}
          </h3>
        {%- endif -%}
        {%- if description != blank -%}
          <p class="JoinFellow__TextBlock-Description">
            {{ description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="JoinFellow__FormBlock" style="background-color: {{ bg_color }}; color: {{ text_color }}">
      {%- if logo -%}
        <div class="JoinFellow__FormBlock-LogoDesktop">
          <img src='{{ logo | img_url: "100x" }}'
               loading="lazy"
               srcset='{{ logo | img_url: "450x" }} 450w,
                       {{ logo | img_url: "560x" }} 560w,
                       {{ logo | img_url: "650x" }} 650w'
               alt="{{ logo.alt | default: form_heading | escape }}">
        </div>
      {%- endif -%}
      <div class="JoinFellow__FormBlock-Content">
        {%- if form_heading != blank -%}
          <h3 class="JoinFellow__FormBlock-Heading">{{ form_heading }}</h3>
        {%- endif -%}
        <div class="klaviyo-form-T7MyB7"></div>
        {%- if form_description != blank -%}
          <p class="JoinFellow__FormBlock-Description">
            {{ form_description }}
          </p>
        {%- endif -%}
      </div>
      {%- if logo_image_mobile -%}
        <div class="JoinFellow__FormBlock-LogoMobile">
          <img src='{{ logo_image_mobile | img_url: "100x" }}'
               loading="lazy"
               srcset='{{ logo_image_mobile | img_url: "450x" }} 450w,
                       {{ logo_image_mobile | img_url: "560x" }} 560w,
                       {{ logo_image_mobile | img_url: "650x" }} 650w'
               alt="{{ logo_image_mobile.alt | default: form_heading | escape }}">
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .JoinFellow-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    background-color: {{ bg_color }};
  }

  {% if heading != blank or description != blank %}
    .JoinFellow-{{ section.id }}::before {
       content: '';
       position: absolute;
       top: 0;
       left: 0;
       display: block;
       width: 50%;
       height: 100%;
       background-color: #000000;
       z-index: 1;
     }

    .JoinFellow-{{ section.id }}::after {
       content: '';
       position: absolute;
       top: 0;
       left: 50%;
       display: block;
       width: 50%;
     }
  {% endif %}

  .JoinFellow-{{ section.id }} form {
    background-color: {{ bg_color }} !important;
  }

</style>

{% schema %}
{
  "name": "Join Fellow",
  "settings": [
    {
      "type": "header",
      "content": "Text Block Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Form Block Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#233539"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image_mobile",
      "label": "Logo mobile"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "form_description",
      "label": "Description"
    }
  ],
  "presets": [
    {
      "name": "Join Fellow",
      "category": "Homepage Sections"
    }
  ]
}
{% endschema %}
