{% if section.settings.bg_color != 'rgba(0,0,0,0)' %}
  {% assign bgColorWhiteDiff = section.settings.bg_color | color_difference: '#ffffff' %}
  {% if bgColorWhiteDiff > 500 %}
    {% assign btnBgColor = 'btn--light' %}
  {% else %}
    {% assign btnBgColor = 'btn--dark' %}
  {% endif %}
{% else %}
  {% assign btnBgColor = 'btn--dark' %}
{% endif %}

<style>
  @media (min-width: 992px) {
    #featuredSection__bg--{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
    }
  }
</style>

<div
  class='featuredSection
  {% if section.settings.overlap == true %} is-overlap{% endif %}
  {% if section.settings.fullbleed == true %} is-fullbleed{% endif %}
  {% if section.settings.noPadding == true %} no-padding{% endif %}'
>
  <div
    id="featuredSection__bg--{{ section.id}}"
    class='featuredSection__bg
    {% if section.settings.fullbleed == true %} f aic{% endif %}
    {% if section.settings.height == "small" %} is-small{% endif %}
    {% if section.settings.height == "medium" %} is-medium{% endif %}
    {% if section.settings.height == "large" %} is-large{% endif %}'
  >
    <div class='container--l mxa'>
      <div class='featuredSection__row f fw jcb {% if section.settings.centered == true %} aic{% endif %}'>

        <div class='featuredSection__image rel{% if section.settings.layout == "right" %} is-right{% endif %}{% if section.settings.overlap == true %} is-overlap{% endif %}{% if section.settings.fullbleed == true %} is-fullbleed{% endif %}'>
          {% if section.settings.fullbleed == true %}
            <div class="image">
              {% render 'image-lazy',
                image: section.settings.image,
                size: 'medium',
                alt: section.settings.title,
                loader: true %}
            </div>
          {% else %}
            <div class="image">
              {% render 'image-lazy',
                image: section.settings.image,
                size: 'medium',
                alt: section.settings.title,
                loader: true %}
            </div>
          {% endif %}
        </div>

        <div
          class='featuredSection__text mxa
          {% if section.settings.layout == "right" %} is-left{% endif %}
          {% if section.settings.textLayout == "left" %} al{% endif %}
          {% if section.settings.textLayout == "center" %} ac{% endif %}
          {% if section.settings.textLayout == "right" %} ar{% endif %}
        '>
          {% if section.settings.eyebrow != blank %}
            <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.title != blank %}
            <h2>{{ section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="rte rte-setting featured-row__subtext">{{ section.settings.text }}</div>
          {% endif %}
          {% if section.settings.button_label != blank and section.settings.button_link != blank %}
            <a href="{{ section.settings.button_link }}" class="btn btn--lg {{ btnBgColor }}">
              {{ section.settings.button_label | escape }}
            </a>
          {% endif %}
        </div>

      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Image with text",
    "settings": [
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "header",
        "content": "Section Layout"
      },
      {
        "type": "select",
        "id": "height",
        "label": "Section Height",
        "default": "medium",
        "options": [
          { "value": "small", "label": "Small" },
          { "value": "medium", "label": "Medium" },
          { "value": "large", "label": "Large" }
        ]
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Image alignment",
        "default": "right",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "centered",
        "label": "Vertically Center",
        "info": "Centers image and text within the section",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "overlap",
        "label": "Image Overlap",
        "info": "Sets image to vertically overlap the background",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "fullbleed",
        "label": "Image Full Bleed",
        "info": "Sets image to expand to the edge of the screen",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "noPadding",
        "label": "Disable Padding",
        "info": "Useful for creating series of left/right blocks",
        "default": false
      },
      {
        "type": "header",
        "content": "Copy Options"
      },
      {
        "type": "select",
        "id": "textLayout",
        "label": "Text alignment",
        "default": "center",
        "options": [
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow Text",
        "info": "Leave blank for no eyebrow text"
      },
      {
        "type": "html",
        "id": "title",
        "label": "Heading",
        "default": "Image with text"
      },
      {
        "type": "html",
        "id": "text",
        "label": "Text",
        "default": "<p>Pair large text with an image to give focus to your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "CTA URL"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "CTA Copy"
      },
      {
        "type": "header",
        "content": "Color Settings"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#FFFFFF"
      },
      {
        "type": "select",
        "id": "text_color",
        "label": "Text Color",
        "options": [
          {
            "value": "#FFFFFF",
            "label": "White"
          },
          {
            "value": "#000000",
            "label": "Black"
          }
        ],
        "default": "#000000"
      }
    ],
    "presets": [
      {
        "name": "Image with text",
        "category": "Image"
      }
    ]
  }
{% endschema %}
