<link rel="stylesheet" href="{{ 'section-featured-post-blog.min.css' | asset_url }}">
{%- assign blog = blogs[section.settings.blog] -%}

<section class='featuredArticleBlog' data-component='featuredPostBlog'>
  <div class='d-md-block{% unless section.settings.title != blank and section.settings.title_location == "left_top" %} d-lg-none d-xl-none{% endunless %}'>
    {% include 'blog-title-block' %}
  </div>
  <div class='featuredArticleBlog__slider hidden-lg-up js-slideshow'>
    {% if section.settings.featuredPost != blank %}
      {% include 'featured-post-slider' %}
    {% endif %}
    {% for article in blog.articles limit: section.settings.post_limit %}
      {% include 'article-card-small' %}
    {% endfor %}
  </div>
  <div class='featuredArticleBlog__row f fw jcb hidden-md-down'>
    {% if section.settings.featuredPost != blank %}
      {% include 'featured-post' %}
    {% endif %}

    {% unless blog.articles_count == 0 %}
      {% assign notThis = articles[section.settings.featuredPost].handle %}
      {% assign blogPosts = blog.articles | remove: "handle", notThis %}
      <div class='additionalPosts__wrapper f fw fdc jcb'>
        {% if section.settings.title != blank and section.settings.title_location == "right_inner" %}
          <div class='d-none d-lg-block d-xl-block'>
            {% include 'blog-title-block' %}
          </div>
        {% endif %}

        {% assign articleCount = 0 %}
        {% for article in blog.articles %}
          {% if article.handle != articles[section.settings.featuredPost].handle and articleCount < section.settings.post_limit %}
            {% include 'article-card-small' %}
            {%- assign articleCount = articleCount | plus: 1 -%}
          {% endif %}
        {% endfor %}

      </div>
    {% endunless %}
  </div>
</section>

{% schema %}
  {
    "name": "Blog with Featured Post",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": {
          "en": "Title",
          "de": "Titel",
          "fr": "En-tête"
        },
        "default": {
          "en": "The Blog",
          "de": "Blogposts",
          "fr": "Articles de blog"
        }
      },
      {
        "type": "text",
        "id": "eyebrow",
        "label": {
          "en": "Eyebrow Text"
        },
        "info": "Text that Appears Above Title"
      },
      {
        "type": "select",
        "id": "title_location",
        "label": "Title Position",
        "options": [
          {
            "value": "left_top",
            "label": "Left Top"
          },
          {
            "value": "left_inner",
            "label": "Left Inner"
          },
          {
            "value": "right_inner",
            "label": "Right Inner"
          }
        ]
      },
      {
        "type": "article",
        "id": "featuredPost",
        "label": "Featured Article"
      },
      {
        "id": "blog",
        "type": "blog",
        "label": {
          "en": "Blog",
          "de": "Blog",
          "fr": "Blog"
        }
      },
      {
        "type": "range",
        "id": "post_limit",
        "label": {
          "en": "Posts",
          "de": "Posts",
          "fr": "Articles"
        },
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 3
      },
      {
        "type": "checkbox",
        "id": "show_author",
        "label": {
          "en": "Show author",
          "de": "Autor anzeigen",
          "fr": "Afficher l'auteur"
        },
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_date",
        "label": {
          "en": "Show date",
          "de": "Datum anzeigen",
          "fr": "Afficher la date"
        },
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_view_all",
        "label": {
          "en": "Show 'View all' button",
          "de": "'Alle anzeigen' Button anzeigen",
          "fr": "Afficher le bouton “Voir tout”"
        },
        "default": false
      }
    ],
    "presets": [
      {
        "name": {
          "en": "Blog with Featured Post",
          "de": "Blogposts",
          "fr": "Articles de blog"
        },
        "category": {
          "en": "Blog",
          "de": "Blog",
          "fr": "Blog"
        },
        "settings": {
          "blog": "News",
          "post_limit": 3
        }
      }
    ]
  }
{% endschema %}
