{%- assign heading = section.settings.heading -%}
{%- assign description = section.settings.description -%}
{%- assign cta_text = section.settings.cta_text -%}
{%- assign cta_link = section.settings.cta_link -%}
{%- assign image = section.settings.image -%}
{%- assign image_position = section.settings.image_position -%}

{%- if heading != blank or description != blank or cta_text != blank or image != blank -%}
  <link rel="stylesheet" href="{{ 'section-coffee-marketplace-iwt.min.css' | asset_url }}">

  <section class="cmImageWithText cmImageWithText__image--{{ image_position }}">
    {%- if image != blank -%}
      <div class="cmImageWithText__image rel">
        {% render 'image', image: image, class_name: 'image-abs-contain', alt: heading, %}
      </div>
    {%- endif -%}
    {%- if heading != blank or description != blank or cta_text != blank -%}
      <div class="cmImageWithText__content">
        {%- if heading != blank -%}
          <h2 class="cmImageWithText__contentHeading m0 cmHeading">
            {{ heading }}
          </h2>
        {%- endif -%}
        {%- if description != blank -%}
          <p class="cmImageWithText__contentDescription cmDescription">
            {{ description }}
          </p>
        {%- endif -%}
        {%- if cta_text != blank and cta_link != blank -%}
          <a href="{{ cta_link }}" class="btn btn--lg btn--dark cmImageWithText__button">
            {{ cta_text | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Images | Split Side 2",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Images | Split Side 2"
    }
  ]
}
{% endschema %}