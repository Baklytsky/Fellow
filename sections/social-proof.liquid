<section class='f fdc aic'>
  <link rel="stylesheet" href="{{ 'section-social-proof.min.css' | asset_url }}">
  {% if section.settings.eyebrowText %}
    <p class='eyebrow'>{{ section.settings.eyebrowText }}</p>
  {% endif %}
  {% if section.settings.sectionTitle %}
    <h2 class='caps my05'>{{ section.settings.sectionTitle }}</h2>
  {% endif %}
  <div class='socialProof__container container--l'  data-component='socialProof'>
    {% for block in section.blocks %}
      {% include 'social-proof-single' %}
    {% endfor %}
  </div>
</section>

{% schema %}
  {
    "name": "Social Proof",
    "class": "my3rem",
    "settings": [
      {
        "type": "text",
        "id": "eyebrowText",
        "label": "Eyebrow Text"
      },
      {
        "type": "text",
        "id": "sectionTitle",
        "label": "Section Title"
      }
    ],
    "max_blocks": 4,
    "blocks": [
      {
        "type": "socialProofItem",
        "name": "Social Proof Item",
        "settings": [
          {
            "type": "image_picker",
            "id": "socialProof__logo",
            "label": "Logo"
          },
          {
            "type": "text",
            "id": "socialProof__quote",
            "label": "Quote"
          },
          {
            "type": "url",
            "id": "socialProof__link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Media Proof | v1",
        "category": "v1 | Homepage Modules",
        "settings": {
          "eyebrowText": "Strategically Chosen Compliments",
          "sectionTitle": "Fantastic Fellow Fanfare"
        }
      }
    ]
  }
{% endschema %}