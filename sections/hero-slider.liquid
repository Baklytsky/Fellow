<div class='hero__module f fw jcc aic rel z2 x{% if section.settings.addMargin == true %} is-marginBottom{% endif %}' data-component='heroSlider'>
  <div class='hero__slider x y' data-heroSlider>
    {% for block in section.blocks %}
      {% assign header = block.settings.heroSlide__header %}
      {% assign subheader = block.settings.heroSlide__subheader %}
      {% assign ctaCopy = block.settings.heroSlide__ctaCopy %}
      {% assign ctaURL = block.settings.heroSlide__ctaURL %}
      {% assign ctaColor = block.settings.heroSlide__ctaColor %}
      {% if ctaColor == 'white' %}
        {%  assign ctaClasses = 'btn btn--lg btn--light' %}
      {% else %}
        {% assign ctaClasses = 'btn btn--lg btn--dark' %}
      {% endif %}
      {% assign ctaSubtext = block.settings.heroSlide__ctaSubtext %}
      {% if block.type == 'heroSlide' %}
        {% include 'hero-slide-single' %}
      {% elsif block.type == 'splitSlide' %}
        {% include 'split-slide-single' %}
      {% endif %}
    {% endfor %}
  </div>
  {% assign firstBg = 0 %}
  {% for block in section.blocks %}
    {% if forloop.first == true %}
      {% assign firstBg = block.settings.subSlide__bgColor %}
      {% assign firstColor = block.settings.subSlide__textColor %}
    {% endif %}
  {% endfor %}
  <div class='hero__mobile_subslide x y js-mobile-subslide' style="background-color: {{ firstBg }}; color: {{ firstColor }}">
    {% for block in section.blocks %}
      {% assign subheader = block.settings.heroSlide__subheader %}
      {% assign ctaCopy = block.settings.heroSlide__ctaCopy %}
      {% assign ctaURL = block.settings.heroSlide__ctaURL %}
      {% assign ctaSubtext = block.settings.heroSlide__ctaSubtext %}
      {% assign ghostBtn = block.settings.heroSlide__ghostBtn %}
      {% comment %} Define First Block {% endcomment %}
      {% assign firstBlock = false %}
      {% if forloop.first == true %}
        {% assign firstBlock = true %}
      {% else %}
        {% assign firstBlock = false %}
      {% endif %}
      {% comment %} Define Subslide CTA Color based on Text Color {% endcomment %}
      {% if block.settings.subSlide__textColor == '#FFFFFF' %}
        {% assign ctaClasses = 'btn btn--lg btn--light' %}
      {% else %}
        {% assign ctaClasses = 'btn btn--lg btn--dark' %}
      {% endif %}
      <div id='hero__text--{{ block.id }}' class='hero__subheader--mobile f fdc aic jcc ac js-mobile-subslide-slide{% if firstBlock == true %} is-visible active{% endif %}' data-color='{{ block.settings.subSlide__textColor }}' data-bg-color='{{ block.settings.subSlide__bgColor }}'>
        {% if subheader != blank %}
          <span class='h3 f aic caps'>{{ subheader }}</span>
        {% else %}
          <div class='pt3rem'></div>
        {% endif %}
        {% if ctaCopy != blank %}
          {%
            include 'component-button' with
            tag: 'a',
            cta: ctaCopy,
            href: ctaURL,
            className: ctaClasses
          %}
        {% endif %}
        {% if ctaSubtext != blank %}
          <p class='hero__ctaSubtext'>{{ ctaSubtext }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

