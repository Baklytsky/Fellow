  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "heroSlide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "heroSlide",
          "label": "Slide"
        },
        {
          "type": "header",
          "content": "Image Positioning"
        },
        {
          "type": "select",
          "id": "desktopAlignment",
          "label": "Desktop Alignment",
          "info": "Adjust the background alignment for desktop, if needed.",
          "default": "center",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ]
        },
        {
          "type": "select",
          "id": "mobileAlignment",
          "label": "Mobile Alignment",
          "info": "Adjust the background alignment for mobile, if needed.",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "header",
          "content": "Slide Text"
        },
        {
          "type": "text",
          "id": "heroSlide__header",
          "label": "Header Text"
        },
        {
          "type": "text",
          "id": "heroSlide__subheader",
          "label": "Subheader Text"
        },
        {
          "type": "select",
          "id": "heroSlide__textAlignment",
          "label": "Text Alignment",
          "info": "Reverts to Centered on Mobile",
          "options": [
            {
              "value": "center",
              "label": "Centered"
            },
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "select",
          "id": "heroSlide__color",
