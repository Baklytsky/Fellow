          "default": "cw",
          "info": "Change the text color. (Defaults to white.)"
        },
        {
          "type": "header",
          "content": "CTA Settings"
        },
        {
          "type": "url",
          "id": "heroSlide__ctaURL",
          "label": "CTA URL"
        },
        {
          "type": "text",
          "id": "heroSlide__ctaCopy",
          "label": "CTA Copy"
        },
        {
          "type": "select",
          "id": "heroSlide__ctaColor",
          "label": "CTA Color",
          "options": [
            {
              "value": "white",
              "label": "White"
            },
            {
              "value": "black",
              "label": "Black"
            }
          ],
          "default": "black",
          "info": "Change the CTA color. (Defaults to black.)"
        }
      ]
    },
    {
      "type": "splitSlide",
      "name": "Split Slide",
      "settings": [
        {
          "type": "header",
          "content": "Layout"
        },
        {
          "type": "select",
          "id": "splitSlide__layout",
          "label": "Section Positioning",
          "options": [
            {
              "value": "left",
              "label": "Text Left"
            },
            {
              "value": "right",
              "label": "Text Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "image_picker",
          "id": "heroSlide",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Image Positioning"
        },
        {
          "type": "select",
          "id": "desktopAlignment",
          "label": "Desktop Alignment",
          "info": "Adjust the background alignment for desktop, if needed.",
          "default": "center",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ]
        },
        {
          "type": "select",
          "id": "mobileAlignment",
          "label": "Mobile Alignment",
          "info": "Adjust the background alignment for mobile, if needed.",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
