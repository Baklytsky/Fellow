{%- assign show_best_sellers = section.settings.show_best_sellers -%}
{%- assign best_sellers_heading = section.settings.best_sellers_heading -%}
{%- assign best_sellers_collection = collections[section.settings.best_sellers_collection] -%}


<section class="searchMain">
  <form action="{{ routes.search_url }}" name="GET" role="search" class="searchForm searchForm--main">
    <input type="search" class="searchForm__input searchForm__input--main" name="q" value="{{ search.terms | escape }}" autocomplete="off" autocorrect="off" autocapitalize="off" aria-label="{{ 'header_search.input_placeholder' | t }}" placeholder="{{ 'header_search.input_placeholder' | t }}" autofocus>
    <label for="search-reset" class="searchForm__resetLabel" {% unless search.performed %}style="display: none" {% endunless %}>
      <input type="reset" id="search-reset" tabindex="-1" value="reset" style="display: none;">
      {% render 'icon' with 'x' %}
    </label>
    <input type="hidden" name="type" value="product">
  </form>


  <div class="searchMain__empty" {% if search.results.size > 0 or search.performed == false %}style="display: none" {% endif %}>
    <div class="searchMain__searchSize">{{ 'general.search.count_results' | t: results_count: search.results_count }}</div>
    <h1 class="searchMain__resultHeading"> {{ 'general.search.no_results' | t }}</h1>
  </div>


  <div class="searchMain__content" {% if search.results.size == 0 or search.performed == false %}style="display: none" {% endif %}>
    {%- if search.performed and search.results.size > 0 -%}
      <div class="searchMain__filters">

      </div>
      <div class="searchMain__contentInner">
        <div class="searchMain__searchSize">{{ 'general.search.count_results' | t: results_count: search.results_count }}</div>

        <div class="searchMain__grid">
          {%- if search.performed and search.results.size > 0 -%}
            {%- if search.types contains 'product' -%}
              {%- for product in search.results -%}
                <div class="searchMain__gridItem">
                  {%- comment -%}
                    {% include 'product-card' %}
                  {%- endcomment -%}

                </div>
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>


   {%- if settings.popular_section_enable -%}
     <div class="search__popular--mainWrapper" {% if search.results.size > 0 %}style="display: none" {% endif %}>
       {% render 'search-grid-popular', class_name: 'search__popular--main' %}
     </div>
  {%- endif -%}

  {%- if show_best_sellers -%}
    <div class="searchBestSellers" {% if search.results.size > 0 %}style="display: none" {% endif %}>
      {% if best_sellers_heading != blank %}
        <h4 class="searchBestSellers__heading">{{ best_sellers_heading }}</h4>
      {% endif %}

      {%- if best_sellers_collection != blank and best_sellers_collection.products_count > 0 -%}
        <div class="searchBestSellers__content">
          {% for product in best_sellers_collection.products limit: 4 %}
            <div class="searchBestSellers__item">
              {% include 'product-card' %}
            </div>
          {% endfor %}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}


  {% if search.performed %}
    {%- comment -%}
      <ul>
        {% for item in search.results %}
          <li>
            {% if item.featured_image %}
              <a href="{{ item.url | within: collection }}" title="{{ item.title | escape }}">
                {{ item.featured_image.src | img_url: '240x240' | img_tag: item.featured_image.alt }}
              </a>
            {% endif %}

            <h5>{{ item.title | link_to: item.url }}</h5>

            {% if item.object_type == 'product' %}
              <p>
                {% if item.compare_at_price > item.price %}
                  {% if item.price_varies %}
                    {% assign sale_price = item.price | money %}
                    {{ 'products.product.on_sale_from_html' | t: price: sale_price }}
                  {% else %}
                    {{ 'products.product.on_sale' | t }}
                    <span itemprop="price">{{ item.price | money }}</span>
                  {% endif %}
                  <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
                  <s>{{ item.compare_at_price | money }}</s>
                {% else %}
                  {% if item.price_varies %}
                    {% assign price = item.price | money %}
                    <span itemprop="price">{{ 'products.product.from_text_html' | t: price: price }}</span>
                  {% else %}
                    <span itemprop="price">{{ item.price | money }}</span>
                  {% endif %}
                {% endif %}
                {% unless item.available %}
                  {{ 'products.product.sold_out' | t }}
                {% endunless %}
              </p>
            {% else %}
              <p>{{ item.content | strip_html | truncatewords: 50 }}</p>
            {% endif %}

          </li>
        {% endfor %}
      </ul>
    {%- endcomment -%}



    {%- comment -%}
      {% if paginate.pages > 1 %}
        {% include 'pagination' %}
      {% endif %}
    {%- endcomment -%}

  {% endif %}

</section>



<script id="SearchPageResultsRender" type="text/template">
  {% raw %}
    {{#each data }}
      <div class="searchMain__gridItem asdasd">
        <div class='productCard productCard--{{ title_handleize }}' data-component='productCard'>
          <div class='productCard__content y' data-image-url="{{ featured_image.image_url }}">

            <div role='img' aria-label='Image of {{ title }}' class='productCard__img rel z0'>
              {{#if badge_text }}
                <span class="productCard__badge abs z3 xsmall cb bg-xlightgrey">{{ badge_text }}</span>
              {{/if }}

              <div class='productCard__img-container default'>
                <img src="{{ featured_image.image_url }}" alt="{{ featured_image.alt }}" class="productCard__image image image-abs-cover">
              </div>

              {{#each variants }}
                <div role='img' class='productCard__img-container variant js-variant-image'
                   {{#if cariantcolor }}
                    data-color='{{ data_color }}'
                   {{/if }}
                   data-variant-url='{{ url }}'
                   data-variant-id='{{ id }}'
                   aria-label='{{ title }}'>

                  <img src="{{ image_url }}" alt="{{ alt }}" class="productCard__image image image-abs-cover">
                </div>
              {{/each }}

              <div class="productCardImg__QuickView">
                <button class="productCardImg__QuickViewButton js-product-view" data-quick-view="{{ url_quickView }}?view=quick-view" type="button">+ Quick Add</button>
              </div>

              <a class='productCardImg__ProductLink abs fill z2 js-product-link' href='{{ url }}' title="{{ title }}" aria-label='{{ title }}'>
                {{#if alt_image }}
                  <img src="{{ alt_image.url }}"
                     alt="{{ alt_image.alt }}"
                     class="productCardImg__AlternativeImage image-abs-cover"
                     role='img'
                     loading='lazy'>
                {{/if }}
              </a>
            </div>

            <div class='productCard__details rel'>
              <h3 class='productCard__title js-product-card-title'>{{ title }}</h3>
              <div class="productCard__price js-product-card-price">
                <p class='{{ product_price_label_classes }}'>{{ product_price_label }}</p>
                <div class="ar productCard__price-wrapper">
                  <h3>{{ price }}</h3>
                </div>
              </div>
              <a href='{{ url }}' class='abs fill z2 js-product-link' aria-label='{{ title }}'></a>
            </div>

          <div class="productCard_ratings f fdr aie mb05"
            {{#if hide_reviews }}
              style="display: none"
            {{/if }}>

            <div class="yotpo bottomLine" style="display:inline-block;" data-product-id="{{ id }}"></div>
            <span class="productCard__reviewNum">({{ reviews_count }})</span>
          </div>


        <form class='productCard__variants rel'>
          <div class='productCard__options'>

            {{#each options }}
              <div class='radio-group f aic' data-option-{{ option_name }}>
                {{#each values }}
                  {{#each variants }}
                    <label class='radio f aic rel js-color-update' for='{{ title_handleize }}-{{ option_name }}__{{ value_handleize }}'
                             {{#if data_color_or_material }}
                              data-color='{{ value_handleize }}'
                             {{/if }}>
                      <span class='u-sr-only'>Label for {{ title }} {{ option_name }}</span>
                      <input
                        type='radio'
                        id='{{ title_handleize }}-{{ option_name }}__{{ value_handleize }}'
                        data-value-handle='{{ value_handleize }}'

                        {{#if data_color }}
                          data-color='{{ value_handleize }}'
                          class="checked"
                        {{/if }}

                        {{#if data_material }}
                          data-material='{{ value_handleize }}'
                        {{/if }}

                        value='{{ value }}'
                        data-option-selector>
                      <div class="radio__title js-productCard-option js-color-update {{ data_color }}"
                           {{#if data_color }}
                           data-color='{{ value_handleize }}'
                           {{/if }}
                          {{#if data_material }}
                            data-material='{{ value_handleize }}'
                          {{/if }}

                      data-variant-url='{{ variant_url }}'
                      data-variant-id='{{ variant_id }}'>
                    </div>
                  </label>
                {{/each }}
              {{/each }}
              </div>
            {{/each }}
          </div>

          </div>
        </form>




          </div>
        </div>
      </div>
    {{/each }}
  {% endraw %}
</script>


{% schema %}
{
  "name": "Search template",
  "settings": [
    {
      "type": "header",
      "content": "Best sellers"
    },
    {
      "type": "checkbox",
      "id": "show_best_sellers",
      "label": "Show section"
    },
    {
      "type": "text",
      "id": "best_sellers_heading",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "best_sellers_collection",
      "label": "Collection"
    }
  ]
}
{% endschema %}