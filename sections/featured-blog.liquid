{%- assign blog = blogs[section.settings.blog] -%}

<section class='module featuredBlog'>
  <div class='row'>
    {% if section.settings.title != blank %}
    <div class='col-lg-2'>
      <h2 class='t-vertical caps'>{{ section.settings.title | escape }}</h2>
    </div>
    {% endif %}

    {% unless blog.articles_count == 0 %}
      {% if section.settings.title != blank %}
        <div class='col-lg-10'>
      {% endif %}
        <div class='f fw fdr row'>
          {% for article in blog.articles limit: section.settings.post_limit %}
            {% include 'article-card' %}
          {% endfor %}
        </div>
      {% if section.settings.title != blank %}
        </div>
      {% endif %}
    {% endunless %}

    {% if section.settings.show_view_all %}
      <div class="ac">
        <a href="{{ blog.url }}" class="btn" aria-label="{{ 'blogs.article.view_all_blogs' | t }}">
          {{ 'blogs.article.view_all' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
  {
    "name": {
      "en": "Blog posts",
      "de": "Blogposts",
      "fr": "Articles de blog"
    },
    "class": "index-section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": {
          "en": "Heading",
          "de": "Titel",
          "fr": "En-tête"
        },
        "default": {
          "en": "Blog posts",
          "de": "Blogposts",
          "fr": "Articles de blog"
        }
      },
      {
        "id": "blog",
        "type": "blog",
        "label": {
          "en": "Blog",
          "de": "Blog",
          "fr": "Blog"
        }
      },
      {
        "type": "range",
        "id": "post_limit",
        "label": {
          "en": "Posts",
          "de": "Posts",
          "fr": "Articles"
        },
        "min": 3,
        "max": 12,
        "step": 3,
        "default": 3
      },
      {
        "type": "checkbox",
        "id": "show_author",
        "label": {
          "en": "Show author",
          "de": "Autor anzeigen",
          "fr": "Afficher l'auteur"
        },
        "default": false
      },
      {
        "type": "checkbox",
        "id": "blog_show_date",
        "label": {
          "en": "Show date",
          "de": "Datum anzeigen",
          "fr": "Afficher la date"
        },
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_view_all",
        "label": {
          "en": "Show 'View all' button",
          "de": "'Alle anzeigen' Button anzeigen",
          "fr": "Afficher le bouton “Voir tout”"
        },
        "default": false
      }
    ],
    "presets": [
      {
        "name": {
          "en": "Blog Posts | v1",
          "de": "Blogposts",
          "fr": "Articles de blog"
        },
        "category": {
          "en": "v1 | Homepage Modules",
          "de": "Blog",
          "fr": "Blog"
        },
        "settings": {
          "blog": "News",
          "post_limit": 3
        }
      }
    ]
  }
{% endschema %}
