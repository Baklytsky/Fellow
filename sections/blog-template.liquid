{%- assign blog_title = blog.title -%}

{% if blog.metafields.custom_fields["desktop_masthead_image"] != blank %}
  {%- assign desktop_masthead = blog.metafields.custom_fields["desktop_masthead_image"] -%}
{% endif %}
{% if blog.metafields.custom_fields["mobile_masthead_image"] != blank %}
  {%- assign mobile_masthead = blog.metafields.custom_fields["mobile_masthead_image"] -%}
{% endif %}

{% if blog.metafields.custom_fields["blog_masthead_alt_text"] != blank %}
  {% assign masthead_alt = blog.metafields.custom_fields["blog_masthead_alt_text"] %}
{% else %}
  {% assign masthead_alt = blog.title %}
{% endif %}

{% if desktop_masthead != blank %}
  {%
    include 'component-masthead' with
    img: desktop_masthead,
    imgMobile: mobile_masthead,
    altText: masthead_alt,
    dataAttr: 'componentMasthead',
    copy: blog_title,
    className: ''
  %}
{% endif %}

<section class='container--l f fdc'>
  {% if desktop_masthead == blank %}
    <header class='f'>
      <h1 class=''>{{ blog_title }}</h1>
      {% if current_tags %}
        {% capture blog_title %}{{ blog.title | link_to: blog.url }} &mdash; {{ current_tags.first }}{% endcapture %}
      {% endif %}
    </header>
  {% endif %}
  {% paginate blog.articles by 12 %}
    <div class='f fw fdr mt3rem'>
      {% for article in blog.articles %}
        {% include 'article-card' %}
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      {% include 'pagination' %}
    {% endif %}
  {% endpaginate %}
</section>