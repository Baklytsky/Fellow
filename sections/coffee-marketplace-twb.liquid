{%- assign pre_heading = section.settings.pre_heading -%}
{%- assign heading = section.settings.heading -%}
{%- assign description = section.settings.description -%}
{%- assign cta_text = section.settings.cta_text -%}
{%- assign cta_link = section.settings.cta_link -%}
{%- assign cta_style = section.settings.cta_style -%}
{%- assign bg_color = section.settings.bg_color -%}
{%- assign text_color = section.settings.text_color -%}

{%- if pre_heading != blank or heading != blank or description != blank or cta_text != blank -%}
  <link rel="stylesheet" href="{{ 'section-coffee-marketplace-twb.min.css' | asset_url }}">

  <section class="cmTWB" style="color: {{ text_color }}; background-color: {{ bg_color }};">
    <div class="cmTWB__wrapper">
      {%- if pre_heading != blank -%}
        <p class="cmTWB__preHeading">{{ pre_heading }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="cmTWB__heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if description != blank -%}
        <p class="cmTWB__description">{{ description }}</p>
      {%- endif -%}
      {%- if cta_link != blank or cta_text != blank -%}
        <a href="{{ cta_link }}" class="btn btn--lg btn--{{ cta_style }} cmTWB__button">
          {{ cta_text | escape }}
        </a>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Text | Call Out Banner",
  "settings": [
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#7C2918"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "pre_heading",
      "label": "Subtitle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        {
          "value": "dark",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "white"
    }
  ],
  "presets": [
    {
      "name": "Text | Call Out Banner"
    }
  ]
}
{% endschema %}