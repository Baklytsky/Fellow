        },
        {
          "type": "url",
          "id": "url_2",
          "label": "Link url"
        },
        {
          "type": "header",
          "content": "Sub block_3"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title_3",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "url_3",
          "label": "Link url"
        },
        {
          "type": "header",
          "content": "Sub block_4"
        },
        {
          "type": "image_picker",
          "id": "image_4",
