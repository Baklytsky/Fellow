{%- assign logo = section.settings.logo -%}
{%- assign logo_svg = section.settings.logo_svg -%}
{%- assign logo_size_mob = section.settings.logo_mobile_size -%}
{%- assign logo_size_desk = section.settings.logo_desktop_size -%}

{%- assign main_menu = section.settings.center_menu -%}
{%- assign right_menu = section.settings.menu_right -%}
{%- assign left_menu = section.settings.menu_left -%}
{%- assign show_search = settings.enable_search -%}

{%- assign show_bar = section.settings.show_announcement -%}
{%- assign text_bar = section.settings.announcement_text -%}
{%- assign link_bar = section.settings.announcement_link -%}

{%- assign count_cart = cart.item_count -%}

<header id='header' data-component='header' class="newHeader">
  <div id="MainHeader">

    {%- if right_menu != blank or left_menu != blank or text_bar != blank -%}
      <div class="newHeader__topMenu">
        <div class="newHeader__topMenuContainer topMenu">
        {%- if left_menu != blank -%}
          <ul class="topMenu__menu topMenu__menu--left leftMenu">
            {%- for item in left_menu.links -%}
              {%- assign title = item.title | handleize -%}
              {%- assign has_submenu_blocks = false -%}

              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  {%- assign link_target = block.settings.target | handleize  -%}
                  {%- if link_target == title  -%}
                    {%- assign has_submenu_blocks = true -%}
                    {% break %}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              <li class="leftMenu__item">
                {%- if item.links != blank or has_submenu_blocks -%}
                <button data-target="{{ left_menu.title | handleize }}__{{ title }}"
                        data-selected="false"
                        class="newHeader__link linkWhite newHeader__button newHeader__MainLink" >
                  {{ item.title }}
                </button>
                {%- else -%}
                  <a href="{{ item.url }}"
                     class="newHeader__link linkWhite newHeader__button newHeader__MainLink" >
                    {{ item.title }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if show_bar and text_bar != blank and link_bar != blank -%}
          <a class="megaMenu__bar" href="{{ link_bar }}">
            <p>{{ text_bar }}</p>

            {%- if section.settings.enable_timer and section.settings.end_date != blank -%}
              <div class="announcement-bar__timer" data-end-date="{{ section.settings.end_date }}">
                <span class="announcement-bar__timer-days"></span>
                <span class="announcement-bar__timer-hours"></span>
                <span class="announcement-bar__timer-minutes"></span>
                <span class="announcement-bar__timer-seconds"></span>
              </div>
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- if right_menu != blank -%}
          <ul class="topMenu__menu topMenu__menu--right rightMenu">
            {%- for item in right_menu.links -%}
              {%- assign title = item.title | handleize -%}
              {%- assign has_submenu_blocks = false -%}

              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  {%- assign link_target = block.settings.target | handleize  -%}
                  {%- if link_target == title  -%}
                    {%- assign has_submenu_blocks = true -%}
                    {% break %}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              <li class="rightMenu__item">
                {%- if item.links != blank or has_submenu_blocks -%}
                  <button data-target="{{ right_menu.title | handleize }}__{{ title }}"
                          data-selected="false"
                          class="newHeader__link linkWhite newHeader__button newHeader__MainLink" >
                    {{ item.title }}
                  </button>
                {%- else -%}
                  <a href="{{ item.url }}"
                     class="newHeader__link linkWhite newHeader__button newHeader__MainLink" >
                    {{ item.title }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}

            {%- if show_search != false -%}
              <li class="rightMenu__search">
                <a role="button"
                   id="search-bar-button"
                   href="/search"
                   data-action="toggle-search"
                   aria-expanded="false"
                   aria-haspopup="true">
                  <p>{{ 'general.search.submit' | t }}</p>

                  {%- render 'icon' with 'search' -%}
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if main_menu != blank -%}
      <div id="Menu" class="newHeader__mainMenu">
        <div class="newHeader__mainMenuContainer mainMenu">
        <button type="button" class="burgerMenu" role="button" aria-label="Open mobile main menu">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <style>
            .mainMenu__logoWrapper {
                max-width: {{ logo_size_desk }}px;
            }

            @media screen and (max-width: 992px) {
                .mainMenu__logoWrapper {
                    max-width: {{logo_size_mob}}px;
                }
            {%- if show_bar != true -%}
              .topMenu {
                  display: none !important;
              }
            {%- endif -%}
            }

            body {
                margin-top: var(--header-height);
            }

        </style>

        <a href="{{ shop.url }}" itemprop="url" class="mainMenu__logoWrapper" aria-label="Logo">
          {%- if logo != blank or logo_svg != blank -%}
            {%- if logo_svg != blank -%}
              {{ logo_svg }}
            {%- else -%}
              <img src="{{ logo | img_url }}" alt="{{ logo.alt }}">
            {%- endif -%}
          {%- else -%}
            {%- render 'fellow-logo' -%}
          {%- endif -%}
        </a>

        <nav class="mainMenu__listWrapper">
          <ul class="mainMenu__list">
            {%- for link in main_menu.links -%}
              {%- assign title = link.title | handleize -%}
              {%- assign has_submenu_blocks = false -%}

              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  {%- assign link_target = block.settings.target | handleize  -%}
                  {%- if link_target == title  -%}
                    {%- assign has_submenu_blocks = true -%}
                    {% break %}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              <li class="mainMenu__item">
                {%- if link.links != blank or has_submenu_blocks -%}
                  <a data-target="{{ main_menu.title | handleize }}__{{ title }}"
                     href="{{ link.url }}"
                     data-selected="false"
                     class="newHeader__link linkBlack newHeader__MainLink">
                    {{ link.title }}
                  </a>
                {%- else -%}
                  <a class="newHeader__link linkBlack newHeader__MainLink"
                     href="{{ link.url }}">{{ link.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
        <button class="mainMenu__cardWrapper js-cart-drawer-toggle"
                tabindex='0'>
          <span class="mainMenu__cardTitle">{{ 'cart.general.short_title' | t }}</span>

          <span class="mainMenu__cardIcon">
            {%- render 'icon' with 'cart' -%}
            <p class="mainMenu__cardCount js-cart-count">
              {{ count_cart }}
            </p>
          </span>
        </button>
        </div>
      </div>
    {%- endif -%}

    {%- if show_search -%}
      <div id="header-search" class="headerSearch" aria-hidden="true" tabindex="-1" aria-labelledby="search-bar-button">

        <form action="{{ routes.search_url }}" name="GET" role="search" class="searchForm headerSearch__form">
          <label for='header-search-input'>
            <span class='visually-hidden'>Search</span>
          </label>
          <input type="search" id="header-search-input" class="searchForm__input headerSearch__input" name="q" autocomplete="off" autocorrect="off" autocapitalize="off" aria-label="{{ 'header_search.input_placeholder' | t }}" placeholder="{{ 'header_search.input_placeholder' | t }}" autofocus>
          <input type="reset" id="header-search-reset" value="reset" class="searchForm__resetInput">
          <label for="header-search-reset" class="searchForm__resetLabel headerSearch__resetLabel">
            <span class='visually-hidden'>Search Reset</span>
            {% render 'icon' with 'x' %}
          </label>
          <button type='submit' class="searchForm__Submit">
            {% render 'icon' with 'arrow-next' %}
            <span class='visually-hidden'>Submit Search</span>
          </button>
          <input type="hidden" name="type" value="product">
        </form>
        <div class="headerSearch__results">
          <div class="headerSearch__emptyResults">
            {{ settings.search_no_result_text | default: 'Sorry, no results' }}
          </div>
          <div class="headerSearch__resultsHeader">
            {%- if settings.search_heading != blank -%}
              <p class="headerSearch__resultsText">
                {{ settings.search_heading }}
              </p>
            {%- endif -%}
            
            <div class="headerSearch__popularSearches">
              {% for i in (1..3) %}
                {%- assign popular_searches = 'popular_searches_product_' | append: forloop.index -%}
                {%- assign popular_searches_products = all_products[settings[popular_searches]] -%}
    
                <a href="{{ popular_searches_products.url }}" class="headerSearch__item">{{ popular_searches_products.title }}</a>
              {% endfor %}
            </div>
          </div>

          <div class="headerSearch__results__loadingState">
            {% render 'icon' with 'spinner' %}
          </div>
          <ul class="headerSearch__resultsContent"></ul>

          {%- if settings.popular_section_enable -%}
            {% render 'search-grid-popular', class_name: 'search__popular--header' %}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="newHeader__openedBlock">
    <div class="newHeader__openedBlockContainer">
    {%- if left_menu != blank -%}
      {%- render 'generate-menu',mobile_menu: false, menu: left_menu, section: section -%}
    {%- endif -%}

    {%- if right_menu != blank -%}
      {%- render 'generate-menu',mobile_menu: false, menu: right_menu, section: section -%}
    {%- endif -%}

    {%- if main_menu != blank -%}
      {%- render 'generate-menu',mobile_menu: false, menu: main_menu, section: section -%}
    {%- endif -%}
    </div>
  </div>

  <div class="mobileMenu">
    {%- if left_menu !=blank or right_menu != blank or main_menu != blank -%}
      <nav class="mobileMenu__wrapper">
        <ul class="mobileMenu__list">

          {%- if show_search != false -%}
            <li class="mobileMenu__item">
              <a class="mobileMenu__link"
                 role="button"
                 href="/search"
                 data-action="toggle-search"
                 aria-expanded="false"
                 aria-haspopup="true"
              >
                <p>{{ 'general.search.submit' | t }}</p>

                {%- render 'icon' with 'search' -%}
              </a>
            </li>
          {%- endif -%}

          {%- if main_menu != blank -%}
            {%- render 'mobile-menu', menu: main_menu, section: section -%}
          {%- endif -%}

          {%- if left_menu != blank -%}
            {%- render 'mobile-menu', menu: left_menu, section: section -%}
          {%- endif -%}

          {%- if right_menu != blank -%}
            {%- render 'mobile-menu', menu: right_menu, section: section -%}
          {%- endif -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</header>


{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
