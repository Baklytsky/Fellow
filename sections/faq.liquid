{%- assign heading = section.settings.heading -%}
{%- assign description = section.settings.description -%}

{%- if heading != blank or description != blank or section.blocks.size > 0 -%}

  <div class="faq page-wrapper">
    {%- if heading != blank -%}
      <h3 class="faq__heading">{{ heading }}</h3>
    {%- endif -%}

    {%- if description != blank -%}
      <p class="faq__description">{{ description }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="faq__list">
        {%- for block in section.blocks -%}
          {%- assign title = block.settings.title -%}
          {%- assign description = block.settings.description -%}

          {%- if title != blank -%}
            <li class="faq__list-item">
              <slide-toggle class="faq__list-header f jcb aic"
                            data-slide-target="{{ block.id }}">
                <div class="faq__list-title">
                  {{ title }}
                </div>
                <div class="dropdownHeader-icon">
                  {% render 'icon' with 'dropdown' %}
                </div>
              </slide-toggle>
              {%- if description != blank -%}
                <div class="faq__list-content" data-slide-content="{{ block.id }}">
                  {{ description }}
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}

        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in section.blocks -%}
            {
              "@type": "Question",
              "name": "{{ block.settings.title }}",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "{{ description | escape }}"
                }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Text | FAQs",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Have Questions?",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "default": "We’ve got answers.",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "faq-block",
      "name": "FAQ block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text | FAQs"
    }
  ]
}
{% endschema %}

