{%- assign show_best_sellers = settings.show_best_sellers -%}
{%- assign best_sellers_heading = settings.best_sellers_heading -%}
{%- assign best_sellers_collection = collections[settings.best_sellers_collection] -%}


<div class='page module' data-component='page'>
  <div class='x'>
    <div class='mxa'>
      <div class="rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{%- assign bg_color = page.metafields.custom_fields["how_it_works_color"] | replace: '#', '' -%}
  <div class="how-it-works bg-xlightgrey" {% if bg_color != blank %} style="background-color: #{{ bg_color }}"{% endif %}>
    <div class="container--m mx-auto">
      {% if page.metafields.custom_fields["how_it_works_heading"] != blank %}
        <h2 class="ac">{{ page.metafields.custom_fields["how_it_works_heading"] }}</h2>
      {% endif %}

      <div class="how-it-works__inner pt1">
        {% assign steps = page.metafields.custom_fields["how_it_works_steps"] %}
        {% for step in steps %}
          <div class="how-it-works__item ac mx-auto">
              <div class="how-it-works__circle mx-auto f aic jcc">
                {%- if step["icon"] != blank -%}
                  {{ step["icon"] }}
                {%- else -%}
                  <span class="block">{{ forloop.index }}</span>
                {%- endif -%}
              </div>
              <div class="mt15">
                {% if step["title"] != blank %}
                  <h4 class="how-it-works__item-title my0 open-sans p semi">
                    {{ step["title"] }}
                  </h4>
                {% endif %}
                <div class="how-it-works__item-body my0">
                  {{ step["body"] | newline_to_br }}
                </div>
              </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

{%- capture popular_section -%}
    {%- if settings.popular_section_enable -%}
      <div class="search__popular--mainWrapper">
        {% render 'search-grid-popular', class_name: 'search__popular--main' %}
      </div>
    {%- endif -%}
  {%- endcapture -%}
  
  {%- capture best_sellers_section -%}
    {%- if show_best_sellers -%}
      <div class="searchBestSellers">
        {% if best_sellers_heading != blank %}
          <h4 class="searchBestSellers__heading">{{ best_sellers_heading }}</h4>
        {% endif %}
        
        {%- if best_sellers_collection != blank and best_sellers_collection.products_count > 0 -%}
          <div class="relatedProducts__row-wrapper rel">
            <div class='f jcs fdr one-fourth relatedProducts__row'>
              {% for product in best_sellers_collection.products limit: 4 %}
                <div class="relatedProducts__item">
                  {% include 'product-card' with
                    cx: 'y',
                    product: product %}
                </div>
              {% endfor %}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endcapture -%}

<div class="pl1 pr1">
{% if popular_section != blank %}
          {{ popular_section }}
        {% endif %}
        
        {% if best_sellers_section != blank %}
          {{ best_sellers_section }}
        {% endif %}
  
</div>
