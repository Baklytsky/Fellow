<link rel="stylesheet" href="{{ 'section-pdp-compare.min.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'section-compare-products-characteristics.min.css' | asset_url }}">
<script src="{{ 'component-pdp-compare.min.js' | asset_url }}" defer="defer"></script>
{%- assign compare_products_heading = section.settings.heading -%}
{%- assign compare_product_array_size = 0 -%}

{%- for block in section.blocks -%}
  {%- if block.settings.compare_product != blank -%}
    {%- assign compare_product_array_size = compare_product_array_size | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- case compare_product_array_size -%}
{%- when 1 -%}
{%- assign table_style_class = 'pdpCompare__table-half' -%}
{%- when 2 -%}
{%- assign table_style_class = 'pdpCompare__table-third' -%}
{%- when 3 -%}
{%- assign table_style_class = 'pdpCompare__table-four' -%}
{%- when 4 -%}
{%- assign table_style_class = 'pdpCompare__table-five' -%}
{%- endcase -%}

<div class="comparison__wrapper page-wrapper">
  {%- if compare_products_heading != blank -%}
    <h3 class="pdpCompare__heading">{{ compare_products_heading }}</h3>
  {%- endif -%}

  {% if compare_product_array_size > 0 %}
    <pdp-compare class='pdpCompare'>
      <table class="pdpCompare__table-mobile-title {{ table_style_class }} is-hidden">
        <thead>
        <tr>
          <th style="visibility:hidden; border: none;">Characteristics</th>
          {%- for block in section.blocks -%}
            {%- if block.settings.compare_product != blank -%}
              {%- assign _product = all_products[block.settings.compare_product] -%}
              <th>
                <div class="pdpCompare__table-th">
                  {{ _product.title }}
                </div>
              </th>
            {%- endif -%}
          {%- endfor -%}
        </tr>
        </thead>
      </table>
      <div class="pdpCompare__wrapper rel" {% if compare_product_array_size == 1 %} style="overflow: hidden" {% endif %}>
        <table class="pdpCompare__table rel {{ table_style_class }}">
          <thead>
          <tr>
            <th style="visibility:hidden;">Characteristics</th>
            {%- for block in section.blocks -%}
              {%- if block.settings.compare_product != blank -%}
                {%- assign _product = all_products[block.settings.compare_product] -%}
                <th>
                  <div class="pdpCompare__table-th">
                    {% include 'product-card', product: _product, hide_reviews: true %}
                  </div>
                </th>
              {%- endif -%}
            {%- endfor -%}
          </tr>
          </thead>
          <tbody>
          {%- for i in (1..20) -%}
            {%- assign key_name = "comparison_" | append: i -%}
            {%- assign characteristic_name = section.settings[key_name] -%}
            {%- if characteristic_name != blank -%}
              <tr>
                <th>{{ characteristic_name }}</th>
                {%- for block in section.blocks -%}
                  {%- if block.settings.compare_product != blank -%}
                    {%- assign product_key_name = "comparison_" | append: i -%}
                    {%- assign characteristic_text = block.settings[product_key_name] -%}
                    <td>
                      <div class="pdpCompare__table-td">
                        <div class="pdpCompare__mobile-characteristic">{{ characteristic_name }}</div>
                        {{ characteristic_text }}
                      </div>
                    </td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
          </tbody>
        </table>
      </div>
    </pdp-compare>
  {% endif %}
</div>


