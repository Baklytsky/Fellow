{% schema %}
  {
    "name": "Playground Section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": {
          "en": "Title",
          "de": "Titel",
          "fr": "En-tête"
        },
        "default": {
          "en": "Our Store & Playground"
        }
      },
      {
        "type": "text",
        "id": "eyebrow",
        "label": {
          "en": "Eyebrow Text"
        },
        "info": "Text that Appears Above Title"
      },
      {
        "type": "select",
        "id": "title_location",
        "label": "Title Position",
        "options": [
          {
            "value": "left_top",
            "label": "Left Top"
          },
          {
            "value": "left_inner",
            "label": "Left Inner"
          },
          {
            "value": "right_inner",
            "label": "Right Inner"
          }
        ]
      },
      {
        "type": "article",
        "id": "featuredPost",
        "label": "Featured Article"
      },
      {
        "id": "blog",
        "type": "blog",
        "label": {
          "en": "Blog",
          "de": "Blog",
          "fr": "Blog"
        }
      },
      {
        "type": "range",
        "id": "post_limit",
        "label": {
          "en": "Posts",
          "de": "Posts",
          "fr": "Articles"
        },
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 3
      },
      {
        "type": "checkbox",
        "id": "show_author",
        "label": {
          "en": "Show author",
          "de": "Autor anzeigen",
          "fr": "Afficher l'auteur"
        },
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_date",
        "label": {
          "en": "Show date",
          "de": "Datum anzeigen",
          "fr": "Afficher la date"
        },
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_view_all",
        "label": {
          "en": "Show 'View all' button",
          "de": "'Alle anzeigen' Button anzeigen",
          "fr": "Afficher le bouton “Voir tout”"
        },
        "default": false
      }
    ],
    "presets": [
      {
        "name": {
          "en": "Playground & Upcoming Events",
          "de": "Blogposts",
          "fr": "Articles de blog"
        },
        "category": {
          "en": "Prototype",
          "de": "Blog",
          "fr": "Blog"
        },
        "settings": {
          "blog": "News",
          "post_limit": 3
        }
      }
    ]
  }
{% endschema %}