<div class='news-module rel' id="news-module--{{ section.id }}">
  <style>
    #news-module--{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      flex-direction: {{ section.settings.layout }};
    }
  </style>
  <div class="news-module__image {% if section.settings.image_fit %} is-scaled{% endif %}">
    <div class="image">
      {% render 'image-lazy',
        image: section.settings.image,
        size: 'medium',
        alt: alt,
        loader: true %}
    </div>
  </div>

  {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
    {% capture cta_html %}
      {% assign button_class = 'btn--lg btn track--xNarrow ' | append: section.settings.button_class %}
      {%
        include 'component-button' with
        tag: 'a',
        cta: section.settings.cta_text,
        href: section.settings.cta_url,
        className: button_class
      %}
    {% endcapture %}
  {% endif %}

  <div class="news-module__text ">
    {% include 'large-text-with-cta',
      tagline: section.settings.tagline,
      header: section.settings.header,
      body: section.settings.body,
      cta_html: cta_html
    %}
  </div>
</div>

{% assign img_url = blank %}
{% assign button_class = blank %}
{% assign cta_html = blank %}

{% schema %}
  {
    "name": "News Module",
    "class": "news-module-section",
    "settings": [
      {
        "type": "header",
        "content": "Image"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Section Layout",
        "default": "row",
        "options": [
          { "value": "row", "label": "Image Left" },
          { "value": "row-reverse", "label": "Image Right" }
        ]
      },
      {
        "type": "checkbox",
        "id": "image_fit",
        "label": "Scale Image to Fit",
        "default": true
      },
      {
        "type": "header",
        "content": "Text"
      },
      {
        "type": "text",
        "id": "tagline",
        "label": "Tagline Text",
        "default": "Tagline Text"
      },
      {
        "type": "html",
        "id": "header",
        "label": "Header Text",
        "default": "Headline Text"
      },
      {
        "type": "textarea",
        "id": "body",
        "label": "Body Text",
        "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer nec odio. Praesent libero. Sed cursus ante dapibus diam. Sed nisi. Nulla quis sem at nibh elementum imperdiet. Duis sagittis ipsum. Praesent mauris. Fusce nec tellus sed augue semper porta. Mauris massa. Vestibulum lacinia arcu eget nulla."
      },
      {
        "type": "header",
        "content": "CTA Settings"
      },
      {
        "type": "url",
        "id": "cta_url",
        "label": "CTA URL"
      },
      {
        "type": "text",
        "id": "cta_text",
        "label": "CTA Text",
        "default": "Learn More"
      },
      {
        "type": "header",
        "content": "Color Settings"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#4a4a4a"
      },
      {
        "id": "text_color",
        "label": "Text Color",
        "default": "#FFFFFF",
        "type": "select",
        "options": [
          {
            "value": "#FFFFFF",
            "label": "White"
          },
          {
            "value": "#231f20",
            "label": "Black"
          }
        ]
      },
      {
        "id": "button_class",
        "label": "Button Color",
        "default": "btn--secondary",
        "type": "select",
        "options": [
          {
            "value": "btn--secondary",
            "label": "Light"
          },
          {
            "value": "btn--dark",
            "label": "Dark"
          },
          {
            "value": "btn--kickstarter-green",
            "label": "Kickstarter Green"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "News Module",
        "category": "Homepage Sections"
      }
    ]
  }
{% endschema %}