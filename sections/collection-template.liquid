{% comment %} Metafield represents index as 1, 2, 3, 4, etc. {% endcomment %}
{% assign product_image_index = collection.metafields.custom_fields.product_image_index | minus: 1 | at_least: 0 | default: 0 %}

{% paginate collection.products by 1000 %}

{% if collection.metafields.custom_fields["desktop_masthead_image"] != blank %}
  {%- assign desktop_masthead = collection.metafields.custom_fields["desktop_masthead_image"] -%}
{% endif %}
{% if collection.metafields.custom_fields["mobile_masthead_image"] != blank %}
  {%- assign mobile_masthead = collection.metafields.custom_fields["mobile_masthead_image"] -%}
{% endif %}
{%- assign collection_title = collection.title -%}

<section class='collection' data-component='collection'>
  {%- if section.settings.show_breadcrumbs -%}
    {% include 'breadcrumbs' %}
  {%- endif -%}
  {% if desktop_masthead != blank %}
    {%
      include 'component-collection-masthead' with
      img: desktop_masthead,
      imgMobile: mobile_masthead,
      dataAttr: 'componentMasthead',
      heading: collection.title,
      copy: collection.description,
      className: ''
    %}
  {% endif %}

  <collection-facets class='collection-wrapper'>
    {%- render 'facets' collection: collection -%}
    <div class='collection__products-wrapper rel'>
      <div class="collection__products-results">
        <div id="collection__variant-results" class="subcollection__products one-fourth">
          {%- for i in (1..8) -%}
            <div class="productCard">
              <div class="productCard__content y">
                <div class="productCard__img skeleton"></div>
                <div class="productCard__details">
                  <div class="productCard__title skeleton"></div>
                  <div class="productCard__price skeleton"></div>
                </div>
                <div class="productCard_ratings f fdr aie mb05 mt05 rel skeleton"></div>
              </div>
            </div>
          {%- endfor -%}
          {%- render 'variant-results' -%}
        </div>
      </div>
    </div>
  </collection-facets>
  <div class='f fw'>
    <div class='col-lg-12'>
      {% if paginate.pages > 1 %}
        {% include 'pagination' %}
      {% endif %}
    </div>
  </div>

  {%- if collection.metafields.custom_fields["show_collection_module"] == 1 -%}
    {%- assign collection_module_bg = collection.metafields.custom_fields["collection_module_background"] | default:  '#FFF9E5' -%}
    {%- assign collection_module_image = collection.metafields.custom_fields["collection_module_image"] -%}
    {%- assign collection_module_image_mobile = collection.metafields.custom_fields["collection_module_mobile_image"] -%}
    {%- assign collection_module_title = collection.metafields.custom_fields["collection_module_title"] -%}
    {% if collection.metafields.custom_fields["collection_module_arrow"] == 1 %}
      {%- assign enable_arrow = true -%}
    {% endif %}
    {%- assign collection_module_btn_text = collection.metafields.custom_fields["collection_module_button_text"] | default:  'Shop Now' -%}
    {%- assign collection_module_btn_url = collection.metafields.custom_fields["collection_module_button_url"] -%}

    <div class="collectionModule" style="background-color: {{ collection_module_bg }}">
      {%- if collection_module_image != blank -%}
        {%- assign desctop_image_class = 'image image-abs-contain' -%}

        {%- if collection_module_image_mobile != blank -%}
          {%- assign desctop_image_class = 'image image-abs-contain hide-tablet' -%}
        {%- endif -%}
        <div class="collectionModule__media rel">
          {%
            include 'component-image' with
            src: collection_module_image,
            alt: collection_module_title,
            className: desctop_image_class,
            absolute: true,
            fill: true
          %}
          {%- if collection_module_image_mobile != blank -%}
            {%
              include 'component-image' with
              src: collection_module_image_mobile,
              alt: collection_module_title,
              className: 'image image-abs-contain hide-tablet-desk',
              absolute: true,
              fill: true
            %}
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if collection_module_title != blank or collection_module_btn_url != blank -%}
        <div class="collectionModule__content rel">
          {%- if enable_arrow -%}
            <div class="collectionModule__content-arrow hide-tablet">
              {%- render 'icon' with 'collection-arrow' -%}
            </div>
            <div class="collectionModule__content-arrow hide-tablet-desk">
              {%- render 'icon' with 'collection-arrow-mobile' -%}
            </div>
          {%- endif -%}
          {%- if collection_module_title != blank -%}
            <h3 class="collectionModule__contentTitle">
              {{ collection_module_title }}
            </h3>
          {%- endif -%}
          {%- if collection_module_btn_url != blank -%}
            <a href="{{ collection_module_btn_url }}"
               class="collectionModule__contentLink btn--dark">
              {{ collection_module_btn_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

</section>

{% endpaginate %}

{% schema %}
  {
    "name": {
      "de": "Kategorie",
      "en": "Collection",
      "es": "Colección",
      "fr": "Collection",
      "it": "Collezione",
      "ja": "コレクション",
      "pt-BR": "Coleção"
    },
    "settings": [
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Show breadcrumbs",
        "default": true
      }
    ]
  }
{% endschema %}