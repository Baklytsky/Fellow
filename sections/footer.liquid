{%- assign show_icons = section.settings.show_icons -%}
{% assign footer_menu = section.settings.footer_menu %}
{%- assign footer_menu_bottom = section.settings.footer_menu_bottom -%}
{%- assign show_footer_payment_icon = section.settings.show_footer_payment_icon -%}

{% if section.settings.bigfooter_marquee == true %}
  {% include 'bigfooter-marquee' %}
{% else %}
  {% include 'footer-marquee' %}
{% endif %}

<footer class='footer'>
  <div class='footer__inner'>
    <div class='row'>
      <div class='footerInner__Left'>
        <div class='f fdc ais'>
          <a class="logo-link" href="{{ routes.root_url }}" aria-label="Open Home page" title="{{ shop.name }}" role="button">
            {% include 'fellow-logo-white' %}
          </a>
          
          {%- if show_icons -%}
          <ul class="footer__icons">
            {%- assign socials = "Instagram Facebook Twitter Pinterest YouTube LinkedIn" | split: ' ' -%}

            {%- for social in socials -%}
              {%- assign social_link = social | prepend: 'social_' | append: '_link' | handleize -%}
              {%- assign icon_link = social | handleize -%}

              {%- if settings[social_link] != blank and section.settings[icon_link] -%}
                <li class="footer__icons-item">
                  <a class="footer__icon-link" href="{{ settings[social_link] | escape }}" target="_blank" aria-label="Icon">
                    <div class="footer__icon">
                      {%- include 'icons-social' with icon_link -%}
                    </div>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        </div>

       {% if section.settings.show_newsletter %}
            {% include 'newsletter-snippet' %}
          {% endif %}
      </div>

      {% if linklists[footer_menu].links.size > 0 %}
        <div class='col-lg-7'>
          <nav class='footerInner__Right f fw x'>
            {% for link in linklists[footer_menu].links %}
              <div class='footer__col'>
                {% if link.links == blank %}
                  <h3 class='h5 m0'><a href="{{ link.url }}">{{ link.title }}</a></h3>
                {% else %}
                  <h3 class='h5 m0'>{{ link.title }}</h3>
                  <ul class='footer__links'>
                    {% for link in link.links %}
                      <li class='track--xNarrow'><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endfor %}
          </nav>
        </div>
      {% endif %}

    </div>
    
     {%- if show_footer_payment_icon -%}
    <div class='footer__payment-icons'>
      <ul>
        {%- for type in shop.enabled_payment_types -%}
          <li>
            {{ type | payment_type_svg_tag: class: 'img-grayscale' | replace: 'aria-labelledby', 'aria-label' }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

    <div class='row'>
      <div class='col'>
        <div class='footer__colophon'>
          <span class='ac xsmall'>&copy; Fellow Industries, Inc. {{ 'now' | date: '%Y' }}</span>

          {%- if linklists[footer_menu_bottom].links.size > 0 -%}
            <ul class="footerColophon__BottomMenu">
              {% for link in linklists[footer_menu_bottom].links %}
                <li class="footerColophon__BottomItem">
                  <a class="footerColophon__BottomLink" href="{{ link.url }}" role="link" aria-label="{{ link.title }}" title="Open {{ link.title }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>


</footer>

{% schema %}
  {
