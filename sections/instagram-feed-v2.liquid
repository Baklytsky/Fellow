{%- if section.settings.enable_section -%}
  {%- assign heading = section.settings.heading | default: false -%}
  {%- assign feed_id = section.settings.feed_id | default: false -%}
  {%- assign instagram_name = section.settings.instagram_name | default: false-%}

  {%- if feed_id -%}
    <section class='Instagram'>
      {%- if heading -%}
        <div class="Instagram__HeadingWrapper">
          <h3 class="Instagram__Heading">{{ heading }}</h3>
        </div>
      {%- endif -%}

      <div class="Instagram__WidgetWrapper">
        <div class="social-widget-wrapper"
             data-widget-id="{{ feed_id }}">
        </div>
      </div>
    </section>

    {%- if instagram_name -%}
      <style>.sw-instagram-col:before {content: '{{ instagram_name }}';}</style>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
  {
    "name": "Instagram Feed v2",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_section",
        "label": "Enable section"
      },
      {
        "type": "text",
        "id": "feed_id",
        "label": "Feed ID"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Brew along with us"
      },
      {
        "type": "text",
        "id": "instagram_name",
        "label": "Instagram name",
        "default": "@instagramname"
      }
    ],
    "presets": [
      {
        "name": "Instagram Feed v2",
        "category": "Social"
      }
    ]
  }
{% endschema %}
