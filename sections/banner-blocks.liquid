{%- assign full_width_container = section.settings.full_width_container -%}

{%- if section.blocks.size > 0 -%}
  <section class="BannerWithCta BannerBlocks">
    <div class="BannerWithCta__Wrapper BannerBlocks__Wrapper {% unless full_width_container %}BannerWithCta__Wrapper--Narrow{% endunless %}">
      {%- for block in section.blocks -%}
        {%- assign image = block.settings.image -%}
        {%- assign image_mobile = block.settings.image_mobile -%}
        {%- assign content_position = block.settings.content_position -%}
        {%- assign text_color = block.settings.text_color -%}
        {%- assign heading = block.settings.heading -%}
        {%- assign heading_size = block.settings.heading_size -%}
        {%- assign text = block.settings.text -%}
        {%- assign cta_url = block.settings.cta_url -%}
        {%- assign cta_copy = block.settings.cta_copy -%}
        {%- assign cta_color = block.settings.cta_color -%}
        
        {%- assign desktop_image_class = 'BannerWithCta__Image image image-abs-cover' -%}
  
        {%- if image_mobile != blank -%}
          {%- assign desktop_image_class = 'BannerWithCta__Image image image-abs-cover hide-mobile' -%}
        {%- endif -%}
        
        <div class="BannerBlocks__Item Content--{{ content_position }} rel">
          {%- if image != blank -%}
            <div class="{{ desktop_image_class }}">
              {% render 'image-lazy',
                image: image,
                class_name: 'image-abs-cover',
                size: 'medium',
                loader: true %}
            </div>
            {%- if image_mobile != blank -%}
              <div class="BannerWithCta__Image image image-abs-cover hide-desktop">
                {% render 'image-lazy',
                  image: image_mobile,
                  class_name: 'image-abs-cover ',
                  size: 'medium',
                  loader: true %}
              </div>
    
            {%- endif -%}
          {%- endif -%}
  
          {%- if heading != blank or text != blank or btn_url != blank -%}
            <div class="BannerWithCta__Content" style="color: {{ text_color }};">
              {%- if heading != blank -%}
                {%- case heading_size -%}
                {%- when 'h2' -%}
                  <h2 class="BannerWithCta__Heading h1">{{ heading }}</h2>
                {%- when 'h3' -%}
                  <h3 class="BannerWithCta__Heading h2">{{ heading }}</h3>
                {%- when 'h4' -%}
                  <h4 class="BannerWithCta__Heading h3">{{ heading }}</h4>
                {%- endcase -%}
              {%- endif -%}
      
              {%- if text != blank -%}
                <p class="BannerWithCta__Text">{{ text }}</p>
              {%- endif -%}
      
              {%- if cta_url != blank and cta_copy != blank -%}
                <a class="btn btn--lg {{ cta_color }}"
                   href="{{ cta_url }}"
                   title="{{ cta_copy }}"
                   role="button">
                  {{ cta_copy }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
     
    </div>
  </section>
{%- endif -%}


{% schema %}
{
  "name": "Banner blocks",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width_container",
      "label": "Full width container"
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            {
              "value": "TopCenter",
              "label": "Top center"
            },
            {
              "value": "MiddleCenter",
              "label": "Middle center"
            },
            {
              "value": "BottomCenter",
              "label": "Bottom center"
            }
          ],
          "default": "TopCenter"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h2",
          "options": [
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            }
          ]
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA URL"
        },
        {
          "type": "text",
          "id": "cta_copy",
          "label": "CTA Copy"
        },
        {
          "type": "radio",
          "id": "cta_color",
          "label": "CTA color",
          "options": [
            {
              "value": "btn--light",
              "label": "White"
            },
            {
              "value": "btn--dark",
              "label": "Black"
            }
          ],
          "default": "btn--dark"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner blocks",
      "category": "Image"
    }
  ]
}
{% endschema %}