{% comment %}
  Collections are listed here.
{% endcomment %}
{% if collection.metafields.custom_fields["desktop_masthead_image"] != blank %}
  {%- assign desktop_masthead = collection.metafields.custom_fields["desktop_masthead_image"] -%}
{% endif %}
{% if collection.metafields.custom_fields["mobile_masthead_image"] != blank %}
  {%- assign mobile_masthead = collection.metafields.custom_fields["mobile_masthead_image"] -%}
{% endif %}
{% if collection.metafields.custom_fields["collection_masthead_alt_text"] != blank %}
  {% assign masthead_alt = collection.metafields.custom_fields["collection_masthead_alt_text"] %}
{% else %}
  {% assign masthead_alt = collection.title %}
{% endif %}

{%- assign collection_title = collection.title -%}

<section class='collection' data-component='collection'>
  {% if desktop_masthead != blank %}
    {%
      include 'component-masthead' with
      img: desktop_masthead,
      imgMobile: mobile_masthead,
      altText: masthead_alt,
      dataAttr: 'componentMasthead',
      copy: collection_title,
      className: ''
    %}
  {% else %}
    {%
      include 'component-masthead' with
      dataAttr: 'componentMasthead',
      className: ''
    %}
  {% endif %}
  {% if linklists[collection.handle].links.size > 0 %}

    {% assign number_of_links = 0 %}

    <div class='container--l'>
      {% for link in linklists[collection.handle].links %}
        {% if link.type == 'collection_link' %}
          {% comment %}
          We've got a collection, loop through its products now.
          {% endcomment %}
          {% assign subcollection = link.object %}
          {% assign sub_product_image_index = subcollection.metafields.custom_fields.product_image_index | minus: 1 | at_least: 0 | default: 0 %}

          {% assign number_of_links = number_of_links | plus: 1 %}
          <div class='subcollection'>
            <div class='subcollection_copy mb1'>
              <h2 class='caps bold mb05'>{{ link.title }}</h2>
              {% if section.settings.show_collection_copy and subcollection.description != blank %}
              <div class='subcollection__dividerTag'>
                <strong class='subcollection__description my0'>
                  {{ subcollection.description }}
                </strong>
              </div>
              {% endif %}
            </div>
            <div class='subcollection__products one-fourth'>
              {% comment %} {% if section.settings.show_collection_card %}
                {% include 'subcollection-intro-card' %}
              {% endif %} {% endcomment %}
              {% for product in subcollection.products %}
                {% include 'product-card', product_image: product.images[sub_product_image_index] %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if number_of_links == 0 %}
      <div class="grid">
        <div class="grid__item grid-item rte text-center">
          <p>
            There are no links of type <i>Collection</i> in your <b>{{ collection.title }}</b> link list.
            Go ahead and <a href="/admin/link_lists/{{ linklists[collection.handle].id }}" target="_blank">edit your link list</a> to use links that point to collections.
          </p>
        </div>
      </div>
    {% endif %}

  {% else %}
    <div class='container--l'>
      <div class='subcollection__products one-fourth'>
        {% assign product_image_index = subcollection.metafields.custom_fields.product_image_index | minus: 1 | at_least: 0 | default: 0 %}
        {% for product in collection.products %}
          {% include 'product-card', product_image: product.images[product_image_index] %}
        {% endfor %}
      </div>
      <div class='f fw'>
        <div class='col-lg-12'>
          {% if paginate.pages > 1 %}
            {% include 'pagination' %}
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
  {
    "name": {
      "en": "Subcollections"
    },
    "settings": [
      {
        "type": "checkbox",
        "id": "show_tagline",
        "label": "Show Product Taglines"
      },
      {
        "type": "checkbox",
        "id": "show_collection_card",
        "label": "Show Collection Intro Card",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_collection_copy",
        "label": "Show Collection Descriptions"
      }
    ]
  }
{% endschema %}