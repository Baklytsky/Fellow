<!DOCTYPE html>
<html lang='{{ shop.locale }}'>
<head>
  <script src="https://www.googleoptimize.com/optimize.js?id=OPT-KLVKQBN"></script>
  <meta charset='utf-8'>
  <meta name='viewport' content='width=device-width,initial-scale=1,shrink-to-fit=no'>
  {% include 'no-index-pages' %}
  {% render 'css-variables' %}

  <link rel='canonical' href='{{ canonical_url }}'>
  <link rel='shortcut icon' href='{{ settings.favicon | img_url: "32x32" }}' type='image/png'>

  {%- comment -%}
    <link rel="preload" href="{{ 'index.css' | asset_url }}" as="style">
    <link rel="preload" href="{{ 'custom.scss.css' | asset_url }}" as="style">
  {%- endcomment -%}

  <link rel="preload" href="{{ 'theme.min.css' | asset_url }}" as="style">

  <link rel="preload" href="{{ 'global.min.js' | asset_url }}" as="script">
  <link rel="preload" href="{{ 'cart.min.js' | asset_url }}" as="script">

  {%- if template contains 'collection' -%}
    <link rel="preload" href="{{ 'collection.min.js' | asset_url }}" as="script">
  {%- endif -%}

  {% include 'redirects' %}

  {% capture seo_title %}
    {{ page_title }}
    {% if current_tags %}
      {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
    {% endif %}
    {% if current_page != 1 %}
      &ndash; {{ 'general.meta.page' | t: page: current_page }}
    {% endif %}
    {% unless page_title contains shop.name %}
      &ndash; {{ shop.name }}
    {% endunless %}
  {% endcapture %}
  <title>{{ seo_title }}</title>

  {% include 'head-meta' %}

  {% if template.directory == 'customers' %}
    <script type="text/javascript">
      const fbq = false;
      const _fbq = false;

      Object.defineProperty(window, 'fbq', {
        value: false,
        writable: false
      });
      Object.defineProperty(window, '_fbq', {
        value: false,
        writable: false
      });
    </script>
    <script src='{{ 'shopify_common.js' | shopify_asset_url }}' defer='defer'></script>
  {% endif %}

    {% include 'global-obj' %}
    {% include 'afterpay' %}
    {% include 'google-tag-manager' %}
    {% include 'preconnect' %}

  {%- comment -%}
    {{ 'index.css' | asset_url | stylesheet_tag }}
    {{ 'custom.scss.css' | asset_url | stylesheet_tag }}
  {%- endcomment -%}

  {{ 'theme.min.css' | asset_url | stylesheet_tag }}

    {% include 'swatchUpload' %}

    {%- if request.path contains 'carter-move-mug' or request.path contains 'carter-everywhere-mug' or product.handle contains 'carter-move-mug-with-360-sip-lid' -%}
    {{ 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css' | stylesheet_tag }}
    {{ 'player_customized.css' | asset_url | stylesheet_tag }}
      {{ 'player-chunk.css' | asset_url | stylesheet_tag }}
    {{ 'https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css' | stylesheet_tag }}
    {{ 'https://admin-fts.threekit.com/app/js/threekit-player-bundle.js' | script_tag }}
    {%- endif -%}
    
    {{ content_for_header }}
    {% include 'friendbuy' %}

</head>

  <body>
    {% section 'accessibility-popup' %}
    {% include 'gtm-no-script' %}
    {% section 'header' %}
    {% include 'modal' %}
    <div id="js-cart-drawer-overlay"></div>
    {% section 'cart-drawer-content' %}

    <main role='main' id='root' tabindex='0'>
      {{ content_for_layout }}
      {% include 'meta-json' %}
    </main>

    {% section 'footer' %}
    {% include 'cloak' %}

    {{ 'libs.min.js' | asset_url | script_tag }}

    {% if template contains 'customers/account' or template contains 'customers/register' or template == 'index' %}
      <script src="https://app.accentuate.io/dist/proxy.js" defer="defer"></script>
      {%- render 'accenture-set-phone' -%}
    {% endif %}

    <script src="{{ 'global.min.js' | asset_url }}" defer='defer'></script>

    {%- if template contains 'collection' -%}
      <script src="{{ 'handlebars-v4.7.7.js' | asset_url }}" defer='defer'></script>
      <script src="{{ 'collection.min.js' | asset_url }}" defer='defer'></script>
    {%- endif -%}

    <script src="{{ 'cart.min.js' | asset_url }}" defer="defer"></script>

    {% include 'component-customize-js' %}

    {% include 'klaviyo' %}
  </body>

  {% include 'link-redirect' %}
  {% include 'yotpo' %}
</html>
