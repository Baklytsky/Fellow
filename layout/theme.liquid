<!DOCTYPE html>
<html lang='{{ shop.locale }}'>
<head>
  <script src="https://www.googleoptimize.com/optimize.js?id=OPT-KLVKQBN"></script>
  <meta charset='utf-8'>
  <meta name='viewport' content='width=device-width,initial-scale=1,shrink-to-fit=no'>
  <link rel='canonical' href='{{ canonical_url }}'>
  <link rel='shortcut icon' href='{{ settings.favicon | img_url: "32x32" }}' type='image/png'>

  <link rel="preload" href="{{ 'index.css' | asset_url }}" as="style">
  <link rel="preload" href="{{ 'custom.scss.css' | asset_url }}" as="style">

  <link rel="preload" href="{{ 'index.js' | asset_url }}" as="script">
  <link rel="preload" href="{{ 'custom.js' | asset_url }}" as="script">

  {%- if template contains 'collection' -%}
    <link rel="preload" href="{{ 'collection.js' | asset_url }}" as="script">
  {%- endif -%}

  {% capture seo_title %}
    {{ page_title }}
    {% if current_tags %}
      {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
    {% endif %}
    {% if current_page != 1 %}
      &ndash; {{ 'general.meta.page' | t: page: current_page }}
    {% endif %}
    {% unless page_title contains shop.name %}
      &ndash; {{ shop.name }}
    {% endunless %}
  {% endcapture %}
  <title>{{ seo_title }}</title>

  {% include 'head-meta' %}

  {% if template.directory == 'customers' %}
    <script src='{{ 'shopify_common.js' | shopify_asset_url }}' defer='defer'></script>
  {% endif %}

     <script>
      window.theme = {
        strings: {
          addToCart: "{{ 'products.product.add_to_cart' | t }}",
          soldOut: "{{ 'products.product.sold_out' | t }}",
          unavailable: "{{ 'products.product.unavailable' | t }}"
        },
        gwpSettings: {
          gwpEnable: "{{ settings.enable_gwp }}",
          gwpThreshold: "{% if settings.gwp_threshold > 0 %}{{ settings.gwp_threshold }}{% else %}0{% endif %}",
          secondGwpThreshold: "{% if settings.second_gwp_threshold > 0 %}{{ settings.second_gwp_threshold }}{% else %}0{% endif %}",
          gwpProductAvailable : "{{ all_products[settings.gwp_product].available }}",
          secondGwpProductAvailable : "{{ all_products[settings.second_gwp_product].available }}",
          gwpProductId: "{{ all_products[settings.gwp_product].selected_or_first_available_variant.id }}",
          secondGwpProductId: "{{ all_products[settings.second_gwp_product].selected_or_first_available_variant.id }}",
          gwpProductType: "{{ all_products[settings.gwp_product].type }}",
          secondGwpProductType: "{{ all_products[settings.second_gwp_product].type }}"
        },
        personalization: {
          perProductAvailable: "{{ all_products[settings.personalization_product].available }}",
          perProductID: "{{ all_products[settings.personalization_product].selected_or_first_available_variant.id  }}"
        },
        giftWrapping: {
          giftWrappingEnable: "{{ settings.enable_gift_wrapping }}",
          giftWrappingAvailable: "{{ all_products[settings.gift_box_product].available }}",
          giftWrappingProductID: "{{ all_products[settings.gift_box_product].selected_or_first_available_variant.id  }}"
        },
        {% if template.name == 'product' %}product: {{ product | json }},{% endif %}
        moneyFormat: "{{ shop.money_format }}"
      }
    </script>

  
    <script src="https://js.afterpay.com/afterpay-1.x.js" data-analytics-enabled
           id="afterpay-placement" data-min="50.00" data-max="2000.00" async>
    </script>
    
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-K9G7563');</script>
    <!-- End Google Tag Manager -->

  <!-- Global site tag (gtag.js) - Google Ads: 951859275 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-951859275"></script>
  <script>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
      dataLayer.push(arguments);
    }

    gtag('js', new Date());
    gtag('config', 'AW-951859275');
  </script>

    <!-- Google Fonts via Preconnect -->
    <link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin />


    {% include 'preconnect' %}

    {{ 'index.css' | asset_url | stylesheet_tag }}
    {{ 'custom.scss.css' | asset_url | stylesheet_tag }}
    
    {%- if request.path contains 'carter-move-mug' or request.path contains 'carter-everywhere-mug' or product.handle contains 'carter-move-mug-with-360-sip-lid' -%}
    {{ 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css' | stylesheet_tag }}
    {{ 'player_customized.css' | asset_url | stylesheet_tag }}
      {{ 'player-chunk.css' | asset_url | stylesheet_tag }}
    {{ 'https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css' | stylesheet_tag }}
    {{ 'https://admin-fts.threekit.com/app/js/threekit-player-bundle.js' | script_tag }}
    {%- endif -%}
    
    {{ content_for_header }}
    {% include 'friendbuy' %}

</head>

  <body>

    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K9G7563"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {% section 'header' %}
    {% include 'modal' %}
    {% include 'cart-drawer' %}

    <main role='main' id='root' tabindex='0'>
      {{ content_for_layout }}
      {% include 'meta-json' %}
    </main>

    {% section 'footer' %}
    {% include 'cloak' %}

    {{ 'jquery-1.11.0.min.js' | asset_url | script_tag }}
    {{ 'jquery.ba-throttle-debounce.min.js' | asset_url | script_tag }}
    {{ 'custom-additional-vendor.js' | asset_url | script_tag }}
  
    {%- if request.path contains 'carter-move-mug' or request.path contains 'carter-everywhere-mug' or product.handle contains 'carter-move-mug-with-360-sip-lid' -%}
    {{ 'player-event.js' | asset_url | script_tag }}
    {{ 'player-inline.js' | asset_url | script_tag }}
    {{ 'player-chunk-one.js' | asset_url | script_tag }}
    {{ 'player-chunk-two.js' | asset_url | script_tag }}
    {%- endif -%}

    <script src="{{ 'custom.js' | asset_url }}" defer='defer'></script>

    {%- if template contains 'collection' -%}
      <script src="{{ 'handlebars-v4.7.7.js' | asset_url }}" defer='defer'></script>
      <script src="{{ 'collection.js' | asset_url }}" defer='defer'></script>
    {%- endif -%}

    <script src="{{ 'index.js' | asset_url }}" defer='defer'></script>
    {% comment %} <script src="https://a.klaviyo.com/media/js/onsite/onsite.js"></script> {% endcomment %}
  <script type="text/javascript">
document.querySelector("#kl_promo_terms").addEventListener('click',function (){
        var _klOnsite = window._klOnsite || []
        _klOnsite.openForm('SJpmKX', () => console.log("you triggered the form!"))
    });
</script>
    <script type="text/javascript">
document.querySelector("#vippromo_terms").addEventListener('click',function (){
        var _klOnsite = window._klOnsite || []
        _klOnsite.openForm('SwWE8b', () => console.log("you triggered the form!"))
    });
</script>
  </body>

  <script>
    jQuery('a[href^="http"]').not('a[href^="{{ shop.url }}"]').attr('target', '_blank');
  </script>

  <!-- yotpo -->
  <script type="text/javascript">(function e() {
      var e = document.createElement("script");
      e.type = "text/javascript", e.async = true, e.src = "//staticw2.yotpo.com/JKrJpoWVtOiKekxIZEcsIIya88lPfCthqp3OznJ5/widget.js";
      var t = document.getElementsByTagName("script")[0];
      t.parentNode.insertBefore(e, t)
    })();
  </script>
  <!-- End yotpo -->
</html>
