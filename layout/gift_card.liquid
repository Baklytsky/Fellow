<!DOCTYPE html>
<html lang='{{ shop.locale }}'>
  <head>
    <meta charset='utf-8'>
    <meta name='viewport' content='width=device-width,initial-scale=1,shrink-to-fit=no'>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">
    <link rel='canonical' href='{{ canonical_url }}'>
    <link rel='shortcut icon' href='{{ settings.favicon | img_url: "32x32" }}' type='image/png'>
    {%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency -%}
    {%- assign formatted_initial_value_stripped = formatted_initial_value | strip_html -%}
    <title>{{ 'gift_cards.issued.title_html' | t: value: formatted_initial_value_stripped, shop: shop.name }}</title>

    {% include 'head-meta' %}

    <script>
      window.theme = {
        strings: {
          addToCart: "{{ 'products.product.add_to_cart' | t }}",
          soldOut: "{{ 'products.product.sold_out' | t }}",
          unavailable: "{{ 'products.product.unavailable' | t }}"
        },
        moneyFormat: "{{ shop.money_format }}"
      }
    </script>

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-K9G7563');</script>
    <!-- End Google Tag Manager -->

    <!-- Global site tag (gtag.js) - Google Ads: 951859275 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-951859275"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-951859275');
    </script>

    {{ 'index.css' | asset_url | stylesheet_tag }}
    {{ 'gift-card.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>
    <script src="{{ 'gift-card.js' | asset_url }}" defer="defer"></script>

    <script>
      var theme = {
        strings: {
          qrImageAlt: {{ 'gift_cards.issued.qr_image_alt' | t | json }}
        }
      };
    </script>

    <script type="text/javascript">
      if (window.MSInputMethodContext && document.documentMode) {
        var scripts = document.getElementsByTagName('script')[0];
        var polyfill = document.createElement("script");
        polyfill.defer = true;
        polyfill.src = "{{ 'ie11CustomProperties.min.js' | asset_url }}";
        scripts.parentNode.insertBefore(polyfill, scripts);
      }
    </script>
    {{ content_for_header }}
  </head>

  <body class="template-giftcard">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-K9G7563"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    {% section 'header' %}

    <main role='main' id='root'>
      {{ content_for_layout }}
      {% include 'meta-json' %}
    </main>

    {% section 'footer' %}
    {% include 'cart-drawer' %}
    {% include 'cloak' %}

    <script src="{{ 'index.js' | asset_url }}" defer='defer'></script>
  </body>
</html>
