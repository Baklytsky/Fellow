{% comment %}
  QR code is rendered in `#QrCode`

  `gift_card.pass_url` is true if apple wallet is enabled for the shop
{% endcomment %}

{% layout 'gift_card' %}

{%- assign formatted_initial_value = gift_card.initial_value | money_without_trailing_zeros: gift_card.currency -%}
{%- assign formatted_initial_value_stripped = formatted_initial_value | strip_html -%}
{%- assign initial_value_size = formatted_initial_value | size -%}

{% if page.metafields.custom_fields["desktop_masthead_image"] != blank %}
  {%- assign desktop_masthead = page.metafields.custom_fields["desktop_masthead_image"] -%}
{% endif %}
{% if page.metafields.custom_fields["mobile_masthead_image"] != blank %}
  {%- assign mobile_masthead = page.metafields.custom_fields["mobile_masthead_image"] -%}
{% endif %}
{% if page.metafields.custom_fields["page_masthead_alt_text"] != blank %}
  {% assign masthead_alt = page.metafields.custom_fields["page_masthead_alt_text"] %}
{% else %}
  {% assign masthead_alt = page.title %}
{% endif %}

{% if desktop_masthead != blank %}
  {%
    include 'component-masthead' with
    img: desktop_masthead,
    imgMobile: mobile_masthead,
    dataAttr: 'componentMasthead',
    className: '',
    overlap: false
  %}
{% else %}
  {%
    include 'component-masthead' with
    dataAttr: 'componentMasthead',
    className: '',
    overlap: false
  %}
{% endif %}

<section class="giftcard open-sans{% if gift_card.expired or gift_card.enabled != true %} giftcard--disabled{% endif %}">

  {% unless gift_card.enabled %}
    <span class="giftcard-tag">{{ 'gift_cards.issued.disabled' | t }}</span>
  {% endunless %}

  {%- assign gift_card_expiry_date = gift_card.expires_on | date: "%d/%m/%y" -%}

  {% if gift_card.expired and gift_card.enabled %}
    <span class="giftcard-tag">{{ 'gift_cards.issued.expired' | t: expiry: gift_card_expiry_date }}</span>
  {% endif %}

  {% if gift_card.expired != true and gift_card.expires_on and gift_card.enabled %}
    <span class="giftcard-tag giftcard-tag--active">{{ 'gift_cards.issued.active' | t: expiry: gift_card_expiry_date }}</span>
  {% endif %}
    <div class='giftcard__introText ac container--l'>
      <span class='eyebrow'>
        You can have whatever you want... from Fellow.
      </span>
      <h1 class='caps mt0 oswald--n7'>
        Congrats, you got Fellowbucks!
      </h1>
    </div>
    <div class='container--s'>
      <div class="giftcard__wrap">
        <img src="{{ 'giftCardCropped.gif' | asset_url }}" alt="Gift image" role="img">

        {%- assign initial_value_size = formatted_initial_value | size -%}
        <div class="h1 giftcard__amount{% if initial_value_size > 6 %} giftcard__amount--medium{% endif %}">
          {% if gift_card.balance != gift_card.initial_value %}
            <span class="giftcard__tooltip">
              <span class="giftcard__tooltip-label">{{ 'gift_cards.issued.remaining_html' | t: balance: gift_card.balance | money }}</span>
            </span>
          {% endif %}
          <strong>{{ formatted_initial_value }}</strong>
        </div>
      </div>
    </div>

    <div class='container--l ac'>
      <section class='f fdc aic'>
        <h2 class='h3 caps'>Your card is worth {{ formatted_initial_value }} in Fellowbucks!</h2>
        {% if gift_card.balance != gift_card.initial_value %}
          <p>
            Looks like you've spent a bit of them though, you've got {{ 'gift_cards.issued.remaining_html' | t: balance: gift_card.balance | money }} left to spend!
          </p>
        {% endif %}

        {%- assign code_size = gift_card.code | format_code | size -%}
        <div class="giftcard__code">
          <div class="giftcard__code__inner">
            <input type="text"
              class="giftcard__code__text{% if gift_card.expired or gift_card.enabled != true %} disabled{% endif %}"
              id="GiftCardDigits"
              value="{{ gift_card.code | format_code }}"
              aria-label="{{ 'gift_cards.issued.gift_card_code' | t }}"
              readonly />
          </div>
        </div>
      </section>

      <p>{{ 'gift_cards.issued.redeem' | t }}</p>

      <a href="{{ shop.url }}" class="btn btn--lg btn--dark no-print" target="_blank">{{ 'gift_cards.issued.shop_link' | t }}</a>

      <div id="QrCode" class="giftcard-qr print-only" data-identifier="{{ gift_card.qr_identifier }}"></div>

      {% if gift_card.pass_url %}
        <a href="{{ gift_card.pass_url }}" class="apple-wallet" aria-label="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}">
          <img class="apple-wallet-image" src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}">
        </a>
      {% endif %}

      <button type="button" class="btn btn--lg print-link" onclick="window.print();">
        {{ 'gift_cards.issued.print' | t }}
      </button>
    </div>
</section>
