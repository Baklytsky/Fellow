{% comment %}
  The share buttons share the home page URL. The share text is grabbed from the store
  meta description.
{% endcomment %}

{% layout 'password' %}

<div class="abs x y ac f aic jcc fdc password">
  <h2>{{ 'general.password_page.login_form_heading' | t }}</h2>
  <div class="mx-auto">
    <div id="Login" class="pb2">
      {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
        <input type="password"
          name="password"
          id="Password"
          class="x"
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
        <button type="submit" name="commit" class="x my2 btn btn--dark btn--md">
          {{ 'general.password_page.login_form_submit' | t }}
        </button>
      {% endform %}
      <p>{{ 'general.password_page.admin_link_html' | t }}</p>
    </div>
  </div>
</div>