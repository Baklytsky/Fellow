{% layout none %}
{%- assign product_counter = 0 -%}

 {%- if search.performed and search.results.size > 0 -%}
   {%- if search.types contains 'product' -%}
     {%- assign ratio = paginate.current_page | times: 100 -%}
     {
     "data": [
     {%- for product in search.results -%}
       {%- if product.available -%}
        {%- assign product_tags = product.tags | handleize -%}
        {%- assign badge_text = product.metafields.custom_fields.card_badge -%}
        {%- assign reviews_count = product.metafields.yotpo.reviews_count | plus: 0 -%}
        {%- assign url = '/products/' | append: product.handle -%}

        {%- unless product.type == "Free Gift" or product_tags contains "searchanise_ignore" -%}
         {%- assign product_counter = product_counter | plus: 1 -%}
          {%- assign count = 0 -%}
          {%- assign tags = product.tags | handleize -%}
           {%- if product_counter > 1 -%},{%- endif -%}{
           "title": {{ product.title | json }},
           "title_handleize": {{ product.title | handleize | json }},
           "price_varies": {{ product.price_varies | json }},
           "id": {{ product.id }},
           "featured_image": {
           "image_url": "{{ product.featured_image | img_url: 'x600' }}",
           "alt": {{ product.featured_image.alt | default: product.title | escape | json }}
           },
           {%- if reviews_count == 0 -%}
             "hide_reviews": "true",
           {%- endif -%}
           "reviews_count": "{{ reviews_count }}",
           {% if product.available %}
             {% if product.price_varies and product.compare_at_price == blank %}
               "product_price_label": "{{ 'products.product.from_text' | t }}",
               "product_price_label_classes": "productCard__from eyebrow",
             {% else %}
               "product_price_label": " ",
               "product_price_label_classes": "productCard__eyebrow--placeholder",
             {% endif %}
           {% else %}
             "product_price_label": "{{ 'products.product.sold_out' | t }}",
             "product_price_label_classes": "productCard__from eyebrow",
           {% endif %}
           "price": "{{ product.price_min | money_without_trailing_zeros }}",

           {%- if product.metafields.custom_fields["product_alternative_image"] != blank  -%}
             {%- assign alt_image = product.metafields.custom_fields["product_alternative_image"] -%}
             {%- assign alternative_url = product.metafields.custom_fields["product_alternative_image"] -%}
             "alt_image": {
             "url": "{{ alternative_url }}",
             "alt": {{ alt_image.images.alt | json}}
             },
           {%- endif -%}
           "vendor": "{{ product.vendor }}",
           {%- if product.variants.size > 1 -%}
             "options_text": "{{ product.variants.size }} more {{ product.options.first }}s",
           {%- endif -%}
           "price_sort" : "{{ product.price }}",
           "url": "{{ product.url }}",
           "url_quickView": "{{ url }}",
           {% if badge_text %}
             "badge_text": {{ badge_text | json }},
           {% endif %}
           {% if product.options %}
             "product_options": "true",
           {% endif %}

            "options": [

              {% for product_option in product.options_with_values limit: 1 %}
                {
                  {%- assign option_name = product_option.name | handleize -%}
                  {%- if option_name == 'color' or option_name == 'material' -%}
                    "option_name": "{{ option_name }}",
                    "values": [
                      {%- for value in product_option.values -%}
                        {
                          "variants": [
                            {%- for variant in product.variants -%}

                            {%- if variant.option1 == value or variant.option2 == value -%}
                              {%- assign color_count = color_count | plus: 1 -%}

                              {%- if option_name == 'color'-%}
                                {%- assign color_name = value | handleize -%}
                                {%- assign color_swatch_name = product.handle | append: '_' | append: color_name | append: '.png' -%}
                                {%- assign color_swatch_image = images[color_swatch_name] -%}
                              {%- endif -%}
                              {
                                "title_handleize": {{ product.title | handleize | json }},
                                "value": "{{ value }}",
                                "value_handleize": "{{ value | handleize }}",
                                "option_name": "{{ option_name | handleize }}",
                                {%- if option_name == 'color' or option_name == 'material' -%}
                                  "data_color_or_material": "{{ value | handleize }}",
                                {%- endif -%}
                                {%- if option_name == 'color' -%}
                                  "data_color": "{{ value | handleize }}",
                                {%- endif -%}
                                {%- if option_name == 'material' -%}
                                  "data_material": "{{ value | handleize }}",
                                {%- endif -%}
                                "variant_url": "{{ variant.url }}",
                                "variant_id": "{{ variant.id }}"
                              }
                              {%- break -%}
                            {%- endif -%}
                           {%- endfor -%}
                          ]
                        }{%- unless forloop.last -%},{%- endunless -%}
                      {%- endfor -%}
                    ]
                  {%- endif -%}

                }{%- unless forloop.last -%},{%- endunless -%}
              {% endfor %}
            ],
           "variants": [
           {% if product.variants.size > 1 %}
             {% for variant in product.variants %}
               {
               {%- for product_option in product.options_with_values -%}
                 {%- assign option_name = product_option.name | handleize -%}
                 {%- if option_name == 'color' or option_name == 'material' -%}
                   {%- for value in product_option.values -%}
                     {%- if variant.option1 == value or variant.option2 == value -%}
                       {% if option_name == 'color' or option_name == 'material' %}
                         "data_color": {{ value | handleize | json }},
                       {% endif %}
                       {%- break -%}
                     {%- endif -%}
                   {%- endfor -%}
                 {%- endif -%}
               {%- endfor -%}

               "url": {{ variant.url | json }},
               "image_url": {{ variant | img_url: '500x' | json }},
               "id": {{ variant.id | json}},
               "title": {{ variant.title | json }}
               }{%- unless forloop.last -%},{%- endunless -%}
             {%- endfor -%}
           {% endif %}
           ]
           }
         {%- endunless -%}
       {%- endif -%}
     {%- endfor -%}

     ]
     }
   {%- endif -%}
 {%- endif -%}
