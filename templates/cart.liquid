<style>
  .container--l.cartly {
    margin-left: 30vw;
    margin-right: 30vw;
  }
  
  .cartPage__footer {
   width: 100%; 
  }
  
  .cartPage--checkoutBttn {
    float: right;
  }
  
  .cartPage-footer__total {
   width: 100%; 
  }
  
  
  @media screen and (max-width: 900px) {
    .container--l.cartly {
    margin-left: 3vw;
    margin-right: 3vw;
      }
     .cartPage {
   margin-top: 0vh; 
  }
}
  </style>


<section class='cartPage'>
  <div class='container--l cartly' data-component='cartPage'>
    {% comment %} Comment tags can't wrap other comment tags so here's a dumb way to make this never render {% endcomment %}
      {% if cart.item_count > 0 %}
        <h1>{{ 'cart.general.title' | t }}</h1>

        <form action="/cart" method="post" novalidate>
          <div class="cart-drawer__items-inner js-cart-drawer-items">
      

              {% for item in cart.items %}

              {% comment %}

              Cart Item Template
              =====================
              The data-label attributes on <td> elements are mobile-friendly
              helpers used for responsive-table labels
              {% endcomment %}

                  <div data-label="{{ 'customer.order.product' | t }}" class="cart-drawer__item">
                    <a {% unless item.product.type contains 'Gift product' %} href="{{ item.url | within: collections.all }}" {% endunless %} class="cart-drawer__itemImage">
                      <img src="{{ item | img_url: '240x240' }}" alt="{{ item.title | escape }}">
                    </a>

                  <div class="cart-drawer__itemContent f fdc" >
                  <div class="cart-drawer__itemDetails">
                                                                                    
                    <a class="cart-drawer__itemTitle" {% unless item.product.type contains 'Gift product' %} href="{{ item.url }}" {% endunless %}>{{ item.product.title }}</a>

                    {% unless item.product.has_only_default_variant %}
                      <p class="cart-drawer__itemOptions'">{{ item.variant.title }}</p>
                    {% endunless %}

                    {%- assign property_size = item.properties | size -%}

                    {% if property_size > 0 %}
                      {% for p in item.properties %}
                    {% assign first_character_in_key = p.first | truncate: 1, '' %}
{% unless p.last == blank or first_character_in_key == '_' %}
                        {{ p.first }}:

                        {% if p.last contains '/uploads/' %}
                          <a href="{{ p.last }}">{{ p.last | split: '/' | last }}</a>
                        {% else %}
                          {{ p.last }}
                        {% endif %}

                        {% endunless %}
                      {% endfor %}
                    {% endif %}

      
                    <a class="button--reset cart-drawer__itemAction js-remove-item" href="{{ item.url_to_remove }}">X</a>
                
                  <div data-label="{{ 'cart.label.price' | t }}">
                    {% if item.original_line_price != item.line_price %}
                    <span class="visually-hidden">{{ 'cart.label.original_price' | t }}</span>
                      <s>{{ item.original_price | money }}</s>  
                    <span class="visually-hidden">{{ 'cart.label.discounted_price' | t }}</span>
                      {{ item.price | money }}
                    {% else %}
                      {{ item.price | money }}
                    {% endif %}
                  </div>
                  <div data-label="{{ 'cart.label.quantity' | t }}">
                <div class='f aic jcb pt05'>
  <div class='pb15' >
 
  </div>
</div>
 </div>
</div>
 </div>                 
 </div>
          

              {% endfor %}
          </div>

        <footer class="cartPage__footer js-cart-footer x y">
  <section class="cart-footer__banner mxa ac">
      <p class="eyebrow ac">Free US Shipping on Orders Over $100</p>
  </section>
        <section class='cartPage-footer__total'>
        <div class='cart-footer__totalLine f aic jcb'>
          <span class='mv1 sans caps ac medium'>Subtotal</span>
          <div>
            {% if cart.original_total_price != cart.items_subtotal_price %}
            <span class="visually-hidden">{{ 'cart.original_total_price' | t }}</span>
                      <s>{{ cart.original_total_price | money }}</s>
                      <span class="visually-hidden">{{ 'cart.items_subtotal_price' | t }}</span>
          <span class='js-subtotal'>{{ cart.items_subtotal_price | money }}</span>
                      
                    {% else %}
                      <span class='js-subtotal'>{{ cart.items_subtotal_price | money }}</span>
            {% endif %}</div>
        </div>
        <a href="/checkout" class="btn btn--lg btn--dark cartPage--checkoutBttn" role="button">
  Checkout
</a>
      </section>
    </footer>
         
        </form>
      {% else %}
        <h1>{{ 'cart.general.title' | t }}</h1>

        {%- assign emptyCTA = settings.cart_empty_cta.url -%}
{%- assign emptyCTACopy = settings.cart_empty_cta_text -%}
  <div class='x y'>
    <div>
      <h4 class='caps'>Your Cart Is Empty</h4>
      {%
        include 'component-button' with
        tag: 'a',
        cta: emptyCTACopy,
        href: emptyCTA,
        className: 'button rel btn btn--dark cart-drawer__empty-btn'
      %}
    </div>
  </div>

       
      
      {% endif %}
  </div>
</section>



 