{% layout none %}
{%- assign colors_str = blank -%}

{% if shop.metafields.custom_fields["color_group_item"] != blank %}
  {% for item in shop.metafields.custom_fields["color_group_item"] %}
    {%- assign color_group_arr = blank -%}
    {%- assign color_name = item["color_name"] -%}
    {%- assign color_hex = item["color_hex"] -%}
    {%- assign color_includes = item["includes_color"] -%}

    {% if color_name != blank and color_hex != blank and color_includes != blank %}
      {%- assign color_group_arr = item["includes_color"] | split: ',' -%}

      {%- for item in color_group_arr -%}
        {%- assign item_handle = item | handleize -%}
        {%- assign colors_str = colors_str | append: '||' | append: color_name | append: '&&' | append: color_hex | append: '~' | append: item_handle | append: '~' -%}
      {%- endfor -%}

    {% endif %}
  {% endfor %}
{% endif %}

{% paginate collection.products by 1000 %}
{
  "products": [
  {%- for product in collection.products -%}

    {%- assign best_selling_order = forloop.index -%}

    {%- assign product_color_names = blank -%}
    {%- assign product_color_names_uniq = blank -%}
    {%- assign product_color_hex = blank -%}
    {%- assign product_color_hex_uniq = blank -%}
    {%- assign product_sizes = blank -%}
    {%- assign product_shop_by_use = blank -%}

    {%- assign option_color_index = blank -%}
    {%- assign option_size_index = blank -%}

    {%- comment -%} /// Get size & color option index /// {%- endcomment -%}

    {%- for option in product.options_with_values -%}
      {%- assign option_name = option.name | handleize -%}
      {%- if option_name == 'color' -%}
        {%- assign option_color_index = forloop.index | minus: 1 -%}
      {%- endif -%}
      {%- if option_name == 'size' -%}
        {%- assign option_size_index = forloop.index | minus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} /// Get all sizes & color types /// {%- endcomment -%}

    {%- if option_color_index != blank or option_size_index != blank -%}
      {%- for variant in product.variants -%}

        {%- if option_color_index != blank -%}
          {%- assign color_name = variant.options[option_color_index] -%}

          {%- if color_name contains ':' -%}
            {%- assign color_name = color_name | split: ':' | last | strip -%}
          {%- endif -%}

          {%- assign color_for_search = color_name | handleize | append: '~' | prepend: '~' -%}

          {%- if colors_str contains color_for_search -%}
            {%- assign first_split = colors_str | split: color_for_search | first -%}
            {%- assign second_split = first_split | split: '||' | last -%}
            {%- assign name = second_split | split: '&&' | first -%}
            {%- assign hex = second_split | split: '&&' | last -%}

            {%- assign product_color_names = product_color_names | append: name | append: '**' -%}
            {%- assign product_color_hex = product_color_hex | append: hex | append: '**' -%}
          {%- endif -%}
        {%- endif -%}

        {%- if option_size_index != blank -%}
          {%- assign product_sizes = product_sizes | append: variant.options[option_size_index] | append: '**' -%}
        {%- endif -%}

      {%- endfor -%}
    {%- endif -%}

    {%- comment -%} /// Get shop by use tag /// {%- endcomment -%}

    {%- for tag in product.tags -%}
      {%- assign tag_handle = tag | handleize -%}
      {%- if tag_handle contains 'shop-by-use' -%}
        {%- assign product_shop_by_use = tag | split: '__' | last | replace: '_', ' '  -%}
      {%- endif -%}
    {%- endfor -%}

    {%- assign product_color_names_uniq = product_color_names | split: '**' | uniq -%}
    {%- assign product_color_hex_uniq = product_color_hex | split: '**' | uniq -%}
    {%- assign product_sizes_uniq = product_sizes | split: '**' | uniq -%}

    {%- assign reviews_count = product.metafields.yotpo.reviews_count | plus: 0 -%}
    {%- if reviews_count == 0 -%}
      {%- assign reviews_count = false -%}
    {%- endif -%}

    {% assign badge_text = product.metafields.custom_fields.card_badge | default: false %}

    {%- assign not_bundle = true -%}
    {% for tag in product.tags %}
      {% if product.tags contains 'Bundle' %}
        {% assign not_bundle = false %}
      {% endif %}
    {% endfor %}

    {%- assign product_type_handle = product.type | handleize -%}
    {%- if product_type_handle != "gift-product" or product_type_handle != "gift-box" or product_type_handle != "personalization-fee" -%}
      {%- unless forloop.first -%},{%- endunless -%}{
      "title": {{ product.title | json }},
      "id": {{ product.id }},
      "featured_image": {
        "origin": "{{ product.featured_image | img_url: 'master' }}",
        "small": "{{ product.featured_image | img_url: 'x180' }}",
        "large": "{{ product.featured_image | img_url: 'x500'}}"
      },
      {% if product.template_suffix contains 'bundle' %}
        "bundle": true,
      {% endif %}
      "price_money": "{{ product.price | money | remove: '.00' }}",
      "price" : {{ product.price }},
      "price_min": {{ product.price_min }},
      {% if product.compare_at_price %}
        "compare_at_price": "{{ product.compare_at_price | money | remove: '.00' }}",
      {% endif %}
      "vendor": "{{ product.vendor }}",
      "relevance": {{ forloop.index | plus: ratio }},
      "published_date": "{{ product.published_at }}",
      "url": "{{ product.url }}",
      "best_sellers": {{ best_selling_order }},
      "inventory": {{ product.selected_or_first_available_variant.inventory_quantity }},
      "date": "{{ product.published_at }}",
      "facets": {
        "shop_by_use": {
          "names": {{ product_shop_by_use | json }}
        },
        "color": {
          "names": {{ product_color_names_uniq | json }},
          "hex": {{ product_color_hex_uniq | json }}
        },
        "sizes": {
          "names": {{ product_sizes_uniq | json}}
        }
      },
      "variants": [
      {% for variant in product.variants %}
        {%- assign variant_color_name = blank -%}
        {%- assign variant_color_hex = blank -%}
        {%- assign color_name = blank -%}

        {%- if option_color_index != blank -%}
          {%- assign color_name = variant.options[option_color_index] -%}

          {%- if color_name contains ':' -%}
            {%- assign color_name = color_name | split: ':' | last | strip -%}
          {%- endif -%}

          {%- assign color_for_search = color_name | handleize | append: '~' | prepend: '~' -%}

          {%- if colors_str contains color_for_search -%}
            {%- assign first_split = colors_str | split: color_for_search | first -%}
            {%- assign second_split = first_split | split: '||' | last -%}
            {%- assign variant_color_name = second_split | split: '&&' | first -%}
            {%- assign variant_color_hex = second_split | split: '&&' | last -%}
          {%- endif -%}
        {%- endif -%}

        {%- if option_size_index != blank -%}
          {%- assign variant_size = variant.options[option_size_index] -%}
        {%- endif -%}

        {%- assign variant_image = variant.image | default: product.featured_image -%}

        {%- assign compare_at_price_is_more_than_price = false -%}
        {%- assign variant_compare_at_price  = variant.compare_at_price -%}
        {%- assign variant_price = variant.price -%}

        {%- unless not_bundle -%}
          {%- assign variant_compare_at_price  = product.compare_at_price -%}
          {%- assign variant_price = product.price -%}
        {%- endunless -%}

        {%- if variant_compare_at_price > variant_price and variant_compare_at_price != blank -%}
          {%- assign compare_at_price_is_more_than_price = true -%}
        {%- endif -%}

        {%- assign show_badge = false -%}
        {% if badge_text and badge_text != blank and not_bundle == true %}
          {%- assign show_badge = true -%}
          {% elsif not_bundle == false %}

          {% if variant.price_max > variant.price %}
            {%- assign show_badge = true -%}
            {%- assign badge_value = product.compare_at_price_max | minus:product.price_max | times:0.01 | floor -%}
            {%- assign badge_text = 'Save up to $' | append: badge_value -%}
          {% endif %}

          {%- if product.compare_at_price > product.price -%}
            {%- assign show_badge = true -%}
            {%- assign badge_value = product.compare_at_price | minus:product.price | times:0.01 | floor -%}
            {%- assign badge_text = 'Save up to $' | append: badge_value -%}
          {%- endif -%}

        {% endif %}

        {%- assign options_in_card = false -%}
        {%- assign separator = blank -%}

        {%- if color_name != blank or variant_size != blank -%}

          {%- if color_name != blank and variant_size != blank -%}
            {%- assign separator = ' | ' -%}
          {%- endif -%}

          {%- assign options_in_card = color_name | append: separator | append: variant_size -%}
        {%- endif -%}

        {
        "title": {{ product.title | json }},
        "product_url": "{{ product.url }}",
        "product_id": {{ product.id }},
        "variant_url": "{{ variant.url }}",
        {% if product.template_suffix contains 'bundle' %}
          "bundle": true,
        {% endif %}
        "reviews_count": {{ reviews_count }},
        "available": {{ variant.available | json }},
        "id": {{ variant.id }},
        "options": {{ variant.options | json }},
        "options_in_card": "{{ options_in_card }}",
        "price": "{{ variant_price }}",
        "price_money": "{{ variant_price | money | remove: '.00' }}",
        "best_sellers": {{ best_selling_order }},
        "inventory": {{ variant.inventory_quantity }},
        "date": "{{ product.published_at }}",
        "budge": {{ show_badge }},
        "budge_text": "{{ badge_text }}",
        "compare_at_price_is_more_than_price": {{ compare_at_price_is_more_than_price }},
        "compare_at_price": "{{ variant_compare_at_price }}",
        "compare_at_price_money": "{{ variant_compare_at_price | money | remove: '.00' }}",
        "shop_by_use": {
          "value": {{ product_shop_by_use | json }}
          },
        "color": {
          "value": "{{ variant_color_name }}",
          "hex": "{{ variant_color_hex }}"
          },
        "size": {
          "value": {{ variant_size | json }}
          },
        "image": {
          "origin": "{{ variant_image | img_url: 'master' }}",
          "small": "{{ variant_image | img_url: 'x180' }}",
          "large": "{{ variant_image | img_url: 'x500' }}"
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {% endfor %}
      ]
    }
    {%- endif -%}
  {%- endfor -%}
  ]
}
{% endpaginate %}