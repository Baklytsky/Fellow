{% comment %}
TODO: Add Other Partnerships Links
{% endcomment %}

{% if page.metafields.custom_fields["desktop_masthead_image"] != blank %}
  {%- assign desktop_masthead = page.metafields.custom_fields["desktop_masthead_image"] -%}
{% endif %}
{% if page.metafields.custom_fields["mobile_masthead_image"] != blank %}
  {%- assign mobile_masthead = page.metafields.custom_fields["mobile_masthead_image"] -%}
{% endif %}
{% if page.metafields.custom_fields["page_intro_image"] != blank %}
  {%- assign introImage = page.metafields.custom_fields["page_intro_image"] -%}
{% endif %}
{% if page.metafields.custom_fields["partner_collection"] != blank %}
  {% assign collectionRef = page.metafields.custom_fields["partner_collection"] %}
  {% assign colRef = collections[collectionRef] %}
{% endif %}
{% if page.metafields.custom_fields["page_masthead_alt_text"] != blank %}
  {% assign masthead_alt = page.metafields.custom_fields["page_masthead_alt_text"] %}
{% else %}
  {% assign masthead_alt = page.title %}
{% endif %}

{% if desktop_masthead != blank %}
  {%
    include 'component-masthead' with
    img: desktop_masthead,
    imgMobile: mobile_masthead,
    dataAttr: 'componentMasthead',
    className: '',
    overlap: false
  %}
{% else %}
  {%
    include 'component-masthead' with
    dataAttr: 'componentMasthead',
    className: '',
    overlap: false
  %}
{% endif %}

<div class='container--l'>
  <section class='module'>
    <div class='row aic mt2'>
      {% if introImage != blank %}
        <div class='col-lg-4 introImage'>
          <div class="image">
            {% render 'image-lazy-metafields',
              image: introImage,
              alt: alt,
              size: 'medium',
              loader: true %}
          </div>
        </div>
      {% endif %}
      <div class='col offset-lg-1 introCopy'>
        <div class='rte'>
          {{ page.content }}
          {% if colRef != blank and colRef.available %}
            <a class='btn my1 caps' href='{{ colRef.url }}'>Shop The Collection</a>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% if page.metafields.custom_fields["partner_page_details"] != blank %}
    <section class='module'>
      {% assign separator = "|###|" %}
      {% assign details_product_array = page.metafields.custom_fields["details_product"] | split: separator %}
      {% assign details_image_array = page.metafields.custom_fields["details_image"] | split: separator %}
      {% assign details_title_array = page.metafields.custom_fields["details_title"] | split: separator %}
      {% assign details_copy_array = page.metafields.custom_fields["details_copy"] | split: separator %}
      {% assign fc_keys = page.metafields.custom_fields["partner_page_details"] | split: "," %}
      {% for i in fc_keys %}
        {% assign index = i | plus: 0 %}
        {% assign imgSrc = details_image_array[index] %}
        {% if details_product_array[index] != blank %}
          {% assign productRef = details_product_array[index] %}
          {%- assign details_product = all_products[productRef] -%}
        {% endif %}
        <div class="row partnership-detail detail-row aic my3rem">
          <div class="col-lg-6 detailRow--image">
            <div class="image">
              {% render 'image-lazy-metafields',
                image: imgSrc,
                alt: alt,
                size: 'medium',
                loader: true %}
            </div>
          </div>
          <div class="col-lg-6 detailRow--copy">
            <h2 class='caps'>
              {{ details_title_array[index] }}
            </h2>
            <div class='rte'>
              {{ details_copy_array[index] }}
              {% if details_product != blank and details_product.available %}
                <script>
                  console.log({{ details_product | json }})
                </script>
                <a class='btn my1 caps' href='{{ details_product.url }}'>Shop Now</a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </section>
  {% endif %}

  <section class='module'>
    <div class='rel x ac'>
      <h1 class='caps'>About</h1>
    </div>
    <div class='row'>
      {% if page.metafields.custom_fields["partner_page_about_copy"] != blank %}
        <div class='col-lg-6'>
          {{ page.metafields.custom_fields["partner_page_about_copy"] }}
        </div>
      {% endif %}
      {% if page.metafields.custom_fields["partner_page_about_image"] != blank %}
        <div class='col-lg-6'>
          {% assign aboutImage = page.metafields.custom_fields["partner_page_about_image"] %}
          <div class="image">
            {% render 'image-lazy-metafields',
              image: aboutImage,
              alt: alt,
              size: 'medium',
              loader: true %}
          </div>
        </div>
      {% endif %}
    </div>
  </section>
</div>