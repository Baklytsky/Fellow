{% layout none %}
<div id="Product" class="pdpTemplate">
  {%- assign meta_reviews_count = product.metafields.yotpo.reviews_count | plus: 0 -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}

  <script text="text/javascript">
    var _learnq = _learnq || [];

    var item = {
      Name: {{ product.title|json }},
      ProductID: {{ product.id|json }},
      Categories: {{ product.collections|map:'title'|json }},
      ImageURL: "https:{{ product.featured_image.src|img_url:'grande' }}",
      URL: "{{ shop.secure_url }}{{ product.url }}",
      Brand: {{ product.vendor|json }},
      Price: {{ product.price|money|json }},
      CompareAtPrice: {{ product.compare_at_price_max|money|json }}
    };

    _learnq.push(['track', 'Viewed Product', item]);
    _learnq.push(['trackViewedItem', {
      Title: item.Name,
      ItemId: item.ProductID,
      Categories: item.Categories,
      ImageUrl: item.ImageURL,
      Url: item.URL,
      Metadata: {
        Brand: item.Brand,
        Price: item.Price,
        CompareAtPrice: item.CompareAtPrice
      }
    }]);
  </script>

  {%- assign show_quantity_selector = true -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

  <product-quick-view id="ProductQuickView" data-product-id="{{ product.id }}">
    {% assign current_variant = product.selected_or_first_available_variant %}
    <div class='pdpMain no-gutters'>
      <div class='pdpQuickView__gallery'>
        {% include 'pdp-image-thumbnails-quick-view.liquid' %}
      </div>
      <div class='pdpQuickView__description'>

        {% if product.metafields.custom_fields["product_tagline"] != blank %}
          {% assign tagline = product.metafields.custom_fields["product_tagline"] %}
        {% endif %}

        {% capture dataProductForm %}
          { "money_format": {{ shop.money_format | json }}, "button": {{ 'products.product.add_to_cart' | t | json }} }
        {% endcapture %}

        <div class='pdpMain__details z2 rel'>
          {% form 'product', product, data-product-form: dataProductForm %}
          <div class='pdpCopy__header'>
            <h1 class='pdpCopy__header-title'>
              <a href="{{ product.url }}" class="QuickView__FullPageLink">{{ product.title }}</a>
            </h1>
            <div class='f ais QuickView__Price'>
              <h2 class="ml1 visually-hidden">
                {{ current_variant.price | money | remove: '.00' }}
              </h2>
              {% if product.available %}
                {% if current_variant.compare_at_price > current_variant.price %}
                  {% comment %}
                    Product is available and on sale
                  {% endcomment %}
                  <div class="f aic">
                    <span class="strike card__price--regular ml1 pdpCopy__header-price pdpCopy__header-price-small rel">
                      {{ current_variant.compare_at_price | money_without_trailing_zeros }}
                      <div class="price-round-arrow">{% render 'icon' with 'round-arrow' %}</div>
                    </span>
                    <span class="visually-hidden">{{ 'products.current_variant.regular_price' | t }}</span>
                    <h2 class="card__price--sale ml1 pdpCopy__header-price">
                      {{ current_variant.price | money_without_trailing_zeros }}
                    </h2>
                  </div>
                {% else %}
                  {% comment %}
                    Product is available and not on sale
                  {% endcomment %}
                  <h2 class="ml1 pdpCopy__header-price">
                    {{ current_variant.price | money | remove: '.00' }}
                  </h2>
                {% endif %}
              {% else %}
                {% comment %}
                  Sold Out
                {% endcomment %}
                <h2 class='strike'>{{ current_variant.price | money_without_trailing_zeros }}</h2>
              {% endif %}
            </div>

            {% if product.description != blank %}
              <div class='pdp__description'>
                <p>{{ product.description | strip_html }}</p>
              </div>
            {% endif %}

            <div data-shop-pay class='shop-pay mb15'>
              {{ form | payment_terms }}
            </div>
          </div>

          {% include 'product-options' %}

          {% if section.settings.show_quantity_selector != true %}
            <div class='pb15'
                {% if section.settings.show_quantity_selector != true or product.tags contains 'gift' %}
                style='display:none'
                {% endif %}>
              {% include 'component-counter' %}
            </div>
          {% endif %}

          <div class='f fdr jcb' id='atc-wrapper'>
            {%- assign hasPreorderTag = false -%}
            {%- if product.tags contains 'preorder' -%}
              {%- assign hasPreorderTag = true -%}
            {%- endif -%}
            {%- capture cta -%}
              {% if product.available %}
                <span data-atc-copy class="js-atc-copy">
                  {% if product.selected_variant.metafields.my_fields.preorder or hasPreorderTag %}
                    Pre-Order
                  {% else %}
                    Add to Cart
                  {% endif %}
                </span>
                {%- assign disableVal = false -%}
              {% else %}
                {% if product.tags contains 'discontinued' %}
                  Discontinued
                {% else %}
                  Out of Stock
                {% endif %}
                {%- assign disableVal = true -%}
              {% endif %}
            {%- endcapture -%}

            {%- assign cta_data = product.selected_or_first_available_variant.id | prepend: 'data-add-id="' | append: '" data-add-qty="1"' -%}
            <div class="pdpDetails__btns" data-disabled-size="{{ product_has_size_option }}">

              {%- if product_has_size_option -%}
                <button type="button" class="cart__button--select-size" disabled>Select size</button>
              {%- endif -%}

              {% include 'component-button' with
                tag: 'button',
                id: 'quickAdd',
                name: 'add',
                type: 'submit',
                href: '#',
                className: 'js-add-to-cart cart__button',
                dataAttr: cta_data,
                disabled: disableVal,
                cta: cta, %}
            </div>

          </div>

          <p class="PdpErrorMessage"></p>

          <div class='d-md-none' data-pay-btn>
            <div class='py1'>
              {{ form | payment_button }}
            </div>
          </div>
          <a href="{{ product.url }}" class="QuickView__FullPage QuickView__FullPageLink">See full page</a>
        </div>
        {% endform %}
      </div>
    </div>
    <script type="application/json">
      {{ product | json }}
    </script>
  </product-quick-view>
</div>
