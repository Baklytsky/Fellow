<div id="Product" class="pdpTemplate">
  {%- assign meta_reviews_count = product.metafields.yotpo.reviews_count | plus: 0 -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}

  <div class='hide'>
    <meta itemprop="name" content="{{ product.title }}{% unless product.has_only_default_variant %} - {{ current_variant.title }}{% endunless %}">
    <meta itemprop="url" content="{{ shop.url }}{{ current_variant.url }}">
    <meta itemprop="brand" content="{{ product.vendor }}">
    <meta itemprop="image" content="{{ featured_image | img_url: '600x600' }}">
    <meta itemprop="description" content="{{ product.description | strip_html | escape }}">

    <script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      "name": "{{ product.title }}",
      "url": "{{ shop.url }}{{ current_variant.url }}",
      "image": "{{ featured_image | img_url: '600x600' }}",
      "description": "{{ product.description | strip_html | strip_newlines }}",
      "sku": "{{ current_variant.sku }}",
      "gtin": "{{ current_variant.barcode }}",
      "gtin13": "0{{ current_variant.barcode }}",
      "brand": {
        "@type": "Thing",
        "name": "{{ product.vendor }}"
      },{% if meta_reviews_count > 0 %}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{ product.metafields.yotpo.reviews_average }}",
        "reviewCount": "{{ meta_reviews_count }}"
      },{% endif %}
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ current_variant.url }}",
        "priceCurrency": "{{ shop.currency }}",
        "price": "{{ current_variant.price | money_without_currency }}",
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "http://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "seller": {
          "@type": "Organization",
          "name": "{{ product.vendor }}"
        }
      }
    }
  </script>


    {% comment %}
      <script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      "name": "{{ product.title }}",
      "url": "{{ shop.url }}{{ product.url }}",
      {% if product.featured_image %}
        {% assign image_size = product.featured_image.width | append: 'x' %}
        "image": [
          "https:{{ product.featured_image.src | img_url: image_size }}"
        ],
      {% endif %}
      "description": "{{ product.description | strip_html }}",
      {% if current_variant.sku != blank %}
        "sku": "{{ current_variant.sku }}",
      {% endif %}
      "brand": {
        "@type": "Thing",
        "name": "{{ product.vendor }}"
      },
      {% if product.variants %}
        "offers": [
          {% for variant in product.variants %}
            {
              "@type" : "Offer",
              "availability" : "http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
              "price" : "{{ variant.price | divided_by: 100.00 }}",
              "priceCurrency" : "{{ shop.currency }}",
              "url" : "{{ shop.url }}{{ variant.url }}",
              "itemOffered" :
              {
                  "@type" : "Product",
                  {% if variant.image %}
        {% assign variant_image_size = variant.image.width | append: 'x' %}
                    "image": "http:{{ variant.image.src | img_url: variant_image_size }}",
                  {% endif %}
        {% if variant.title != blank %}
                    "name" : "{{ variant.title }}",
                  {% endif %}
        {% if variant.sku != blank %}
                    "sku": "{{ variant.sku }}",
                  {% endif %}
        {% if variant.weight != blank %}
                    "weight": {
                      "@type": "QuantitativeValue",
                      {% if variant.weight_unit != blank %}
                        "unitCode": "{{ variant.weight_unit }}",
                      {% endif %}
                      "value": "{{ variant.weight | weight_with_unit: variant.weight_unit }}"
                    },
                  {% endif %}
                  "url": "{{ shop.url }}{{ variant.url }}"
              }
            }{% unless forloop.last %},{% endunless %}
        {% endfor %}
        ]
      {% endif %}
    }
  </script>
    {% endcomment %}

    <script id="productJson-{{ product.id }}" class="js-product-json" type='text/template'>
      {
      "selectedOrFirstAvailableVariant": {{ current_variant.id | json }},
      "product": {{ product | json }}
      }
    </script>
  </div>

  <script text="text/javascript">
    var _learnq = _learnq || [];

    var item = {
      Name: {{ product.title|json }},
      ProductID: {{ product.id|json }},
      Categories: {{ product.collections|map:'title'|json }},
      ImageURL: "https:{{ product.featured_image.src|img_url:'grande' }}",
      URL: "{{ shop.secure_url }}{{ product.url }}",
      Brand: {{ product.vendor|json }},
      Price: {{ product.price|money|json }},
      CompareAtPrice: {{ product.compare_at_price_max|money|json }}
    };

    _learnq.push(['track', 'Viewed Product', item]);
    _learnq.push(['trackViewedItem', {
      Title: item.Name,
      ItemId: item.ProductID,
      Categories: item.Categories,
      ImageUrl: item.ImageURL,
      Url: item.URL,
      Metadata: {
        Brand: item.Brand,
        Price: item.Price,
        CompareAtPrice: item.CompareAtPrice
      }
    }]);
  </script>
  {%- assign show_quantity_selector = true -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

  <div id="ProductQuickView" data-product-id="{{ product.id }}">
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% if product.metafields.custom_fields["desktop_masthead_image"] or product.metafields.custom_fields["mobile_masthead_image"] != blank %}
      {%- assign masthead_exists = true -%}
    {% endif %}
    <div class='module full' {%- comment -%}data-component='pdpMain'{%- endcomment -%}>
      <div class='pdpMain row no-gutters'>
        <div class='col-lg-7 order-lg-1'>

          {% include 'pdb-image-thumbnails.liquid' %}

        </div>
        <div class='col-lg-5 order-lg-2'>

          {% if product.metafields.custom_fields["product_tagline"] != blank %}
            {% assign tagline = product.metafields.custom_fields["product_tagline"] %}
          {% endif %}

          {% capture dataProductForm %}
            { "money_format": {{ shop.money_format | json }}, "button": {{ 'products.product.add_to_cart' | t | json}} }
          {% endcapture %}

          <div class='pdpMain__details z2 rel'>
            {% form 'product', product, data-product-form: dataProductForm %}
              <div class='pdpCopy__header'>
                <div class='f fdc jcc ais'>
                  <h1 class='pdpCopy__header-title'>{{ product.title }}</h1>
                  <h2 data-selected-var-price class="ml1 visually-hidden">{{ current_variant.price | money | remove: '.00' }}</h2>
                  {% if product.available %}
                    {% if product.compare_at_price > product.price %}

                      <h2 class="inline-block card__price--sale ml1 pdpCopy__header-price">
                        {{ current_variant.price | money_without_trailing_zeros }}
                      </h2>
                      <span class="visually-hidden">{{ 'products.current_variant.regular_price' | t }}</span>
                      <strong class="inline-block strike card__price--regular ml1 pdpCopy__header-price">{{ current_variant.compare_at_price | money_without_trailing_zeros }}</strong>
                    {% else %}
                      <h2 data-selected-var-price class="m0 pdpCopy__header-price">{{ current_variant.price | money | remove: '.00' }}</h2>
                    {% endif %}
                  {% else %}
                    <h2 class='strike'>{{ current_variant.price | money_without_trailing_zeros }}</h2>
                  {% endif %}
                </div>

                {% if tagline != blank %}
                  <div class='pdp__tagline'>
                    {{ tagline | capitalize }}
                  </div>
                {% endif %}

                {% if product.description != blank %}
                  <div class='pdp__description'>
                    <p>{{ product.description | truncate: 300 | strip_html }}</p>
                  </div>
                {% endif %}

                <div class="pdp__reviews hide-mobile">
                  {%- assign reviews_count = product.metafields.yotpo.reviews_count | plus: 0 -%}
                  {%- if reviews_count > 0 -%}
                    {% include 'yotpo-star-rating-widget' %}
                  {%- endif -%}
                </div>

                <div data-shop-pay class='shop-pay mb15'>
                  {{ form | payment_terms }}
                </div>
              </div>

              {% include 'product-options' %}

              {% if section.settings.quantity_selector_inline != true %}
                <div class='pb15'
                    {% if section.settings.show_quantity_selector !=true or product.tags contains 'gift' %}
                      style='display:none'
                    {% endif %}>

                  {% include 'component-counter' %}
                </div>
              {% endif %}

                <div class='{% if template contains 'gift_card' %}f fdc jcb{% else %}f fdr jcb{% endif %}'  id='atc-wrapper'>

                {% unless template contains 'gift_card' %}
                  {% if section.settings.show_quantity_selector and section.settings.quantity_selector_inline %}
                    <div class="f is-inline">
                      {% include 'component-counter' %}
                    </div>
                  {% endif %}
                {% endunless %}

                {%- capture cta -%}
                  {% if product.available %}
                    <span data-atc-copy class="js-atc-copy">
                      {% if product.tags contains 'preorder' %}
                        Preorder
                      {% else %}
                        Add to Cart
                      {% endif %}
                    </span>
                    <span data-selected-var-price style="display: none">{{ current_variant.price | money }}</span>
                    {%- assign disableVal = false -%}
                  {% else %}
                    {% if product.tags contains 'discontinued' %}
                      Discontinued
                    {% else %}
                      Out of Stock
                    {% endif %}
                    {%- assign disableVal = true -%}
                  {% endif %}
                {%- endcapture -%}

                {%- assign cta_data = product.selected_or_first_available_variant.id | prepend: 'data-add-id="' | append: '" data-add-qty="1"' -%}
                  <div class="pdpDetails__btns" data-disabled-size="{{ product_has_size_option }}">

                    {%- if product_has_size_option -%}
                      <button type="button" class="cart__button--select-size" disabled>Select size</button>
                    {%- endif -%}

                    {%
                      include 'component-button' with
                      tag: 'button',
                      id: 'quickAdd',
                      name: 'add',
                      type: 'submit',
                      href: '#',
                      className: 'cart__button',
                      dataAttr: cta_data,
                      disabled: disableVal,
                      cta: cta,
                    %}

                    <div class='is-hidden' data-bis>
                      <button class='button cart__button klaviyo-bis-trigger'>Out of Stock | Notify Me</button>
                    </div>
                  </div>

              </div>
              
              <p id="PdpErrorMessage"></p>

              <div class='d-md-none' data-pay-btn>
                <div class='py1'>
                  {{ form | payment_button }}
                </div>
              </div>
            <a href="{{ product.url }}" class="QuickView__FullPage">See full page</a>
            </div>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>