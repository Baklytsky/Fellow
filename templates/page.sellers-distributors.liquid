{% section 'page-template' %}

{% if page.metafields.custom_fields["regions"] != blank %}
    <div class="sellers-distributors container--l" data-component='accordion' data-watch-css>
      {% assign regions = page.metafields.custom_fields["regions"] %}
      {% for region in regions %}
          <section class="sellers-distributors__region">
            <h2 class="sellers-distributors__region-name js-accordion-toggle" role="button" tabindex="0">{{ region["name"] }}</h2>
            <div class="sellers-distributors__countries row js-accordion-content">
              {% assign sorted_countries = region["countries"] | sort_natural: 'name' %}
              {% for country in sorted_countries %}
                <div class="sellers-distributors__country {% if two_column_array[index] == '1' %}col-lg-6{% else %}col-lg-3{% endif %}">
                  <h3 class="sellers-distributors__country-name">
                    {{ country["name"] }}
                  </h3>

                  <div class="sellers-distributors__country-content">
                    {{ country["content"] }}
                  </div>
                </div>
              {% endfor %}
            </div>
          </section>
      {% endfor %}
    </div>
{% endif %}