<account-element class="account-wrapper">
  <div class="page-wrapper">
    <div class="account-login__reset-pass account-dialog">
      <h2 class="account-heading">{{ 'customer.activate_account.title' | t }}</h2>
      <div class="account-text">{{ 'customer.activate_account.subtext' | t }}</div>

      {% form 'activate_customer_password' %}
      {%- assign inputClassName = blank -%}

        {% if form.errors %}
          <div class='account-error'>
            {%- render 'icon' with 'error' -%}
            <span>{{ form.errors | default_errors }}</span>
          </div>
          {%- assign inputClassName = 'input-error' -%}
        {% endif %}

      {%- assign activate_password_label = 'customer.activate_account.password' | t -%}

        {% render 'component-input'
          label: activate_password_label,
          name: 'customer[password]',
          type: 'password',
          className: inputClassName %}

      {%- assign activate_confirm_password_label = 'customer.activate_account.password_confirm' | t -%}

        {% render 'component-input'
          label: activate_confirm_password_label,
          name: 'customer[password_confirmation]',
          type: 'password',
          className: inputClassName %}

      {%- assign activate_accepts_marketing_label = 'customer.activate_account.accepts_marketing' | t -%}
        {%- if settings.email_klaviyo_list_id != blank -%}
          {%- assign accepts_email_marketing_attr = 'data-klaviyo-list-id=' | append:'"' | append: settings.email_klaviyo_list_id | append:'"'  -%}
        {%- endif -%}

      {% render 'component-input'
        label: activate_accepts_marketing_label,
        name: 'customer[accepts_marketing]',
        type: 'checkbox',
        value: 'false',
        className: inputClassName,
        attr: accepts_email_marketing_attr
      %}

      {%- assign activate_btn_cta = 'customer.activate_account.submit' | t -%}

        {% render 'component-button'
          tag: 'button',
          type: 'submit',
          cta: activate_btn_cta,
          className: 'account-btn btn btn--lg btn--dark' %}

        {%- if settings.contact_us_link != blank -%}
          <div class='account-subtitle f aic'>
            Need help? <a href="{{ settings.contact_us_link }}" target="_blank">Contact Us</a>
          </div>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</account-element>