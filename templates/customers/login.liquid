<account-element class='account-wrapper'>
  {%- assign show_recover = false -%}

  <div class='page-wrapper'>
    <div id="recover" class="account-login__recover-wrapper" data-dialog>
      <div class='account-login__recover account-dialog'>
        <h2 class='account-heading'>{{ 'customer.recover_password.title' | t }}</h2>

        {% form 'recover_customer_password' %}

          {%- unless form.posted_successfully? -%}
            <div class='account-text'>{{ 'customer.recover_password.subtext' | t }}</div>
          {%- endunless -%}

          {%- assign inputClassName = blank -%}
          {%- assign inputErrorMessage = blank -%}

          {% if form.errors %}
            <div class='account-error'>
              {%- render 'icon' with 'error' -%}
              <span>
                  That email address does not match our records. Please try again or
                  <a href="{{ routes.account_register_url }}">create an account</a>.
                </span>
            </div>
            {%- assign inputClassName = 'input-error' -%}
            {%- assign inputErrorMessage = 'customer.recover_password.error_message' | t -%}
          {% endif %}

          {% if form.posted_successfully? %}
            {%- assign show_recover = true -%}
            <div class='account-text account-text-recover'>{{ 'customer.recover_password.success' | t }}</div>
          {% else %}

            {%- assign recover_email_label = 'customer.recover_password.email' | t -%}

            {%
              render 'component-input'
              label: recover_email_label,
              name: 'email',
              type: 'email',
              className: inputClassName,
              inputErrorMessage: inputErrorMessage,
              autocomplete: 'on'
            %}

            {%- assign reset_btn_cta = 'customer.recover_password.submit' | t -%}

            {%
              render 'component-button'
              tag: 'button',
              type: 'submit',
              cta: reset_btn_cta,
              className: 'account-btn btn btn--lg btn--dark'
            %}
        {% endif %}

          {%- unless form.posted_successfully? -%}
            <button type="button" class='js-recover-cancel' data-toggle-dialog="login_form">or <span>{{ 'customer.reset_password.cancel' | t }}</span></button>
          {%- endunless -%}

        {% endform %}
      </div>
    </div>

    <div id="login_form" class="account-login__login-wrapper" data-dialog {% if show_recover %}style="display: none" {% endif %}>
      <div class='account-login__login account-dialog'>
        <h2 class='account-heading'>{{ 'customer.login.sign_in' | t }}</h2>

        {% form 'customer_login' %}
        {%- assign inputClassName = '' -%}

          {% if form.errors %}
            <div class='account-error'>
              {%- render 'icon' with 'error' -%}
              <span>
                The email and/or password provided don't match our records. Try again or
                <button type="button" class='js-recover-trigger' data-toggle-dialog="recover">reset your password</button>.
              </span>
            </div>
            {%- assign inputClassName = 'input-error' -%}
          {% endif %}

        {%- assign login_email_label = 'customer.login.email' | t -%}

          {%
            render 'component-input'
            label: login_email_label,
            name: 'customer[email]',
            type: 'email',
            className: inputClassName,
            autocomplete: 'on'
          %}

        {%- assign login_password_label = 'customer.login.password' | t -%}

          {%
            render 'component-input'
            label: login_password_label,
            name: 'customer[password]',
            type: 'password',
            className: inputClassName
          %}

          <button type="button"
                  class='js-recover-trigger'
                  data-toggle-dialog="recover" {% if show_recover %}data-click-trigger{% endif %}>{{ 'customer.login.forgot_password' | t }}</button>

        {%- assign login_submit_cta = 'customer.login.sign_in' | t -%}

          {%
            render 'component-button'
            tag: 'button',
            type: 'submit',
            cta: login_submit_cta,
            className: 'account-btn btn btn--lg btn--dark'
          %}
        {% endform %}

        {%- if settings.contact_us_link != blank -%}
          <div class='account-subtitle f aic'>
            Need help? <a href="{{ settings.contact_us_link }}" target="_blank">Contact Us</a>
          </div>
        {%- endif -%}

        {% if shop.checkout.guest_login %}
          <div class='h1 px1'>
            <hr class='cgm' />
          </div>

          {% form 'guest_login' %}
            {%
              include 'button' with
              tag: 'button',
              type: 'submit',
              cta: 'Continue as a guest',
              className: 'btn btn__blue',
              outline: true
            %}
          {% endform %}
        {% endif %}
      </div>

      <div class="account-login__create account-dialog rel">
        <h2 class="account-heading">{{ 'customer.login.create_title' | t  }}</h2>
        <div class="account-text">{{ 'customer.login.create_description' | t  }}</div>

        {%- assign create_account_cta = 'customer.login.create' | t -%}

        {% render 'component-button'
          href: routes.account_register_url,
          cta: create_account_cta,
          className: 'account-btn btn btn--lg btn--dark' %}
      </div>
    </div>
  </div>
</account-element>
