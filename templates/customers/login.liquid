<account-element class='account-wrapper'>
  <div class='page-wrapper'>
    <div class="account-login__recover-wrapper js-recover-dialog" data-dialog>
      <div class='account-login__recover account-dialog'>
        <h2 class='account-heading'>{{ 'customer.reset_password.title' | t }}</h2>
        <div class='account-text'>{{ 'customer.reset_password.subtext' | t }}</div>

        {% form 'recover_customer_password' %}

          {% if form.posted_successfully? %}
            <span class='js-recover-success'>Success! Check your email for a link to reset your password.</span>
          {% else %}
            {%
              include 'component-input' with
              label: 'Email',
              name: 'email',
              type: 'email'
            %}

            {% if form.errors %}
              {% for field in form.errors %}
                {% if field == 'form' %}
                  <p class='small cg'>{{ form.errors.messages[field] }}</p>
                {% else %}
                  <p class='small cg'>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}.</p>
                {% endif %}
              {% endfor %}
            {% endif %}

            {%
              include 'component-button' with
              tag: 'button',
              type: 'submit',
              cta: 'Reset password',
              className: 'account-btn btn btn--lg btn--dark'
            %}
        {% endif %}

        {% endform %}

        <button type="button" class='js-recover-cancel' data-toggle-dialog>or <span>{{ 'customer.reset_password.cancel' | t }}</span></button>
      </div>
    </div>

    <div class="account-login__login-wrapper js-login-dialog active" data-dialog>
      <div class='account-login__login account-dialog'>
        <h2 class='account-heading'>{{ 'customer.login.sign_in' | t }}</h2>

        {% form 'customer_login' %}
        {%- assign inputClassName = '' -%}

          {% if form.errors %}
            <div class='account-error'>
              {%- render 'icon' with 'error' -%}
              <span>
                The email and/or password provided don't match our records. Try again or
                <button type="button" class='js-recover-trigger' data-toggle-dialog>reset your password</button>.
              </span>
            </div>
            {%- assign inputClassName = 'input-error' -%}
          {% endif %}

          {%
            include 'component-input' with
            label: 'Email',
            name: 'customer[email]',
            type: 'email',
            className: inputClassName
          %}

          {%
            include 'component-input' with
            label: 'Password',
            name: 'customer[password]',
            type: 'password',
            className: inputClassName
          %}

          <button type="button" class='js-recover-trigger' data-toggle-dialog>{{ 'customer.login.forgot_password' | t }}</button>

          {%
            include 'component-button' with
            tag: 'button',
            type: 'submit',
            cta: 'Sign in',
            className: 'account-btn btn btn--lg btn--dark'
          %}
        {% endform %}

        {%- if settings.contact_us_link != blank -%}
          <div class='account-subtitle f aic'>
            Need help? <a href="{{ settings.contact_us_link }}" target="_blank">Contact Us</a>
          </div>
        {%- endif -%}

        {% if shop.checkout.guest_login %}
          <div class='h1 px1'>
            <hr class='cgm' />
          </div>

          {% form 'guest_login' %}
            {%
              include 'button' with
              tag: 'button',
              type: 'submit',
              cta: 'Continue as a guest',
              className: 'btn btn__blue',
              outline: true
            %}
          {% endform %}
        {% endif %}
      </div>

      <div class="account-login__create account-dialog rel">
        <h2 class="account-heading">{{ 'customer.login.create_title' | t  }}</h2>
        <div class="account-text">{{ 'customer.login.create_description' | t  }}</div>

        {%- assign create_account_cta = 'customer.login.create' | t -%}

        {% include 'component-button' with
          href: '/account/register'
          cta: create_account_cta,
          className: 'account-btn btn btn--lg btn--dark' %}
      </div>
    </div>
  </div>
</account-element>
