<account-element class='account-page page-wrapper' tabindex="0">
  <div class="account-breadcrumbs hide-mobile">
    <nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
      <ol>
        <li><a href="/" title="Home">Home</a></li>
        <li><a href="{{ routes.account_url }}" aria-current="page">Account Overview</a></li>
        <li aria-current="page">Order Details</li>
      </ol>
    </nav>
  </div>
  <div class='account-wrapper'>
    <div class="account-sidebar">
      <h2 class="account-heading hide-mobile">{{ 'customer.account.title' | t: name: customer.first_name }}</h2>
      <div class="account-sidebar-menu">
        <a href="{{ routes.account_url }}"
           class="account-sidebar-menu-item f aic" data-acoount-overview>
          {%- render 'icon' with 'customer-logo' -%}
          {{ 'customer.account.overview' | t }}
        </a>
        <a href="{{ routes.account_logout_url }}" class="account-sidebar-menu-item f aic hide-mobile">
          {%- render 'icon' with 'sign-out' -%}
          {{ 'customer.account.sign_out' | t }}
        </a>
      </div>
    </div>

    <section class='account-home rel'>
      {%- render 'account-order', order: order -%}
    </section>
  </div>

</account-element>
