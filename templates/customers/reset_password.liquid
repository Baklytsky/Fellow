<account-element class="account-wrapper">
  <div class="page-wrapper">
    <div class="account-login__reset-pass account-dialog">
      {% form 'reset_customer_password' %}
      {%- assign inputClassName = blank -%}

        <h2 class="account-heading">{{ 'customer.reset_password.title' | t }}</h2>
        {%- comment -%}
          <div class="account-text">{{ 'customer.reset_password.subtext' | t: email: email }}</div>
        {%- endcomment -%}

        {% if form.errors %}
          <div class='account-error'>
            {%- render 'icon' with 'error' -%}
            <span>{{ form.errors | default_errors }}</span>
          </div>
          {%- assign inputClassName = 'input-error' -%}
        {% endif %}

      {%- assign reset_password_label = 'customer.reset_password.password' | t -%}

        {% render 'component-input'
          label: reset_password_label,
          name: 'customer[password]',
          type: 'password',
          className: inputClassName %}

      {%- assign reset_confirm_password_label = 'customer.reset_password.password_confirm' | t -%}

        {% render 'component-input'
          label: reset_confirm_password_label,
          name: 'customer[password_confirmation]',
          type: 'password',
          className: inputClassName %}

      {%- assign reset_btn_cta = 'customer.activate_account.submit' | t -%}

        {% render 'component-button'
          tag: 'button',
          type: 'submit',
          cta: reset_btn_cta,
          className: 'account-btn btn btn--lg btn--dark' %}

        {%- if settings.contact_us_link != blank -%}
          <div class='account-subtitle f aic'>
            Need help? <a href="{{ settings.contact_us_link }}" target="_blank">Contact Us</a>
          </div>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</account-element>
