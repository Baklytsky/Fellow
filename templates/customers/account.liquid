<account-element class='account-page page-wrapper' tabindex="0">
  <div class='account-wrapper'>
    <div class="account-sidebar">
      <h2 class="account-heading hide-mobile">{{ 'customer.account.title' | t: name: customer.first_name }}</h2>
      <div class="account-sidebar-menu">
        <a href="{{ routes.account_url }}"
           class="account-sidebar-menu-item f aic current-page" data-acoount-overview>
          {%- render 'icon' with 'customer-logo' -%}
          {{ 'customer.account.overview' | t }}
        </a>
        <a href="{{ routes.account_logout_url }}" class="account-sidebar-menu-item f aic hide-mobile">
          {%- render 'icon' with 'sign-out' -%}
          {{ 'customer.account.sign_out' | t }}
        </a>
      </div>
    </div>

    <section class='account-home rel'>
      {%- render 'account-update',
        customer: customer,
        formClassName: 'account-address-form'  -%}

      {% render 'account-address-form',
        id: 'new',
        formClassName: 'account-address-form',
        action: customer.new_address,
        title: 'Add New Address',
        cta: 'Save' %}

      {%- unless customer.addresses_count == 0 -%}
        {%- for address in customer.addresses -%}
          {%
            render 'account-address-form',
            id: address.id,
            action: address,
            formClassName: 'account-address-form',
            title: 'Edit Shipping Address',
            cta: 'Save'
          %}
        {%- endfor -%}
      {%- endunless -%}

      <div class="account-home-content" data-account-content>
        <div class='account-orders'>
          {%- render 'account-orders', customer: customer -%}
        </div>

        <div class="account-info">
          {%- render 'account-info', customer: customer -%}
        </div>

        <div class="account-address">
          <h2 class="account-heading">{{ 'customer.addresses.title' | t }}</h2>

          <div class="account-action-wrapper f aic account-action-add-address">
            <button type="button" class="account-action-btn" data-toggle-address="new">
              {{ 'customer.addresses.add_new' | t }}
            </button>
          </div>

          {%- unless customer.addresses_count == 0 -%}
            {%- for address in customer.addresses -%}
              {% assign default_addy = false %}

              {% if customer.default_address == address %}
                {% assign default_addy = true %}
              {% endif %}

              {%
                render 'account-address',
                address: address,
                default: default_addy,
                edit: true
              %}
            {%- endfor -%}
          {%- endunless -%}

        </div>

        {%- unless customer.accepts_marketing -%}

          <div class="account-contact-preferences">
            <h2 class="account-heading">{{ 'customer.addresses.contact_preferences' | t }}</h2>
            <form action="/">
              {%- assign register_accepts_marketing_label = 'customer.register.accepts_marketing' | t -%}
                {%- if settings.email_klaviyo_list_id != blank -%}
                  {%- assign accepts_email_marketing_attr = 'data-klaviyo-list-id=' | append:'"' | append: settings.email_klaviyo_list_id | append:'"' -%}
                {%- endif -%}

              {% render 'component-input'
                label: register_accepts_marketing_label,
                name: 'customer[accepts_marketing]',
                type: 'checkbox',
                value: 'false',
                className: inputClassName,
                attr: accepts_email_marketing_attr %}

              {%- assign register_accepts_sms_marketing_label = 'customer.register.accepts_sms_marketing' | t -%}
                {%- if settings.sms_klaviyo_list_id != blank -%}
                  {%- assign accepts_sms_marketing_attr = 'data-klaviyo-list-id=' | append:'"' | append: settings.sms_klaviyo_list_id | append:'"' -%}
                {%- endif -%}

              {% render 'component-input'
                label: register_accepts_sms_marketing_label,
                name: 'customer[sms_marketing_consent]',
                type: 'checkbox',
                value: 'false',
                className: inputClassName,
                attr: accepts_sms_marketing_attr %}

              {% render 'component-button'
                tag: 'button',
                type: 'submit',
                cta: 'Save',
                className: 'account-btn btn btn--lg btn--dark' %}
            </form>
          </div>

        {%- endunless -%}
      </div>
    </section>
  </div>

</account-element>
