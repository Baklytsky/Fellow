{% if page.metafields.custom_fields["desktop_masthead_image"] != blank %}
  {%- assign desktop_masthead = page.metafields.custom_fields["desktop_masthead_image"] -%}
{% endif %}
{% if page.metafields.custom_fields["mobile_masthead_image"] != blank %}
  {%- assign mobile_masthead = page.metafields.custom_fields["mobile_masthead_image"] -%}
{% endif %}
{% if page.metafields.custom_fields["page_intro_image"] != blank %}
  {%- assign introImage = page.metafields.custom_fields["page_intro_image"] -%}
{% endif %}
{% if page.metafields.custom_fields["page_masthead_alt_text"] != blank %}
  {% assign masthead_alt = page.metafields.custom_fields["page_masthead_alt_text"] %}
{% else %}
  {% assign masthead_alt = page.title %}
{% endif %}

{% if desktop_masthead != blank %}
  {%
    include 'component-masthead' with
    img: desktop_masthead,
    imgMobile: mobile_masthead,
    masthead_alt:
    dataAttr: 'componentMasthead',
    className: '',
    overlap: false
  %}
{% else %}
  {%
    include 'component-masthead' with
    dataAttr: 'componentMasthead',
    className: '',
    overlap: false
  %}
{% endif %}

<div class='container--l pt0 mt3rem' data-component='page'>
  <div class='row'>
    <div class='col-lg-3'>
      <div class="image">
        {% render 'image-lazy-metafields',
          image: introImage,
          alt: alt,
          size: 'medium',
          loader: true %}
      </div>
    </div>
    <div class='col-lg-7 offset-lg-1'>
      <div class="rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{% include 'page-jumbo-slider' %}
{% include 'jobs-list' %}
{% include 'meta-json' %}